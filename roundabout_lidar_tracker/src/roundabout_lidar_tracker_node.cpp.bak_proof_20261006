  double min_z_ = -0.8;
  double max_z_ = 2.5;
  double ring_margin_ = 3.0;
  double nonground_min_intensity_ = 90.0;
  double raw_ground_percentile_ = 20.0;
  double raw_ground_clearance_ = 0.25;
