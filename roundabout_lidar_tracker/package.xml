<?xml version="1.0"?>
<package format="2">
  <name>roundabout_lidar_tracker</name>
  <version>0.1.0</version>
  <description>Lightweight LiDAR clustering and tracking for roundabout missions.</description>

  <maintainer email="kuuve@todo.todo">kuuve</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>
  <depend>libpcl-all-dev</depend>
  <depend>mission_planner_msgs</depend>
  <depend>mission_supervisor</depend>
  <depend>nav_msgs</depend>
  <depend>pcl_conversions</depend>
  <depend>pcl_ros</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2</depend>
  <depend>visualization_msgs</depend>
  <test_depend>rostest</test_depend>

  <export />
</package>
