	    int index = 0;
	    for (const auto& pose_stamped : path_msg->poses) {
	        waypoint_maker::Waypoint wp;

	        wp.waypoint_index = index++;
	        wp.pose = pose_stamped;  // geometry_msgs::PoseStamped 그대로 복사
	        

