cost_weight:
  cte_cost_weight: 3500
  epsi_cost_weight: 2200

  # cost += v_start_weight * (v[t] - v_target[t])^2
  # v[t] : 예측된 차량 속도 , v_target : MPC가 정한 목표 속도
  v_start_weight: 20

  delta_cost_weight: 800

  # cost += delta_start_cost_weight * (delta[0] - previous_delta_cmd)^2
  # 매 solve 첫 조향이 직전 실제 command와 이어지도록 해서 고속 직선 조향 부호 플리핑을 줄임
  delta_start_cost_weight: 30000

  # 오차 발생 시 속도를 임의로 깎지 않고 ref_v(15 m/s)를 사수하도록 설정
  v_target_cost_weight: 300
  delta_change_cost_weight: 350000

  # 속도 명령 입력 부드럽게
  v_target_change_cost_weight: 100

# ==============================================================================
# 제어 속도 상한 통합 관리 (Control Speed Limits)
# - 도심/고주로 권역별 최고속도 상한
# - 규정 초과 방지 하드리미터 (control_arbiter)
# - 미션 구간별 속도 상한 (constraint_to_speed_cap 연동)
# - 특수 기동(회피/카메라 킥) 속도 상한
# ==============================================================================
speed_limit:
  # 1. 권역별 기본 최고속도 상한 (m/s)
  urban_max_mps: 15.0 # 도심 최고속도 상한 (15.0 m/s = 54.0 km/h, 규정 60km/h 페널티 방어)
  highway_max_mps: 25.0 # 고주로 최고속도 상한 (25.0 m/s = 90.0 km/h)

  # 2. 규정 초과 방지 하드리미터 (control_arbiter)
  hard_limit_enabled: true
  hard_limit_mps: 16.2 # 58.3 km/h 도심 절대 상한선 초과 시 즉시 제동 개입
  hard_limit_brake: 0.25 # 하드리미터 제동 세기 (0~1)
  hard_limit_release_mps: 0.4 # 하드리미터 해제 마진 (16.2 - 0.4 = 15.8 m/s 복귀 시 해제)

  # 3. 특수 기동 속도 상한
  # M2 section 속도를 상한으로 두고, obstacle_avoidance_node가 검출 거리와
  # 횡가속/jerk 한계로 실제 회피 가능 속도를 매 주기 계산해 이 아래로 낮춘다.
  # 10.0 -> 8.33 (2026-09-23): 회피 중 목표 30 km/h. 접근 구간은 M2 상한
  # (10.0) 그대로이고, 회피가 걸리면 이 값이 상한이 된다. 실제 속도는
  # obstacle_avoidance_node 가 선택된 경로의 s_clear 로 매 주기 이 아래로
  # 낮춘다(거리가 부족할 때만).
  avoidance_mps: 8.33
  # 7.0 -> 5.5 (2026-09-25, 18:19 백): 동적 구간에서 좌측 인도 보행자가 뛰어들 때
  # 6.0 m/s 에서 AEB 로 섰다(판정 지연 0.37 s). 7.0 캡은 실제 속도보다 높아 효과가
  # 없었다. 선감속은 동적 구간(M3)과 음영구간(터널)에서만 걸린다.
  camera_kick_mps: 5.5 # 카메라/라이다 인지 사전 감속 킥 속도

  # 4. 미션 구간별 속도 상한 (constraint_to_speed_cap 연동)
  # 여기 값을 바꾸면 missions.yaml을 수정하지 않아도 해당 section의 상한이
  # 바뀐다. M6/M7 고주로는 한 구간 안에 직선/곡선 속도가 모두 있으므로
  # 아래 section 상한 대신 mission_speed.state_3/state_4를 사용한다.
  sections:
    M1: 11.5 # 신호등 1 s
    M2: 10.0 # 정적 장애물 구간 (10.0 m/s = 36.0 km/h)
    M3: 10.0 # 동적 장애물 구간 (10.0 m/s = 36.0 km/h)
    # 15.0 -> 10.0 (2026-09-14 실측). 이 구간은 정지선이 둘이다 - M4(5443)와
    # 그 뒤 다섯번째 신호등(~6040). 15.0 이면 두번째 정지선 접근 중 10.6 m/s
    # 까지 붙어서, 황색 전환 시 제동거리(5 m/s^2 기준 10.6 m)가 남은 거리
    # (9.15 m)를 넘겨 정지선을 넘었다. 10.0 이면 5 m/s^2 에서 10.0 m,
    # 2.5 m/s^2 에서도 20 m 라 34 m 전부터 보이는 이 신호에 대응할 수 있다.
    M4: 11.0 # 신호등 4 구간 + 다섯번째 신호등 (36.0 km/h)
    M5: 15.0 # 회전교차로 접근 감속 구간 (10.0 m/s = 36.0 km/h)
    # 터널 진입 접근 구간(3.csv 6198~6999). 고주로 무제한에서 터널 10.0 으로
    # 바로 떨어뜨리지 않고 한 단계 거쳐 감속한다.
    M7B: 15.0 # 터널 접근
    # 랜덤 정적·동적 장애물과 GPS 데드리코닝을 같이 사용하는
    # 터널 구간이므로 도심 장애물 구간보다 낮게 제한한다.
    M8: 9.0 # 터널/음영구간 idx 7000~9000

# ==============================================================================
# 도심 (Urban: M1~M5, M8~M12) 제어 파라미터 (커브 오차 0 피팅)
# 속도 기반 동적 스케줄링 (차량 실제 속도 기준):
# - 저속/코너링 (<7 m/s): delta 1200, cte 6000, delta_chg 350000 -> 강력한 라인 추종 및 시원한 턴인으로 커브 오차 0 달성
# - 도심 고속 직진 (15 m/s = 54 km/h): delta 38000, cte 1500, delta_chg 650000 -> 칼직진 안정성 및 라인 고정
# ==============================================================================
urban_control:
  # 실측(2026-09-04 17:19 백) 급커브 t=8~10 / 67~68 / 89~94 에서 조향이 0.698(40deg)
  # 상한에 포화된 채 cte 가 1.8m 까지 벌어졌다. 조향을 더 허용해도 물리 상한이라
  # 소용이 없고, 코너 진입 전에 이미 늦은 상태였다 - 감속을 앞당기고(아래
  # curvature_speed) 코너에서 조향 억제를 더 푸는 방향으로 잡는다.
  # 실측(2026-09-04 18:14 백) 커브 탈출 후 저속 직선(t=39~48, 5.6~5.8 m/s)에서
  # cte 가 0.001~0.02m 로 거의 완벽한데도 조향이 ±0.04 로 계속 진동했다.
  # 추종오차가 아니라 조향이 사실상 공짜라(delta 600) MPC 가 cte 1cm 에도
  # 반응해서 스스로 만든 진동이다. 저속 세트의 조향/슬루 비용을 올린다.
  cte_cost_start_weight: 6000.0 # cte 1cm 를 0 으로 만들려는 과민반응 완화 (9000 -> 6000)
  cte_cost_urban_weight: 1500.0 # 도심 직선(15 m/s) 칼직진 유지
  epsi_cost_weight: 3200.0 # 코너 진입/탈출 헤딩 수렴 강화 (2400 -> 3200)
  delta_cost_start_weight: 2500.0 # 저속 미세 조향 억제 (600 -> 2500)
  delta_cost_high_speed_weight: 38000.0 # 도심 고속 직진 시 조향 안정화
  delta_cost_start_mps: 5.0 # 커브 탈출 5.7 m/s 가 저속 세트에 안 걸리게 (7.0 -> 5.0)
  delta_cost_full_mps: 15.0 # 스케줄링 최대 속도 (m/s)
  delta_change_cost_start_weight: 500000.0 # 조향 변화율 억제로 진동 감쇠 (200000 -> 500000)
  delta_change_cost_urban_weight: 650000.0 # 고속 조향 슬루 억제
  preview_distance_m: 45.0 # 커브 감속을 더 일찍 시작 (36.0 -> 45.0 m)
  max_speed_mps: 15.0 # 도심 최고속도 상한 (m/s)

# M2 정적 장애물 회피 경로를 추종하는 동안에만 적용된다. 일반 도심 MPC
# 피팅은 그대로 두고, 회피 S-curve에 대한 횡오차 응답만 빠르게 만든다.
#
# 2026-09-22: 한 번 7000/6000/600000 으로 바꿨다가 원복했다.
#   당시 17:19 백에서 epsi p90 11.1 deg, 조향 부호반전 9회를 보고
#   '과조향 진동'으로 판단해 슬루 억제를 올렸는데(delta_change 350k->600k),
#   18:04 백에서 epsi p90 이 16.5 deg 로 오히려 나빠졌다.
#   다시 보니 진동이 아니라 조향 부족이었다:
#     t=6.0~8.8 구간에서 epsi 가 +7.3 -> +11.1 deg 로 꾸준히 커지는 동안
#     조향은 +0.066 -> +0.003 으로 오히려 줄었고, 조향 최대값도
#     0.299 rad 로 물리한계(0.698)의 43% 밖에 안 썼다(포화 아님).
#   게다가 그 백의 epsi 는 상당 부분이 제어 문제가 아니라 경로 굴곡이었다.
#   /local_path 에 (0,0) 점이 섞여 있었고(437 프레임 중 6프레임, 뒤쪽 17점),
#   MPC polyfit 이 그 점을 물어 계수가 망가졌다. 그건
#   adding_global_path 의 조기 return 버그였고 따로 고쳤다.
#   즉 경로가 깨끗해지기 전의 데이터로 맞춘 값이라 근거가 무효다.
#   기준선으로 되돌리고, 다음 주행 데이터로 다시 맞춘다.
avoidance_control:
  cte_cost_weight: 4000.0
  epsi_cost_weight: 4000.0
  delta_cost_weight: 12000.0
  delta_change_cost_weight: 350000.0
  # M2 회피 경로를 추종할 때만 사용하는 횡가속 기반 곡률 속도 상한.
  # 경로 생성기의 spatial_max_lat_accel(3.0)과 맞춘다. 다른 구간은
  # curvature_speed/lateral_accel_limit_mps2(2.2)를 그대로 쓴다.
  lateral_accel_limit_mps2: 3.0
  curvature_min_speed_mps: 3.0 # 급한 회피 곡선에서 전역 4.5m/s 바닥값으로 횡가속 한계를 넘기지 않도록

# ==============================================================================
# 고주로 (Highway: M6, M7 speed_limit_exempt, 25 m/s = 90 km/h) 제어 파라미터 (차선변경 후 무오실 피팅)
# 고속 특화 파라미터:
# - 극대화된 헤딩 댐핑(epsi 7000)과 위상지연 제거(output_lpf_alpha_high_speed 0.75)로
#   차선변경 완료 후 목표 차선 중앙에 빨려들어가듯 안착하여 오실레이션(요동) 완전 소멸
# ==============================================================================
highway_control:
  # 실측(2026-09-04 18:19 백) 차선변경 후 헤딩이 수렴하지 못하고 주기 2.5~3초,
  # 진폭 ±3~7도로 계속 진동했다(t=132~148, M7 직선까지 지속). 조향 부호 반전은
  # 거의 없었고 cte 도 0.02~0.89m 로 나쁘지 않은데 자세만 안 잡혔다 - 즉
  # delta_change 900000 이 조향 변화를 과하게 눌러 헤딩 오차를 보고도 늦게
  # 반응했고, 그 위상지연이 진동을 유지시켰다. 24 m/s 에서 0.5초 지연은 12m 다.
  # 실측(2026-09-04 18:25 백) 차선변경 후 epsi 진폭이 0.6도 -> 9.7도 로 16배
  # 증폭되며 발산했다(주기 1.0~1.5초). 액추에이터 응답비율은 1.00 이고 solve 도
  # 45~55ms 로 정상 - 즉 지연이 아니라 폐루프 게인이 과한 것이다. 24 m/s 에서는
  # Lf=3.0 기준 조향 1도가 초당 약 8도의 요레이트를 만들어, 작은 조향에도 헤딩이
  # 크게 반응한다. 직전 시도(epsi 12000 + delta_change 400000)는 게인을 올리고
  # 감쇠를 푼 것이라 발산을 키웠다 - 반대로 간다.
  cte_cost_weight: 1000.0 # 고속 횡방향 과민 반응 완화 (1200 -> 1000)
  epsi_cost_weight: 10500.0 # 헤딩 댐핑 강화로 고속 차체 흔들림 원천 억제 (9500 -> 10500)
  delta_cost_weight: 52000.0 # 고속 조향각 억제 강화로 불필요한 과조향 차단 (42000 -> 52000)
  delta_change_cost_weight: 750000.0 # 조향 변화율 억제로 고속 조향 급격한 변동 억제 (600000 -> 750000)
  preview_distance_m: 45.0 # 고속 안전 제동거리용 선제 프리뷰 (m)
  max_speed_mps: 25.0 # 고주로 최고속도 상한 (m/s)

# 레거시 호환용 파라미터
# [미사용] mpc.cpp 는 urban_control/highway_control 만 읽는다(이 네임스페이스
# 참조 0건). 예전 2단 스케줄 시절 잔재이며, 여기 값을 고쳐도 반영되지 않는다.
# 실제 튜닝은 위의 urban_control / highway_control 에서 한다.
speed_scheduled_cost:
  enabled: true
  delta_cost_start_mps: 7.0
  delta_cost_full_mps: 15.0
  delta_cost_start_weight: 1200.0
  delta_cost_high_speed_weight: 38000.0
  cte_cost_start_weight: 6000.0
  cte_cost_urban_weight: 1500.0
  epsi_cost_start_weight: 2400.0
  epsi_cost_urban_weight: 2400.0
  delta_change_cost_start_weight: 350000.0
  delta_change_cost_urban_weight: 650000.0

k_v: 0.4
N: 30 # horizon 30*0.05 = 1.50 s. 45 는 IPOPT 가 9.6 Hz 로 처져 슬루가 실효 1.08 rad/s 로 깎였다.
dt: 0.05
ref_v: 15.0 # 기본 순항 목표속도 (m/s). 실제 주행 최고속도는 speed_limit.urban_max_mps(15.0) / highway_max_mps(25.0) 로 제어됨
speed:
  upperBound: 40.0 # 솔버 변수 절대 상한. 실질적인 주행 속도 상한은 상단의 speed_limit 파라미터가 동적 클램핑 수행
  lowerBound: 0.0
steer:
  upperBound: 0.6981
  lowerBound: -0.6981
  # 모라이 부호 반대
  command_sign: -1.0
  # 조향 슬루레이트 (1.8 rad/s = 103 deg/s로 물리 액추에이터 지연 및 위상 오실레이션 억제)
  command_rate_limit_radps: 1.8

  # 최종 /ctrl_cmd.steering 출력 LPF
  output_lpf_enabled: true
  output_lpf_alpha: 0.65
  output_lpf_alpha_high_speed: 0.72 # 고속 조향 출력 고주파 진동 흡수 및 안정화 (0.85 -> 0.72)

# 규정 2-6-1 아이오닉5 축거 3.000 m.
# 기존 2.0 은 erp-42(축거 1.04) 시절부터 남은 튜닝값이라 실차 운동학과 어긋났다.
# Lf 를 키우면 같은 조향각에서 예측 요레이트가 작아진다 -> MPC 가 더 큰 조향을 낸다.
Lf: 3.0

# MORAI CtrlCmd longitudinal control.  Mode 1 directly controls pedals using
# /Competition_topic speed feedback; accel and brake are clamped to 0~1.
longitudinal:
  command_type: 1
  throttle_kp: 0.22
  throttle_ki: 0.02
  throttle_integral_limit: 2.0
  throttle_accel_limit: 0.60
  # M6/M7(고주로) 구간 전용. 도심 0.60은 M2/M3 저속(36km/h) 기준 검증값이라
  # 그대로면 고주로 목표(25 m/s)까지 가속이 못 따라간다.
  throttle_accel_limit_exempt: 1.0
  # 평소 감속 브레이크 상한 (0.60 -> 0.50: 급제동 시 차체 노즈다이브/피칭 진폭 억제).
  # 비상/킥 제동은 아래 kick_brake_limit(1.0)을 사용.
  throttle_brake_limit: 0.50
  # static_speed_scale(카메라/라이다 감속 킥, /obstacle_avoidance/static_speed_scale)
  # 걸릴 때만 쓰는 별도 브레이크 세기. 평소 순항속도 변화(커브 등)는
  # throttle_brake_limit 로 부드럽게, 킥은 더 세게. 2026-09-03 mpc_path_tracking.h
  # 에 static_speed_scale 구독·kick_brake_limit 분기를 정동적 원본대로 이식.
  kick_brake_limit: 1.0
  # 브레이크가 한 사이클 만에 확 튀는 걸 막는 초당 최대 증가량 (1.2 -> 0.8: 급제동 꿀렁거림 및 피칭 진동 억제).
  # 실제 위험 정지는 obstacle_stop_node가 /ctrl_cmd 를 직접 덮어써서 이 경로를
  # 안 거치므로 안전엔 무관.
  brake_rate_limit_per_sec: 0.8
  # 페달 데드밴드 (방안 1): 목표속도 부근 오차(+-0.18 m/s) 내에서는 가속/제동 모두 0(타행) 처리하여 꿀렁거림 완전 제거
  throttle_pedal_deadband: 0.04

# /local_path가 끝점 근처에서 너무 짧아지면 3차 polyfit에 필요한 점이 부족해
# MPC 노드가 assert로 죽을 수 있다. 이때는 MPC solve를 건너뛰고 stop command를 낸다.
path_end_stop:
  enabled: true
  min_polyfit_points: 4

# waypoint_system CSV 4번째 컬럼 mission_state 기반 속도 계획.
# 단위는 모두 m/s. 각 state 목표속도를 먼저 적용하고,
# 이후 curvature_speed가 필요하면 한 번 더 낮춘다.
mission_speed:
  enabled: true
  # 스테이트 변경으로 인한 목표 속도 급변 시 부드러운 가감속 슬루레이트 제한 (m/s^2)
  rate_limit_up_mps2: 2.2 # 15 -> 25 m/s 가속 시 약 4.5초에 걸쳐 신속하고 부드럽게 가속 (1.8 -> 2.2)
  rate_limit_down_mps2: 3.0 # 고주로 속도 감소 시 보다 신속하고 경쾌하게 감속 (2.0 -> 3.0)
  # 0.csv 도심 구간 전체 기본 순항속도 15.0 m/s (54 km/h) 일괄 적용
  default_mps: 15.0
  # CSV 4번째 컬럼의 state별 제한속도. 미션 state 속도는 여기서 조정한다.
  state_0_mps: 15.0
  state_1_mps: 15.0
  state_2_mps: 15.0
  state_3_mps: 25.0 # 고주로 직선 상한
  # 고주로 곡선 구간(3.csv idx 3000~5599, 2.csv idx 3000~4179). 65 km/h 속도 제한 적용 (idx 4700 곡선 진입 170m 전부터 여유로운 서행 안착)
  state_4_mps: 20.0 # 고주로 3.csv 속도제한 (18.06 m/s * 3.6 = 65.0 km/h)
  state_5_mps: 15.0
  state_6_mps: 15.0
  state_7_mps: 15.0
  state_8_mps: 15.0
  state_9_mps: 15.0
  state_10_mps: 15.0
  state_11_mps: 15.0
  state_12_mps: 15.0

# Curvature-based speed limit.
# MPC 추종은 /local_path를 유지하고, 속도 제한은 /final_waypoint.rk를
# 경로 누적거리 기준으로 preview한다. rk가 없으면 polyfit 곡률로 fallback.
# 커브에서는 Solve 1회 동안 ref_v/speed.upperBouㄴㄴㄴㄴㄴnd를 낮춘다.
curvature_speed:
  enabled: true
  # 방안 2: splined.csv 의 rk 재보간 노이즈 스파이크 배제, MPC 자체 부드러운 polyfit 곡률 사용
  use_waypoint_rk: false
  fallback_to_polyfit: true # rk가 없거나 너무 작으면 기존 MPC polyfit 곡률 사용
  # 실측 급커브에서 진입 속도가 10~13 m/s 로 높아 조향 40deg 포화 + cte 1.8m 가
  # 났다. 횡가속 한계를 낮춰 코너 진입 목표속도 자체를 끌어내린다.
  lateral_accel_limit_mps2: 2.2 # 2.8 -> 2.2 (약 0.22 g). 코너 진입 속도를 더 낮춘다
  min_speed_mps: 4.5 # 급커브 최소 속도 하한 (5.5 -> 4.5). 필요하면 더 느리게 돌게 허용
  max_speed_mps: 0.0 # 0이면 ref_v/speed.upperBound 중 작은 값 사용
  preview_distance_m: 28.0 # 기본값 (urban_control 28.0m, highway_control 50.0m 구간별 동적 스위칭)
  min_lookahead_m: 0.5 # 바로 앞 피팅 노이즈 무시
  deadband_inv_m: 0.035 # R < 28m 급커브 감속
  sample_count: 40
  percentile: 0.80 # 1.0이면 max, 0.90이면 상위 90% 곡률 사용
  rate_limit_up_mps2: 4.0 # 커브 탈출 후 15 m/s까지 신속 재가속
  rate_limit_down_mps2: 4.5 # 커브 진입 전 확실한 제동 감속
