<launch>
	<!-- 실험용 오버라이드. 기본값은 mpc_params.yaml 과 동일하므로
	     인자를 안 주면 기존 거동 그대로다.
	       N 45 -> 30 : horizon 2.25s -> 1.50s, 솔브 비용 감소
	     IPOPT 는 단일 스레드라 코어를 늘려도 소용없다. 문제를 줄여야 한다. -->
	<arg name="N" default="30"/>
	<!-- MPC 출력 토픽. mpc_path_tracking.h 는 /ctrl_cmd 를 하드코딩하므로
	     remap 으로만 바꿀 수 있다. obstacle_stop_node 가 최종단으로 들어가는
	     원본(정동적) 구성에서는 /ctrl_cmd_raw 로 내보내고, 정지 노드가
	     /ctrl_cmd 를 최종 발행한다.
	     remap 은 노드 안에만 건다. control_feedback_monitor 는 최종 /ctrl_cmd 를
	     그대로 보게 둬야 실제로 차에 나간 명령을 기록한다. -->
	<arg name="ctrl_cmd_topic" default="/ctrl_cmd"/>
	<!-- MPC 가 외부 ACC 목표속도로 구독하는 토픽. 기본은 smpc_lane_change 의
	     원본 이름(/smpc/target_speed_mps) 그대로다.
	     enable_behavior(SMPC 차선변경)를 켜면 acc_speed_planner_node 와
	     smpc_decision_node 가 이 이름을 자기들끼리도 내부적으로 주고받으므로
	     그 이름 자체는 절대 안 건드린다 - 대신 이 remap 으로 "우리 MPC 가
	     실제로 듣는 이름"만 따로 뗀다. control.launch 가 이걸
	     /smpc/target_speed_mps_gated 로 넘기면, constraint_to_speed_cap 이
	     M6/M7(고주로)에서만 ACC 원본값을 그 이름으로 중계하고 그 외 구간은
	     자기 미션 캡을 낸다 - 그래서 ACC 는 고주로 밖에서는 MPC 에 전혀
	     영향을 못 준다(랩 전체에서 계속 값을 내고 있어도). -->
	<arg name="external_acc_topic" default="/smpc/target_speed_mps"/>
	<!-- false 면 MPC 가 SMPC ACC 목표속도를 무시한다(mission_speed/curvature 만
	     사용). SMPC 의 차선변경 판단은 그대로 두고 속도 개입만 끊는 스위치라,
	     ACC 가 원인인지 분리 검증할 때 쓴다. -->
	<arg name="external_acc_enabled" default="true"/>
	<rosparam command="load" file="$(find mpc_path_tracking)/config/mpc_params.yaml" />
	<!-- mpc.h 는 전역 NodeHandle 로 파라미터를 읽는다(ros::NodeHandle nh).
	     따라서 노드 private 이 아니라 전역 /N 을 덮어써야 적용된다.
	     yaml 로드 뒤에 두어야 순서상 이 값이 이긴다. -->
	<param name="/N" value="$(arg N)"/>
	<param name="external_acc/enabled" value="$(arg external_acc_enabled)"/>
	<node name="mpc_path_tracking_node" pkg="mpc_path_tracking" type="mpc_path_tracking" output="screen">
		<remap from="/ctrl_cmd" to="$(arg ctrl_cmd_topic)"/>
		<remap from="/smpc/target_speed_mps" to="$(arg external_acc_topic)"/>
	</node>

	<!-- Diagnostic only: compares /ctrl_cmd with MORAI's /Ego_topic feedback. -->
	<node name="control_feedback_monitor" pkg="mpc_path_tracking"
	      type="control_feedback_monitor" output="screen">
		<param name="feedback_topic" value="/Competition_topic" />
		<param name="target_speed_topic" value="/control_feedback/mpc_target_speed_mps" />
		<param name="mission_speed_topic" value="/control_feedback/mission_speed_target_mps" />
		<param name="curve_speed_limit_topic" value="/control_feedback/curvature_speed_limit_mps" />
		<param name="path_curvature_topic" value="/control_feedback/path_curvature_for_speed_limit" />
		<param name="report_rate_hz" value="20.0" />
		<param name="output_dir" value="$(find mpc_path_tracking)/data" />
	</node>

<!-- <node pkg="tf2_ros" type="static_transform_publisher" name="base_to_map" args="0 0 0 0 0 0 map base_link" /> -->


</launch>
