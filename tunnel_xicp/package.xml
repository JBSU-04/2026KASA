<?xml version="1.0"?>
<package format="2">
  <name>tunnel_xicp</name>
  <version>0.1.0</version>
  <description>Observation-only official X-ICP tunnel wall registration.</description>
  <maintainer email="kuuve@example.com">KUUVE</maintainer>
  <license>BSD-3-Clause</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>roscpp</depend><depend>rospy</depend><depend>sensor_msgs</depend>
