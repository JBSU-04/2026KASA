	// ---------------- 콜백 ----------------
	void waypointCallback(const waypoint_maker::Lane::ConstPtr &msg)
	{
		if (msg->waypoints.size() < 2)
			return;

		// CSV idx 기준 0~static_dynamic_split_idx_는 정적 미션 구간, 그 이후는
		// 동적 미션 구간으로 코스가 고정되어 있음. 매 콜백 갱신(스플라인 재계산
		// 캐시 체크보다 먼저) - 아래 캐시로 조기 return 되어도 최신 값 유지.
		current_waypoint_idx_ = msg->waypoints.front().waypoint_index;
		current_lane_number_ = msg->waypoints.front().lane_number;

		// waypoint_loader가 odom 콜백마다(수십 Hz) /final_waypoint를 재발행하므로,
		// 실제로 내용이 바뀐 경우에만 스플라인을 재계산한다 (안 그러면 매번 무거운
		// calc_spline_course가 돌아서 planLoop 타이머가 계속 밀림).
		const double fx = msg->waypoints.front().pose.pose.position.x;
		const double fy = msg->waypoints.front().pose.pose.position.y;
		const double bx = msg->waypoints.back().pose.pose.position.x;
		const double by = msg->waypoints.back().pose.pose.position.y;
		if (have_path_ &&
			msg->waypoints.size() == last_wp_count_ &&
			std::abs(fx - last_wp_front_x_) < 1e-3 && std::abs(fy - last_wp_front_y_) < 1e-3 &&
			std::abs(bx - last_wp_back_x_) < 1e-3 && std::abs(by - last_wp_back_y_) < 1e-3)
		{
			return;
		}
		last_wp_count_ = msg->waypoints.size();
		last_wp_front_x_ = fx; last_wp_front_y_ = fy;
		last_wp_back_x_ = bx; last_wp_back_y_ = by;
		path_wp_x_.clear();
		path_wp_y_.clear();
		path_wp_indices_.clear();
		path_wp_x_.reserve(msg->waypoints.size());
		path_wp_y_.reserve(msg->waypoints.size());
		path_wp_indices_.reserve(msg->waypoints.size());
		for (const auto &wp : msg->waypoints)
		{
			path_wp_x_.push_back(wp.pose.pose.position.x);
			path_wp_y_.push_back(wp.pose.pose.position.y);
			path_wp_indices_.push_back(wp.waypoint_index);
		}

		vecD wx, wy;
		wx.reserve(msg->waypoints.size());
		wy.reserve(msg->waypoints.size());
		for (const auto &wp : msg->waypoints)
		{
			wx.push_back(wp.pose.pose.position.x);
			wy.push_back(wp.pose.pose.position.y);
		}

		vecD rx, ry, ryaw, rk;
		Spline2D new_csp = calc_spline_course(wx, wy, rx, ry, ryaw, rk, spline_ds_);

		rx_ = rx;
		ry_ = ry;
		ryaw_ = ryaw;
		rk_ = rk;
		csp_.reset(new Spline2D(new_csp));

		global_s_.assign(rx_.size(), 0.0);
		double s = 0.0;
		for (size_t i = 1; i < rx_.size(); ++i)
		{
			s += dist(rx_[i], ry_[i], rx_[i - 1], ry_[i - 1]);
			global_s_[i] = s;
		}
		s_dest = global_s_.empty() ? 0.0 : global_s_.back();

		have_path_ = true;

		publishGlobalPath();
	}

	void publishGlobalPath()
	{
		nav_msgs::Path msg;
		msg.header.stamp = ros::Time::now();
		msg.header.frame_id = "map";
		for (size_t i = 0; i < rx_.size(); ++i)
		{
			geometry_msgs::PoseStamped ps;
			ps.header = msg.header;
			ps.pose.position.x = rx_[i];
			ps.pose.position.y = ry_[i];
			double yaw = (i < ryaw_.size()) ? ryaw_[i] : 0.0;
			tf::Quaternion q = tf::createQuaternionFromYaw(yaw);
			ps.pose.orientation.x = q.x();
			ps.pose.orientation.y = q.y();
			ps.pose.orientation.z = q.z();
			ps.pose.orientation.w = q.w();
			msg.poses.push_back(ps);
		}
		global_path_pub_.publish(msg);
	}

	void cameraDetectionCallback(const std_msgs::Bool::ConstPtr &msg)
	{
		// 이제 별도 스레드(camera_spinner_)에서 실행됨 - planLoop(메인 스레드)와
		// 동시에 speed_kick_* 상태를 건드릴 수 있어서 락으로 보호한다.
		std::lock_guard<std::mutex> lock(speed_kick_mutex_);
		camera_obstacle_present_ = msg->data;
		last_camera_detection_time_ = ros::Time::now();
		// 카메라 감지 즉시 반응. 예전엔 이 트리거 판단/발행이 obstacleInfoCallback
		// 안에 있어서 /obstacle_info(라이다 클러스터링, 실측 0.6~0.7초 간격)가
		// 들어와야만 평가됐음 -> 카메라는 바로 감지해도 킥은 최대 0.6~0.7초 뒤에야
		// 걸리는 지연이 있었음. 여기서 바로 평가/발행해서 트리거 뜨자마자 반응하게 함.
		updateSpeedKickLocked();
	}

	void tunnelOffsetCallback(const std_msgs::Float64::ConstPtr &msg)
	{
		tunnel_lateral_offset_ = msg->data;
		last_tunnel_offset_stamp_ = ros::Time::now();
		tunnel_wall_offset_valid_ = true;
	}

	// ★ 터널 벽 제한(2026-09-29). tunnel_wall_detector 가 벽을 curb_inset 만큼
	//   안쪽으로 옮긴 '연석선'까지 실제 자차 기준 수직거리를 준다:
	//   [valid, 우측 연석선 거리, 좌측 연석선 거리, 우 기울기, 좌 기울기].
	void tunnelLimitsCallback(const std_msgs::Float64MultiArray::ConstPtr &msg)
	{
		if (msg->data.size() < 3)
			return;
		tunnel_limits_valid_ = msg->data[0] > 0.5;
		tunnel_r_curb_ = msg->data[1];
		tunnel_l_curb_ = msg->data[2];
		tunnel_limits_stamp_ = ros::Time::now();
	}

	// ★ 라이다 선감속(2026-09-29). 터널 연석선 안쪽 + 전방 20 m 안 물체.
	//   카메라 선감속(tunnel_camera_kick_enabled)을 대신한다.
	void tunnelLidarKickCallback(const std_msgs::Bool::ConstPtr &msg)
	{
		std::lock_guard<std::mutex> lock(speed_kick_mutex_);
		lidar_obstacle_present_ = msg->data;
		if (msg->data)
			last_lidar_detection_time_ = ros::Time::now();
		updateSpeedKickLocked();
	}

	// ★ 2026-09-29 (20:27 백): 터널 벽/턱 조각 판정(config/tunnel_wall_profile.yaml).
	//   근거리 인지가 벽·턱 조각을 차로 안 물체로 올렸다 - 자차가 회피 복귀로 기울거나
	//   추측항법이 흘러 벽 쪽에 붙으면 자차 기준 y 로는 차로 안에 들어온다(ego y -1.7~-2.4).
	//   기준경로 idx 별 실측 경계(우 턱 -3.5~-3.9 / 좌 +6.9~7.5)와 물체의 실제 횡위치
	//   (추측항법 횡거리 - 벽 보정)를 비교해, 경계 안쪽 tunnel_wall_piece_margin 이내 또는
	//   바깥이면 벽 조각으로 보고 회피/충돌/선감속 대상에서 뺀다.
	bool tunnelWallProfileAt(int idx, double &right, double &left) const
	{
		right = 0.0; left = 0.0;
		const std::size_t n = tunnel_wall_profile_.size() / 3;
		if (n < 2 || idx < tunnel_wall_profile_[0] || idx > tunnel_wall_profile_[(n - 1) * 3])
			return false;
		std::size_t lo = 0, hi = n - 1;
		while (hi - lo > 1)
		{
			const std::size_t mid = (lo + hi) / 2;
			if (tunnel_wall_profile_[mid * 3] <= idx) lo = mid; else hi = mid;
		}
		const double i0 = tunnel_wall_profile_[lo * 3], i1 = tunnel_wall_profile_[hi * 3];
		const double f = (i1 > i0) ? (idx - i0) / (i1 - i0) : 0.0;
		const double r0 = tunnel_wall_profile_[lo * 3 + 1], r1 = tunnel_wall_profile_[hi * 3 + 1];
		const double l0 = tunnel_wall_profile_[lo * 3 + 2], l1 = tunnel_wall_profile_[hi * 3 + 2];
		// 한쪽이 0(경계 없음)이면 보간하지 않고 그 쪽은 경계 없음으로 본다.
		if (r0 < 0.0 && r1 < 0.0) right = r0 + f * (r1 - r0);
		if (l0 > 0.0 && l1 > 0.0) left = l0 + f * (l1 - l0);
		return right < 0.0 || left > 0.0;
	}

	static std::set<int> jsonIds(const Json::Value &arr)
	{
		std::set<int> out;
		if (arr.isArray())
			for (const auto &v : arr) out.insert(v.asInt());
		return out;
	}

	void dynStateCallback(const std_msgs::String::ConstPtr &msg)
	{
		Json::CharReaderBuilder builder;
		Json::Value root;
		std::string errs;
		std::istringstream ss(msg->data);
		if (!Json::parseFromStream(builder, ss, &root, &errs)) return;
		dyn_hold_ = root.get("hold", false).asBool();
		dyn_ids_ = jsonIds(root["dynamic_ids"]);
		restatic_ids_ = jsonIds(root["static_ids"]);
		dyn_state_stamp_ = ros::Time::now();
	}

	void bgIdsCallback(const std_msgs::String::ConstPtr &msg)
	{
		Json::CharReaderBuilder builder;
		Json::Value root;
		std::string errs;
		std::istringstream ss(msg->data);
		if (!Json::parseFromStream(builder, ss, &root, &errs)) return;
		bg_ids_ = jsonIds(root["ids"]);
		bg_ids_stamp_ = ros::Time::now();
	}

	// M3(0.csv, static_dynamic_split_idx 초과 ~ dynamic_zone_max_idx) 안인가
	bool inM3Zone() const
	{
		return !tunnel_mode_ && current_lane_number_ == 0 && current_waypoint_idx_ >= 0 &&
			current_waypoint_idx_ > static_dynamic_split_idx_ &&
			(dynamic_zone_max_idx_ < 0 || current_waypoint_idx_ <= dynamic_zone_max_idx_);
	}

	// M3 정적 전환 회피 모드: 정지 노드가 static_ids 를 넘겼거나, 그 회피에서 아직 복귀 중
	bool m3AvoidMode() const
	{
		if (!m3_static_avoid_enabled_ || !inM3Zone())
			return false;
		return m3_avoid_latched_ || (dynStateFresh() && !restatic_ids_.empty());
	}

	bool dynStateFresh() const
	{
		return !dyn_state_stamp_.isZero() && (ros::Time::now() - dyn_state_stamp_).toSec() < 0.5;
	}

	bool isTunnelWallPiece(const Json::Value &obs) const
	{
		if (!tunnel_mode_ || !tunnel_wall_piece_filter_enabled_)
			return false;
		if (!obs.isMember("position_world") || obs["position_world"].size() < 2)
			return false;
		int idx = -1;
		double lat = 0.0;
		if (!obstaclePathLocation(obs["position_world"][0].asDouble(),
				obs["position_world"][1].asDouble(), idx, lat))
			return false;
		const double off = tunnel_wall_offset_valid_ ? tunnel_lateral_offset_ : 0.0;
		const double lat_true = lat - off;
		if (obs.get("observed_motion_valid", false).asBool() &&
			obs.get("observation_age", 1e9).asDouble() >= 0.0 &&
			obs.get("observation_age", 1e9).asDouble() <= 0.3 &&
			obs.isMember("observed_velocity") && obs["observed_velocity"].size() >= 2)
		{
			size_t j=0; double best=1e18;
			for(size_t i=0;i<path_wp_x_.size();++i) {
				const double d=std::hypot(path_wp_x_[i]-obs["position_world"][0].asDouble(),path_wp_y_[i]-obs["position_world"][1].asDouble());
				if(d<best){best=d;j=i;}
			}
			if(path_wp_x_.size()<2) return false;
			const size_t a=std::min(j,path_wp_x_.size()-2), b=a+1;
			const double yaw=std::atan2(path_wp_y_[b]-path_wp_y_[a],path_wp_x_[b]-path_wp_x_[a]);
			const double normal_v = -std::sin(yaw) * obs["observed_velocity"][0].asDouble() +
				std::cos(yaw) * obs["observed_velocity"][1].asDouble();
			if (-std::copysign(1.0, lat_true) * normal_v >= 0.5)
				return false; // coherent inward crossing is not background
		}
		if (!bg_ids_stamp_.isZero() && (ros::Time::now() - bg_ids_stamp_).toSec() < 0.5 &&
			bg_ids_.count(obs.get("id", -1).asInt()))
			return true;
		double right = 0.0, left = 0.0;
		const bool have_profile = tunnelWallProfileAt(idx, right, left);
		bool piece = have_profile &&
			((right < 0.0 && lat_true <= right + tunnel_wall_piece_margin_) ||
			 (left > 0.0 && lat_true >= left - tunnel_wall_piece_margin_));

		// 입구(3.csv 7201~7299)와 프로파일의 0 구간은 고정 경계가 없다.
		// 이때 tunnel_wall_detector가 같은 시각에 측정한 연석선을 경로 좌표로
		// 옮겨 벽 조각을 제거한다. 기존에는 이 구간에서 필터가 바로 false가 되어
		// 입구 벽이 회피 트리거가 되고 조향이 좌우로 튈 수 있었다.
		const bool live_limits = tunnel_limits_valid_ && !tunnel_limits_stamp_.isZero() &&
			(ros::Time::now() - tunnel_limits_stamp_).toSec() <= tunnel_wall_limits_timeout_;
		if (!piece && live_limits)
		{
			int vehicle_idx=-1; double vehicle_d=0.;
			if(!obstaclePathLocation(pose_x_,pose_y_,vehicle_idx,vehicle_d)) return false;
			const double vehicle_true_d = vehicle_d - off;
			const double live_right = vehicle_true_d - tunnel_r_curb_;
			const double live_left = vehicle_true_d + tunnel_l_curb_;
			piece = lat_true <= live_right + tunnel_wall_piece_margin_ ||
				lat_true >= live_left - tunnel_wall_piece_margin_;
			if (piece)
			{
				right = live_right;
				left = live_left;
			}
		}
		if (piece)
			ROS_INFO_THROTTLE(1.0, "[obstacle_avoidance] tunnel wall piece ignored: id=%d idx=%d "
				"lat %.2f (boundary R %.2f / L %.2f%s)", obs.get("id", -1).asInt(), idx,
				lat_true, right, left, live_limits ? ", live available" : "");
		return piece;
	}

