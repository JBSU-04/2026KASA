// 회피 폭 상한 조회(노드와 공유). 곡선이 있으면 선형 보간, 없으면 구간값.
// 반환 false = 이 idx 에는 정의가 없음(제한 없음). right/left 0 이하 = 제한 없음.
bool road_width_at(const std::vector<double> &profile, const std::vector<double> &zones,
	int idx, double &right, double &left)
{
	if (profile.size() >= 6)
	{
		const std::size_t n = profile.size() / 3;
		if (idx < profile[0] || idx > profile[(n - 1) * 3])
			return false;
		// 이분 탐색: profile[k*3] <= idx <= profile[(k+1)*3] 인 k
		std::size_t lo = 0, hi = n - 1;
		while (hi - lo > 1)
		{
			const std::size_t mid = (lo + hi) / 2;
			if (profile[mid * 3] <= idx) lo = mid; else hi = mid;
		}
		const double i0 = profile[lo * 3], i1 = profile[hi * 3];
		const double f = (i1 > i0) ? (idx - i0) / (i1 - i0) : 0.0;
		right = profile[lo * 3 + 1] + f * (profile[hi * 3 + 1] - profile[lo * 3 + 1]);
		left = profile[lo * 3 + 2] + f * (profile[hi * 3 + 2] - profile[lo * 3 + 2]);
		return true;
	}
	for (std::size_t z = 0; z + 3 < zones.size(); z += 4)
	{
		if (idx < static_cast<int>(zones[z]) || idx > static_cast<int>(zones[z + 1]))
			continue;
		right = zones[z + 2];
		left = zones[z + 3];
		return true;
	}
	return false;
}
