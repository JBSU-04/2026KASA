// samples paths and returns the bestpath
FrenetPath frenet_optimal_planning(Spline2D csp, double s0, double c_speed, double c_d,
								   double c_d_d, double c_d_dd, FrenetPath lp, double pose_x, double pose_y, vecD ob_x, vecD ob_y, double bot_yaw,
								   int committed_avoid_side, int preferred_avoid_side,
								   double side_preference_cost)
{
	// 후보 실패 시 이전 프레임의 오래된 경로에 차가 고착되지 않도록 매 사이클 초기화
	FrenetPath bestpath;
	// 이 호출의 충돌 검사용 격자(ObGrid 주석). 어떤 경로로 나가도 비운다.
	g_ob_grid.build(ob_x, ob_y);
	struct GridGuard { ~GridGuard() { g_ob_grid.clear(); } } grid_guard;

	//initialise object of class Fplist
	//object member fplist_lat stores sampled frenet paths
	vector<FrenetPath> fplist = Fplist(c_speed, c_d, c_d_d, c_d_dd, s0).fplist_lat;

	// 이미 한쪽(좌측 또는 우측)으로 회피가 확정된 경우, 반대쪽으로 뒤집으려는 후보에 높은 비용 부과 (좌우 진동/오실 방지)
	// 방향은 첫 장애물 옆 오프셋(avoid_offset)으로 본다 - 다단 후보의 끝점은
	// 둘째 장애물 반대편이나 복귀 뒤 값이다.
	if (committed_avoid_side != 0)
	{
		for (auto &fp : fplist)
		{
			const double off = fp.avoid_offset();
			// committed_avoid_side == -1: 우측 회피 유지 -> 좌측(off > 0.15) 후보 억제
			// committed_avoid_side == +1: 좌측 회피 유지 -> 우측(off < -0.15) 후보 억제
			if (committed_avoid_side * off < -0.15)
			{
				fp.set_cf(fp.get_cf() + 3000.0);
			}
		}
	}

	int n_yaw_rejected = 0, n_collision_rejected = 0;
	int n_curvature_rejected = 0, n_inward_rejected = 0;
	double best_d_tried = 0.0, min_clearance = 1e18;
	// (예전의 '이전보다 안쪽 후보 배제' 필터는 |d| 비용이 대신하므로 꺼져 있다.
	//  AVOID_EXCESS_COST 주석 참조.)

	// ---- 후보 평가 ----
	// 충돌 비율은 진단과 홀드 비용을 계산하지만, 최종 선택에는 frac=0인
	// 후보만 들어간다. 전부 막히면 빈 경로를 반환해 상위 노드가 안전 정지를
	// 요청한다. 한 번 막힌 오프셋은 몇 사이클 동안
	// 비싸게 유지해서, 경로점 기반 검사가 프레임마다 흔들려도 방금 버린
	// 후보로 성급히 되돌아가지 않게 한다.
	for (auto &kv : g_collision_hold)
		if (kv.second > 0) kv.second--;

	// ★ 분기한정. 다단 후보가 들어오면서 후보가 수십 개에서 최대 ~1500 개로
	//   늘었다. 전역 변환·충돌 검사가 비용의 대부분이라, 변환 없이 계산되는
	//   항(사전 비용)으로 먼저 정렬하고 싼 것부터 평가한다. 최종 비용 =
	//   사전 비용 + 곡률 비용(>=0) 이므로, 사전 비용이 지금까지의 최적
	//   최종 비용 이상이면 그 뒤 후보는 더 나을 수 없다 -> 중단.
	//   전수 평가와 같은 답을 낸다(홀드 기억은 단일 후보에만 쓴다 - 아래).
	struct Ranked { double pre; int i; };
	std::vector<Ranked> order;
	order.reserve(fplist.size());
	for (int i = 0; i < static_cast<int>(fplist.size()); i++)
	{
		const FrenetPath &fp = fplist[i];
		const double off = fp.avoid_offset();
		// |d| 에 비례한 벌점. 충돌 비용이 압도적으로 크므로 '막힌 후보'는
		// 어차피 탈락하고, 이 항은 '안 막힌 후보들 중 가장 안쪽'을 고르게 한다.
		// 장애물 사이 틈이 차폭보다 넓으면 그 틈을 지나는 후보가 |d| 가 작아
		// 자연히 선택된다(멀리 돌지 않는다).
		// 뒤쪽 오프셋 항(AVOID_FINAL_COST_RATIO): 첫 묶음 뒤 오프셋과 끝 오프셋에도
		// 비율만큼 |d| 비용을 건다.
		//   - 첫 오프셋이 같으면 장애물 뒤에서 기준선으로 돌아오는 후보가 싸다.
		//   - 둘째 장애물 옆 오프셋도 필요한 만큼만 고른다(이 항이 없으면 S자의
		//     둘째 오프셋은 곡률 비용으로만 정해져 +1.5/+2.0 이 번갈았다).
		//   단일 후보는 세 값이 같아 모두 같은 비율로 커질 뿐 순서는 그대로다.
		const double second = fp.second_offset();
		double pre = const_cast<FrenetPath &>(fp).get_cf() + AVOID_EXCESS_COST *
			(std::abs(off) + AVOID_FINAL_COST_RATIO *
				(std::abs(second) + std::abs(fp.final_offset())));
		// 직전 계획과 첫 묶음 뒤 오프셋이 다르면 유지 비용(SPATIAL_PLAN_CHANGE_COST 주석).
		if (std::isfinite(AVOID_PREV_SECOND) && std::abs(second - AVOID_PREV_SECOND) > 0.3)
			pre += SPATIAL_PLAN_CHANGE_COST;
		// 커밋된 방향의 반대편으로 넘어가는 후보에 벌점. 같은 쪽이면 0 이라
		// 그 안에서는 기존대로 |d| 최소가 선택된다. 반대편이 유일하게
		// 충돌 없는 선택지면(벌점은 충돌 비용보다 작으므로) 여전히 넘어간다.
		if (AVOID_LOCK_SIDE != 0 && off * AVOID_LOCK_SIDE < -AVOID_INWARD_MARGIN)
			pre += AVOID_SIDE_FLIP_COST;
		// 최초 방향을 정할 때는 장애물 중심의 반대편을 우선한다. 단, 이 값은
		// 충돌 제약보다 작은 비용일 뿐이므로 그쪽이 막혔거나 도로 폭 상한을
		// 넘으면 반대편의 충돌 없는 후보가 선택된다.
		if (committed_avoid_side == 0 && preferred_avoid_side != 0 &&
			off * preferred_avoid_side < -AVOID_INWARD_MARGIN)
			pre += side_preference_cost;
		// 지금 따라가는 오프셋이 이번 프레임에 실제로 깨끗하면, 과거 한두
		// 프레임의 기억만으로 다른 후보로 내쫓지 않는다.
		// 홀드는 단일 후보(= 오프셋 하나)의 기억이다. 다단 후보에 같은 키를
		// 쓰면 '둘째 장애물 때문에 막힌 단일 d1' 의 기억이 그 d1 으로 첫
		// 장애물을 지나 S자로 빠지는 후보까지 막는다.
		const bool is_current = std::abs(off - AVOID_PREV_OFFSET) < 0.3;
		if (!fp.multi_stage() && !is_current)
		{
			auto it = g_collision_hold.find(quantize_offset(off));
			if (it != g_collision_hold.end() && it->second > 0)
				pre += COLLISION_COST;
		}
		order.push_back({pre, i});
	}
	std::sort(order.begin(), order.end(),
		[](const Ranked &a, const Ranked &b) { return a.pre < b.pre; });

	int best_idx = -1;
	int opposite_fallback_idx = -1;
	double best_cost = 1e18;
	double opposite_fallback_cost = 1e18;
	bool clear_found = false;
	int n_evaluated = 0, n_multi_skipped = 0;
	char curv_dbg[200] = "";
	const auto eval_start = std::chrono::steady_clock::now();
	for (const Ranked &rk : order)
	{
		if (rk.pre >= best_cost)
			break;
		const int i = rk.i;
		const bool multi = fplist[i].multi_stage();
		if (multi && SPATIAL_EVAL_BUDGET_MS > 0.0 &&
			std::chrono::duration<double, std::milli>(
				std::chrono::steady_clock::now() - eval_start).count() > SPATIAL_EVAL_BUDGET_MS)
		{
			++n_multi_skipped;
			continue;   // 단일 후보는 예산과 무관하게 계속 평가한다
		}
		++n_evaluated;
		fplist[i].adding_global_path(csp);
		double max_candidate_curvature = 0.0;
		const vecD candidate_curvatures = fplist[i].get_c();
		const vecD candidate_s = fplist[i].get_s();
		vecD preview_curvatures;
		bool finite_curvature = true;
		for (size_t k = 0; k < candidate_curvatures.size(); ++k)
		{
			// 기준 스플라인 끝 1.5 m 는 yaw 외삽 오차로 곡률이 튄다(path_max_curvature 참조).
			//   리플레이 2026-09-25(15:45 백): 마지막 점 곡률 6.29 로 후보 64개 전량 탈락.
			if (s_dest > 0.0 && k < candidate_s.size() && candidate_s[k] > s_dest - 1.5)
				continue;
			const double kappa = candidate_curvatures[k];
			if (!std::isfinite(kappa)) { finite_curvature = false; break; }
			max_candidate_curvature = std::max(max_candidate_curvature, std::abs(kappa));
			if (k < candidate_s.size() && candidate_s[k] - s0 <= 30.0)
				preview_curvatures.push_back(std::abs(kappa));
		}
		if (candidate_curvatures.empty() || !finite_curvature ||
			(MAX_CURVATURE > 0.0 && max_candidate_curvature > MAX_CURVATURE))
		{
			if (n_curvature_rejected == 0)
			{
				// 진단: 첫 곡률 탈락 후보의 위치(전 후보가 곡률로 탈락할 때 원인 추적용)
				size_t kk = 0;
				double kv = 0.0;
				for (size_t k = 0; k < candidate_curvatures.size(); ++k)
					if (!std::isfinite(candidate_curvatures[k]) || std::abs(candidate_curvatures[k]) > kv)
					{
						kk = k;
						kv = std::isfinite(candidate_curvatures[k]) ? std::abs(candidate_curvatures[k]) : 1e9;
						if (kv >= 1e9) break;
					}
				const vecD cd = fplist[i].get_d();
				snprintf(curv_dbg, sizeof(curv_dbg),
					"first=[d_avoid %.2f kappa %.2f at k=%zu/%zu s-s0=%.2f d=%.2f n_xy=%zu n_s=%zu]",
					fplist[i].avoid_offset(), kv, kk, candidate_curvatures.size(),
					kk < candidate_s.size() ? candidate_s[kk] - s0 : -1.0,
					kk < cd.size() ? cd[kk] : 0.0, fplist[i].get_x().size(), candidate_s.size());
			}
			++n_curvature_rejected;
			continue;
		}
		// A single 0.25 m spline-sampling spike should not decide which side
		// to use.  Score the 90th percentile over the controller preview;
		// the hard maximum above still rejects genuinely sharp candidates.
		double scored_curvature = max_candidate_curvature;
		if (!preview_curvatures.empty())
		{
			const size_t rank = static_cast<size_t>(0.90 *
				(preview_curvatures.size() - 1));
			std::nth_element(preview_curvatures.begin(),
				preview_curvatures.begin() + rank, preview_curvatures.end());
			scored_curvature = preview_curvatures[rank];
		}

		vecD path_yaw_dbg = fplist[i].get_yaw();
		bool yaw_ok = !path_yaw_dbg.empty() &&
			std::abs(path_yaw_dbg[0] - bot_yaw) <= 0.523599;
		if (!yaw_ok)
		{
			n_yaw_rejected++;
			continue;   // 조향이 물리적으로 불가능한 후보는 그대로 배제
		}

		const double off = fplist[i].avoid_offset();
		const int key = quantize_offset(off);
		// 다단 후보는 첫 충돌에서 멈춘다(비율은 진단용일 뿐).
		const double frac = multi
			? (fplist[i].collides(ob_x, ob_y, ROBOT_RADIUS) ? 1.0 : 0.0)
			: fplist[i].collision_fraction(ob_x, ob_y, ROBOT_RADIUS);
		if (frac > 0.0)
		{
			if (!multi)
				g_collision_hold[key] = COLLISION_HOLD_CYCLES;
			n_collision_rejected++;
		}
		else
		{
			clear_found = true;
		}

		// 경로점별 연석 위반 비율. 끝점 di 범위 제한만으로는 개방 구간에서
		// 시작해 제한 구간을 관통하는 경로를 못 막는다(위 CURB_* 주석 참조).
		const double curb_frac = fplist[i].curb_violation_fraction();
		const double cost = rk.pre
			+ AVOID_CURVATURE_COST * scored_curvature
			+ COLLISION_FRAC_COST * frac
			+ CURB_VIOLATION_COST * curb_frac;
		// Collision is a hard feasibility constraint.  Returning the
		// least-colliding path made the vehicle intentionally follow a path
		// with collision_frac > 0 when an oncoming vehicle narrowed M8.
		const bool opposite_to_lock = AVOID_LOCK_SIDE != 0 &&
			off * AVOID_LOCK_SIDE < -AVOID_INWARD_MARGIN;
		// A curb crossing is a physical infeasibility, not merely a cost.
		// Otherwise a cheap right-side candidate can beat a valid left-side
		// candidate and get rejected only after planning, causing a stop.
		if (frac <= 1e-9 && curb_frac <= 1e-9)
		{
			if (opposite_to_lock)
			{
				if (cost < opposite_fallback_cost)
				{
					opposite_fallback_cost = cost;
					opposite_fallback_idx = i;
				}
			}
			else if (cost < best_cost)
			{
				best_cost = cost;
				best_idx = i;
			}
		}
		// 진단용 최소 간격은 막힌 단일 후보 5 개까지만 잰다(점 x 장애물 전수라 비싸다).
		if (frac > 0.0 && !multi && n_collision_rejected <= 5)
		{
			for (unsigned int k = 0; k < fplist[i].get_x().size(); ++k)
				for (size_t j = 0; j < ob_x.size(); ++j)
					min_clearance = std::min(min_clearance,
						dist(fplist[i].get_x()[k], fplist[i].get_y()[k], ob_x[j], ob_y[j]));
			best_d_tried = off;
		}
	}
	const double eval_ms = std::chrono::duration<double, std::milli>(
		std::chrono::steady_clock::now() - eval_start).count();
	// Once a side is committed, a same-side collision-free path always wins.
	// Crossing to the other side is retained only as an emergency fallback
	// when every path on the committed side is physically blocked.
	if (best_idx < 0 && opposite_fallback_idx >= 0)
	{
		best_idx = opposite_fallback_idx;
		best_cost = opposite_fallback_cost;
		ROS_WARN_THROTTLE(0.5,
			"[frenet] committed side blocked; using opposite-side emergency path");
	}

	if (best_idx >= 0)
	{
		bestpath = fplist[best_idx];
		const double d_avoid = bestpath.avoid_offset();
		const double d_end = bestpath.final_offset();
		std::string stages;
		for (size_t k = 0; k < bestpath.stage_d.size(); ++k)
		{
			char buf[48];
			snprintf(buf, sizeof(buf), k ? " ->%.2f@%.1fm" : "%.2f",
				bestpath.stage_d[k], bestpath.stage_s[k] - s0);
			stages += buf;
		}
		ROS_INFO_THROTTLE(0.2,
			"[frenet] chosen d_avoid=%.2f d_end=%.2f stages[%s] cost=%.1f "
			"(cands=%zu evaluated=%d multi_skipped=%d %.1fms yaw_rej=%d curvature_rej=%d "
			"collided=%d clear_found=%d)",
			d_avoid, d_end, stages.c_str(), best_cost, fplist.size(), n_evaluated,
			n_multi_skipped, eval_ms, n_yaw_rejected, n_curvature_rejected,
			n_collision_rejected, (int)clear_found);
	}

	if (bestpath.get_x().empty())
	{
		ROS_WARN_THROTTLE(0.2,
			"[frenet] ALL %zu candidates rejected: yaw=%d curvature=%d collision=%d inward=%d "
			"(evaluated=%d multi_skipped=%d %.1fms) %s "
			"min_clearance_seen=%.2fm (robot_radius=%.2f) last_d_tried=%.2f",
			fplist.size(), n_yaw_rejected, n_curvature_rejected,
			n_collision_rejected, n_inward_rejected, n_evaluated, n_multi_skipped, eval_ms,
			curv_dbg,
			min_clearance > 1e17 ? -1.0 : min_clearance, ROBOT_RADIUS, best_d_tried);
	}

	return bestpath;
}

FrenetPath frenet_optimal_planning_2(Spline2D csp, double s0, double c_speed, double c_d,
								   double c_d_d, double c_d_dd, FrenetPath lp, double pose_x, double pose_y, vecD ob_x, vecD ob_y, double bot_yaw, int a)
{
	// 후보 실패 시 이전 프레임의 오래된 경로에 차가 고착되지 않도록 매 사이클 초기화
	FrenetPath bestpath;

	//initialise object of class Fplist
	//object member fplist_lat stores sampled frenet paths
	vector<FrenetPath> fplist = Fplist(c_speed, c_d, c_d_d, c_d_dd, s0).fplist_lat;

	//sort sampled paths and check for collision in order of path cost
	std::sort(fplist.begin(), fplist.end(), sortByCost);
	for (int i = 0; i < fplist.size(); i++)
	{
		//path converted to global frame first
		fplist[i] = calc_global_path_2(fplist[i], csp, a);
		if (check_path(fplist[i], bot_yaw, 0.523599, pose_x, pose_y, ob_x, ob_y, ROBOT_RADIUS) == 1)
		{
			bestpath = fplist[i];
			break;
		}
		// bestpath = fplist[i];
		// break;
	}

	return bestpath;
}

//class constructor which generates paths
Fplist::Fplist(double c_speedc, double c_dc, double c_d_dc, double c_d_ddc, double s00)
{
	int cnt111 = 0;
	int cnt222 = 0;
	c_speed = c_speedc;
	c_d = c_dc;
	c_d_d = c_d_dc;
	c_d_dd = c_d_ddc;
	s0 = s00;

	if (SPATIAL_AVOIDANCE_ENABLED)
	{
		const double di_lo = -(MAX_ROAD_WIDTH_RIGHT > 0.0 ? MAX_ROAD_WIDTH_RIGHT : MAX_ROAD_WIDTH);
		const double di_hi =  (MAX_ROAD_WIDTH_LEFT  > 0.0 ? MAX_ROAD_WIDTH_LEFT  : MAX_ROAD_WIDTH);
		std::vector<double> grid;
		for (double di = di_lo; di <= di_hi + 1e-6; di += D_ROAD_W)
			grid.push_back(di);
		// 다단 후보 전환점(SPATIAL_SWITCH_S 주석). 가까운 두 묶음까지만 본다.
		std::vector<double> sw;
		for (double x : SPATIAL_SWITCH_S)
			if (x > s0 + 1.0) sw.push_back(x);
		std::sort(sw.begin(), sw.end());
		if (sw.size() > 2) sw.resize(2);
		const double step2 = std::max(D_ROAD_W, SPATIAL_STAGE_D_STEP);
		std::vector<double> grid2;   // 둘째 묶음 옆 오프셋(0 제외)
		for (double d = -step2; d >= di_lo - 1e-6; d -= step2) grid2.push_back(d);
		for (double d = step2; d <= di_hi + 1e-6; d += step2) grid2.push_back(d);
		auto generate = [&](bool gentle)
		{
			for (double di : grid)
				fplist_lat.push_back(calc_spatial(di, gentle));
			// ★ 다단(S자/복귀) 후보. 전환점은 노드가 장애물 위치로 정한다.
			if (sw.empty())
				return;
			for (double d1 : grid)
			{
				if (std::abs(d1) < 0.2)
					continue;   // 첫 묶음 옆을 d=0 으로 지나는 건 단일 후보와 같다
				// (a) 첫 묶음을 지나고 기준선 복귀
				fplist_lat.push_back(calc_spatial_stages({d1, 0.0}, {s0, sw[0]}, gentle));
				// 급한 예비 후보는 단일·(a) 까지만(후보 3000 개 -> 평가 최대 71 ms 였다).
				if (sw.size() < 2 || !gentle)
					continue;
				// (b) 두 묶음 모두 d1 으로 지나고 복귀
				fplist_lat.push_back(calc_spatial_stages({d1, 0.0}, {s0, sw[1]}, gentle));
				for (double d2 : grid2)
				{
					if (std::abs(d2 - d1) < 0.2)
						continue;
					// (c) 첫 묶음 뒤 d2 로 옮겨 둘째 묶음을 지나고 복귀 (S자)
					fplist_lat.push_back(calc_spatial_stages({d1, d2, 0.0}, {s0, sw[0], sw[1]}, gentle));
					// (d) 첫 묶음 뒤 d2 로 옮겨 유지 (둘째 뒤가 지평 밖이거나 막힌 경우)
					fplist_lat.push_back(calc_spatial_stages({d1, d2}, {s0, sw[0]}, gentle));
				}
			}
		};
		generate(true);
		// 느릴 때만 현재 속도 기준 급한 후보를 예비로 추가(비용 +SPATIAL_SHARP_COST).
		if (c_speed < SPATIAL_LENGTH_MIN_SPEED - 0.5)
			generate(false);
		return;
	}

	//latitudinal part of the FrenetPath object is sampled and stored in fplist_lat
	if (STOP_CAR)
	{

		const double di_lo = -(MAX_ROAD_WIDTH_RIGHT > 0.0 ? MAX_ROAD_WIDTH_RIGHT : MAX_ROAD_WIDTH);
		const double di_hi =  (MAX_ROAD_WIDTH_LEFT  > 0.0 ? MAX_ROAD_WIDTH_LEFT  : MAX_ROAD_WIDTH);
		for (double di = di_lo; di < di_hi; di += D_ROAD_W)
		{
			for (double Ti = MINT; Ti < MAXT; Ti += DT)
			{
				FrenetPath temp = calc_lat(di, Ti, 0.0);
				for (int p = 0; p < samples_tv; p++)
				{	
					fplist_lat.push_back(temp);
				}
			}
		}
	}
	else
	{

		const double di_lo = -(MAX_ROAD_WIDTH_RIGHT > 0.0 ? MAX_ROAD_WIDTH_RIGHT : MAX_ROAD_WIDTH);
		const double di_hi =  (MAX_ROAD_WIDTH_LEFT  > 0.0 ? MAX_ROAD_WIDTH_LEFT  : MAX_ROAD_WIDTH);
		for (double di = di_lo; di < di_hi; di += D_ROAD_W)
		{
			for (double Ti = MINT; Ti < MAXT; Ti += DT)
			{
				cnt111++;
				for (double Di_d = -MAX_LAT_VEL; Di_d < MAX_LAT_VEL + 0.001; Di_d += D_D_NS)
				{
					FrenetPath temp = calc_lat(di, Ti, Di_d);
					for (int p = 0; p < samples_tv; p++)
					{
						FrenetPath temp = calc_lat(di, Ti, 0.0);
						fplist_lat.push_back(temp);
					}
				}
			}
		}
		//cout << "cnt111 : " << cnt111 << endl;
	}

	//longitudinal part of the FrenetPath object is sampled and stored in fplist_lon
	if (STOP_CAR)
	{

		for (double Ti = MINT; Ti < MAXT; Ti += DT)
		{
			fplist_lon.push_back(calc_lon(TARGET_SPEED, Ti));
		}
	}
	else
	{

		for (double Ti = MINT; Ti < MAXT; Ti += DT)
		{
			for (double tv = TARGET_SPEED - D_T_S * N_S_SAMPLE; tv < TARGET_SPEED + D_T_S * N_S_SAMPLE; tv += D_T_S)
			{
				cnt222++;
				fplist_lon.push_back(calc_lon(tv, Ti));
			}
		}
	}
	//cout << "cnt222 : " << cnt222 << endl;

	//copy longitudinal part of the FrenetPath object to corresponding paths in fplist_lat
	for (int i = 0; i < fplist_lat.size(); i += samples_tv)
	{
		copy(i);
	}

	//cost calculated as a weighted sum of longitudinal and latitudinal path costs
	for (int i = 0; i < fplist_lat.size(); i++)
	{
		calc_cost(i);
	}
}

// calculates latitudinal part of FrenetPath object using the sampling parameters passed
FrenetPath Fplist::calc_lat(double di, double Ti, double Di_d)
{
	FrenetPath fp;

	// Ti 는 '회피를 끝내는 시간'이지 '경로를 그리는 길이'가 아니다. 예전에는
	// n = 1 + Ti/DT 로 둘을 묶어놔서 서로를 배제했다: 짧은 Ti 는 제때 비키지만
	// 경로가 장애물까지 닿지 않아 충돌검사를 무의미하게 통과했고, 긴 Ti 는
	// 장애물에 닿지만 그 지점에서 아직 안 비켜져 있어 전부 충돌했다.
	// 실측 2026-09-07(3.9m/s, 장애물 5.2m): Ti=1.0 은 3.9m 까지만 그려져 장애물에
	// 미달, Ti>=3.0 은 전 후보 충돌(min_clearance 0.00~0.22m) -> 1400 후보 전탈락.
	// 이제 모든 후보를 공통 지평까지 그리고, Ti 이후는 완료된 오프셋을 유지한다.
	const double horizon = max(Ti, PLAN_HORIZON_T);
	int n = 1 + (int)std::lround(horizon / DT);
	fp.t.resize(n);
	fp.d.resize(n);
	fp.d_d.resize(n);
	fp.d_dd.resize(n);
	fp.d_ddd.resize(n);

	quintic lat_qp(c_d, c_d_d, c_d_dd, di, Di_d, 0.0, Ti);

	for (int te = 0; te < n; te++)
	{
		double t = te * DT;
		// Ti 이후에는 quintic 을 외삽하지 않는다(발산한다). 목표 오프셋에
		// 도달한 상태를 그대로 유지해 '비킨 채로 지나간다'를 표현한다.
		double tq = min(t, Ti);
		fp.t[te] = t;
		fp.d[te] = lat_qp.calc_point(tq);
		fp.d_d[te] = (t <= Ti) ? lat_qp.calc_first_derivative(tq) : 0.0;
		fp.d_dd[te] = (t <= Ti) ? lat_qp.calc_second_derivative(tq) : 0.0;
		fp.d_ddd[te] = (t <= Ti) ? lat_qp.calc_third_derivative(tq) : 0.0;
	}

	vecD d_ddd_vec = fp.d_ddd;
	fp.Jp = (inner_product(d_ddd_vec.begin(), d_ddd_vec.end(), d_ddd_vec.begin(), 0));
	fp.Ti = (Ti);
	fp.cd = (KJ * fp.Jp + KT * Ti + KD * std::pow((fp.d).back(), 2));
	return fp;
}

// calculates longitudinal part of FrenetPath object using the sampling parameters passed
FrenetPath Fplist::calc_lon(double tv, double Ti)
{
	FrenetPath fp;
	// ★ 종방향 목표를 '실제로 갈 수 있는 거리'로 둔다.
	//   예전에는 Ti 안에 무조건 25m(하드캡)를 가도록 강제했다. 그러면 Ti=1.0
	//   일 때 평균 25m/s, Ti=3.4 에서도 7.4m/s 가 되어, 실제 주행속도(4m/s
	//   안팎)와 무관하게 s 가 앞질러 간다. 그 결과 횡방향이 Ti 에 전이를
	//   끝내도 그 시점의 s 는 이미 19~23m 앞이고, 5~10m 에 있는 장애물
	//   구간에서는 아직 거의 비켜나지 않은 경로가 된다.
	//     실측 2026-09-09(15:11): d_end=-3.5 를 골랐는데 장애물이 있는 s=5~10m
	//     에서 d 는 -0.44~-0.61 뿐이었고(완료는 s=30m), 차는 그 경로를 정확히
	//     따라가 장애물에 접촉했다. Ti/mint 를 줄여도 효과가 없던 이유가 이것이다.
	//   등속 근사(c_speed~tv)로 도달 거리를 잡고, s_dest/25m 는 상한으로만 쓴다.
	const double s_reach = 0.5 * (max(c_speed, 0.5) + max(tv, 0.5)) * Ti;
	const double s_target = min(s0 + min(s_reach, 25.0), s_dest);
	quintic lon_qp(s0, c_speed, 0.0, s_target, tv, 0.0, Ti);	// 도착 지점 거리 설정

	// 횡방향과 같은 지평으로 그려야 한다. 길이가 다르면 check_collision 의
	// s.size() != x.size() 가드에 걸려 그 후보는 무조건 충돌로 처리된다.
	const double horizon = max(Ti, PLAN_HORIZON_T);
	int n = 1 + (int)std::lround(horizon / DT);
	fp.t.resize(n);
	fp.s.resize(n);
	fp.s_d.resize(n);
	fp.s_dd.resize(n);
	fp.s_ddd.resize(n);

	for (int te = 0; te < n; te++)
	{
		double t = te * DT;
		fp.t[te] = t;
		if (t <= Ti)
		{
			fp.s[te] = lon_qp.calc_point(t);
			fp.s_d[te] = lon_qp.calc_first_derivative(t);
			fp.s_dd[te] = lon_qp.calc_second_derivative(t);
			fp.s_ddd[te] = lon_qp.calc_third_derivative(t);
		}
		else
		{
			// Ti 이후는 도달 속도로 등속 전진. quintic 외삽은 s 가 되돌아가거나
			// 발산해서 경로가 꼬인다.
			double sv = lon_qp.calc_first_derivative(Ti);
			fp.s[te] = lon_qp.calc_point(Ti) + sv * (t - Ti);
			fp.s_d[te] = sv;
			fp.s_dd[te] = 0.0;
			fp.s_ddd[te] = 0.0;
		}
	}
	fp.Ti = (Ti);
	vecD s_ddd_vec = fp.s_ddd;
	fp.Js = (inner_product(s_ddd_vec.begin(), s_ddd_vec.end(), s_ddd_vec.begin(), 0));
	fp.dss = std::pow((TARGET_SPEED - (fp.s_d.empty() ? 0.0 : fp.s_d.back())), 2);
	fp.cv = (KJ * fp.Js + KT * fp.Ti + KD * fp.dss);
	return fp;
}

// calc_lat/calc_lon 결과를 후보군 탐색 없이 그대로 하나로 합친다 (부드러운 복귀용)
FrenetPath Fplist::calc_direct(double di, double Ti, double tv)
{
	FrenetPath lat = calc_lat(di, Ti, 0.0);
	FrenetPath lon = calc_lon(tv, Ti);
	lat.s = lon.s;
	lat.s_d = lon.s_d;
	lat.s_dd = lon.s_dd;
	lat.s_ddd = lon.s_ddd;
	lat.Js = lon.Js;
	lat.cv = lon.cv;
	lat.cf = (KLAT * lat.cd + KLON * lat.cv);
	return lat;
}

FrenetPath Fplist::calc_spatial(double di, bool gentle)
{
	return calc_spatial_stages(std::vector<double>{di}, std::vector<double>{s0}, gentle);
}

FrenetPath Fplist::calc_spatial_stages(const std::vector<double> &targets,
	const std::vector<double> &starts, bool gentle)
{
	FrenetPath fp;
	if (targets.empty())
		return fp;
	const double v = std::max(0.5, c_speed);
	// For h(q)=10q^3-15q^4+6q^5, max |h''| ~= 5.774 and
	// max |h'''| = 60. Convert acceleration/jerk bounds to time,
	// then to travelled distance using the measured vehicle speed.
	// 전환 길이에 쓰는 속도(SPATIAL_LENGTH_MIN_SPEED 주석). 시간 축(t)은 실제 속도.
	const double v_len = gentle ? std::max(v, SPATIAL_LENGTH_MIN_SPEED) : v;
	auto transition_length = [v_len](double shift) {
		const double ta = std::sqrt(5.774 * shift / std::max(0.1, SPATIAL_MAX_LAT_ACCEL));
		const double tj = std::cbrt(60.0 * shift / std::max(0.1, SPATIAL_MAX_LAT_JERK));
		const double transition_t = std::max(0.8, std::max(ta, tj));
		return std::max(SPATIAL_MIN_TRANSITION_M,
			std::min(SPATIAL_MAX_TRANSITION_M, v_len * transition_t));
	};
	const double length = transition_length(std::abs(targets[0] - c_d));
	double horizon = std::max(std::max(length + 12.0, v * PLAN_HORIZON_T),
		SPATIAL_MIN_HORIZON_M);
	// ★ 지평을 남은 기준경로 길이로 자른다.
	//   /final_waypoint 는 자차 앞 49.8 m 뿐인데 지평이 v*7.0 s 라,
	//   7.1 m/s 를 넘으면 모든 후보가 스플라인 끝을 넘었다. 넘은 후보는
	//   adding_global_path 에서 잘리고(s.size()!=x.size()), collision_fraction
	//   이 그걸 1.0(완전 막힘)으로 본다 - 즉 후보 전량 탈락 -> 회피 실패 ->
	//   AEB 1.0 제동.
	//     실측 2026-09-23(16:04 두 주행): 실패 6회 중 4회가 v 7.47~9.68 m/s
	//     에서 났고, 그 중 2회는 31 m 앞 장애물을 처음 본 순간이었다
	//     (9.7 -> 5.9 m/s 급제동). 30 km/h 회피를 막던 직접 원인이다.
	//   s_dest 는 전역 스플라인 끝이다. 0.5 m 여유를 둔다.
	if (s_dest > s0)
		horizon = std::min(horizon, std::max(2.0 * SPATIAL_SAMPLE_DS, s_dest - s0 - 0.5));
	// ★ 초기 횡기울기/곡률을 현재 상태에서 이어받는다.
	//   예전 h(q) 는 시작점 기울기·곡률이 0 이라, 매 재계획(20 Hz)마다 경로가
	//   '지금 이 자리에서는 기준선과 평행'으로 시작했다. 차는 이미 옆으로
	//   움직이는 중인데 경로가 곧게 가라고 하니 MPC 가 되돌려 조향했고,
	//   횡이동이 쌓이지 않았다.
	//     실측 2026-09-23(16:04:23 백): 발행 경로의 시작 1 m 기울기는
	//     +0.005~0.013 인데 차량 실제 횡이동률은 +0.10~0.15 (m/m) 였다.
	//     그 결과 d_end +3.00 을 1.8 s 유지했는데도 차는 +0.70 에 머물렀고,
	//     (16:04:54) 장애물 4 m 앞에서 +1.91 (필요 2.67) -> 후보 전부
	//     충돌 -> 정지. 그 직전 d_end 2.75 -> 3.25 로 키운 것이 '한 번
	//     과회피'로 보였다.
	//   c_d_d / c_d_dd 는 시간 미분이다(노드가 직전 계획에서 이어 붙여 준다).
	//   공간 미분으로 바꿔 5차식 경계조건으로 쓴다.
	const double slope0 = std::max(-0.35, std::min(0.35, c_d_d / v));
	const double curv0 = std::max(-0.12, std::min(0.12, c_d_dd / (v * v)));
	// 전환 구간들. 0번은 지금 위치에서 targets[0] 으로, k번은 starts[k] 이후
	// (앞 전환이 끝나기 전이면 끝난 뒤) targets[k-1] -> targets[k] 로 간다.
	// 전환 사이에는 앞 목표를 그대로 유지한다.
	std::vector<quintic> seg_q;
	std::vector<double> seg_u0, seg_len;
	seg_q.emplace_back(c_d, slope0, curv0, targets[0], 0.0, 0.0, length);
	seg_u0.push_back(0.0);
	seg_len.push_back(length);
	for (size_t k = 1; k < targets.size(); ++k)
	{
		const double start_u = std::max(
			(k < starts.size() ? starts[k] : s0) - s0,
			seg_u0.back() + seg_len.back());
		const double len = transition_length(std::abs(targets[k] - targets[k - 1]));
		seg_q.emplace_back(targets[k - 1], 0.0, 0.0, targets[k], 0.0, 0.0, len);
		seg_u0.push_back(start_u);
		seg_len.push_back(len);
	}
	const double ds_step = std::max(0.1, SPATIAL_SAMPLE_DS);
	const int n = 1 + static_cast<int>(std::ceil(horizon / ds_step));
	fp.t.reserve(n); fp.d.reserve(n); fp.d_d.reserve(n);
	fp.d_dd.reserve(n); fp.d_ddd.reserve(n); fp.s.reserve(n);
	fp.s_d.reserve(n); fp.s_dd.reserve(n); fp.s_ddd.reserve(n);
	double jerk_sum = 0.0;
	size_t seg = 0;
	for (int i = 0; i < n; ++i)
	{
		const double u = std::min(horizon, i * ds_step);
		while (seg + 1 < seg_q.size() && u >= seg_u0[seg + 1])
			++seg;
		const double uu = u - seg_u0[seg];
		const bool in_transition = uu < seg_len[seg];
		quintic &lat = seg_q[seg];
		fp.t.push_back(u / v);
		fp.d.push_back(in_transition ? lat.calc_point(uu) : targets[seg]);
		fp.d_d.push_back(in_transition ? lat.calc_first_derivative(uu) * v : 0.0);
		fp.d_dd.push_back(in_transition ? lat.calc_second_derivative(uu) * v * v : 0.0);
		fp.d_ddd.push_back(in_transition ? lat.calc_third_derivative(uu) * v * v * v : 0.0);
		fp.s.push_back(s0 + u);
		fp.s_d.push_back(v); fp.s_dd.push_back(0.0); fp.s_ddd.push_back(0.0);
		jerk_sum += fp.d_ddd.back() * fp.d_ddd.back();
	}
	fp.stage_d = targets;
	fp.stage_s.clear();
	for (double u0 : seg_u0)
		fp.stage_s.push_back(s0 + u0);
	fp.stage_end_s = s0 + seg_u0.back() + seg_len.back();
	fp.first_len = seg_len[0];
	fp.Ti = length / v;
	fp.Jp = jerk_sum;
	fp.Js = 0.0;
	fp.dss = std::pow(TARGET_SPEED - v, 2);
	fp.cd = KJ * fp.Jp + KT * fp.Ti + KD * targets[0] * targets[0];
	fp.cv = KD * fp.dss;
	fp.cf = KLAT * fp.cd + KLON * fp.cv;
	fp.sharp = !gentle && v_len < std::max(v, SPATIAL_LENGTH_MIN_SPEED) - 1e-6;
	if (fp.sharp)
		fp.cf += SPATIAL_SHARP_COST;
	return fp;
}

//crossproduct of sampled latitudinal and longitudinal parts
void Fplist::copy(int i)
{
	int index_start = ((fplist_lat[i]).Ti - MINT) * samples_tv;

	for (int j = 0; j < samples_tv; j++)
	{
		fplist_lat[i + j].s = (fplist_lon[index_start + j].s);
		fplist_lat[i + j].s_d = (fplist_lon[index_start + j].s_d);
		fplist_lat[i + j].s_dd = (fplist_lon[index_start + j].s_dd);
		fplist_lat[i + j].s_ddd = (fplist_lon[index_start + j].s_ddd);
		fplist_lat[i + j].Js = (fplist_lon[index_start + j].Js);
		fplist_lat[i + j].dss = (fplist_lon[index_start + j].dss);
		fplist_lat[i + j].cv = (fplist_lon[index_start + j].cv);
	}
}

//calculate final cost of path as weighted sum of latitudinal and longitudinal path costs
void Fplist::calc_cost(int i)
{
	fplist_lat[i].cf = (KLAT * fplist_lat[i].cd + KLON * fplist_lat[i].cv);
}
