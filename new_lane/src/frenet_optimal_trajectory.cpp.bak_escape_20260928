void FrenetPath::adding_global_path(Spline2D &csp)
{
	int n = s.size();
	x.resize(n);
	y.resize(n);
	// ★ s 가 전역경로 끝을 넘어가면 그 지점에서 자른다.
	//   예전에는 여기서 곧바로 return 했는데, x/y 는 이미 resize(n) 으로
	//   0 초기화된 상태라 나머지 원소가 (0,0) 인 채 그대로 발행됐다.
	//     실측 2026-09-22(18:04 백): 437 프레임 중 6프레임(1.4%)에서
	//     /local_path 뒤쪽 17점이 전부 (0,0) 이었다(n=71, 54번째부터).
	//     map 좌표가 (302533, 4123997) 인 경로에 원점이 붙으니 MPC 의
	//     polyfit 이 그 점들까지 물고 계수가 망가진다.
	//   채워진 데까지만 남기면 짧은 경로가 될 뿐이라 안전하다
	//   (path_end_stop 이 점 개수 부족을 따로 처리한다).
	int filled = n;
	for (int i = 0; i < n; i++)
	{
		double ix, iy;
		csp.calc_position(ix, iy, s[i]);
		if (ix == NONE)
		{
			filled = i;
			break;
		}
		double iyaw = csp.calc_yaw(s[i]);
		double fx = ix - d[i] * sin(iyaw);
		double fy = iy + d[i] * cos(iyaw);
		x[i] = (fx);
		y[i] = (fy);
	}
	if (filled < n)
	{
		x.resize(filled);
		y.resize(filled);
		n = filled;
		if (n < 2)
		{
			yaw.clear(); ds.clear(); c.clear();
			return;
		}
	}
	yaw.resize(n - 1);
	ds.resize(n - 1);

	for (int i = 0; i < n - 1; i++)
	{
		double dx = x[i + 1] - x[i];
		double dy = y[i + 1] - y[i];
		yaw[i] = std::atan2(dy, dx);

		ds[i] = (sqrt(dx * dx + dy * dy));
	}
	// Compute curvature for full-length paths as well as truncated paths.
	// Returning here when s.size() == x.size() left c empty for virtually
	// every valid avoidance candidate, bypassing the curvature check.
	c.resize((n - 1) - 1);
	for (int i = 0; i < (n - 1) - 1; i++)
	{
		if (ds[i] != 0)
		{
			const double dyaw = yaw[i + 1] - yaw[i];
			c[i] = std::atan2(std::sin(dyaw), std::cos(dyaw)) / ds[i];
		}
		else
		{
			c[i] = FLT_MAX;
		}
	}
}

void FrenetPath::adding_global_path_2(Spline2D csp, int a)
{
	int n = s.size();
	x.resize(n);
	y.resize(n);
	for (int i = 0; i < n; i++)
	{
		double ix, iy;
		csp.calc_position(ix, iy, s[i]);
		if (ix == NONE)
		{
			return;
		}
		double iyaw = csp.calc_yaw(s[i]);
		double fx = ix - (d[i]-a) * sin(iyaw);
		double fy = iy + (d[i]-a) * cos(iyaw);
		x[i] = (fx);
		y[i] = (fy);
	}
	yaw.resize(n - 1);
	ds.resize(n - 1);

	for (int i = 0; i < n - 1; i++)
	{
		double dx = x[i + 1] - x[i];
		double dy = y[i + 1] - y[i];
		if (abs(dx) > 0.0001)
		{
			yaw[i] = (atan2(dy, dx));
		}
		else
		{
			yaw[i] = 0;
		}

		ds[i] = (sqrt(dx * dx + dy * dy));
	}
	// To remove paths whose predicted s goes out of bounds of global path.
	if (s.size() == x.size())
	{
		return;
	}
	c.resize((n - 1) - 1);
	for (int i = 0; i < (n - 1) - 1; i++)
	{
		if (ds[i] != 0)
			c[i] = ((yaw[i + 1] - yaw[i]) / ds[i]);
		else
		{
			c[i] = FLT_MAX;
		}
	}
}

