// 정적 장애물 회피 노드 (Frenet Optimal Trajectory 기반)
//
// 입력:
//   /final_waypoint  (waypoint_maker::Lane)  - 기준 전역 경로
//   /odom            (nav_msgs::Odometry)    - 현재 차량 world pose + 속도
//   /obstacle_info   (std_msgs::String, JSON)- 인지 노드가 발행하는 장애물 목록
// 출력:
//   /local_path      (nav_msgs::Path)        - MPC가 그대로 추종하는 회피 경로
//
// frenet_optimal_trajectory.cpp / cubic_spline_planner.cpp / polynomials.cpp 는
// 그대로 재사용하고(같은 소스 재컴파일), 이 노드에서 ROS 배선과
// 인지 결과 -> 장애물 좌표 변환, 경로 필터링만 새로 짠다.

#include <ros/ros.h>
#include <ros/callback_queue.h>
#include <boost/bind.hpp>
#include <nav_msgs/Odometry.h>
#include <nav_msgs/Path.h>
#include <std_msgs/String.h>
#include <std_msgs/Bool.h>
#include <std_msgs/Float64.h>
#include <geometry_msgs/PoseStamped.h>
#include <tf/transform_datatypes.h>
#include <jsoncpp/json/json.h>
#include <memory>
#include <cmath>
#include <mutex>
#include <set>

#include "new_lane/frenet_optimal_trajectory.hpp"
#include "new_lane/cubic_spline_planner.hpp"
#include "new_lane/frenetROS_obst.hpp"   // initial_conditions_new()
#include "waypoint_maker/Lane.h"
#include "lidar_ttc_tracker/TrackedObjectArray.h"
#include <morai_msgs/EgoVehicleStatus.h>

class ObstacleAvoidanceNode
{
public:
	ObstacleAvoidanceNode() : pnh_("~")
	{
		loadParams();

		local_path_pub_ = nh_.advertise<nav_msgs::Path>("/local_path", 1);
		global_path_pub_ = nh_.advertise<nav_msgs::Path>("/global_path", 1, true);  // latched
		avoidance_failed_pub_ = nh_.advertise<std_msgs::Bool>("/avoidance_failed", 1);
		// 회피/복귀 중일 때만 target_speed_(TARGET_SPEED)를 실어 보냄.
		// mpc_path_tracking이 curvature_speed_limit과 같은 방식(min(ref_v, 이 값))으로
		// 적용해서 실제 주행속도를 낮춘다. 평소(패스스루)에는 무제한(사실상 미적용)
		// 값을 보내 mission_speed/curvature_speed 로직을 그대로 둔다.
		avoidance_speed_pub_ = nh_.advertise<std_msgs::Float64>("/obstacle_avoidance/target_speed_mps", 1);
		// 정적(또는 unknown) 장애물이 confirmed 되는 즉시(거리/corridor 판단 없이)
		// 원래 속도의 70%로 감속. 회피 판단 로직과 무관하게 단순하게 동작.
		static_speed_scale_pub_ = nh_.advertise<std_msgs::Float64>("/obstacle_avoidance/static_speed_scale", 1);

		waypoint_sub_ = nh_.subscribe("/final_waypoint", 1, &ObstacleAvoidanceNode::waypointCallback, this);
		odom_sub_ = nh_.subscribe("/odom", 1, &ObstacleAvoidanceNode::odomCallback, this);
		// queue_size=100이면 콜백 처리가 잠깐 밀렸을 때 쌓인 메시지를 한꺼번에
		// 몰아서 처리하느라(버스트) planLoop/카메라 감지 같은 다른 콜백이 순간적으로
		// 밀리는 원인이 될 수 있음. 필요한 건 항상 "가장 최신 속도값"뿐이라
		// 오래된 메시지는 그냥 버리는 게 맞음 -> queue_size=1로 낮춤.
		competition_sub_ = nh_.subscribe("/Competition_topic", 1, &ObstacleAvoidanceNode::competitionCallback, this);
		obstacle_sub_ = nh_.subscribe("/obstacle_info", 1, &ObstacleAvoidanceNode::obstacleInfoCallback, this);
		// 대향 차량 감지용. /obstacle_info 는 경로 코리도(1.4m)로 걸러진 뒤라
		// 반대 차선(3~5m)이 안 올라온다. TTC 트래커는 roi_y_half 5.5m 로 그쪽을
		// 본다.
		tracked_sub_ = nh_.subscribe("/tracked_objects", 1,
			&ObstacleAvoidanceNode::trackedObjectsCallback, this);
		// 카메라(세그멘테이션)가 훨씬 멀리서부터 장애물을 "감지"만 해서 알려주는
		// 신호. 라이다 확정보다 먼저 들어와서 감속을 미리 걸어주는 용도로만 쓰고,
		// 회피 경로 계산(ob_x/ob_y)에는 전혀 관여하지 않는다.
		// planLoop가 무거운 Frenet 계산(사이클당 수백 개 후보 충돌체크) 중일 때
		// 기본 큐(싱글스레드)를 쓰면 이 콜백이 그 뒤에서 순서를 기다려야 해서
		// "카메라는 바로 감지했는데 킥은 늦게 걸리는" 지연이 생겼음. 이 구독만
		// 별도 큐+전용 스레드로 분리해서 무거운 계산과 무관하게 항상 즉시 처리되게 함.
		ros::SubscribeOptions camera_ops = ros::SubscribeOptions::create<std_msgs::Bool>(
			"/camera_detection/obstacle_present", 1,
			boost::bind(&ObstacleAvoidanceNode::cameraDetectionCallback, this, _1),
			ros::VoidConstPtr(), &camera_queue_);
		camera_detection_sub_ = nh_.subscribe(camera_ops);
		camera_spinner_.reset(new ros::AsyncSpinner(1, &camera_queue_));
		camera_spinner_->start();

		tunnel_offset_sub_ = nh_.subscribe("/tunnel/wall_offset", 1, &ObstacleAvoidanceNode::tunnelOffsetCallback, this);
		frenet_d_pub_ = nh_.advertise<std_msgs::Float64>("/obstacle_avoidance/frenet_d", 1);

		plan_timer_ = nh_.createTimer(ros::Duration(1.0 / plan_rate_hz_),
									   &ObstacleAvoidanceNode::planLoop, this);

		ROS_INFO("[obstacle_avoidance] started. plan_rate=%.1fHz, path_corridor_radius=%.2fm, "
				 "정적 회피 구간 idx %s~%d",
				 plan_rate_hz_, path_corridor_radius_,
				 static_zone_min_idx_ >= 0 ? std::to_string(static_zone_min_idx_).c_str() : "처음",
				 static_dynamic_split_idx_);
	}

private:
	// ---------------- 파라미터 로드 (전부 launch에서 조정 가능) ----------------
	void loadParams()
	{
		pnh_.param("plan_rate_hz", plan_rate_hz_, 10.0);
		pnh_.param("spline_ds", spline_ds_, 0.5);
		// CSV 웨이포인트 idx 기준: 0~이 값은 정적 미션 구간(회피), 이후는 동적
		// 미션 구간(obstacle_stop_node가 정지 전담, 여긴 회피 안 함).
		pnh_.param("static_dynamic_split_idx", static_dynamic_split_idx_, 1430);
		// 정적 미션 구간의 시작 idx. 원본 코스는 출발부터가 정적 구간이라
		// 하한이 없었지만, 전체 랩에서는 앞쪽에 일반 주행 구간이 길게 있고
		// 거기서 잡히는 노변 구조물까지 회피/감속 대상이 되어버린다.
		// 음수면 하한 없음 == 원본과 동일한 거동.
		pnh_.param("static_zone_min_idx", static_zone_min_idx_, -1);
		pnh_.param("dynamic_zone_max_idx", dynamic_zone_max_idx_, -1);
		// 회피 트리거 코리도. '물체 몸통 가장자리 ~ 기준경로' 거리 기준이며,
		// 인지의 path_corridor_half_width 와 같은 값이어야 한다(같은 양을 잰다).
		pnh_.param("path_corridor_radius", path_corridor_radius_, 1.5);
		// 충돌 검사용 반경. 트리거보다 넓게 잡아야 회피 경로가 지나가는 자리의
		// 장애물을 프레넷이 본다. max_road_width_left(4.5) + robot_radius 여유.
		pnh_.param("collision_corridor_radius", collision_corridor_radius_, 4.0);
		// 필요량 초과 1m 당 비용. cf(45만 규모)보다 크고 충돌(2e7)보다 작아야 한다.
		pnh_.param("avoid_excess_cost", avoid_excess_cost_, 3.0e5);
		pnh_.param("avoid_side_flip_cost", avoid_side_flip_cost_, 5.0e6);
		pnh_.param("avoid_side_preference_cost", avoid_side_preference_cost_, 4.0e6);
		pnh_.param("primary_release_behind_idx", primary_release_behind_idx_, 20);
		pnh_.param("primary_switch_min_idx", primary_switch_min_idx_, 50);
		pnh_.param("primary_group_span_idx", primary_group_span_idx_, 30);
		pnh_.getParam("road_width_zones", road_width_zones_);
		if (!road_width_zones_.empty() && road_width_zones_.size() % 4 != 0)
		{
			ROS_WARN("[obstacle_avoidance] road_width_zones needs groups of 4 "
					 "[start,end,right,left]; got %zu values -> ignored",
					 road_width_zones_.size());
			road_width_zones_.clear();
		}
		pnh_.param("max_d_step_per_cycle", max_d_step_per_cycle_, 0.4);   // 사이클당 허용 d 변화량(m)
		pnh_.param("max_d_step_outward_per_cycle", max_d_step_outward_per_cycle_, 1.0);
		// 장애물이 앞에 있는 동안 이미 확보한 회피량이 이만큼 넘게 줄어들면
		// 되돌린다. 0 이면 완전 고정(장애물 크기 재추정으로 실제 덜 피해도
		// 되는 경우까지 막음), 크면 요동을 못 잡는다.
		// 커밋 중 후보 배제 시 허용할 '안쪽' 여유(m). 수치 흔들림 정도는 통과시킨다.
		pnh_.param("avoid_inward_margin", avoid_inward_margin_, 0.1);
		// 좌측(중앙선 넘는 방향) 회피 폭. 대향 차량이 없을 때만 여기까지 쓴다.
		pnh_.param("max_road_width_left", max_road_width_left_, 3.5);
		// 대향 차량이 있으면 이 폭까지만 나간다(자기 차로 안).
		pnh_.param("max_road_width_left_blocked", max_road_width_left_blocked_, 1.2);
		pnh_.param("max_road_width_right", max_road_width_right_, 3.5);
		// 대향 차량 판정: 이 거리 안 + 이 속도 이상으로 다가오는 차량
		pnh_.param("oncoming_check_range_m", oncoming_check_range_m_, 60.0);
		pnh_.param("oncoming_min_closing_mps", oncoming_min_closing_mps_, 2.0);
		// 좌측(양수 y) 이 값 이상 떨어진 트랙만 '대향 차선' 으로 본다.
		pnh_.param("oncoming_min_lateral_m", oncoming_min_lateral_m_, 1.5);
		// 한 번 보이면 이 시간(s) 동안 유지 - 순간 미검출로 폭이 튀지 않게.
		pnh_.param("oncoming_hold_sec", oncoming_hold_sec_, 2.0);
		pnh_.param("obstacle_hold_sec", obstacle_hold_sec_, 0.5);   // 장애물이 안 잡혀도 이 시간(s) 동안은 최근 목록 유지
		pnh_.param("passed_release_margin", passed_release_margin_, 1.0);   // 이 값(m)만큼 앞에 남아있어도 "지나간 것"으로 보고 hold 조기 해제
		// 플래너는 20Hz지만 장애물 기하는 라이다(설정 10Hz, 최근 실측
		// 6.8~7.1Hz)에서만 새로 생긴다. 같은 스캔을 여러 번 실패로 세지 않고,
		// 서로 다른 관측이 이 횟수만큼 연속 실패할 때 정지를 요청한다.
		pnh_.param("max_avoidance_fail_observations",
			max_avoidance_fail_observations_, 3);
		pnh_.param("failure_no_observation_timeout_sec",
			failure_no_observation_timeout_sec_, 0.6);
		// 이미 회피 방향을 따라 물체 옆까지 온 상태에서는 새 후보가 잠깐
		// 사라져도 급정지하지 않고 직전 유효 경로로 통과한다. 장애물 경계의
		// 가장 앞 점이 이 거리 이내일 때만 적용한다.
		pnh_.param("side_pass_continue_front_m",
			side_pass_continue_front_m_, 1.5);
		pnh_.param("return_ti", return_ti_, 6.0);   // 복귀 경로를 완주하는 데 걸리는 시간(s), 길수록 완만하게 복귀
		// return_ti_는 버스처럼 긴 물체 기준으로 튜닝된 값(그대로 유지). 이보다
		// 짧은 물체를 지나칠 땐 이 길이(m)를 기준으로 비례해서 복귀시간을 줄인다
		// (물체 길이가 이 값 이상이면 return_ti_ 그대로, 짧을수록 비례해서 감소).
		pnh_.param("return_ti_ref_length", return_ti_ref_length_, 8.0);
		// 아무리 짧은 물체라도 복귀가 너무 급격해서 오실이 생기지 않도록 하는 하한(s)
		pnh_.param("min_return_ti", min_return_ti_, 2.0);
		pnh_.param("return_lat_time_scale", return_lat_time_scale_, 1.8);
		pnh_.param("return_heading_threshold_deg", return_heading_threshold_deg_, 3.5);
		pnh_.param("obstacle_boundary_samples", obstacle_boundary_samples_, 8);
		pnh_.param("require_confirmed", require_confirmed_, true);

		// 회피 경로가 이 곡률(1/m)을 넘으면(=너무 급하게 꺾으면) 채택하지 않고
		// 이전 경로를 유지한다. curvature_limit = 1 / 최소 회전반경(m).
		// 예: 0.5 -> 최소 회전반경 2m 이하로 꺾는 경로는 거부.
		pnh_.param("curvature_limit", curvature_limit_, 0.5);

		// 관련 장애물이 없을 때 패스스루로 내보낼 기준경로 길이(m).
		// Frenet 출력 길이(MAXT*TARGET_SPEED)와 비슷하게 맞춰서 전환 시 급격한
		// 경로 길이 변화가 없도록 한다.
		pnh_.param("passthrough_length_m", passthrough_length_m_, 45.0);

		// Frenet 샘플링 / 비용 파라미터 (frenet_optimal_trajectory.cpp의 extern 전역값)
		pnh_.param("max_speed", MAX_SPEED, 15.0);
		pnh_.param("max_accel", MAX_ACCEL, 3.0);
		pnh_.param("max_curvature", MAX_CURVATURE, 1.0);
		pnh_.param("max_road_width", MAX_ROAD_WIDTH, 1.5);   // 기준선에서 좌우로 최대 얼마나 벗어날지
		pnh_.param("d_road_w", D_ROAD_W, 0.25);              // d 샘플링 간격
		pnh_.param("dt", DT, 0.2);
		pnh_.param("maxt", MAXT, 3.0);
		pnh_.param("mint", MINT, 1.5);
		// 모든 후보를 그리는 공통 지평(초). Ti(회피 완료 시간)와 분리돼 있어야
		// 짧은 Ti 로 빠르게 비킨 경로도 장애물 너머까지 이어져 제대로 검사된다.
		// 장애물 최대 관심거리 / 주행속도 보다 커야 한다(예: 30m / 8m/s ~ 3.8s).
		pnh_.param("plan_horizon_t", PLAN_HORIZON_T, 4.0);
		pnh_.param("spatial_avoidance_enabled", SPATIAL_AVOIDANCE_ENABLED, true);
		pnh_.param("spatial_max_lat_accel", SPATIAL_MAX_LAT_ACCEL, 3.0);
		pnh_.param("spatial_max_lat_jerk", SPATIAL_MAX_LAT_JERK, 8.0);
		pnh_.param("spatial_min_transition_m", SPATIAL_MIN_TRANSITION_M, 10.0);
		pnh_.param("spatial_max_transition_m", SPATIAL_MAX_TRANSITION_M, 32.0);
		pnh_.param("spatial_sample_ds", SPATIAL_SAMPLE_DS, 0.25);
		nh_.param("/speed_limit/avoidance_mps", TARGET_SPEED, 4.5);
		pnh_.param("target_speed", TARGET_SPEED, TARGET_SPEED);
		pnh_.param("dynamic_speed_cap_enabled", dynamic_speed_cap_enabled_, true);
		pnh_.param("avoidance_min_speed_mps", avoidance_min_speed_mps_, 4.5);
		pnh_.param("avoidance_front_clearance_m", avoidance_front_clearance_m_, 3.5);
		pnh_.param("avoidance_speed_safety_factor", avoidance_speed_safety_factor_, 0.90);
		double speed_kick_target_kmh = 17.0;
		double camera_kick_mps = 17.0 / 3.6;
		if (nh_.getParam("/speed_limit/camera_kick_mps", camera_kick_mps)) {
			speed_kick_target_kmh = camera_kick_mps * 3.6;
		}
		pnh_.param("speed_kick_target_kmh", speed_kick_target_kmh, speed_kick_target_kmh);
		speed_kick_target_mps_ = speed_kick_target_kmh / 3.6;
		pnh_.param("tunnel_camera_kick_enabled", tunnel_camera_kick_enabled_, true);
		pnh_.param("speed_kick_duration_sec", speed_kick_duration_sec_, 3.0);
		pnh_.param("d_t_s", D_T_S, 1.0);
		pnh_.param("n_s_sample", N_S_SAMPLE, 1.0);
		pnh_.param("robot_radius", ROBOT_RADIUS, 0.6);       // 차량 자체 반폭 여유 (장애물 반경과 별개)
		pnh_.param("robot_circle_offset", ROBOT_CIRCLE_OFFSET, 1.2); // 차체 중심 전/후 원 간격
		pnh_.param("robot_footprint_center_offset", ROBOT_FOOTPRINT_CENTER_OFFSET, 1.35); // base_link -> 차체 중심
		pnh_.param("min_lat_vel", MIN_LAT_VEL, -0.5);
		pnh_.param("max_lat_vel", MAX_LAT_VEL, 0.5);
		pnh_.param("d_d_ns", D_D_NS, 1.0);
		pnh_.param("max_shift_d", MAX_SHIFT_D, 1.5);

		pnh_.param("kj", KJ, 0.1);
		pnh_.param("kt", KT, 0.1);
		pnh_.param("kd", KD, 1.0);
		pnh_.param("kd_v", KD_V, 1.0);
		pnh_.param("klat", KLAT, 1.0);
		pnh_.param("klon", KLON, 1.0);
	}

	// ---------------- 콜백 ----------------
	void waypointCallback(const waypoint_maker::Lane::ConstPtr &msg)
	{
		if (msg->waypoints.size() < 2)
			return;

		// CSV idx 기준 0~static_dynamic_split_idx_는 정적 미션 구간, 그 이후는
		// 동적 미션 구간으로 코스가 고정되어 있음. 매 콜백 갱신(스플라인 재계산
		// 캐시 체크보다 먼저) - 아래 캐시로 조기 return 되어도 최신 값 유지.
		current_waypoint_idx_ = msg->waypoints.front().waypoint_index;
		current_lane_number_ = msg->waypoints.front().lane_number;

		// waypoint_loader가 odom 콜백마다(수십 Hz) /final_waypoint를 재발행하므로,
		// 실제로 내용이 바뀐 경우에만 스플라인을 재계산한다 (안 그러면 매번 무거운
		// calc_spline_course가 돌아서 planLoop 타이머가 계속 밀림).
		const double fx = msg->waypoints.front().pose.pose.position.x;
		const double fy = msg->waypoints.front().pose.pose.position.y;
		const double bx = msg->waypoints.back().pose.pose.position.x;
		const double by = msg->waypoints.back().pose.pose.position.y;
		if (have_path_ &&
			msg->waypoints.size() == last_wp_count_ &&
			std::abs(fx - last_wp_front_x_) < 1e-3 && std::abs(fy - last_wp_front_y_) < 1e-3 &&
			std::abs(bx - last_wp_back_x_) < 1e-3 && std::abs(by - last_wp_back_y_) < 1e-3)
		{
			return;
		}
		last_wp_count_ = msg->waypoints.size();
		last_wp_front_x_ = fx; last_wp_front_y_ = fy;
		last_wp_back_x_ = bx; last_wp_back_y_ = by;
		path_wp_x_.clear();
		path_wp_y_.clear();
		path_wp_indices_.clear();
		path_wp_x_.reserve(msg->waypoints.size());
		path_wp_y_.reserve(msg->waypoints.size());
		path_wp_indices_.reserve(msg->waypoints.size());
		for (const auto &wp : msg->waypoints)
		{
			path_wp_x_.push_back(wp.pose.pose.position.x);
			path_wp_y_.push_back(wp.pose.pose.position.y);
			path_wp_indices_.push_back(wp.waypoint_index);
		}

		vecD wx, wy;
		wx.reserve(msg->waypoints.size());
		wy.reserve(msg->waypoints.size());
		for (const auto &wp : msg->waypoints)
		{
			wx.push_back(wp.pose.pose.position.x);
			wy.push_back(wp.pose.pose.position.y);
		}

		vecD rx, ry, ryaw, rk;
		Spline2D new_csp = calc_spline_course(wx, wy, rx, ry, ryaw, rk, spline_ds_);

		rx_ = rx;
		ry_ = ry;
		ryaw_ = ryaw;
		rk_ = rk;
		csp_.reset(new Spline2D(new_csp));

		global_s_.assign(rx_.size(), 0.0);
		double s = 0.0;
		for (size_t i = 1; i < rx_.size(); ++i)
		{
			s += dist(rx_[i], ry_[i], rx_[i - 1], ry_[i - 1]);
			global_s_[i] = s;
		}
		s_dest = global_s_.empty() ? 0.0 : global_s_.back();

		have_path_ = true;

		publishGlobalPath();
	}

	void publishGlobalPath()
	{
		nav_msgs::Path msg;
		msg.header.stamp = ros::Time::now();
		msg.header.frame_id = "map";
		for (size_t i = 0; i < rx_.size(); ++i)
		{
			geometry_msgs::PoseStamped ps;
			ps.header = msg.header;
			ps.pose.position.x = rx_[i];
			ps.pose.position.y = ry_[i];
			double yaw = (i < ryaw_.size()) ? ryaw_[i] : 0.0;
			tf::Quaternion q = tf::createQuaternionFromYaw(yaw);
			ps.pose.orientation.x = q.x();
			ps.pose.orientation.y = q.y();
			ps.pose.orientation.z = q.z();
			ps.pose.orientation.w = q.w();
			msg.poses.push_back(ps);
		}
		global_path_pub_.publish(msg);
	}

	void cameraDetectionCallback(const std_msgs::Bool::ConstPtr &msg)
	{
		// 이제 별도 스레드(camera_spinner_)에서 실행됨 - planLoop(메인 스레드)와
		// 동시에 speed_kick_* 상태를 건드릴 수 있어서 락으로 보호한다.
		std::lock_guard<std::mutex> lock(speed_kick_mutex_);
		camera_obstacle_present_ = msg->data;
		last_camera_detection_time_ = ros::Time::now();
		// 카메라 감지 즉시 반응. 예전엔 이 트리거 판단/발행이 obstacleInfoCallback
		// 안에 있어서 /obstacle_info(라이다 클러스터링, 실측 0.6~0.7초 간격)가
		// 들어와야만 평가됐음 -> 카메라는 바로 감지해도 킥은 최대 0.6~0.7초 뒤에야
		// 걸리는 지연이 있었음. 여기서 바로 평가/발행해서 트리거 뜨자마자 반응하게 함.
		updateSpeedKickLocked();
	}

	void tunnelOffsetCallback(const std_msgs::Float64::ConstPtr &msg)
	{
		tunnel_lateral_offset_ = msg->data;
		last_tunnel_offset_stamp_ = ros::Time::now();
		tunnel_wall_offset_valid_ = true;
	}

	void odomCallback(const nav_msgs::Odometry::ConstPtr &msg)
	{
		pose_x_ = msg->pose.pose.position.x;
		pose_y_ = msg->pose.pose.position.y;

		tf::Quaternion q(msg->pose.pose.orientation.x, msg->pose.pose.orientation.y,
						  msg->pose.pose.orientation.z, msg->pose.pose.orientation.w);
		tf::Matrix3x3 m(q);
		double roll, pitch;
		m.getRPY(roll, pitch, bot_yaw_);

		// /odom의 twist.linear가 MORAI에서는 항상 0으로 들어와서 c_speed가 계속
		// 0으로 계산되던 진짜 원인이었음. mpc_path_tracking이 이미 같은 이유로
		// /odom 대신 /Competition_topic의 velocity를 실제 속도로 쓰고 있어서,
		// 여기서도 그쪽을 우선 사용한다(competitionCallback에서 갱신).
		// /odom은 이제 위치/자세(pose, yaw)만 사용.
		if (!have_competition_speed_)
		{
			bot_speed_ = std::hypot(msg->twist.twist.linear.x, msg->twist.twist.linear.y);
		}
		have_odom_ = true;
	}

	void competitionCallback(const morai_msgs::EgoVehicleStatus::ConstPtr &msg)
	{
		bot_speed_ = std::hypot(msg->velocity.x, msg->velocity.y);
		have_competition_speed_ = true;
	}

	// 점 하나가 기준경로(rx_, ry_)에서 얼마나 떨어져 있는지 (최근접점 거리, 근사)

	double distToPath(double x, double y) const
	{
		double best = 1e18;
		for (size_t i = 0; i < rx_.size(); ++i)
		{
			double dd = dist(rx_[i], ry_[i], x, y);
			if (dd < best)
				best = dd;
		}
		return best;
	}

	// 장애물 근처 기준경로의 진행방향(yaw)을 반환. 장애물의 길이(length, 진행
	// 방향)/폭(width, 좌우) 직사각형을 도로 방향에 맞춰 배치하는 데 쓴다.
	double nearestPathYaw(double x, double y) const
	{
		double best = 1e18;
		double yaw = 0.0;
		for (size_t i = 0; i < rx_.size(); ++i)
		{
			double dd = dist(rx_[i], ry_[i], x, y);
			if (dd < best)
			{
				best = dd;
				yaw = (i < ryaw_.size()) ? ryaw_[i] : 0.0;
			}
		}
		return yaw;
	}

	// 현재 /final_waypoint 원본에서 장애물과 가장 가까운 CSV index와 부호 있는
	// 횡거리(d>0 왼쪽, d<0 오른쪽)를 구한다. 연석 제한은 자차 위치가 아니라
	// 실제로 피해야 할 장애물 위치의 도로 단면에 적용해야 한다.
	bool obstaclePathLocation(double x, double y, int &waypoint_idx, double &lateral) const
	{
		if (path_wp_x_.empty() || path_wp_x_.size() != path_wp_indices_.size())
			return false;
		size_t best_i = 0;
		double best = 1e18;
		for (size_t i = 0; i < path_wp_x_.size(); ++i)
		{
			const double dx = x - path_wp_x_[i];
			const double dy = y - path_wp_y_[i];
			const double d2 = dx * dx + dy * dy;
			if (d2 < best) { best = d2; best_i = i; }
		}
		double yaw = 0.0;
		if (best_i + 1 < path_wp_x_.size())
			yaw = std::atan2(path_wp_y_[best_i + 1] - path_wp_y_[best_i],
				path_wp_x_[best_i + 1] - path_wp_x_[best_i]);
		else if (best_i > 0)
			yaw = std::atan2(path_wp_y_[best_i] - path_wp_y_[best_i - 1],
				path_wp_x_[best_i] - path_wp_x_[best_i - 1]);
		waypoint_idx = path_wp_indices_[best_i];
		lateral = -(x - path_wp_x_[best_i]) * std::sin(yaw)
			+ (y - path_wp_y_[best_i]) * std::cos(yaw);
		return true;
	}

	// 카메라 감지 여부만 보고 speed_kick_active_ 갱신 + 발행. cameraDetectionCallback
	// (별도 스레드, 즉시 반응)과 planLoop(메인 스레드 10Hz, duration 만료를 라이다
	// 콜백 도착과 무관하게 체크) 양쪽에서 호출하므로 락으로 감싼다.
	void updateSpeedKick()
	{
		std::lock_guard<std::mutex> lock(speed_kick_mutex_);
		updateSpeedKickLocked();
	}

	// speed_kick_mutex_를 이미 잡은 상태에서만 호출할 것 (cameraDetectionCallback,
	// updateSpeedKick() 내부에서만 사용)
	void updateSpeedKickLocked()
	{
		// 고주로 차선(1/2/3.csv) 및 도심 기본경로 외 구간에서는 카메라 감속 절대 비활성화.
		// 고주로 갓길 라바콘 등을 카메라가 인지하여 고속 주행 중 20km/h로 급감속하는 문제를 차단한다.
		// 단 터널(M8, 3.csv)은 예외다 - 거기도 랜덤 정적·동적 장애물을 M2/M3 와
		// 같은 파이프라인으로 처리하므로 선 감속이 똑같이 필요하다. 터널 판정은
		// mission_mode 로 하므로 고주로 일반 주행에는 영향이 없다.
		//   실측 2026-09-13(16:08 백): M8 1951 프레임 내내 static_speed_scale 이
		//   9999.0(비활성)이었다. camera_speed_kick_node 는 M8 을 이미 허용
		//   목록에 갖고 있는데(section_id in M2/M3/M8), 소비 측 이 게이트가
		// 터널(M8)에서 카메라 선감속을 쓸지 (tunnel_camera_kick_enabled).
		// 카메라로 전방 장애물(정적/동적) 인지 시 선감속을 걸어 여유로운 회피/정지 궤적 확보.
		const bool tunnel_kick_ok = tunnel_mode_ && tunnel_camera_kick_enabled_;
		if (current_lane_number_ != 0 && !tunnel_kick_ok)
		{
			speed_kick_active_ = false;
			std_msgs::Float64 scale_msg;
			scale_msg.data = 9999.0;
			static_speed_scale_pub_.publish(scale_msg);
			return;
		}

		bool camera_recent = camera_obstacle_present_ &&
			(ros::Time::now() - last_camera_detection_time_).toSec() < 0.5;
		bool zone_known = current_waypoint_idx_ >= 0 && static_zone_min_idx_ >= 0;
		// 터널에서는 0.csv 기준 idx 구간(static_zone_min/dynamic_zone_max)이
		// 의미가 없다 - 3.csv 는 인덱스가 따로 돌기 때문이다. 구간 판정은
		// 이미 mission_mode=tunnel 이 해주므로 그대로 허용한다.
		bool in_camera_zone = tunnel_kick_ok ||
			((current_lane_number_ == 0) && (!zone_known ||
			(current_waypoint_idx_ >= static_zone_min_idx_ &&
			 (dynamic_zone_max_idx_ < 0 || current_waypoint_idx_ <= dynamic_zone_max_idx_))));
		bool trigger = camera_recent && in_camera_zone;
		ros::Time now = ros::Time::now();

		if (trigger)
		{
			speed_kick_active_ = true;
			speed_kick_active_until_ = now + ros::Duration(speed_kick_duration_sec_);
		}
		else if (speed_kick_active_ && now >= speed_kick_active_until_)
		{
			speed_kick_active_ = false;
		}

		// 배율(%)이 아니라 절대 목표속도(m/s)를 보낸다. mpc 쪽에서 min(ref_v, 이 값)으로
		// 적용하기 때문에, 이미 이 속도보다 느리면 자동으로 무시(더 안 줄임)되고,
		// 다시 이 속도보다 빨라지면 그때 다시 걸리는 게 자연스럽게 된다.
		std_msgs::Float64 scale_msg;
		scale_msg.data = speed_kick_active_ ? speed_kick_target_mps_ : 9999.0;
		static_speed_scale_pub_.publish(scale_msg);
	}

	// 좌측(대향) 차선에서 다가오는 차량이 있는지 본다.
	// 좌측 회피는 중앙선을 넘는 방향이라, 대향 차량이 있으면 자기 차로 안으로만
	// 피해야 한다. 판정은 보수적으로 - 하나라도 있으면 막는다.
	void trackedObjectsCallback(const lidar_ttc_tracker::TrackedObjectArray::ConstPtr &msg)
	{
		last_oncoming_observation_ = msg->header.stamp;
		if (!have_odom_)
			return;
		const double c = std::cos(-bot_yaw_), sn = std::sin(-bot_yaw_);
		for (const auto &o : msg->objects)
		{
			if (!o.is_vehicle)
				continue;
			// map -> ego 좌표
			const double dx = o.x - pose_x_, dy = o.y - pose_y_;
			const double fx = c * dx - sn * dy;      // 전방
			const double fy = sn * dx + c * dy;      // 좌측(+)
			if (fx <= 0.0 || fx > oncoming_check_range_m_)
				continue;
			if (fy < oncoming_min_lateral_m_)
				continue;   // 내 차로이거나 우측
			// 다가오는가: 자차 진행방향 성분이 음수(마주봄)
			const double vfx = c * o.vx - sn * o.vy;
			if (o.velocity_valid && o.observation_age < 0.3 &&
				vfx > -oncoming_min_closing_mps_)
				continue;
			last_oncoming_seen_ = ros::Time::now();
			ROS_INFO_THROTTLE(1.0,
				"[obstacle_avoidance] oncoming vehicle id=%u at fwd=%.1f left=%.1f "
				"closing=%.1f m/s -> left avoid width limited to %.2f m",
				o.id, fx, fy, -vfx, max_road_width_left_blocked_);
			return;
		}
	}

	bool oncomingBlocked() const
	{
		if (tunnel_mode_)
			return !tunnel_oncoming_ids_.empty();
		if (last_oncoming_seen_.isZero())
			return false;
		return (ros::Time::now() - last_oncoming_seen_).toSec() < oncoming_hold_sec_;
	}

	void obstacleInfoCallback(const std_msgs::String::ConstPtr &msg)
	{
		if (!have_path_)
			return;

		Json::CharReaderBuilder builder;
		Json::Value root;
		std::string errs;
		std::istringstream ss(msg->data);
		if (!Json::parseFromStream(builder, ss, &root, &errs))
		{
			ROS_WARN_THROTTLE(5.0, "[obstacle_avoidance] failed to parse /obstacle_info: %s", errs.c_str());
			return;
		}

		vecD ob_x, ob_y;
		tunnel_mode_ = root.get("mission_mode", "").asString() == "tunnel" && current_lane_number_ == 3;
		observation_stamp_ = ros::Time::now();
		tunnel_unresolved_ = false;
		if (!tunnel_mode_)
		{
			tunnel_oncoming_ids_.clear();
			oncoming_id_last_seen_.clear();
		}
		// ★ 목록 분리(인지 측과 쌍).
		//   obstacles         : 기준경로 코리도 1.4m 안 - "회피를 시작할까"(트리거)
		//   collision_objects : 코리도 6.0m 안 전체   - "이 경로가 안전한가"(충돌)
		//   충돌 검사는 넓은 목록으로 해야 한다. 트리거 목록만 쓰면, 회피를
		//   시작한 뒤 회피 경로가 지나가는 자리(기준경로에서 2~4m 옆)의
		//   장애물이 프레넷에 안 보여서 그 위로 경로를 그린다(실제 충돌).
		//   반대로 트리거를 넓은 목록으로 하면 옆 차로/노견 물체에도 회피가
		//   걸리므로, 트리거는 좁은 목록 그대로 둔다.
		const bool has_split = root.isMember("collision_objects");
		const Json::Value &obs_list =
			has_split ? root["collision_objects"] : root["obstacles"];

		// 회피 방향과 도로 폭은 가장 가까운 '다음' 트리거 장애물을 기준으로
		// 정한다. 자차 idx만 쓰면 20~30m 앞 연석 제한 구간의 버스를 보고도
		// 제한이 적용되기 전까지 우측 경로를 만들게 된다. 반대로 모든 원거리
		// 물체 중 가장 엄격한 제한을 쓰면 첫 장애물을 피하기도 전에 두 번째
		// 구간 제한이 개입하므로, 현재 장애물보다 뒤 2m 이내부터 가장 작은
		// CSV idx를 가진 물체 하나를 primary로 잡는다.
		struct TriggerGeometry
		{
			int idx;
			double lateral;
			double half_width;
			double area;
		};
		std::vector<TriggerGeometry> trigger_geometry;
		const Json::Value &trigger_list = root["obstacles"];
		for (const auto &obs : trigger_list)
		{
			if (require_confirmed_ && !obs.get("confirmed", false).asBool()) continue;
			if (obs.get("passed", false).asBool()) continue;
			if (!obs.isMember("position_world") || obs["position_world"].size() < 2) continue;
			int idx = -1;
			double lateral = 0.0;
			if (!obstaclePathLocation(obs["position_world"][0].asDouble(),
				obs["position_world"][1].asDouble(), idx, lateral)) continue;
			if (current_waypoint_idx_ >= 0 &&
				idx < current_waypoint_idx_ - primary_release_behind_idx_) continue;
			double width = obs.get("width", 0.35).asDouble();
			double length = obs.get("length", 0.35).asDouble();
			width = std::min(std::max(width, 0.35), 2.6);
			length = std::min(std::max(length, 0.35), 3.0);
			trigger_geometry.push_back({idx, lateral, 0.5 * width, width * length});
		}
		int candidate_primary_idx = -1;
		double candidate_primary_min_d = 0.0;
		double candidate_primary_max_d = 0.0;
		if (!trigger_geometry.empty())
		{
			int foremost_idx = trigger_geometry.front().idx;
			for (const auto &g : trigger_geometry)
				foremost_idx = std::min(foremost_idx, g.idx);

			// 같은 물체가 여러 클러스터로 갈라져도 가장 큰 조각을 대표로 삼고,
			// 그 전후 primary_group_span_idx 안의 조각은 하나의 점유 폭으로 합친다.
			const TriggerGeometry *representative = nullptr;
			for (const auto &g : trigger_geometry)
				if (std::abs(g.idx - foremost_idx) <= 10 &&
					(!representative || g.area > representative->area))
					representative = &g;
			if (representative)
			{
				candidate_primary_idx = representative->idx;
				candidate_primary_min_d = 1e18;
				candidate_primary_max_d = -1e18;
				for (const auto &g : trigger_geometry)
				{
					if (std::abs(g.idx - candidate_primary_idx) > primary_group_span_idx_) continue;
					candidate_primary_min_d = std::min(candidate_primary_min_d,
						g.lateral - g.half_width);
					candidate_primary_max_d = std::max(candidate_primary_max_d,
						g.lateral + g.half_width);
				}
			}
		}
		if (candidate_primary_idx >= 0)
		{
			const bool first_primary = primary_obstacle_idx_ < 0;
			const bool old_primary_passed = current_waypoint_idx_ >= 0 &&
				current_waypoint_idx_ > primary_obstacle_idx_ + primary_release_behind_idx_;
			const bool advanced_to_next = primary_obstacle_idx_ >= 0 &&
				candidate_primary_idx > primary_obstacle_idx_ + primary_switch_min_idx_ &&
				old_primary_passed;
			if (first_primary || advanced_to_next)
			{
				if (advanced_to_next)
				{
					ROS_INFO("[obstacle_avoidance] primary obstacle advanced idx %d -> %d; "
						"releasing previous side lock", primary_obstacle_idx_, candidate_primary_idx);
					committed_avoid_side_ = 0;
					primary_changed_for_plan_ = true;
				}
				primary_obstacle_idx_ = candidate_primary_idx;
				primary_obstacle_min_d_ = candidate_primary_min_d;
				primary_obstacle_max_d_ = candidate_primary_max_d;
			}
			else if (std::abs(candidate_primary_idx - primary_obstacle_idx_) <= 15)
			{
				primary_obstacle_idx_ = candidate_primary_idx;
				primary_obstacle_min_d_ = candidate_primary_min_d;
				primary_obstacle_max_d_ = candidate_primary_max_d;
			}

			// 장애물 크기와 위치가 랜덤이어도 통과 가능한지를 직접 계산한다.
			// 좌측 통과에 필요한 d는 장애물 좌측 끝 + 차량 충돌 반경,
			// 우측 통과에 필요한 |d|는 차량 반경 - 장애물 우측이 아닌 좌측 끝이다.
			double right_limit = tunnel_mode_ ? 1.5 : max_road_width_right_;
			double left_limit = oncomingBlocked()
				? max_road_width_left_blocked_ : max_road_width_left_;
			roadWidthLimitsForIdx(primary_obstacle_idx_, right_limit, left_limit);
			const double left_required = std::max(0.0,
				primary_obstacle_max_d_ + ROBOT_RADIUS);
			const double right_required = std::max(0.0,
				ROBOT_RADIUS - primary_obstacle_min_d_);
			const bool left_feasible = left_required <= left_limit + 1e-6;
			const bool right_feasible = right_required <= right_limit + 1e-6;
			if (left_feasible && right_feasible)
				preferred_avoid_side_ = right_required <= left_required ? -1 : 1;
			else if (right_feasible)
				preferred_avoid_side_ = -1;
			else if (left_feasible)
				preferred_avoid_side_ = 1;
			else
				preferred_avoid_side_ = 0;  // 양쪽 모두 불가능: 플래너가 실패시 정지 요청
			ROS_INFO_THROTTLE(0.5,
				"[obstacle_avoidance] primary idx=%d occupied_d=[%.2f,%.2f], "
				"required right/left=%.2f/%.2f, limits=%.2f/%.2f -> prefer %s",
				primary_obstacle_idx_, primary_obstacle_min_d_, primary_obstacle_max_d_,
				right_required, left_required, right_limit, left_limit,
				preferred_avoid_side_ < 0 ? "RIGHT" :
				(preferred_avoid_side_ > 0 ? "LEFT" : "NONE"));
		}
		if (tunnel_mode_)
		{
			last_oncoming_observation_ = observation_stamp_;
			std::set<int> current_frame_oncoming;
			for (const auto &obs : obs_list)
			{
				if (!obs.isMember("position_ego") || obs["position_ego"].size() < 2 ||
					obs.get("infrastructure_candidate", false).asBool()) continue;
				const int id = obs.get("id", -1).asInt();
				const double x = obs["position_ego"][0].asDouble();
				const double y = obs["position_ego"][1].asDouble();
				if (id < 0 || obs.get("observation_age", 1.0).asDouble() > 0.4) continue;
				if (x < -1.5) continue; // 자차 측면/후방 통과
				if (obs.get("motion_state", "unknown").asString() == "static") continue;
				// 대향 차로 횡방향 유효 범위 (1.2m <= y <= 5.5m, 5.5m 초과는 좌측 터널 벽면)
				if (x <= 0.0 || y < oncoming_min_lateral_m_ || y > 5.5) continue;
				const bool valid = obs.get("velocity_valid", false).asBool();
				double forward_velocity = 0.0;
				if (valid && obs["velocity"].size() >= 2)
					forward_velocity = std::cos(bot_yaw_)*obs["velocity"][0].asDouble() +
						std::sin(bot_yaw_)*obs["velocity"][1].asDouble();
				// Invalid velocity alone is not evidence of an oncoming vehicle;
				// roadside/static clusters start that way too.  Require either a
				// valid opposing longitudinal component or measured motion.
				if ((valid && forward_velocity < -0.3) ||
					obs.get("speed", 0.0).asDouble() > 1.5)
				{
					current_frame_oncoming.insert(id);
					tunnel_oncoming_ids_.insert(id);
					oncoming_id_last_seen_[id] = observation_stamp_;
				}
			}
			// 더 이상 관측되지 않거나 통과한 오래된 ID 정리 (Stale ID 방지)
			for (auto it = tunnel_oncoming_ids_.begin(); it != tunnel_oncoming_ids_.end(); )
			{
				int oid = *it;
				if (current_frame_oncoming.find(oid) == current_frame_oncoming.end())
				{
					auto seen_it = oncoming_id_last_seen_.find(oid);
					if (seen_it == oncoming_id_last_seen_.end() ||
						(observation_stamp_ - seen_it->second).toSec() > 0.4)
					{
						it = tunnel_oncoming_ids_.erase(it);
						if (seen_it != oncoming_id_last_seen_.end())
							oncoming_id_last_seen_.erase(seen_it);
						continue;
					}
				}
				++it;
			}
		}
		int n_total = obs_list.size();
		int n_after_motion = 0, n_after_confirmed = 0, n_after_pos = 0, n_after_corridor = 0;
		int n_trigger = 0;   // 이 중 트리거 코리도 안에 있는 개수
		double nearest_trigger_forward = 1e18;
		double max_length_this_cycle = 0.0;
		double newest_geometry_measurement = 0.0;

		// 동적 미션 구간(코스 설계상 정적 장애물이 없음이 보장됨)에서는 회피 자체를
		// 하지 않는다 - obstacle_stop_node가 이 구간의 모든 confirmed 장애물을
		// motion_state 판정 없이 즉시 정지 처리하므로, 여기서 뭔가를 피하려고 조향을
		// 섞으면 정지 이후 재출발 시 불필요하게 옆으로 밀려난 상태로 남을 수 있음.
		bool in_dynamic_zone = current_waypoint_idx_ >= 0 &&
			current_waypoint_idx_ > static_dynamic_split_idx_;
		// 정적 미션 구간 이전. 회피 대상이 아직 없는 일반 주행 구간이므로
		// 여기서는 회피도 감속도 걸지 않는다.
		bool before_static_zone = current_waypoint_idx_ >= 0 &&
			static_zone_min_idx_ >= 0 &&
			current_waypoint_idx_ < static_zone_min_idx_;
		// 정적 구간으로 확실히 확인된 경우(웨이포인트 인덱스로 판단됨)엔 코스
		// 설계상 동적 장애물이 절대 없다고 보장되니까, motion_state가 노이즈로
		// 잠깐 "dynamic"으로 오판되더라도(크고 가까운 물체일수록 위치 추정이
		// 흔들려서 실제로 발생함 - 회피 도중 갑자기 회피 대상에서 빠져 위험했음)
		// 무시하고 그냥 계속 회피 대상으로 취급한다. 아직 구간 판정이 안 된
		// 상태(current_waypoint_idx_==-1, 폴백)에서만 안전하게 motion_state를 본다.
		bool confirmed_static_zone = current_waypoint_idx_ >= 0 &&
			current_waypoint_idx_ <= static_dynamic_split_idx_ &&
			!before_static_zone;
		if (tunnel_mode_ || (!in_dynamic_zone && !before_static_zone))
		{
		for (const auto &obs : obs_list)
		{
			// 터널 모드에서 동적 장애물은 obstacle_stop_node 가 즉시 정지를 전담하므로
			// 회피 플래너의 정적 회피 목록에서는 배제
			if (obs.isMember("motion_state") && obs["motion_state"].asString() == "dynamic")
			{
				// 한 프레임 box wobble로 static 물체가 dynamic이 되어도
				// 회피 실패/AEB를 만들지 않는다. 정지 노드와 같은 확정 근거를 쓴다.
				const bool reliable_dynamic =
					obs.get("dynamic_streak", 0).asInt() >= 2 &&
					obs.get("speed", 0.0).asDouble() >= 0.8 &&
					obs.get("observation_age", 9.0).asDouble() <= 1.0;
				const int dynamic_id = obs.get("id", -1).asInt();
				const bool is_oncoming = tunnel_oncoming_ids_.find(dynamic_id) !=
					tunnel_oncoming_ids_.end();
				// Perception's in_trigger_corridor is the union of the reference-path
				// and ego-forward corridors.  In a tunnel an opposing-lane vehicle can
				// therefore set that tag while remaining clear of our route.  It must
				// constrain left-side avoidance, but must not publish avoidance_failed
				// and indirectly request AEB.  Re-evaluate against the reference path.
				if (tunnel_mode_ && reliable_dynamic && !is_oncoming &&
					obs.isMember("position_world") && obs["position_world"].size() >= 2)
				{
					const double wx = obs["position_world"][0].asDouble();
					const double wy = obs["position_world"][1].asDouble();
					const double half_extent = 0.5 * std::max(
						obs.get("length", 0.0).asDouble(),
						obs.get("width", 0.0).asDouble());
					const bool reference_path_conflict =
						(distToPath(wx, wy) - half_extent) <= path_corridor_radius_;
					if (reference_path_conflict)
						tunnel_unresolved_ = true;
				}
				continue;
			}
			// 갓 확정된 장애물은 속도이력이 3프레임 쌓이기 전까지 "unknown"으로
			// 유지되는데, 이 상태를 무시하면 화면엔 이미 confirmed(초록색)로
			// 잡히는데도 회피 노드는 몇 프레임(수백ms) 늦게 반응하게 된다.
			// dynamic만 확실히 걸러내고, unknown은 안전하게 static처럼 취급해서 바로 회피 대상에 포함한다.
			if (!tunnel_mode_ && !confirmed_static_zone && obs["motion_state"].asString() == "dynamic")
				continue;
			// obstacle_stop_node는 이미 지나친(passed) 장애물을 무시하는데 이 노드는
			// 안 보고 있었음 -> 지나친 뒤에도 계속 회피 대상으로 남아서 절대 센터로
			// 복귀를 못 했음(latest_ob_x_가 영원히 안 비게 됨).
			if (obs.isMember("passed") && obs["passed"].asBool())
				continue;
			n_after_motion++;
			// 감속(obstacle_stop_node의 speed_kick)보다 조향을 늦게 시작하도록
			// 거리 게이트를 걸었었는데, 그러면 회피가 너무 늦게 시작돼서 오히려
			// 위험함. 감속은 obstacle_stop_node가 독립적으로 처리하니까, 조향은
			// 인지되는 즉시(거리 제한 없이) 바로 시작하는 게 맞음.
			if (require_confirmed_ && !obs["confirmed"].asBool())
				continue;
			n_after_confirmed++;
			if (!obs.isMember("position_world") || obs["position_world"].size() < 2)
				continue;
			n_after_pos++;

			// 방어적 저상 잔차 필터: ego 기준 z < -1.45m(지면 대비 25cm 이하)인 바닥 잔차는 회피 대상에서 배제
			if (obs.isMember("position_ego") && obs["position_ego"].size() >= 3)
			{
				double ez = obs["position_ego"][2].asDouble();
				const bool temporal_far =
					obs.get("source", "").asString() == "raw_temporal_far";
				if (ez < -1.45 && !tunnel_mode_ && !temporal_far)
					continue;
			}

			double wx = obs["position_world"][0].asDouble();
			double wy = obs["position_world"][1].asDouble();

			double d2p = distToPath(wx, wy);
			double ex = obs.isMember("position_ego") ? obs["position_ego"][0].asDouble() : -999;
			int oid = obs.isMember("id") ? obs["id"].asInt() : -1;
			// Opposing-lane tracks constrain the available left side below, but
			// must not also be inserted as static collision geometry.  Doing both
			// squeezed every candidate and produced clear_found=0.
			if (tunnel_mode_ && tunnel_oncoming_ids_.find(oid) != tunnel_oncoming_ids_.end())
				continue;
			// 충돌 반경 밖이면 어떤 후보 경로도 거기로 안 가므로 완전히 버린다.
			// 그 안이면 기하(ob_x/ob_y)는 만들고, 트리거 반경 안인지는 따로 센다.
			bool pass_corridor = d2p <= collision_corridor_radius_;

			// ★ 트리거 판정은 '물체 몸통 가장자리' 기준으로 통일한다.
			//   d2p 는 중심까지의 거리라 그대로 쓰면 폭에 따라 판정이 흔들린다
			//   (폭 1.0m 물체는 중심 1.75m 여도 가장자리는 1.25m 다).
			//   회피가 필요한 실제 조건은 '가장자리 < robot_radius' 이므로
			//   가장자리로 재야 물리적으로 일관된다.
			//   인지(obstacle_perception)도 같은 양(lateral - half_extent)을
			//   path_corridor_half_width 로 재서 in_trigger_corridor 태그를
			//   달아 보낸다. 같은 기준이므로 태그가 있으면 그걸 그대로 쓴다
			//   - 인지는 /final_waypoint 원본으로, 여기 rx_ 는 그걸 스플라인
			//   재샘플한 것이라 미세하게 다른데, 둘을 AND 하면 결국 더 좁은
			//   쪽만 남아서 한쪽 값이 죽은 파라미터가 된다.
			double half_extent = 0.5 * std::max(
				obs.get("length", 0.0).asDouble(),
				obs.get("width", 0.0).asDouble());
			bool in_trigger;
			if (obs.isMember("in_trigger_corridor"))
				in_trigger = obs["in_trigger_corridor"].asBool();
			else
				// 구버전 인지(태그 없음) 폴백. 같은 식으로 직접 계산한다.
				// 여기 length/width 는 인지가 클램핑(0.35~2.2 / 0.35~1.5)한
				// 값이라 인지의 np.ptp 원본과 미세하게 다를 수 있다. 태그가
				// 오는 정상 경로에서는 이 분기를 안 타므로 영향은 없다.
				in_trigger = (d2p - half_extent) <= path_corridor_radius_;
			// A confirmed track starts as unknown until enough independent scans
			// establish velocity.  M8 random static obstacles can pass the vehicle
			// before ever reaching the explicit static state, so unknown must be a
			// provisional static avoidance trigger.  Explicit dynamic tracks were
			// already removed above and are handled by obstacle_stop_node.
			// 쓰로틀(0.2s)이 여러 장애물(노이즈 클러스터 포함)의 로그를 한 줄로
			// 공유해서, 진짜 타겟 물체가 실제로 더 일찍 corridor를 통과했어도
			// 다른 장애물 로그에 밀려 기록이 안 남을 수 있었음. id별로 매 프레임
			// 다 찍어서 진짜 최초 통과 시점을 정확히 본다.
			// 매 사이클(10Hz) x 장애물마다 스로틀 없이 찍다 보니 CPU를 꽤 잡아먹고
			// 있었음(이 노드가 100% CPU까지 쓰는 원인 중 하나) - 디버깅용으로 넣어둔
			// 로그라 이제 스로틀 걸어서 부담 줄임.
			ROS_INFO_THROTTLE(0.2, "[obstacle_avoidance] DEBUG corridor check: id=%d ego_x=%.1f dist_to_path=%.2f (limit=%.2f) %s",
				oid, ex, d2p, path_corridor_radius_,
				!pass_corridor ? "reject" : (in_trigger ? "PASS" : "collision_only"));
			if (!pass_corridor)
				continue;   // 회피 폭 밖 - 무시
			n_after_corridor++;
			if (in_trigger)
			{
				n_trigger++;
				if (ex > 0.0) nearest_trigger_forward = std::min(nearest_trigger_forward, ex);
			}

			double radius = obs.get("radius", 0.5).asDouble();
			if (radius <= 0.0)
				radius = 0.5;

			// 지금까지는 장애물이 완전히 뒤로 넘어갈 때까지(passed) 계속 100%
			// 회피 상태를 유지하다가, 넘어가는 순간 한번에 복귀로 전환해서 그때는
			// 이미 많이 밀려나있어 복귀가 급해지는 문제가 있었음. 아직 완전히
			// 안 지나쳤어도(전방에 남아있어도) "이미 옆(또는 살짝 뒤)까지 와서
			// 충분히 떨어진 상태"면 더 이상 회피 대상으로 안 보고 조금 더 일찍
			// 복귀를 시작한다. 전방으로 아직 많이 남아있을 때(멀리서 접근 중)는
			// 장애물이 자차 후방으로 충분히 빠졌거나(-2.5m 이하), 또는
			// 횡방향으로 자차 차폭+안전마진을 완전히 벗어난 경우에만 회피 대상에서 제외.
			// 차체 옆(0 < ego_x < ROBOT_RADIUS)에 아직 물체가 있는데 섣불리 무시하면
			// 복귀 조향 중 차체 측면/후미 충돌이 발생함.
			if (obs.isMember("position_ego") && obs["position_ego"].size() >= 2)
			{
				double ego_x = obs["position_ego"][0].asDouble();
				double ego_y = obs["position_ego"][1].asDouble();
				if (ego_x < -2.5 && std::abs(ego_y) > ROBOT_RADIUS + radius)
					continue;
			}

			// 장애물을 반지름 하나짜리 원으로 근사하면, 버스처럼 길쭉한 물체는
			// (길이/폭 대각선 기준) 실제 폭보다 훨씬 큰 원이 되어서 필요 이상으로
			// 많이 피하게 됨. 대신 실제 길이(진행방향)/폭(좌우) 직사각형을 도로
			// 방향에 맞춰 배치해서, 회피에 진짜 필요한 만큼(폭 기준)만 피하게 한다.
			double length = obs.get("length", 2.0 * radius).asDouble();  // 진행방향 전체 길이
			double width = obs.get("width", 2.0 * radius).asDouble();    // 좌우 전체 폭
			if (length <= 0.0) length = 2.0 * radius;
			if (width <= 0.0) width = 2.0 * radius;
			newest_geometry_measurement = std::max(
				newest_geometry_measurement,
				obs.get("last_seen", 0.0).asDouble());

			// 방어적 클램핑: 인지에서 비정상적인 크기(연석/인도 병합 등)가 유입되어도
			// 회피 노드에서 장애물 경계가 차선을 가로막아 후보가 전량 충돌 기각(비상정지)되는 사태 방지
			// ★ 상한이 실물보다 작으면 '장애물을 실제보다 좁게' 보고 그 위로
			//   경로를 그린다. 실측 2026-09-09(15:11 주행): 카고박스 실제 폭
			//   1.75m 가 인지/회피 양쪽 상한 1.5 에 걸려 1.50 으로 깎였고,
			//   통과 시 장애물이 ego_y=+0.48m (차체 반폭 0.95 안쪽)로 들어와
			//   차가 박았다. 물체가 클수록 더 많이 깎이므로 큰 장애물에서
			//   가장 위험하다. 인지와 같은 값으로 올린다.
			//   거대 클러스터(연석/벽 병합) 방어는 인지의 SVD 형상 필터가 맡는다.
			width = std::min(std::max(width, 0.35), 2.6);
			length = std::min(std::max(length, 0.35), 3.0);
			radius = std::min(std::max(radius, 0.25), 2.0);
			double hl = length / 2.0, hw = width / 2.0;

			// 복귀 소요시간(return_ti_)을 물체 길이와 무관하게 항상 고정으로 쓰면,
			// 버스처럼 긴 물체엔 자연스러워도 짧은 물체엔 "다 지나간 지 한참인데도
			// 계속 옆에 붙어서 천천히 복귀"하는 것처럼 과하게 느껴짐. 지금 사이클에
			// 실제로 회피 대상인 물체들 중 가장 긴 길이를 기록해서, 나중에 복귀
			// 시작할 때(calc_direct 호출부) 그 길이에 비례해 복귀시간을 줄인다.
			max_length_this_cycle = std::max(max_length_this_cycle, length);

			ROS_INFO_THROTTLE(0.2,
				"[obstacle_avoidance] DEBUG obstacle geom: id=%d radius=%.2f length=%.2f width=%.2f "
				"(effective clearance needed = robot_radius(%.2f) + half_width(%.2f) = %.2f)",
				oid, radius, length, width, ROBOT_RADIUS, hw, ROBOT_RADIUS + hw);

			double yaw = nearestPathYaw(wx, wy);
			double fx = std::cos(yaw), fy = std::sin(yaw);     // 진행방향 단위벡터
			double lxv = -std::sin(yaw), lyv = std::cos(yaw);  // 좌측 단위벡터

			for (int k = 0; k < obstacle_boundary_samples_; ++k)
			{
				double t = 2.0 * M_PI * k / obstacle_boundary_samples_;
				double cx = std::cos(t), cy = std::sin(t);
				// 원 위의 방향(cx,cy)을 그대로 직사각형 경계까지 투영(반지름 스케일링)
				double scale = 1.0 / std::max(std::abs(cx) / hl, std::abs(cy) / hw);
				double local_f = cx * scale;
				double local_l = cy * scale;
				ob_x.push_back(wx + local_f * fx + local_l * lxv);
				ob_y.push_back(wy + local_f * fy + local_l * lyv);
			}
			ob_x.push_back(wx);
			ob_y.push_back(wy);
		}
		}  // !in_dynamic_zone && !before_static_zone

		// 클러스터 파편화로 어느 한 프레임에서만 순간적으로 after_corridor=0이
		// 되는 경우, 그걸 바로 "장애물이 없어졌다"로 보고 복귀 모드로 넘어가면
		// 아직 옆을 다 못 지난 상태에서 중앙으로 확 꺾이다가 장애물에 부딪힘
		// (복귀 오실의 원인). 최근에 실제로 봤으면(obstacle_hold_sec_ 이내)
		// 이번 프레임이 비어있어도 마지막으로 확인된 장애물 목록을 유지한다.
		// ★ 트리거 게이트.
		//   ob_x 에는 충돌 코리도(6m) 안의 모든 물체 기하가 들어있다. 그걸
		//   그대로 "회피 대상 있음"으로 쓰면, 옆 차로나 노견의 물체만 보여도
		//   회피가 켜진다(트리거 코리도를 좁게 둔 목적이 사라진다).
		//   그래서 회피 '시작'은 트리거 코리도 안에 물체가 있을 때만 한다.
		//   단, 이미 회피 중이면(latest_ob_x_ 비어있지 않음) 계속 유지한다 -
		//   회피로 옆으로 밀려나면 기준경로 기준 횡거리가 그대로여도 차가
		//   비켜난 만큼 트리거 판정이 흔들릴 수 있고, 회피 도중 목록이 비면
		//   그게 바로 "복귀 시작"으로 읽혀 장애물 쪽으로 다시 꺾인다.
		const bool avoiding_now = !latest_ob_x_.empty();
		if (!ob_x.empty() && (n_trigger > 0 || avoiding_now))
		{
			latest_ob_x_ = ob_x;
			latest_ob_y_ = ob_y;
			if (newest_geometry_measurement > 0.0)
				geometry_observation_stamp_.fromSec(newest_geometry_measurement);
			last_obstacle_seen_ = ros::Time::now();
			last_obstacle_length_ = max_length_this_cycle;
			if (nearest_trigger_forward < 1e17)
				nearest_trigger_forward_m_ = nearest_trigger_forward;
		}
		else
		{
			// obstacle_hold_sec_(순간적 미검출 버티기 용도)가 길어지면서(버스처럼
			// 큰 물체가 근접 시 잠깐 안 잡히는 경우를 버티려고 늘림), 반대로
			// 장애물이 "진짜로" 다 지나갔는데도 그 마지막 world 위치를 계속
			// 붙들고 있어서 복귀가 그만큼(최대 hold_sec) 불필요하게 늦어지는
			// 부작용이 생겼음. 붙들고 있는 점들이 이미 차량 뒤쪽(ego 기준 x<0)으로
			// 넘어갔으면 - 진짜로 지나쳤다는 뜻이므로 - hold_sec 안 지났어도
			// 즉시 놓아준다. 아직 하나라도 앞쪽에 남아있으면(옆에 있는데 순간
			// 미검출) 기존대로 hold_sec까지 유지.
			// x < 0(완전히 뒤로 넘어감)까지 기다리면 그 남은 거리를 다 주행할
			// 때까지 지연이 생김. 완전히 안 넘어가도 이 여유(m) 이내로
			// 가까워졌으면 사실상 지나간 걸로 보고 더 일찍 놓아줘서 복귀 지연을 줄임.
			bool still_ahead = false;
			double cy = std::cos(bot_yaw_), sy = std::sin(bot_yaw_);
			for (size_t i = 0; i < latest_ob_x_.size(); ++i)
			{
				double dx = latest_ob_x_[i] - pose_x_;
				double dy = latest_ob_y_[i] - pose_y_;
				double ego_x = cy * dx + sy * dy;
				if (ego_x > passed_release_margin_)
				{
					still_ahead = true;
					break;
				}
			}
			if (!still_ahead ||
				(ros::Time::now() - last_obstacle_seen_).toSec() > obstacle_hold_sec_)
			{
				// last_obstacle_length_는 여기서 리셋하지 않는다 - planLoop의 복귀
				// 경로 계산(calc_direct)이 이 시점 이후에 이 값을 읽어서 복귀시간을
				// 정하는데, 여기서 미리 0으로 지워버리면 물체 크기와 무관하게 항상
				// 최소 복귀시간(min_return_ti_)으로 강제돼서 복귀가 너무 급격해지고,
				// 차가 그 곡선을 다 못 따라가 덜 꺾인 채 차선을 밟는 문제가 생겼음.
				// 복귀가 실제로 다 끝난(중앙 근접) 시점에만 planLoop에서 리셋한다.
				latest_ob_x_.clear();
				latest_ob_y_.clear();
				primary_obstacle_idx_ = -1;
				primary_obstacle_min_d_ = 0.0;
				primary_obstacle_max_d_ = 0.0;
				nearest_trigger_forward_m_ = 1e18;
				preferred_avoid_side_ = 0;
				primary_changed_for_plan_ = false;
			}
		}

		// 트리거/발행 로직은 updateSpeedKick()으로 옮김 (cameraDetectionCallback에서
		// 즉시, planLoop에서 주기적으로 호출). 여기선 더 이상 안 부름 - 이 콜백은
		// /obstacle_info 도착 주기에 묶이므로 여기서 부르면 카메라의 독립적인
		// 조기 감속 반응이 그만큼 늦어진다.
		(void)n_after_corridor;  // 디버그 로그용으로만 유지

		ROS_INFO_THROTTLE(0.2,
			"[obstacle_avoidance] DEBUG obstacles total=%d after_motion=%d after_confirmed=%d "
			"after_pos=%d after_corridor=%d trigger=%d (split=%d, corridor trig/coll=%.2f/%.2f)",
			n_total, n_after_motion, n_after_confirmed, n_after_pos, n_after_corridor,
			n_trigger, has_split ? 1 : 0,
			path_corridor_radius_, collision_corridor_radius_);
	}

	void resetAvoidanceFailureState()
	{
		avoidance_fail_count_ = 0;
		last_failed_geometry_stamp_ = ros::Time(0);
		avoidance_failure_start_ = ros::Time(0);
	}

	bool registerAvoidanceFailure()
	{
		const ros::Time now = ros::Time::now();
		if (avoidance_failure_start_.isZero())
			avoidance_failure_start_ = now;

		// planLoop 호출 횟수가 아니라 라이다가 만든 독립 관측만 센다.
		if (!geometry_observation_stamp_.isZero() &&
			(last_failed_geometry_stamp_.isZero() ||
			 geometry_observation_stamp_ > last_failed_geometry_stamp_))
		{
			++avoidance_fail_count_;
			last_failed_geometry_stamp_ = geometry_observation_stamp_;
		}

		const bool lidar_stale =
			(now - avoidance_failure_start_).toSec() >=
			failure_no_observation_timeout_sec_;
		return avoidance_fail_count_ >= max_avoidance_fail_observations_ ||
			lidar_stale;
	}

	// 후보가 전멸했을 때 재발행하려는 '직전 경로'가 지금 기하로도 여전히
	// 안전한지 확인한다.
	//   실측 2026-09-21(18:19:40 백): 방벽이 20m 전부터 계속 보였는데
	//   폭이 0.73 -> 1.71 m 로 커지는 동안 후보가 전멸했고, 노드는 낡은
	//   경로를 1.1초간 그대로 재발행했다. 그 경로는 현재 기하 기준
	//   여유가 0.75~1.02 m 뿐이라 ROBOT_RADIUS(1.35)를 위반했고 결국
	//   24 km/h 로 충돌했다(감속도 -314 m/s^2). 같은 구조로 3주행 연속.
	//   '경로가 없음'보다 '안전하지 않은 경로를 확신하며 발행함'이 위험하다.
	// 반환 true = 재발행해도 되는 경로.
	// 구간별 회피 폭 상한을 primary 장애물 idx 에 맞춰 적용한다.
	// road_width_zones: [start, end, right, left] * N (평평한 1차원 배열).
	// left 를 0 이하로 두면 그 구간에서 좌측은 기존값을 유지한다.
	void roadWidthLimitsForIdx(int constraint_idx, double &right_limit,
								 double &left_limit) const
	{
		if (road_width_zones_.size() < 4 || constraint_idx < 0)
			return;
		for (std::size_t i = 0; i + 3 < road_width_zones_.size(); i += 4)
		{
			const int lo = static_cast<int>(road_width_zones_[i]);
			const int hi = static_cast<int>(road_width_zones_[i + 1]);
			if (constraint_idx < lo || constraint_idx > hi)
				continue;
			const double right = road_width_zones_[i + 2];
			const double left = road_width_zones_[i + 3];
			if (right > 0.0)
				right_limit = std::min(right_limit, right);
			if (left > 0.0)
				left_limit = std::min(left_limit, left);
			return;   // 먼저 매칭된 구간만 적용
		}
	}

	void applyIdxRoadWidth()
	{
		const int constraint_idx = primary_obstacle_idx_ >= 0
			? primary_obstacle_idx_ : current_waypoint_idx_;
		roadWidthLimitsForIdx(constraint_idx, MAX_ROAD_WIDTH_RIGHT,
			MAX_ROAD_WIDTH_LEFT);
		if (constraint_idx < 0)
			return;
		for (std::size_t i = 0; i + 3 < road_width_zones_.size(); i += 4)
		{
			const int lo = static_cast<int>(road_width_zones_[i]);
			const int hi = static_cast<int>(road_width_zones_[i + 1]);
			if (constraint_idx < lo || constraint_idx > hi)
				continue;
			ROS_INFO_THROTTLE(1.0,
				"[obstacle_avoidance] road width by obstacle idx %d (ego idx %d) "
				"in zone [%d,%d] -> right=%.2f left=%.2f",
				constraint_idx, current_waypoint_idx_, lo, hi,
				MAX_ROAD_WIDTH_RIGHT, MAX_ROAD_WIDTH_LEFT);
			return;
		}
	}

	bool lastPathStillClear()
	{
		if (last_path_.get_x().empty())
			return false;
		if (latest_ob_x_.empty())
			return true;   // 볼 장애물이 없으면 판단 근거도 없다
		FrenetPath probe = last_path_;
		return probe.collision_fraction(latest_ob_x_, latest_ob_y_,
										ROBOT_RADIUS) <= 1e-9;
	}

	bool canContinueCommittedPass()
	{
		if (committed_avoid_side_ == 0 || last_path_.get_x().empty() ||
			latest_ob_x_.empty())
			return false;

		const double c = std::cos(bot_yaw_);
		const double s = std::sin(bot_yaw_);
		double max_forward = -1.0e9;
		for (size_t i = 0; i < latest_ob_x_.size(); ++i)
		{
			const double dx = latest_ob_x_[i] - pose_x_;
			const double dy = latest_ob_y_[i] - pose_y_;
			max_forward = std::max(max_forward, c * dx + s * dy);
		}
		return max_forward <= side_pass_continue_front_m_;
	}

	// ---------------- 계획 루프 ----------------
	void planLoop(const ros::TimerEvent &)
	{
		// duration 만료(speed_kick_active_ -> false)가 카메라 재감지 없이도 제때
		// 반영되도록 10Hz로 주기적으로도 호출. (즉시 트리거는 cameraDetectionCallback)
		updateSpeedKick();

		if (!have_path_ || !have_odom_ || !csp_)
			return;

		double s0, c_speed, c_d, c_d_d, c_d_dd;
		FrenetPath dummy;
		int min_id = initial_conditions_new(*csp_, global_s_, rx_, ry_, rk_, ryaw_,
								s0, c_speed, c_d, c_d_d, c_d_dd,
								bot_yaw_, pose_x_, pose_y_, dummy, bot_speed_);

		double yaw_err = 0.0;
		if (min_id >= 0 && min_id < static_cast<int>(ryaw_.size()))
		{
			yaw_err = bot_yaw_ - ryaw_[min_id];
			while (yaw_err > M_PI) yaw_err -= 2.0 * M_PI;
			while (yaw_err < -M_PI) yaw_err += 2.0 * M_PI;
		}

		std_msgs::Float64 frenet_d_msg;
		frenet_d_msg.data = c_d;
		frenet_d_pub_.publish(frenet_d_msg);

		if (tunnel_wall_offset_valid_ && (ros::Time::now() - last_tunnel_offset_stamp_).toSec() > 0.5)
		{
			tunnel_lateral_offset_ *= 0.85;
			if (std::abs(tunnel_lateral_offset_) < 0.01)
			{
				tunnel_lateral_offset_ = 0.0;
				tunnel_wall_offset_valid_ = false;
			}
		}

		// M2/M3(정적/동적 회피)는 0.csv 전용 미션이다. 고주로 차선(1/2/3.csv)에서는
		// 회피 대상도 없고 SMPC가 속도를 전담하므로, 여기서 감속(TARGET_SPEED=6.0)이나
		// 회피 경로 계산을 걸면 안 된다 - 걸리면 mpc_path_tracking이 min()으로 그대로
		// 받아서 SMPC ACC 목표(최대 25.0)를 무시하고 6.0에 갇힌다. 다만 이 노드가
		// use_avoidance:=true 방식에서 /local_path의 유일한 발행자이므로, 그냥 return
		// 하면 고주로 차선에서 /local_path 자체가 끊겨 MPC가 옛 경로에 멈춘다 -
		// 반드시 기준경로(새 CSV 중심선) 패스스루는 계속 내보낸다.
		if (current_lane_number_ != 0 && !tunnel_mode_)
		{
			publishAvoidanceFailed(false);
			publishAvoidanceSpeedLimit(false);
			publishPassthroughPath(s0);
			return;
		}
		if (tunnel_mode_ && (tunnel_unresolved_ ||
			(!observation_stamp_.isZero() && (ros::Time::now()-observation_stamp_).toSec() > 1.0)))
		{
			publishAvoidanceFailed(true);
			return;
		}

		// 정적 회피 구간(M2: static_zone_min_idx_ ~ static_dynamic_split_idx_) 외의
		// 구간(신호등 M1, 동적 장애물 M3, 신호등 M4, 회전교차로 M5 등)에서는 회피/감속을
		// 절대 걸지 않는다. 코너 등에서 |c_d| > 0.3m 편차만 보고 회피 중(6.0m/s, 21.6km/h)으로
		// 오인해 감속하는 현상을 원천 방지한다.
		const bool outside_static_zone = (current_waypoint_idx_ >= 0) &&
			((static_zone_min_idx_ >= 0 && current_waypoint_idx_ < static_zone_min_idx_) ||
			 (static_dynamic_split_idx_ >= 0 && current_waypoint_idx_ > static_dynamic_split_idx_));
		if (outside_static_zone && !tunnel_mode_)
		{
			latest_ob_x_.clear();
			latest_ob_y_.clear();
			last_obstacle_length_ = 0.0;
			committed_avoid_side_ = 0;
			resetAvoidanceFailureState();
			publishAvoidanceFailed(false);
			publishAvoidanceSpeedLimit(false);  // 평소 주행: 9999.0 m/s
			publishPassthroughPath(s0);
			return;
		}

		// 장애물이 없어졌다고 바로 기준경로(centerline)로 넘어가면, 아직 옆으로
		// 밀려나 있는 차 입장에선 목표 경로가 순간적으로 뚝 끊겨서 MPC가 급하게
		// 꺾어 복귀하게 됨(복귀 오실의 원인). 실제로 거의 중앙(|c_d| 작음)까지
		// 돌아왔을 때만 패스스루로 전환하고, 그 전까지는 장애물 없이도 Frenet을
		// 장애물이 없어졌다고 바로 기준경로(centerline)로 넘어가면, 아직 옆으로
		// 밀려나 있는 차 입장에선 목표 경로가 순간적으로 뚝 끊겨서 MPC가 급하게
		// 꺾어 복귀하게 됨(복귀 오실의 원인).
		// 횡방향 편차(|c_d|)가 작을 뿐만 아니라, 차체 헤딩 오차(|yaw_err|)도 정렬되었을 때만
		// 패스스루로 전환하고, 그 전까지는 Frenet 5차 다항식(d_dot=0 조건)이 끝까지 부드럽게 자세를 정렬하도록 한다.
		const double kReturnToCenterThreshold = 0.3;  // m
		const double kReturnHeadingThreshold = return_heading_threshold_deg_ * M_PI / 180.0;
		const bool return_aligned = (std::abs(c_d) < kReturnToCenterThreshold) &&
		                            (std::abs(yaw_err) < kReturnHeadingThreshold);
		const bool return_dead_center = (std::abs(c_d) < 0.10);

		if (latest_ob_x_.empty() && (return_aligned || return_dead_center))
		{
			last_obstacle_length_ = 0.0;  // 복귀 완전히 끝남 - 다음 물체를 위해 리셋
			committed_avoid_side_ = 0;    // 회피 완전히 끝남 - 방향 락 리셋
			resetAvoidanceFailureState();
			publishAvoidanceFailed(false);
			publishAvoidanceSpeedLimit(false);  // 평소 주행: 속도 제한 없음
			publishPassthroughPath(s0);
			return;
		}

		// 회피 탐색이든 복귀든, 이 지점에 도달했으면 아직 "회피 중"이므로
		// target_speed로 감속 요청. mpc_path_tracking이 min(ref_v, 이 값)으로 적용.
		publishAvoidanceSpeedLimit(true);

		FrenetPath path;
		if (latest_ob_x_.empty())
		{
			// 장애물은 없는데 아직 옆으로 밀려나 있는 상태(|c_d| >= threshold).
			// 회피용 짧은 시간범위(mint~maxt) 기반 비용 탐색을 쓰면 "제자리 유지"가
			// 항상 이겨서 안 돌아오므로, 훨씬 긴 고정 시간으로 직접 부드러운
			// 복귀 경로를 만든다 (비용 탐색 자체를 우회).
			// 방금까지 피하던 물체의 길이에 비례해서 복귀시간을 줄이되,
			// 횡방향 이탈량(|c_d|)이 클 때도 그에 비례하여 복귀시간을 확장한다.
			// 3m 이상 크게 회피한 뒤 3초 만에 무리하게 파고드는(-13도 급다이브)
			// 현상과 그 반동으로 인한 복귀 후 오실레이션을 원천 차단한다.
			double length_ratio = last_obstacle_length_ / return_ti_ref_length_;
			length_ratio = std::min(1.0, std::max(0.0, length_ratio));
			double base_return_ti = return_ti_ * length_ratio;
			double lat_return_ti = std::abs(c_d) * return_lat_time_scale_;
			double effective_return_ti = std::max(min_return_ti_, std::max(base_return_ti, lat_return_ti));
			effective_return_ti = std::min(return_ti_ * 1.2, effective_return_ti);

			const double effective_c_d = (tunnel_mode_ && tunnel_wall_offset_valid_)
				? (c_d - tunnel_lateral_offset_) : c_d;

			Fplist fpl(c_speed, effective_c_d, c_d_d, c_d_dd, s0);
			path = fpl.calc_direct(0.0, effective_return_ti, TARGET_SPEED);
			path.adding_global_path(*csp_);
		}
		else
		{
			// 회피 커밋 상태를 플래너에 넘긴다. 커밋 중이면 '이전보다 중앙에
			// 가까운' 후보가 후보 목록에서 아예 빠져서, d=0 이 간헐적으로
			// 살아나 회피량이 튀는 일이 없어진다(src_최적 local_planner 방식).
			// 좌우 비대칭 회피 폭. 좌측은 중앙선을 넘는 방향이라, 대향 차량이
			// 보이면 자기 차로 안으로만 피한다.
			MAX_ROAD_WIDTH_LEFT = oncomingBlocked()
				? max_road_width_left_blocked_ : max_road_width_left_;
			MAX_ROAD_WIDTH_RIGHT = tunnel_mode_ ? 1.5 : max_road_width_right_;
			// ★ 연석이 보이면 그쪽 상한을 연석 안쪽까지로 좁힌다.
			//   고정값(우 3.5 / 좌 4.5)은 '1차선 옆이 연석' 구간과 '삼거리라
			//   옆이 트인' 구간을 구분하지 못한다. 실측 2026-09-21(18:59:20
			//   백): 연석이 경로 우측 2.42~2.48m 에 정상 검출됐는데도 폭
			//   0.35 짜리 작은 원으로 모델링돼 플래너가 그 위로 경로를 그렸고,
			//   차체 우측이 연석 안쪽 2.6m 까지 들어간 채 2.4초를 달렸다
			//   (6주행 중 3회). 연석이 안 보이면 인지가 값을 안 보내므로
			//   기존 고정값이 그대로 남아 삼거리에서는 넓게 쓸 수 있다.
			// ★ 구간별 회피 폭 상한. csv idx 로 지정한다.
			//   인지로 연석을 찾아 폭을 자동 산출하는 방식은 실주행에서
			//   한 번도 발동하지 않았다(3주행 0/194, 0/160, 0/165 - 백
			//   재생에서는 29~56 프레임 나왔는데 실차에서만 0이라
			//   원인을 특정하지 못했다). 연석 위치는 코스가 고정이라
			//   idx 로 주는 편이 확실하고 검증도 쉽다.
			//   형식: [idx_start, idx_end, right_m, left_m] 의 반복.
			//   겹치면 먼저 매칭된 구간을 쓴다. 해당 구간이 없으면
			//   기존 고정값(max_road_width_right/left)을 그대로 쓴다.
			applyIdxRoadWidth();
			AVOID_LOCK_SIDE = committed_avoid_side_;
			AVOID_PREV_OFFSET = last_path_.get_d().empty()
				? 0.0 : last_path_.get_d().back();
			AVOID_INWARD_MARGIN = avoid_inward_margin_;
			// 회피량 최소화: 충돌 안 나는 후보 중 가장 안쪽을 고르게 한다.
			AVOID_EXCESS_COST = avoid_excess_cost_;
			AVOID_SIDE_FLIP_COST = avoid_side_flip_cost_;
			const double effective_c_d = (tunnel_mode_ && tunnel_wall_offset_valid_)
				? (c_d - tunnel_lateral_offset_) : c_d;
			vecD planning_ob_x = latest_ob_x_;
			vecD planning_ob_y = latest_ob_y_;
			if (tunnel_mode_ && tunnel_wall_offset_valid_ && !planning_ob_x.empty())
			{
				const double shift = tunnel_lateral_offset_;
				for (size_t i = 0; i < planning_ob_x.size(); ++i)
				{
					planning_ob_x[i] += shift * std::sin(bot_yaw_);
					planning_ob_y[i] -= shift * std::cos(bot_yaw_);
				}
			}
			path = frenet_optimal_planning(*csp_, s0, c_speed, effective_c_d, c_d_d, c_d_dd,
											last_path_, pose_x_, pose_y_,
											planning_ob_x, planning_ob_y, bot_yaw_,
											committed_avoid_side_, preferred_avoid_side_,
											avoid_side_preference_cost_);
			AVOID_LOCK_SIDE = 0;   // 다른 경로(복귀 등)에는 영향 주지 않는다
			MAX_ROAD_WIDTH_LEFT = 0.0;   // 0 = 대칭(MAX_ROAD_WIDTH) 로 복귀
			MAX_ROAD_WIDTH_RIGHT = 0.0;
		}

		if (path.get_x().empty())
		{
			// 낡은 경로를 재발행하기 전에 반드시 현재 기하로 재검증한다.
			if (canContinueCommittedPass() && lastPathStillClear())
			{
				resetAvoidanceFailureState();
				publishAvoidanceFailed(false);
				ROS_WARN_THROTTLE(0.5,
					"[obstacle_avoidance] no new candidate beside obstacle; "
					"continuing committed previous path");
				publishLocalPath(last_path_);
				return;
			}
			const bool request_stop = registerAvoidanceFailure();
			ROS_WARN_THROTTLE(0.3,
				"[obstacle_avoidance] no collision-free path found "
				"(independent lidar failures %d/%d) -> %s",
				avoidance_fail_count_, max_avoidance_fail_observations_,
				request_stop ? "requesting STOP" : "holding previous path");

			if (request_stop)
			{
				publishAvoidanceFailed(true);
				return;
			}
			// 1~2사이클 일시적 기각 시 직전 경로가 유효하면 유지하여 순간 급정지 방지.
			// 단 '유효'는 현재 기하로도 충돌이 없다는 뜻이어야 한다. 검출 흔들림
			// 때문에 잠깐 후보가 빈 경우만 이 완충이 의미가 있고, 장애물이
			// 실제로 경로를 막은 경우에는 여기서 버텨봐야 충돌로 이어진다.
			if (lastPathStillClear())
			{
				publishLocalPath(last_path_);
				return;
			}
			ROS_WARN_THROTTLE(0.3,
				"[obstacle_avoidance] previous path no longer clears current "
				"obstacle geometry -> requesting STOP instead of reusing it");
			publishAvoidanceFailed(true);
			return;
		}

		double chosen_d = path.get_d().empty() ? 0.0 : path.get_d().back();
		// 회피 방향 락-인(Lock-in): 한번 회피 방향(좌/우)이 결정되면 장애물을 완전히 통과할 때까지 유지
		if (committed_avoid_side_ == 0 && std::abs(chosen_d) >= 0.35)
		{
			committed_avoid_side_ = (chosen_d > 0.0) ? 1 : -1;
			// 부호 규약: adding_global_path 가 fx = ix - d*sin(yaw) 이므로
			// d > 0 이 진행방향 '좌측' 이다. 예전 로그는 이걸 RIGHT 로 찍고
			// 있어서 실측(장애물 우측 -1.6m -> d_end +3.25)과 반대로 보였다.
			ROS_INFO("[obstacle_avoidance] Committed avoidance direction locked to: %s (d_end=%.2f)",
				committed_avoid_side_ > 0 ? "LEFT" : "RIGHT", chosen_d);
		}

		double max_c = 0.0;
		for (double c : path.get_c())
			max_c = std::max(max_c, std::abs(c));

		ROS_INFO_THROTTLE(0.3, "[obstacle_avoidance] DEBUG path found: d_end=%.2f max_curvature=%.3f",
			path.get_d().empty() ? 0.0 : path.get_d().back(), max_c);

		if (max_c > curvature_limit_)
		{
			if (canContinueCommittedPass())
			{
				resetAvoidanceFailureState();
				publishAvoidanceFailed(false);
				publishLocalPath(last_path_);
				return;
			}
			const bool request_stop = registerAvoidanceFailure();
			ROS_WARN_THROTTLE(0.5,
				"[obstacle_avoidance] rejected path: curvature %.2f > limit %.2f "
				"(independent lidar failures %d/%d), keeping previous path",
				max_c, curvature_limit_, avoidance_fail_count_,
				max_avoidance_fail_observations_);
			if (request_stop)
			{
				publishAvoidanceFailed(true);
				return;
			}
			if (!last_path_.get_x().empty())
			{
				publishLocalPath(last_path_);
				return;
			}
			publishAvoidanceFailed(true);
			return;
		}

		// 경로 생성 성공 시 실패 카운터 리셋 및 정상 상태 발행
		resetAvoidanceFailureState();
		publishAvoidanceFailed(false);

		// 매 사이클 새로 비용 탐색을 하다보니(회피 탐색 중일 때) 장애물 위치
		// 추정이 조금만 흔들려도 목표 d가 프레임 간 크게 튈 수 있음.
		// 이건 회피 탐색(latest_ob_x_가 비어있지 않을 때)에만 적용한다 - 복귀
		// 경로(calc_direct)는 이미 실제 차량의 현재 상태(c_d)에서 시작하는
		// 별도 길이(3.5s)의 부드러운 곡선이라, 회피 탐색(2.0s)의 종점 d와
		// 직접 비교하면 길이가 다른 경로끼리 비교하는 셈이라 항상 "많이 튄
		// 것"으로 오판돼서 복귀 경로가 영원히 거부되는 버그가 있었음
		// (그 결과 마지막 회피 경로에 계속 붙잡혀서 최대조향이 안 풀림).
		if (!latest_ob_x_.empty() && !primary_changed_for_plan_)
		{
			double last_d = last_path_.get_d().empty() ? 0.0 : last_path_.get_d().back();
			double new_d = path.get_d().empty() ? 0.0 : path.get_d().back();

			// 회피 방향이 확정되어 있을 경우, 반대 방향으로 튀는 경로를 엄격히 차단 (좌우 뒤집힘 방지)
			if (committed_avoid_side_ != 0 && committed_avoid_side_ * new_d < -0.15)
			{
				ROS_WARN_THROTTLE(0.5,
					"[obstacle_avoidance] rejected side flip from committed %s to new_d=%.2f, preserving last_d=%.2f",
					committed_avoid_side_ > 0 ? "LEFT" : "RIGHT", new_d, last_d);
				new_d = last_d;
			}

			bool moving_toward_center = std::abs(new_d) < std::abs(last_d);

			double clamp_step = 0.0;
			bool need_clamp = false;
			if (moving_toward_center && std::abs(new_d - last_d) > max_d_step_per_cycle_)
			{
				need_clamp = true;
				clamp_step = max_d_step_per_cycle_;
				ROS_WARN_THROTTLE(0.5,
					"[obstacle_avoidance] d jump %.2f -> %.2f exceeds max_d_step_per_cycle=%.2f, clamping instead of freezing",
					last_d, new_d, max_d_step_per_cycle_);
			}
			// 회피(멀어지는) 방향은 원래 위험 반응 늦추지 않으려고 제한이 없었는데,
			// 이미 어느 정도 피하고 있는 상태(|last_d|가 어느 정도 있음)에서 장애물
			// 크기 재추정(max-hold)이나 위치 노이즈 때문에 매 사이클 조금씩 더
			// 필요하다고 판단해서 계속 야금야금 더 꺾여나가는 문제가 있었음.
			// 최초 반응(작은 |last_d|에서 시작)은 그대로 즉시 허용하되, 이미 어느
			// 정도 피하고 있는 중이면 한 사이클에 너무 크게 더 밀려나가는 것만 제한.
			else if (!moving_toward_center && std::abs(last_d) > 0.3 &&
				std::abs(new_d - last_d) > max_d_step_outward_per_cycle_)
			{
				need_clamp = true;
				clamp_step = max_d_step_outward_per_cycle_;
				ROS_WARN_THROTTLE(0.5,
					"[obstacle_avoidance] outward d jump %.2f -> %.2f exceeds max_d_step_outward_per_cycle=%.2f, clamping instead of freezing",
					last_d, new_d, max_d_step_outward_per_cycle_);
			}

			if (need_clamp)
			{
				// 예전엔 여기서 그냥 거부하고 이전 경로를 유지했는데, last_path_가
				// 갱신 안 되니까 다음 사이클에도 똑같은 "옛날 기준" 대비 초과로
				// 계속 거부되면서 d가 영원히 그 자리에 멈춰버리는 버그가 있었음
				// (필요한 회피 여유가 계속 커지는 상황에서 못 따라가 결국 충돌).
				// 거부 대신 허용된 만큼만 이동시켜서, 느리더라도 매 사이클 확실히
				// 목표에 가까워지도록(clamp) 한다.
				double clamped_d = last_d + (new_d > last_d ? clamp_step : -clamp_step);
				// 만약 committed_avoid_side_가 걸려있다면 clamped_d가 장애물 중앙(d=0)으로 침범하지 못하게 방어
				if (committed_avoid_side_ < 0 && clamped_d > -0.2) clamped_d = -0.2;
				if (committed_avoid_side_ > 0 && clamped_d < 0.2) clamped_d = 0.2;
				Fplist fpl(c_speed, c_d, c_d_d, c_d_dd, s0);
				FrenetPath clamped_path = fpl.calc_direct(clamped_d, MINT, TARGET_SPEED);
				clamped_path.adding_global_path(*csp_);
				if (!clamped_path.get_x().empty())
					path = clamped_path;
			}
		}

		publishAvoidanceFailed(false);
		last_path_ = path;
		publishLocalPath(path);
		primary_changed_for_plan_ = false;
	}

	void publishAvoidanceFailed(bool failed)
	{
		std_msgs::Bool msg;
		msg.data = failed;
		avoidance_failed_pub_.publish(msg);
	}

	// active=true: available longitudinal distance and the spatial S-curve's
	// lateral acceleration/jerk limits determine the speed cap. A far proposal
	// leaves M2 at its section speed; a late detection reduces speed only as much
	// as needed to finish the same geometric transition before the obstacle.
	// active=false: 사실상 무제한 값(9999)을 보내 mpc 쪽 min()에서 걸리지 않게 함.
	void publishAvoidanceSpeedLimit(bool active)
	{
		std_msgs::Float64 msg;
		double cap = TARGET_SPEED;
		double live_forward = nearest_trigger_forward_m_;
		if (active && !latest_ob_x_.empty())
		{
			const double c = std::cos(bot_yaw_), s = std::sin(bot_yaw_);
			for (size_t i = 0; i < latest_ob_x_.size(); ++i)
			{
				const double forward = c * (latest_ob_x_[i] - pose_x_) +
					s * (latest_ob_y_[i] - pose_y_);
				if (forward > 0.0) live_forward = std::min(live_forward, forward);
			}
		}
		if (active && dynamic_speed_cap_enabled_ && live_forward < 1e17)
		{
			const double required_shift = std::max(0.5,
				std::min(std::abs(primary_obstacle_min_d_ - ROBOT_RADIUS),
					std::abs(primary_obstacle_max_d_ + ROBOT_RADIUS)));
			const double ta = std::sqrt(5.774 * required_shift /
				std::max(0.1, SPATIAL_MAX_LAT_ACCEL));
			const double tj = std::cbrt(60.0 * required_shift /
				std::max(0.1, SPATIAL_MAX_LAT_JERK));
			const double transition_t = std::max(0.8, std::max(ta, tj));
			const double available = std::max(0.0,
				live_forward - avoidance_front_clearance_m_);
			const double feasible_speed = avoidance_speed_safety_factor_ *
				available / transition_t;
			cap = std::max(avoidance_min_speed_mps_, std::min(TARGET_SPEED, feasible_speed));
			ROS_INFO_THROTTLE(0.5,
				"[obstacle_avoidance] spatial speed cap %.2fm/s "
				"(obstacle %.1fm, shift %.2fm, transition %.2fs)",
				cap, live_forward, required_shift, transition_t);
		}
		msg.data = active ? cap : 9999.0;
		avoidance_speed_pub_.publish(msg);
	}

	// 장애물 없을 때: 기준경로(rx_, ry_, ryaw_)에서 현재 s0부터
	// passthrough_length_m_ 만큼만 잘라서 그대로 /local_path로 publish.
	void publishPassthroughPath(double s0)
	{
		size_t start_idx = 0;
		for (size_t i = 0; i < global_s_.size(); ++i)
		{
			if (global_s_[i] >= s0)
			{
				start_idx = i;
				break;
			}
		}

		nav_msgs::Path msg;
		msg.header.stamp = ros::Time::now();
		msg.header.frame_id = "map";

		const double shift = (tunnel_mode_ && tunnel_wall_offset_valid_) ? tunnel_lateral_offset_ : 0.0;

		const double s_end = s0 + passthrough_length_m_;
		for (size_t i = start_idx; i < rx_.size() && global_s_[i] <= s_end; ++i)
		{
			geometry_msgs::PoseStamped ps;
			ps.header = msg.header;
			double yaw = (i < ryaw_.size()) ? ryaw_[i] : 0.0;
			ps.pose.position.x = rx_[i] - shift * std::sin(yaw);
			ps.pose.position.y = ry_[i] + shift * std::cos(yaw);
			tf::Quaternion q = tf::createQuaternionFromYaw(yaw);
			ps.pose.orientation.x = q.x();
			ps.pose.orientation.y = q.y();
			ps.pose.orientation.z = q.z();
			ps.pose.orientation.w = q.w();
			msg.poses.push_back(ps);
		}

		// 경로 끝(마지막 waypoint 도달)에서는 되감기 금지.
		//
		// 아래 4점 백필은 "아직 앞에 경로가 남아 있는데 슬라이스가 짧게 잘린"
		// 경우를 위한 방어다. 그런데 전역 경로의 마지막 점까지 소진한 뒤에도
		// 되감아 4점을 채우면 /local_path 가 0 으로 줄지 않고 4 에서 멈춘다.
		// MPC 의 path-end 정지는 waypoints_size_ < path_end_min_polyfit_points_(4)
		// 일 때만 발동하므로(mpc_path_tracking.h), 4 에서 멈추면 정지가 영원히
		// 발동하지 않는다.
		//   실측(2026-09-15 18:01 백, 3.csv 종단): t=366.0 에 마지막 waypoint 도달
		//   -> lp=4 로 고정 -> 5 초간 brake=0, accel 0.06~0.14 로 14.9 m/s 주행
		//   -> 백 종료까지 미정지.
		// 남은 점이 4 개 미만이면 그대로(0~3점) 내보내 MPC 가 정지하게 한다.
		const bool reached_path_end = (start_idx + 4 > rx_.size());
		if (msg.poses.size() < 4 && rx_.size() >= 4 && !reached_path_end)
		{
			msg.poses.clear();
			size_t safe_start = start_idx;
			for (size_t i = safe_start; i < rx_.size(); ++i)
			{
				geometry_msgs::PoseStamped ps;
				ps.header = msg.header;
				double yaw = (i < ryaw_.size()) ? ryaw_[i] : 0.0;
				ps.pose.position.x = rx_[i] - shift * std::sin(yaw);
				ps.pose.position.y = ry_[i] + shift * std::cos(yaw);
				tf::Quaternion q = tf::createQuaternionFromYaw(yaw);
				ps.pose.orientation.x = q.x();
				ps.pose.orientation.y = q.y();
				ps.pose.orientation.z = q.z();
				ps.pose.orientation.w = q.w();
				msg.poses.push_back(ps);
			}
		}

		local_path_pub_.publish(msg);
	}

	void publishLocalPath(FrenetPath &path)
	{
		nav_msgs::Path msg;
		msg.header.stamp = ros::Time::now();
		msg.header.frame_id = "map";

		vecD xs = path.get_x();
		vecD ys = path.get_y();
		vecD yaws = path.get_yaw();

		const double shift = (tunnel_mode_ && tunnel_wall_offset_valid_) ? tunnel_lateral_offset_ : 0.0;

		for (size_t i = 0; i < xs.size(); ++i)
		{
			geometry_msgs::PoseStamped ps;
			ps.header = msg.header;
			double yaw = (i < yaws.size()) ? yaws[i] : 0.0;
			ps.pose.position.x = xs[i] - shift * std::sin(yaw);
			ps.pose.position.y = ys[i] + shift * std::cos(yaw);
			tf::Quaternion q = tf::createQuaternionFromYaw(yaw);
			ps.pose.orientation.x = q.x();
			ps.pose.orientation.y = q.y();
			ps.pose.orientation.z = q.z();
			ps.pose.orientation.w = q.w();
			msg.poses.push_back(ps);
		}

		local_path_pub_.publish(msg);
	}

