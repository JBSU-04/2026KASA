class Fplist
{
public:
	Fplist(double c_speed, double c_d, double c_d_d, double c_d_dd, double s0);
	FrenetPath calc_lat(double di, double Ti, double Di_d);
	FrenetPath calc_lon(double tv, double Ti);
	// 비용 후보군 탐색(calc()) 없이, 지정한 di/Ti/tv 하나로 바로 경로를 만든다.
	// 장애물이 없어져서 중앙으로 복귀할 때, 회피용으로 짧게 잡은 시간범위(mint~maxt)
	// 안에서 탐색하면 큰 offset을 짧은 시간에 되돌리는 candidate의 jerk 비용이
	// 너무 커서 항상 "제자리 유지"가 이겨버림. 복귀는 급하지 않으니 훨씬 긴
	// Ti를 직접 지정해서 부드럽게 복귀하는 경로를 강제로 만들기 위함.
	FrenetPath calc_direct(double di, double Ti, double tv);
	// Quintic smooth-step in longitudinal arc length. The transition length is
	// derived from lateral acceleration/jerk limits and current speed.
	FrenetPath calc_spatial(double di, bool gentle = true);
	// targets[0] 은 지금 바로, targets[k] 는 starts[k](절대 s) 이후에 가는 오프셋.
	// 전환 길이는 calc_spatial 과 같은 횡가속/저크 규칙으로 정한다.
	// gentle=false 는 현재 속도로 전환 길이를 잡는 예비 후보(SPATIAL_LENGTH_MIN_SPEED 주석).
	FrenetPath calc_spatial_stages(const std::vector<double> &targets,
		const std::vector<double> &starts, bool gentle = true);
	void copy(int i);
	void calc_cost(int i);

	double c_speed;
	double c_d;
	double c_d_d;
	double c_d_dd;
	double s0;
	std::vector<FrenetPath> fplist_lat;
	std::vector<FrenetPath> fplist_lon;
	int samples_tv = 2 * N_S_SAMPLE;
};

