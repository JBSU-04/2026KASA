<launch>
  <!-- 우리 경로 기준값은 total_bringup 에서 넘긴다. 1430 은 정동적 트리 자체 CSV 값. -->
  <arg name="static_dynamic_split_idx" default="1430" />
  <!-- 정적 회피 구간의 시작 idx. 음수면 하한 없음 == 정동적 원본 거동. -->
  <arg name="static_zone_min_idx" default="-1" />
  <arg name="dynamic_zone_max_idx" default="-1" />

  <!-- 속도 값의 단일 출처는 mpc_params.yaml(/speed_limit/*) 이다.
       아래 두 인자는 '실험용 일회성 오버라이드' 전용이라 기본값이 비어 있고,
       비어 있으면 param 을 아예 안 올려서 노드가 yaml 값을 쓴다.
         예: roslaunch ... target_speed:=4.0 -->
  <arg name="target_speed" default=""/>
  <arg name="speed_kick_target_kmh" default=""/>
  <arg name="tunnel_camera_kick_enabled" default="false"/>

  <node name="obstacle_avoidance_node" pkg="new_lane" type="obstacle_avoidance_node" output="screen" respawn="true">
    <param name="dynamic_zone_max_idx" value="$(arg dynamic_zone_max_idx)" />
    <param name="tunnel_camera_kick_enabled" value="$(arg tunnel_camera_kick_enabled)" />
    <!-- 음영구간(M8) 회피 (2026-09-26, 정적 구간 로직 기반).
         tunnel_max_road_width_left: 터널 좌측 벽(자차 기준 ~5.5 m) - 반폭 0.95 - 여유 0.35.
         tunnel_stage_candidates_enabled: 연속 장애물 다단(S자) 후보를 터널에서도 사용.
         높은 물체 12 m 가정은 벽 조각 오인 방지를 위해 터널에서 계속 끈다. -->
    <param name="tunnel_max_road_width_left" value="4.2" />
    <param name="tunnel_stage_candidates_enabled" value="true" />
    <!-- 카메라 장애물 선감속 구간 (2026-09-25): 동적 장애물 구간(M3, static_dynamic_split_idx
         초과)과 음영구간(터널, tunnel_camera_kick_enabled)에서만 건다.
         true 로 하면 정적 장애물 구간(M2)에서도 건다(예전 동작). -->
    <param name="camera_kick_static_zone_enabled" value="false" />

    <!-- 계획 주기 (MPC 20Hz와 동기화) -->
    <param name="plan_rate_hz" value="20.0" />
    <!-- 기준경로 스플라인 리샘플 간격(m).
         publishPassthroughPath 는 현재 s0 이후의 격자점부터 잘라 보내는데,
         격자는 고정이고 차량은 연속 이동하므로 이 값이 곧 경로 시작점의
         양자화 오차가 된다. 0.5m 일 때 24.7 m/s(프레임당 1.235m)에서 첫 점이
         1.0m / 1.5m 를 번갈아 이동했고(실측 2026-09-04 18:44 백), 그 ±0.235m
         떨림이 polyfit 계수를 매 프레임 바꿔 cte/epsi 를 진동시켰다.
         CSV 원본과 local_path_publisher 는 이미 0.1m 간격을 쓴다. -->
    <param name="spline_ds" value="0.1" />

    <!-- CSV 웨이포인트 idx 기준: 0~이 값은 정적 미션 구간(회피 활성), 이후는 동적
         미션 구간(obstacle_stop_node가 정지 전담이므로 이 노드는 회피 안 함) -->
    <param name="static_dynamic_split_idx" value="$(arg static_dynamic_split_idx)" />
    <param name="static_zone_min_idx" value="$(arg static_zone_min_idx)" />

    <!-- 장애물 관련성 필터 -->
    <!-- 회피 트리거 코리도(m). '장애물 몸통 가장자리 ~ 기준경로' 거리 기준이다.
         ★ 인지(obstacle_perception)의 path_corridor_half_width 와 반드시 같은
           값이어야 한다 - 같은 양을 재고, 인지가 이 기준으로 판정한
           in_trigger_corridor 태그를 여기서 그대로 쓴다. 한쪽만 고치면
           고친 쪽이 무시된다.
         예전엔 1.75(중심 기준, 차선 반폭 1.6+여유)였다. 중심 기준은 물체
         폭에 따라 판정이 흔들려서(폭 1.0m 이면 중심 1.75m = 가장자리 1.25m)
         가장자리 기준으로 통일했다. 1.4 는 차로 반폭(~1.6) 안쪽 값으로,
         robot_radius 와는 무관한 별개 손잡이다(그쪽은 충돌 간격). -->
    <param name="path_corridor_radius" value="1.5" />
    <!-- 충돌 검사용 코리도. 트리거(path_corridor_radius)보다 넓어야
         회피 경로가 지나가는 자리의 장애물이 프레넷에 보인다.
         ★ 상한은 인지의 1차 수집 폭(4.0)이다 - 그보다 크게 잡아도 그 밖의
           점은 인지 1차에서 이미 잘려 클러스터가 없다. 그래서 회피 폭
           max_road_width_left(4.5) 전체를 덮지는 못한다. -->
    <!-- 4.0 -> 7.0 (2026-09-23): 좌측 상한 5.5 에 맞춤(5.5 + 충돌반경 1.35 ≈ 6.9).
         인지 static 프로파일 수집폭 7.0 과 같은 값. -->
    <!-- 7.0 -> 7.5 (2026-09-25): 좌측 상한 6.0 에서 차체 좌측이 6.95 m 라
         그 바깥 물체까지 충돌 기하에 들어오게 넓힌다. -->
    <param name="collision_corridor_radius" value="7.5"/>
    <!-- |d| 1m 당 비용. "충돌 안 나는 후보 중 가장 안쪽"을 고르게 해서
         회피량을 최소화한다. 장애물 두 개 사이 틈이 차폭보다 넓으면 그 틈을
         지나는 경로가 |d| 가 작아 자연히 선택된다.
         cf(jerk 지배, ~45만)와 같은 규모여야 실제로 선택을 바꾸고,
         충돌 비용(2e7)보다는 훨씬 작아야 한다 - 크면 '부딪히더라도 안쪽으로'
         가 되어 버린다.
           실측 2026-09-09: 폭 1.3~1.4m 장애물에 d=-4.69m 까지 나갔다.
           kd*d^2 (kd=1.5) 는 d=4.7 에서 33점이라 45만에 완전히 묻혔다. -->
    <param name="avoid_excess_cost" value="3.0e5"/>
    <!-- 장애물의 실제 좌우 경계 + robot_radius 로 양쪽 통과에 필요한 d를
         계산한다. 도로 폭 안에서 가능한 쪽 중 이동량이 작은 방향을 우선하고,
         최종 안전 여부는 후보별 충돌 검사가 결정한다. -->
    <param name="avoid_side_preference_cost" value="4.0e6"/>
    <!-- primary 장애물 전환: 이전 장애물 중심을 2m 지난 뒤, 5m 이상 앞의
         다음 장애물로 바뀌면 기존 좌우 락을 풀어 각각 독립적으로 판단한다.
         CSV가 0.1m 간격이라 아래 값은 waypoint index 단위다. -->
    <param name="primary_release_behind_idx" value="20"/>
    <param name="primary_switch_min_idx" value="50"/>
    <!-- 3m 안에 붙어 검출된 조각/복수 장애물은 하나의 횡방향 점유 구간으로
         합쳐 빈틈을 잘못 통과 가능하다고 판단하지 않게 한다. -->
    <param name="primary_group_span_idx" value="30"/>
    <param name="obstacle_boundary_samples" value="8" /> <!-- 장애물 원둘레를 몇 개 점으로 근사할지 -->
    <param name="require_confirmed" value="true" />     <!-- 확정된 장애물만 사용 -->
    <!-- 복귀(중앙으로 가까워지는 이동)가 사이클당 이 값(m)보다 크게 튀면 거부하고
         이전 경로 유지 -> 복귀 오실 완화. -->
    <param name="max_d_step_per_cycle" value="0.4" />
    <!-- 회피(멀어지는) 방향은 최초 반응은 그대로 즉시 허용하되(|last_d|<=0.3일 땐
         제한 없음), 이미 어느 정도 피하고 있는 중엔 장애물 크기 재추정/노이즈
         때문에 야금야금 더 밀려나가지 않게 사이클당 이 값(m)으로 제한 -->
    <param name="max_d_step_outward_per_cycle" value="0.5" />
    <!-- 회피 방향이 커밋된 동안, '이전보다 중앙에 가까운' 후보를 프레넷
         후보 목록에서 아예 뺀다(src_최적 local_planner 와 같은 방식).
           실측 2026-09-08: 같은 장애물(경로 정중앙)에 d_end 가
           -3.50 / -0.50 / -3.25 / -0.25 로 매 프레임 왕복했다. 비용이
           KD*d^2 라 d=0 이 항상 최저인데, 경로점 기반 충돌검사가 차량이 조금
           움직일 때마다 통과/불통과를 오가면서 그 후보가 간헐적으로 살아난다.
           MPC 목표가 매 프레임 3m 씩 바뀌니 어느 쪽도 못 따라갔다.
         선택된 뒤에 되돌리는 방식(peak hold)은 기존 clamp 와 매 프레임
         상쇄돼서 실패했다 - 애초에 후보로 만들지 않는 편이 확실하다.
         이 값은 수치 흔들림 정도로 안쪽에 오는 것만 허용하는 여유(m)다.
         중앙 복귀는 장애물이 사라진 뒤 별도 복귀 경로가 담당한다. -->
    <param name="avoid_inward_margin" value="0.1" />

    <!-- ===== 좌우 비대칭 회피 폭 =====
         좌측(d>0, 진행방향 왼쪽)은 중앙선을 넘는 방향이라 물리적으로는 더
         넓게 쓸 수 있다. 다만 대향 차량이 있으면 안 되므로, /tracked_objects
         에서 좌측으로 다가오는 차량이 보이면 자기 차로 안으로만 피한다.
           실측 2026-09-08: 회피 계획은 d_end +3.25 로 안정적이었는데도 실차가
           장애물에 닿았다. 확보된 간격 중앙값 1.58m 로 필요치(1.60)에 못 미쳤다.
         부호 규약: adding_global_path 가 fx = ix - d*sin(yaw) 이므로 d>0 이 좌측. -->
    <!-- 4.5 -> 5.5 (2026-09-23): 좌측은 반대 차로라 여유를 둔다. 라이다 raw 로
         본 좌측 경계는 idx 2700~2774 의 6.09~6.50 m 둔덕(높이 0.4 m) 외에는
         9 m 안에 없다 - 그 구간만 road_width_zones 로 4.95 로 줄인다.
         인지 수집폭(static 프로파일)과 collision_corridor_radius 도 7.0 으로
         같이 넓혔다. 안 그러면 차가 가는 곳의 물체가 안 보인다. -->
    <!-- 5.5 -> 6.0 (2026-09-25): 구간별 좌측은 road_width_profile 이 정한다
         (연석 실측 - 1.10, 상한 6.0). 이 값은 프로파일 밖 구간의 기본값. -->
    <param name="max_road_width_left" value="6.0" />
    <!-- 대향 차량이 보일 때의 좌측 상한. 자기 차로(폭 3.2m)의 반 정도.
         ★ 2026-09-23: 터널(M8) 밖에서는 대향차량 판정을 끈다. 대회 규정상
           정적/동적 장애물 구간(M2/M3)에는 NPC 차량이 없는데, 켜 두면 노변
           구조물·오검출 트랙만으로 좌측 폭이 1.2 m 로 줄 수 있다.
           다시 켜려면 oncoming_check_outside_tunnel 을 true 로. -->
    <param name="max_road_width_left_blocked" value="1.2" />
    <param name="oncoming_check_outside_tunnel" value="false" />
    <!-- 신호+회피 안전 로직: 빨간불(정지 필요)인데 정지선 전이고, 회피+복귀가
         신호 정지 지점 전에 끝나지 않으면 회피를 시작하지 않고 차선 중앙을
         유지한다. 장애물이 정지선 근처면 초록불 뒤 정지 상태에서 회피할
         거리를 남기려고 base_link 가 장애물 앞 tl_hold_gap_m 에서 먼저 선다.
         14 -> 20 m (2026-09-23): 정지 상태 출발 회피에 여유를 더 둔다.
         ★ 정지 거리는 장애물이 기준경로를 침범한 정도에 따라 8~20 m 로 바뀐다.
           침범 정도 = 피하려면 옮겨야 하는 최소 횡거리(좌/우 중 작은 쪽).
             <= tl_gap_shift_min_m (0.35 m, 안쪽 끝이 경로에서 1 m 이상 벗어남) -> 8 m
             >= tl_gap_shift_max_m (1.85 m, 경로 중심을 0.5 m 넘게 덮음)       -> 20 m
             그 사이는 선형. -->
    <param name="tl_guard_enabled" value="true" />
    <!-- 회피 판단(회피 시작·방향 선택/고정·신호 정지 거리)은 물체 앞쪽 끝이
         이 거리 안에 들어온 추정부터 쓴다. 30 m 밖 원거리 추정은 흔들림이
         커서(저상물 안쪽 끝 0.67 m 번짐, 폭 0.98~2.50) 충돌 검사용으로만 둔다. -->
    <param name="decision_range_m" value="30.0" />
    <param name="tl_hold_gap_m" value="20.0" />
    <param name="tl_hold_gap_min_m" value="10.0" />
    <param name="tl_gap_shift_min_m" value="0.35" />
    <param name="tl_gap_shift_max_m" value="1.85" />
    <param name="max_road_width_right" value="3.5" />
    <!-- ★ 구간별 회피 폭 상한. [idx_start, idx_end, right_m, left_m] 의 반복.
         자차 현재 idx가 아니라 가장 가까운 다음 장애물의 idx를 사용한다.
         따라서 제한 구간 안의 버스를 미리 검출하면 진입 전부터 제한이 적용된다.
         1차선 옆이 연석인 구간과 삼거리처럼 트인 구간을 구분한다.
         right/left 를 0 이하로 두면 그 방향은 위 고정값을 그대로 쓴다.
         해당 구간이 없으면 전 구간 고정값(우 3.5 / 좌 4.5)이다.
         인지로 연석을 자동 탐지하는 방식은 실주행에서 한 번도 발동하지
         않아(3주행 0/194, 0/160, 0/165) idx 지정으로 바꿨다.
         실측 근거(2026-09-22, 09-21 19:31~19:32 주행 3건 점군 분석):
           저상(지면상대 0.06~0.45 m) 점 중 우측 1.5 m 밖에서 종방향으로
           연속된 선을 연석으로 보고, idx 구간별 횡거리를 집계했다.
             idx 2900~3125 : 2.35 ~ 3.65 m  (최소 2.35)
             idx 3125~3365 : 연속 선 미검출  -> 교차로, 우측 개방
             idx 3375~3450 : 1.65 ~ 2.35 m  (최소 1.65)
           상한 = 최소 연석거리 - 차체 반폭(0.95) - 여유(0.20).
         실측 이탈량: 같은 3주행에서 우측 최대 이탈이 A 0.15 / B 2.36 /
           C 3.19 m 였다. C 구간의 3.19 m 는 차체 우측이 연석 안쪽
           2.49 m 까지 들어간 값이며, 해당 주행(19:32:59)은 충돌이
           발생한 주행이다. 이 구간만 상한이 필요한 이유다.
         최신 두 주행(12:45:54, 12:46:27 heavy)도 직접 재실측했다.
         /groundgrid/ground 저상점(지면상대 0.025~0.20m)을 map으로 변환해
         0.csv 기준 횡거리로 투영한 결과:
           ego idx 2700~3000 : 우측 연속 경계 3.35~3.65m
           ego idx 3110~3300 : 연속 우측 경계 없음(개방 구간)
           ego idx 3350 부근 : 가장 가까운 우측 저상 경계 1.65m
         마지막 구간 중심 상한은 1.65 - 차체반폭 0.95 - 여유 0.20 = 0.50m.
         따라서 [3365,3700]의 0.50m를 유지한다. 앞 구간 1.20m도 이번
         실측 상한 2.20m보다 보수적이고 기존 최소 관측 2.35m까지 포함해
         연석을 넘지 않는 값이므로 유지한다. -->
    <!-- 2026-09-22 재실측으로 1.20 / 0.50 -> 2.00 / 1.00 상향.
         이전 값은 오염된 측정에서 나왔다. 연석거리를 재던 주행(19:31,
         17:19:35)이 그 자신 우측으로 1.5 m 나가 있었고, 차체 옆 지면과
         연석면이 저상점으로 찍혀 '연석이 1.4~1.5 m 에 있다'로 읽혔다.
         세 주행을 나란히 놓으면 드러난다(idx 3400~3424, 5% 연석거리):
