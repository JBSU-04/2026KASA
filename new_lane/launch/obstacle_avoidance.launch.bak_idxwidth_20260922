<launch>
  <!-- 우리 경로 기준값은 total_bringup 에서 넘긴다. 1430 은 정동적 트리 자체 CSV 값. -->
  <arg name="static_dynamic_split_idx" default="1430" />
  <!-- 정적 회피 구간의 시작 idx. 음수면 하한 없음 == 정동적 원본 거동. -->
  <arg name="static_zone_min_idx" default="-1" />
  <arg name="dynamic_zone_max_idx" default="-1" />

  <!-- 속도 값의 단일 출처는 mpc_params.yaml(/speed_limit/*) 이다.
       아래 두 인자는 '실험용 일회성 오버라이드' 전용이라 기본값이 비어 있고,
       비어 있으면 param 을 아예 안 올려서 노드가 yaml 값을 쓴다.
         예: roslaunch ... target_speed:=4.0 -->
  <arg name="target_speed" default=""/>
  <arg name="speed_kick_target_kmh" default=""/>
  <arg name="tunnel_camera_kick_enabled" default="true"/>

  <node name="obstacle_avoidance_node" pkg="new_lane" type="obstacle_avoidance_node" output="screen" respawn="true">
    <param name="dynamic_zone_max_idx" value="$(arg dynamic_zone_max_idx)" />
    <param name="tunnel_camera_kick_enabled" value="$(arg tunnel_camera_kick_enabled)" />

    <!-- 계획 주기 (MPC 20Hz와 동기화) -->
    <param name="plan_rate_hz" value="20.0" />
    <!-- 기준경로 스플라인 리샘플 간격(m).
         publishPassthroughPath 는 현재 s0 이후의 격자점부터 잘라 보내는데,
         격자는 고정이고 차량은 연속 이동하므로 이 값이 곧 경로 시작점의
         양자화 오차가 된다. 0.5m 일 때 24.7 m/s(프레임당 1.235m)에서 첫 점이
         1.0m / 1.5m 를 번갈아 이동했고(실측 2026-09-04 18:44 백), 그 ±0.235m
         떨림이 polyfit 계수를 매 프레임 바꿔 cte/epsi 를 진동시켰다.
         CSV 원본과 local_path_publisher 는 이미 0.1m 간격을 쓴다. -->
    <param name="spline_ds" value="0.1" />

    <!-- CSV 웨이포인트 idx 기준: 0~이 값은 정적 미션 구간(회피 활성), 이후는 동적
         미션 구간(obstacle_stop_node가 정지 전담이므로 이 노드는 회피 안 함) -->
    <param name="static_dynamic_split_idx" value="$(arg static_dynamic_split_idx)" />
    <param name="static_zone_min_idx" value="$(arg static_zone_min_idx)" />

    <!-- 장애물 관련성 필터 -->
    <!-- 회피 트리거 코리도(m). '장애물 몸통 가장자리 ~ 기준경로' 거리 기준이다.
         ★ 인지(obstacle_perception)의 path_corridor_half_width 와 반드시 같은
           값이어야 한다 - 같은 양을 재고, 인지가 이 기준으로 판정한
           in_trigger_corridor 태그를 여기서 그대로 쓴다. 한쪽만 고치면
           고친 쪽이 무시된다.
         예전엔 1.75(중심 기준, 차선 반폭 1.6+여유)였다. 중심 기준은 물체
         폭에 따라 판정이 흔들려서(폭 1.0m 이면 중심 1.75m = 가장자리 1.25m)
         가장자리 기준으로 통일했다. 1.4 는 차로 반폭(~1.6) 안쪽 값으로,
         robot_radius 와는 무관한 별개 손잡이다(그쪽은 충돌 간격). -->
    <param name="path_corridor_radius" value="1.5" />
    <!-- 충돌 검사용 코리도. 트리거(path_corridor_radius)보다 넓어야
         회피 경로가 지나가는 자리의 장애물이 프레넷에 보인다.
         ★ 상한은 인지의 1차 수집 폭(4.0)이다 - 그보다 크게 잡아도 그 밖의
           점은 인지 1차에서 이미 잘려 클러스터가 없다. 그래서 회피 폭
           max_road_width_left(4.5) 전체를 덮지는 못한다. -->
    <param name="collision_corridor_radius" value="4.0"/>
    <!-- |d| 1m 당 비용. "충돌 안 나는 후보 중 가장 안쪽"을 고르게 해서
         회피량을 최소화한다. 장애물 두 개 사이 틈이 차폭보다 넓으면 그 틈을
         지나는 경로가 |d| 가 작아 자연히 선택된다.
         cf(jerk 지배, ~45만)와 같은 규모여야 실제로 선택을 바꾸고,
         충돌 비용(2e7)보다는 훨씬 작아야 한다 - 크면 '부딪히더라도 안쪽으로'
         가 되어 버린다.
           실측 2026-09-09: 폭 1.3~1.4m 장애물에 d=-4.69m 까지 나갔다.
           kd*d^2 (kd=1.5) 는 d=4.7 에서 33점이라 45만에 완전히 묻혔다. -->
    <param name="avoid_excess_cost" value="3.0e5"/>
    <param name="obstacle_boundary_samples" value="8" /> <!-- 장애물 원둘레를 몇 개 점으로 근사할지 -->
    <param name="require_confirmed" value="true" />     <!-- 확정된 장애물만 사용 -->
    <!-- 복귀(중앙으로 가까워지는 이동)가 사이클당 이 값(m)보다 크게 튀면 거부하고
         이전 경로 유지 -> 복귀 오실 완화. -->
    <param name="max_d_step_per_cycle" value="0.4" />
    <!-- 회피(멀어지는) 방향은 최초 반응은 그대로 즉시 허용하되(|last_d|<=0.3일 땐
         제한 없음), 이미 어느 정도 피하고 있는 중엔 장애물 크기 재추정/노이즈
         때문에 야금야금 더 밀려나가지 않게 사이클당 이 값(m)으로 제한 -->
    <param name="max_d_step_outward_per_cycle" value="0.5" />
    <!-- 회피 방향이 커밋된 동안, '이전보다 중앙에 가까운' 후보를 프레넷
         후보 목록에서 아예 뺀다(src_최적 local_planner 와 같은 방식).
           실측 2026-09-08: 같은 장애물(경로 정중앙)에 d_end 가
           -3.50 / -0.50 / -3.25 / -0.25 로 매 프레임 왕복했다. 비용이
           KD*d^2 라 d=0 이 항상 최저인데, 경로점 기반 충돌검사가 차량이 조금
           움직일 때마다 통과/불통과를 오가면서 그 후보가 간헐적으로 살아난다.
           MPC 목표가 매 프레임 3m 씩 바뀌니 어느 쪽도 못 따라갔다.
         선택된 뒤에 되돌리는 방식(peak hold)은 기존 clamp 와 매 프레임
         상쇄돼서 실패했다 - 애초에 후보로 만들지 않는 편이 확실하다.
         이 값은 수치 흔들림 정도로 안쪽에 오는 것만 허용하는 여유(m)다.
         중앙 복귀는 장애물이 사라진 뒤 별도 복귀 경로가 담당한다. -->
    <param name="avoid_inward_margin" value="0.1" />

    <!-- ===== 좌우 비대칭 회피 폭 =====
         좌측(d>0, 진행방향 왼쪽)은 중앙선을 넘는 방향이라 물리적으로는 더
         넓게 쓸 수 있다. 다만 대향 차량이 있으면 안 되므로, /tracked_objects
         에서 좌측으로 다가오는 차량이 보이면 자기 차로 안으로만 피한다.
           실측 2026-09-08: 회피 계획은 d_end +3.25 로 안정적이었는데도 실차가
           장애물에 닿았다. 확보된 간격 중앙값 1.58m 로 필요치(1.60)에 못 미쳤다.
         부호 규약: adding_global_path 가 fx = ix - d*sin(yaw) 이므로 d>0 이 좌측. -->
    <param name="max_road_width_left" value="4.5" />
    <!-- 대향 차량이 보일 때의 좌측 상한. 자기 차로(폭 3.2m)의 반 정도. -->
    <param name="max_road_width_left_blocked" value="1.2" />
    <param name="max_road_width_right" value="3.5" />

    <!-- 대향 차량 판정. /obstacle_info 는 경로 코리도(1.4m)로 걸러진 뒤라
         반대 차선이 안 올라온다 - TTC 트래커(roi_y_half 5.5m)를 쓴다. -->
    <param name="oncoming_check_range_m" value="45.0" />
    <param name="oncoming_min_closing_mps" value="2.0" />
    <!-- 좌측으로 이만큼 떨어진 트랙만 '대향 차선' 으로 본다(내 차로 제외). -->
    <param name="oncoming_min_lateral_m" value="1.5" />
    <!-- 한 번 보이면 이 시간 유지 - 순간 미검출로 회피 폭이 튀지 않게. -->
    <param name="oncoming_hold_sec" value="2.0" />
    <!-- 클러스터 파편화로 한 프레임만 장애물이 안 잡혀도(after_corridor=0) 바로
         복귀 모드로 전환되던 게 복귀 오실의 진짜 원인이었음 - 최근 이 시간(s)
         이내에 실제로 봤으면 이번 프레임이 비어도 마지막 목록을 유지 -->
    <!-- 버스처럼 크고 가까운 물체는 근접 시 라이다가 순간적으로 부분적으로만
         보이면서(occlusion) 트랙이 끊기고 새 ID로 재생성되는데, 그 새 트랙의
         위치추정이 한동안 부정확해서(dist_to_path가 corridor 제한을 훨씬
         벗어남) corridor 필터에 걸려 "관련 없음"으로 판정되는 공백이 1~2초 가까이
         생길 수 있음. 0.5초로는 그 공백을 못 버텨서 아직 옆에 있는 버스를
         "지나갔다"고 오판해 복귀하다가 뒷부분에 충돌했음 -> 넉넉히 늘림. -->
    <param name="obstacle_hold_sec" value="3.0" />
    <!-- 차체 후미(후축 기준 약 -2.5m) 완전히 뒤로 빠지기 전까지는 hold를 놓지 않는다.
         양수(+0.5m)로 두면 차체 옆(앞바퀴/조수석 도어)에 장애물이 있는데 즉시 복귀를
         시작해 차체 측면/후미로 장애물을 긁는 충돌이 발생함. -->
    <param name="passed_release_margin" value="-2.5" />
    <!-- 계획루프(20Hz)가 아니라 독립 라이다 관측(센서 설정 10Hz)을 기준으로
         3회 연속 실패해야 정지한다. 라이다 입력 자체가 끊기면 0.6초 뒤 정지. -->
    <param name="max_avoidance_fail_observations" value="3" />
    <param name="failure_no_observation_timeout_sec" value="0.6" />
    <!-- 회피 커밋 후 장애물의 가장 앞 경계가 차량 앞 1.5m 이내면,
         재계획 일시 실패 시 직전 유효 경로를 유지해 옆에서 급정지하지 않는다. -->
    <param name="side_pass_continue_front_m" value="1.5" />
    <!-- 복귀 경로를 완주하는 데 걸리는 시간(s). 짧으면 급하게 확 꺾여서 복귀 오실이
         심해짐 - 길게 잡아서 훨씬 완만하게(천천히) 복귀하도록 함 -->
    <param name="return_ti" value="6.0" />
    <!-- return_ti는 버스 기준 튜닝값(안 건드림). 짧은 물체는 이 길이(m) 미만이면
         비례해서 복귀시간을 줄여 "짧은 물체인데 계속 옆에 붙어서 천천히 복귀"하는
         과함을 줄인다. 이 값 이상 길이의 물체는 return_ti 그대로 적용. -->
    <param name="return_ti_ref_length" value="8.0" />
    <!-- 아무리 짧은 물체라도 복귀가 너무 급격해서 오실이 생기지 않도록 하는 하한(s) -->
    <!-- 2026-09-21 3차: 2.5 -> 2.0.
         17:25 백 실측: 이탈 3.9 s(26.9 m) 대비 복귀가 3.7 s 넘게 걸렸고
         백 종료(16.4 s)까지도 cte -0.15 로 안 끝났다.
         이 시점의 항별 값(최대이탈 1.62 m, 6.9 m/s):
             base_return_ti (물체길이 3.0 클램프) 2.25 s
             lat_return_ti  (1.62 * 1.0)         1.62 s
             min_return_ti                       2.50 s  <- 이게 이기고 있었다
         즉 scale 을 더 낮춰도 효과가 없고 하한만 낮추면 된다.
         2.0 으로 내리면 base 2.25 가 새 지배항이 되어 17.2 -> 15.5 m.
         횡가속 1.50 -> 1.85 m/s^2, 곡률 0.0388 로 curvature_limit(0.5)
         대비 13배 여유다.
         ※ return_ti(6.0)는 버스 기준 튜닝값이라 건드리지 않았다 - 그걸
           낮추면 긴 물체의 복귀까지 같이 급해진다. -->
    <!-- 2026-09-21 1차: 3.0 -> 2.5 (복귀경로 단축, 랩타임 목적) -->
    <param name="min_return_ti" value="2.0" />
    <!-- 복귀 횡방향 이탈량(|d|)에 비례하여 복귀시간을 늘려 급격한 복귀 다이브 방지 -->
    <!-- 2026-09-21 2차: 1.3 -> 1.0.
         13-04-50 백 실측으로 다시 확인했다. 회피 프로파일은
           이탈 t=8.7 -> 최대 +3.28 m (t=12.5) -> 복귀완료 t=18.2
           나가는 데 3.8 s / 복귀 5.7 s (28.2 m) 로 복귀가 1.5배 길다.
         복귀시간을 지배하는 항은 역시 lat_return_ti 였다. base_return_ti 는
         장애물 length 가 3.0 m 로 클램프되므로 최대 6.0*3.0/8.0 = 2.25 s 밖에
         안 나온다(실제 콘은 0.35 m). 즉 |c_d| * scale 만 조절하면 된다.
           scale 1.3 -> 4.26 s = 21.1 m
           scale 1.0 -> 3.28 s = 16.2 m
         곡률 0.065 로 curvature_limit(0.5) 대비 여전히 7배 여유다. -->
    <!-- 2026-09-21 1차: 1.8 -> 1.3 (복귀경로 단축).
         회피 자체는 짧은데(maxt 3.5 = 17.5m) 복귀가 길다는 관찰에 따른 조정.
         실제로 복귀시간을 지배하는 항이 이것이다 - 콘/드럼처럼 짧은 물체는
         base_return_ti(물체길이 비례)가 작아서 lat_return_ti = |c_d| * scale
         가 항상 이긴다. 회피 이탈량 2.3 m 기준:
             1.8 -> 4.14 s = 20.7 m
             1.3 -> 2.99 s = 14.9 m   (28% 단축)
         급복귀 위험은 곡률로 확인했다. 필요 횡가속도 0.77 -> 1.49 m/s^2,
         곡률 0.059 로 curvature_limit(0.5) 대비 8배 여유가 있다.
         원래 이 값이 큰 이유는 '3m 회피 후 3초 만에 -13도 급다이브'를 막기
         위해서였는데, 그 경우(|c_d| 3.0)는 1.3 에서도 3.9 s 가 나와
         급다이브 영역에 들어가지 않는다. -->
    <param name="return_lat_time_scale" value="1.0" />
    <!-- 복귀 완료 판정 시 차체 헤딩 정렬 오차 허용 상한(deg). 차체가 경로와 정렬된 뒤 패스스루 전환 -->
    <param name="return_heading_threshold_deg" value="3.5" />

    <!-- 회피 경로 곡률 제한: 1/최소회전반경(m). 이보다 급하게 꺾는 경로는 버리고 이전 경로 유지 -->
    <param name="curvature_limit" value="0.8" />        <!-- 0.8 = 최소 회전반경 약 1.25m 이하 거부 -->

    <!-- 관련 장애물 없을 때 패스스루로 내보낼 기준경로 길이(m). MPC 45m 프리뷰 및 3차 다항식 외삽 방지 일치 -->
    <param name="passthrough_length_m" value="45.0" />

    <!-- Frenet 샘플링 범위 -->
    <param name="max_speed" value="15.0" />
    <param name="max_accel" value="3.0" />
    <param name="max_curvature" value="1.0" />
    <param name="max_road_width" value="3.5" />         <!-- 기준선에서 좌우 최대 오프셋(m). 충분한 회피 마진 확보 -->
    <param name="d_road_w" value="0.25" />              <!-- d 샘플링 간격(m) : 정밀한 후보 생성 (0.35 -> 0.25) -->
    <!-- 경로점 개수는 n = 1 + Ti/dt 로 결정됨. maxt를 3.0->1.5로 줄이면서 dt를
         그대로 두면 점이 4개로 확 줄어서(원래 ~8개) mpc_path_tracking이 최소
         horizon 점 개수를 못 채워 범위밖 접근으로 죽었음(exit -6/SIGABRT).
         dt를 촘촘히 줄여서 점 개수를 원래 수준으로 유지. -->
    <param name="dt" value="0.1" />
    <!-- mint를 1.0초로 단축하여 근접 장애물(3~5m 전방)에서도 신속하게 횡방향 회피를 시작할 수 있도록 허용 -->
    <param name="maxt" value="3.5" />
    <param name="mint" value="1.0" />
    <!-- 모든 후보를 그리는 공통 지평(초). Ti(회피 완료 시간)와 분리돼 있다.
         예전에는 경로 길이가 Ti 에 묶여 있어서, 짧은 Ti 는 경로가 장애물까지
         닿지 않아 충돌검사를 무의미하게 통과하고 긴 Ti 는 그 지점에서 아직
         안 비켜져 있어 전부 충돌했다(실측 2026-09-07: 1400 후보 전탈락,
         min_clearance 0.00~0.22m).

         ★ 이 값이 곧 '충돌을 볼 수 있는 거리' 다. 여기 안 닿는 장애물은
         모든 후보가 '충돌 없음' 이 되고, 그러면 비용이 가장 싼 d=0(직진)이
         선택된다 - 장애물을 향해 그대로 간다.
           실측 2026-09-08: 장애물 16.4m 앞, 경로 정중앙(dist_to_path=0.11)
           인데 d_end=0.00 이었다. 4.0s 는 속도 4.5m/s 일 때만 18m 이고,
           회피 감속으로 tv 가 3.0 까지 떨어지는 후보는 12.8m 밖에 못 그린다.
         7.0s 면 tv=3.0 에서 21.8m, tv=2.0 까지 떨어져도 14m 를 덮는다.
         궤적 '형상' 은 Ti(mint~maxt)가 정하고 이 값은 그리는 길이만 늘리므로,
         회피 궤적이 완만해지거나 복귀가 늦어지는 부작용은 없다.
         종방향 목표에 s0+25m 하드캡이 있어 이보다 더 키워도 25m 를 못 넘는다. -->
    <param name="plan_horizon_t" value="7.0" />
    <!-- ★ 회피 주행 속도는 mpc_params.yaml 의 /speed_limit/avoidance_mps 가
         단일 출처다. 노드는 그걸 먼저 읽고, 여기 target_speed 가 있으면
         그게 덮는다(pnh_.param 이 뒤에 온다).
           2026-09-09: 여기 4.5 가 박혀 있어서 yaml 의 5.5 가 영구히 무시됐다.
           "회피 속도를 yaml 에 합쳤는데 반영이 안 된다" 의 원인.
         그래서 기본값은 주지 않는다. 실험용으로 한 번만 덮고 싶을 때
         인자로 넘긴다: target_speed:=4.0 -->
    <param name="target_speed" value="$(arg target_speed)" if="$(eval arg('target_speed') != '')"/>

    <!-- 라이다 정적/unknown confirmed든, 카메라 감지든 상관없이 감지되면
         즉시 이 절대 속도(km/h)로 제한. 사전 감속을 확실히 걸어 여유로운 회피 궤적 확보 -->
    <!-- 같은 이유로 mpc_params.yaml 의 /speed_limit/camera_kick_mps 를 단일
         출처로 쓴다(노드가 m/s -> km/h 로 환산해 받는다). 여기서 덮고 싶을
         때만 인자로 넘긴다: speed_kick_target_kmh:=17.0 -->
    <param name="speed_kick_target_kmh" value="$(arg speed_kick_target_kmh)"
           if="$(eval arg('speed_kick_target_kmh') != '')"/>
    <!-- 한 번 감속 트리거되면(라이다/카메라 무관) 이 시간(s) 동안 감속 유지,
         그 동안은 재트리거 없음. 시간 지나면 자동으로 풀리고 바로 재감지 가능 -->
    <param name="speed_kick_duration_sec" value="6.0" />
    <param name="d_t_s" value="1.0" />
    <param name="n_s_sample" value="1.0" />             <!-- 0으로 하면 루프 조건(tv < target+0) 때문에 후보가 0개가 되어버림 -->
    <!-- 현재 MORAI 차량 폭 약 1.90m 기준: 반폭 0.95m에 경로추종,
         클러스터 위치 오차와 3원 근사 여유 0.40m를 더한다.
         장애물 사이 통과에 필요한 빈 폭은 대략 2.70m이다. -->
    <param name="robot_radius" value="1.35" />
    <!-- base_link는 후륜축 부근이다. 차체 중심(+1.35m)을 기준으로 앞/뒤
         +/-1.2m에 원을 놓아 실제 전후 길이까지 충돌 검사한다. -->
    <param name="robot_circle_offset" value="1.20" />
    <param name="robot_footprint_center_offset" value="1.35" />
    <param name="min_lat_vel" value="0.0" />
    <param name="max_lat_vel" value="0.0" />
    <param name="d_d_ns" value="1.0" />
    <param name="max_shift_d" value="1.5" />           <!-- 라이다/카메라 인지가 실제 순항속도(약 7~8m/s)보다 훨씬
         느린 target_speed(5.0m/s) 기준 3초짜리 경로를 만들다보니, 장애물
         발견 시점(8~10m 전방)부터 실제로 밟는 거리 안에서는 옆으로 다
         못 꺾고 초반의 완만한 구간만 타다가 그대로 지나침. 실제 반응
         가능 거리에 맞춰 훨씬 짧게(=더 급하게 완료) 잡음. -->

    <!-- 비용함수 가중치 -->
    <!-- cd = kj*jerk + kt*시간 + kd*d^2. kd가 너무 크면 복귀 유인력이 회피를 방해함. 균형 잡힌 1.5로 설정 -->
    <param name="kj" value="0.2" />
    <param name="kt" value="0.1" />
    <param name="kd" value="1.5" />
    <param name="kd_v" value="1.0" />
    <param name="klat" value="1.0" />
    <param name="klon" value="1.0" />

  </node>

  <!-- 터널 음영구간 라이다 벽면 보정 노드 (카메라 VP 기반 Yaw 보정으로 대체하여 비활성화) -->
  <!--
  <node pkg="new_lane" type="tunnel_wall_detector.py" name="tunnel_wall_detector" output="screen" respawn="true">
    <param name="target_wall_dist" value="2.45" />
    <param name="nominal_tunnel_width" value="8.4" />
    <param name="max_shift" value="1.8" />
    <param name="shift_rate_limit" value="0.5" />
    <param name="deadband_m" value="0.05" />
  </node>
  -->

</launch>
