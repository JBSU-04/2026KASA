"""Tunnel Wall Detector Node.

Subscribes to LiDAR /nonground point cloud and estimates distance to the right
and left tunnel walls. Computes the lateral shift required to keep the vehicle
centered in lane 3 during GPS outages in the tunnel. Decouples intentional
Frenet avoidance swerving from true dead-reckoning drift.
"""

import json
import math
import os
import sys
from collections import deque
import numpy as np

# Import the source module instead of catkin's executable relay in devel/lib.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
from tunnel_region import read_region, contains
from obstacle_geometry import regional_plane_heights
from tunnel_scene_policy import preslow
