from std_msgs.msg import Bool, Float64, Float64MultiArray, String
from visualization_msgs.msg import Marker, MarkerArray


def pointcloud2_to_xyz_array(msg):
    """Fast unpacking of PointCloud2 into an (N, 3) float32 numpy array."""
    field_offset = {f.name: f.offset for f in getattr(msg,'fields',[])}
    if not all(k in field_offset for k in ('x', 'y', 'z')):
        return np.empty((0, 3), dtype=np.float32)

    names = ['x', 'y', 'z']
    dtype = np.dtype({
        'names': names,
        'formats': [np.float32] * 3,
        'offsets': [field_offset[name] for name in names],
        'itemsize': msg.point_step,
    })
    n = len(msg.data) // msg.point_step
    arr = np.frombuffer(msg.data, dtype=dtype, count=n)
    pts = np.stack([arr[name] for name in names], axis=-1)
    return pts[~np.isnan(pts).any(axis=1)]


def fit_wall_line_ransac(points_xy, max_iter=25, dist_thresh=0.08, max_slope=0.30,
                         allow_median_fallback=True):
    """Fit a line y = m*x + b to wall points using RANSAC.

    Returns (m, b, inlier_ratio) or (None, None, 0.0) if fit fails.
    """
    n = len(points_xy)
    if n < 20:
        return None, None, 0.0

    best_inliers = 0
    best_m = 0.0
    best_b = 0.0

    x = points_xy[:, 0]
    y = points_xy[:, 1]

    # Pre-filter by slope bounds using randomized pairs
    for _ in range(max_iter):
        idx = np.random.choice(n, 2, replace=False)
        dx = x[idx[1]] - x[idx[0]]
        if abs(dx) < 1.0:
            continue
        dy = y[idx[1]] - y[idx[0]]
        m = dy / dx
        if abs(m) > max_slope:
            continue
        b = y[idx[0]] - m * x[idx[0]]

        # Distance from line: |m*x - y + b| / sqrt(m^2 + 1)
        dists = np.abs(m * x - y + b) / math.sqrt(m * m + 1.0)
        inliers = np.count_nonzero(dists < dist_thresh)

        if inliers > best_inliers:
            best_inliers = inliers
            best_m = m
            best_b = b

    if best_inliers < max(15, int(n * 0.25)):
        # Fallback: simple median of y if points are concentrated
        if allow_median_fallback and n >= 20:
            med_y = float(np.median(y))
            return 0.0, med_y, float(n) / max(n, 1)
        return None, None, 0.0

    # Refine with least squares on inliers
    dists = np.abs(best_m * x - y + best_b) / math.sqrt(best_m * best_m + 1.0)
    inlier_mask = dists < dist_thresh
    if np.count_nonzero(inlier_mask) >= 10:
        poly = np.polyfit(x[inlier_mask], y[inlier_mask], 1)
        return float(poly[0]), float(poly[1]), float(best_inliers) / n

    return best_m, best_b, float(best_inliers) / n


def track_ground(bins, z, ground_z, x_min, bin_m, y=None, road_half=3.0, band=0.25,
                 min_pts=15):
    """x 칸별 노면 높이.

    1) 도로 중앙부(|y| <= road_half) 점 중 기준 +-1 m 안 낮은 점의 칸별 20 백분위로
       노면 곡선 z(x)=a+bx+cx^2 를 강건하게(잔차 0.15 m 넘는 칸 제외 반복) 맞춘다.
    2) 칸마다 그 곡선 +-band 안 점의 20 백분위, 점이 모자라면 곡선 값.
    고정 기준(ground_z +-0.4)으로만 찾으면 급감속/가속으로 차가 숙이거나 들릴 때
    먼 칸(15~35 m)의 노면 링이 기준 밖으로 벗어나, 링 전체가 +0.3~0.5 m 물체로
    보였다(13:02 백).
    """
    nb = int(bins.max()) + 1
    xc = x_min + (np.arange(nb) + 0.5) * bin_m
    sel = np.abs(z - ground_z) <= 1.0
    if y is not None:
        sel &= np.abs(y) <= road_half
    bx, bz = bins[sel], z[sel]
    cx, cz = [], []
    for bb in np.unique(bx):
        zz = bz[bx == bb]
        if len(zz) >= 8:
            cx.append(xc[bb])
            cz.append(np.percentile(zz, 20))
    curve = np.full(nb, ground_z, dtype=np.float64)
    if cx:
        cx, cz = np.array(cx), np.array(cz)
        keep = np.ones(len(cx), dtype=bool)
        coef = None
        for _ in range(4):
            n = int(keep.sum())
            if n == 0:
                break
            deg = 2 if n >= 6 else (1 if n >= 3 else 0)
            coef = np.polyfit(cx[keep], cz[keep], deg)
            res = np.abs(np.polyval(coef, cx) - cz)
            new_keep = res <= 0.15
            if new_keep.sum() < max(1, n // 2) or np.array_equal(new_keep, keep):
                break
            keep = new_keep
        if coef is not None:
            curve = np.polyval(coef, xc)
            # 곡선이 기준에서 터무니없이 벗어나면(자차 피치 +-3 deg 상당) 기준을 쓴다.
            bad = np.abs(curve - ground_z) > 0.06 * np.maximum(np.abs(xc), 5.0)
            curve[bad] = ground_z
    ground = curve.copy()
    order = np.argsort(bins, kind='stable')
    sb, sz = bins[order], z[order]
    starts = np.searchsorted(sb, np.arange(nb + 1))
    for bb in range(nb):
        zz = sz[starts[bb]:starts[bb + 1]]
        zz = zz[np.abs(zz - curve[bb]) <= band]
        if len(zz) >= min_pts:
            ground[bb] = np.percentile(zz, 20)
    return ground


def above_ground_points(pts, ground_z=-1.75, x_min=-10.0, x_max=40.0, y_abs_max=12.0,
                        h_min=-0.3, h_max=3.0, bin_m=2.0, ego_box=(-3.5, 2.0, 1.3)):
    """센서 좌표 점군 -> (x, y, h) 노면 기준 높이. 선감속과 같은 규약.

    x 를 bin_m 칸으로 나눠 칸마다 노면(ground_z +-0.4 안 낮은 점의 20 백분위)을 잡는다.
    ego_box = (x_min, x_max, |y|max) 센서 기준 자차 차체 점 제거.
    """
    if not len(pts):
        return np.empty((0, 3))
    m = ((pts[:, 0] >= x_min) & (pts[:, 0] <= x_max) &
         (np.abs(pts[:, 1]) <= y_abs_max) & (pts[:, 2] <= ground_z + h_max + 0.5))
    if ego_box is not None:
        m &= ~((pts[:, 0] > ego_box[0]) & (pts[:, 0] < ego_box[1]) &
               (np.abs(pts[:, 1]) < ego_box[2]))
    p = pts[m]
    if not len(p):
        return np.empty((0, 3))
    bins = np.floor((p[:, 0] - x_min) / bin_m).astype(int)
    ground = track_ground(bins, p[:, 2], ground_z, x_min, bin_m, y=p[:, 1])
    h = p[:, 2] - ground[bins]
    keep = (h >= h_min) & (h <= h_max)
    return np.column_stack([p[keep, 0], p[keep, 1], h[keep]])


def regional_ground_points(pts, ground_z, x_min, x_max, h_min, h_max, details=False):
    """Gravity-frame regional planes; unknown ground is not background evidence.

    Return x/y/height and a per-point background-height compatibility mask. Close
    unsupported points retain the legacy proposal as a conservative fallback.
    """
    p = pts[np.isfinite(pts).all(axis=1) & (pts[:, 0] >= x_min) &
            (pts[:, 0] <= x_max) & (np.abs(pts[:, 1]) <= 12) &
            (pts[:, 2] <= ground_z+h_max+.5)]
    if not len(p):
        empty = (np.empty((0, 3)), np.empty(0, dtype=bool))
        return empty + (np.empty(0),) if details else empty
    height, valid, keys = regional_plane_heights(p, ground_z)
    # Near-field fallback cannot use a failed plane to veto an obstacle.
    bins = np.floor((p[:, 0]-x_min)/2.).astype(int)
    legacy_ground = track_ground(bins, p[:, 2], ground_z, x_min, 2., y=p[:, 1])
    legacy_h = p[:, 2]-legacy_ground[bins]
    fallback = np.column_stack([p[:, :2], legacy_h])
    fallback = fallback[(legacy_h >= h_min) & (legacy_h <= h_max)]
    near = fallback[fallback[:, 0] <= 8.]
    keep = valid & (height >= h_min) & (height <= h_max)
    out = np.column_stack([p[keep, :2], height[keep]])
    # The legacy map stores heights from the previous longitudinal estimator.
    # Significant model disagreement must not let that map erase a real point.
    quality = np.abs(height[keep]-legacy_h[keep]) <= .15
    old_height = legacy_h[keep]
    if len(near):
        # Only append where no supported plane covers that tile.
        supported = {tuple(k) for k in keys[valid]}
        add = np.array([tuple(k) not in supported for k in np.floor(near[:, :2]/[6., 4.]).astype(int)])
        out = np.vstack([out, near[add]])
        quality = np.r_[quality, np.zeros(add.sum(), bool)]
        old_height = np.r_[old_height, near[add, 2]]
    return (out, quality, old_height) if details else (out, quality)


def background_candidate_masks(q, compatible, legacy_height, novel, legacy_novel,
                               legacy_judged, geometry_background, sensor_x,
                               near_height_min=.20, near_height_max=2.2,
                               near_inside=None):
    """Height disagreement alone is uncertainty, not positive object evidence."""
    background = legacy_judged & ~legacy_novel & geometry_background
    evidence = np.where(compatible, novel, legacy_novel)
    near = ((q[:, 0]+sensor_x <= 8.) & (legacy_height >= near_height_min) &
            (legacy_height <= near_height_max))
    if near_inside is not None:
        near &= near_inside
    candidate = ~background & (evidence | (~compatible & near))
    return background, candidate, ~background & ~candidate


class TunnelBgMap:
    """장애물 없는 주행으로 만든 터널 배경맵(build_tunnel_bgmap.py).

    터널 방향으로 돌린 격자(u 진행, v 좌측)에 칸마다 '노면 위 최대 높이'(hmax)와
    '관측됨'(seen)을 둔다. 둘 다 추측항법 오차만큼 미리 팽창해 저장한다.
    지금 점이 배경보다 margin 이상 높고(= 배경에 없는 것) 관측된 칸이면 새 물체.
    """

    def __init__(self, path):
        d = np.load(path)
        self.ox, self.oy = float(d['origin'][0]), float(d['origin'][1])
        self.theta = float(d['theta'])
        self.res = float(d['res'])
        self.iu0, self.iv0 = int(d['i0'][0]), int(d['i0'][1])
        self.hmax = d['hmax'].astype(np.float32)
        self.seen = d['seen'].astype(bool)
        # 물체-배경 판정용: 팽창을 좁힌 배경 높이(진행 +-0.6 m, 횡 +-0.2 m).
        #   횡 팽창(0.4 m)을 그대로 쓰면 턱 바로 옆 도로의 실제 장애물까지 배경이 된다.
        raw = d['hmax_raw'].astype(np.float32) if 'hmax_raw' in d else self.hmax
        try:
            from scipy import ndimage
            du = max(0, int(round(0.6 / float(d['res']))))
            dv = max(0, int(round(0.2 / float(d['res']))))
            self.hmax_obj = ndimage.maximum_filter(raw, size=(2 * du + 1, 2 * dv + 1),
                                                   mode='constant', cval=-1.0)
        except ImportError:
            self.hmax_obj = raw
        self.c, self.s = math.cos(self.theta), math.sin(self.theta)
        self.path = path

    def index(self, wx, wy):
        dx = np.asarray(wx) - self.ox
        dy = np.asarray(wy) - self.oy
        u = dx * self.c + dy * self.s
        v = -dx * self.s + dy * self.c
        iu = np.floor(u / self.res).astype(np.int64) - self.iu0
        iv = np.floor(v / self.res).astype(np.int64) - self.iv0
        ok = (iu >= 0) & (iu < self.hmax.shape[0]) & (iv >= 0) & (iv < self.hmax.shape[1])
        return iu, iv, ok

    def covers(self, wx, wy):
        iu, iv, ok = self.index(np.array([wx]), np.array([wy]))
        return bool(ok[0] and self.seen[iu[0], iv[0]])

    def is_background(self, wx, wy, top, min_h=0.3, margin=0.3):
        """물체 중심이 배경 구조물(벽/턱) 칸이고 윗면이 배경보다 margin 넘게 높지 않으면 True."""
        iu, iv, ok = self.index(np.array([wx]), np.array([wy]))
        if not ok[0] or not self.seen[iu[0], iv[0]]:
            return False
        h = float(self.hmax_obj[iu[0], iv[0]])
        return h >= min_h and top <= h + margin

    def novel(self, wx, wy, h, margin):
        """(새 물체 여부, 판정 가능 여부) bool 배열."""
        iu, iv, ok = self.index(wx, wy)
        judged = np.zeros(len(h), dtype=bool)
        nov = np.zeros(len(h), dtype=bool)
        if np.any(ok):
            a, b = iu[ok], iv[ok]
            sn = self.seen[a, b]
            judged[ok] = sn
            nov[ok] = sn & (np.asarray(h)[ok] > self.hmax[a, b] + margin)
        return nov, judged


class TunnelWallDetector:
    """터널(음영구간) 벽 기반 보정 + 제한영역 + 라이다 선감속 트리거.

    2026-09-29 (16:23 백) 재구성:
      - 실측 단면(15~20 s, 39 스캔): 우측 연석 -3.9 m / 벽면 -4.4 m,
        좌측 연석 +6.9~7.1 m / 벽면 +7.4~7.6 m, 폭 11.8 m. 예전 값(폭 8.4,
        우측 2.45, 좌측 창 1.5~6.5 m)은 이 터널과 맞지 않아 좌측 벽을 못 봤다.
      - 헤딩 누적: 카메라 VP 헤딩이 +-1 deg 흔들려 추측항법 위치가 벽 기준
        +-0.3 m 흘렀다(13~17 s 좌측(중앙선 쪽) 0.2 m, 17~21.6 s 우측 0.3 m).
        /odom 은 경로 위(+-0.1 m)라고 믿었다. 벽까지 거리로 추측항법 오차를
        직접 재서 /tunnel/wall_offset 으로 플래너에 준다(플래너가 빼서 계획).
      - 기준 벽 거리(target)는 GPS 가 얼 때(그 순간 추측항법 오차 ~0) 자동 보정.
      - /tunnel/wall_limits: 연석선(벽 - curb_inset) 까지 거리 -> 플래너 좌우 제한.
      - /tunnel/lidar_obstacle_ahead: 연석선 안쪽, 전방 kick_range 안 물체.
    """

    def __init__(self):
        # 기하(센서 프레임: x 전방, y 좌측, z 는 센서 기준 - 지면 약 -1.75)
        self.nominal_tunnel_width = float(rospy.get_param('~nominal_tunnel_width', 11.8))
        self.width_tolerance = float(rospy.get_param('~width_tolerance', 1.0))
        self.target_wall_dist = float(rospy.get_param('~target_wall_dist', 4.30))
        self.auto_target = bool(rospy.get_param('~auto_target', True))
        self.auto_target_window_sec = float(rospy.get_param('~auto_target_window_sec', 4.0))
        self.auto_target_samples = int(rospy.get_param('~auto_target_samples', 8))
        self.curb_inset = float(rospy.get_param('~curb_inset', 0.1))
        # Prewarm wall geometry only near the entrance, not across the highway.
        self.entry_preview_enabled = bool(rospy.get_param('~entry_preview_enabled', True))
        self.entry_preview_start_idx = float(rospy.get_param('~entry_preview_start_idx', 7000))
        self.entry_preview_end_idx = float(rospy.get_param('~entry_preview_end_idx', 7550))
        self.entry_preview_lookahead_m = float(rospy.get_param('~entry_preview_lookahead_m', 35.0))
        self.right_roi = rospy.get_param('~right_roi_y', [-6.5, -2.5])
        self.left_roi = rospy.get_param('~left_roi_y', [5.0, 10.0])
        self.wall_z = rospy.get_param('~wall_z', [0.0, 1.5])
        self.wall_x = rospy.get_param('~wall_x', [1.0, 15.0])
        self.sensor_x = float(rospy.get_param('~sensor_x', 1.10))
        # 보정 필터
        self.max_shift = float(rospy.get_param('~max_shift', 1.20))
        self.shift_rate_limit = float(rospy.get_param('~shift_rate_limit', 0.30))
        self.ema_alpha = float(rospy.get_param('~ema_alpha', 0.20))
        self.deadband_m = float(rospy.get_param('~deadband_m', 0.03))
        self.offset_enabled = bool(rospy.get_param('~offset_enabled', True))
        # 라이다 선감속
        self.kick_enabled = bool(rospy.get_param('~kick_enabled', True))
        self.kick_range = float(rospy.get_param('~kick_range_m', 20.0))
        self.kick_min_x = float(rospy.get_param('~kick_min_x_m', 3.0))
        self.kick_z = rospy.get_param('~kick_z', [-1.45, 0.5])
        # 선감속 영역은 제한선과 따로 '벽에서' 잰다. 벽 아래 턱(우측 -3.9 m, 높이
        # ~0.75 m, 벽면 -4.4 m)이 영역 안에 들어오면 계속 오검출된다.
        self.kick_wall_inset = float(rospy.get_param('~kick_wall_inset_m', 0.8))
        self.kick_min_points = int(rospy.get_param('~kick_min_points', 8))
        self.kick_confirm_frames = int(rospy.get_param('~kick_confirm_frames', 2))
        self.limits_hold_sec = float(rospy.get_param('~limits_hold_sec', 1.0))
        import m8_geometry_native
        m8_geometry_native.enabled=bool(rospy.get_param('/tunnel_recovery/native_geometry_enabled',True))
        self.physical_boundary_policy = bool(rospy.get_param('~physical_boundary_policy', False))
        # ★ 2026-09-29 (19:23 백): 선감속은 원본 점군 + 국소 지면으로 판정한다.
        #   낮은 장애물(윗면 0.33 m)을 /nonground(GroundGrid)가 10 m 밖에서 지면으로
        #   지워 선감속이 한 번도 안 걸렸다(원본 점은 25~30 m 부터 있었다).
        #   영역 안 점을 x 2 m 칸으로 나눠 칸마다 노면 높이(낮은 점의 20 백분위)를 잡고
        #   그보다 kick_min_height 이상 높은 점을 물체로 센다.
        self.kick_use_raw = bool(rospy.get_param('~kick_use_raw', True))
        self.kick_cloud_topic = rospy.get_param('~kick_cloud_topic', '/perception/points_gravity')
        self.bg_ground_quality = 'not_observed'
        self.bg_observations = []
        self.bg_direct_walls = []
        self.kick_min_height = float(rospy.get_param('~kick_min_height_m', 0.20))
        # 노면 요철/경사로 퍼진 점(16:23 13.3 s: 차로 전폭에 0.12~0.16 m)을 거르기 위해
        # 1 m 격자 한 칸에 kick_cell_min_points 이상 모인 점만 물체로 본다.
        self.kick_cell_m = float(rospy.get_param('~kick_cell_m', 1.0))
        self.kick_cell_min_points = int(rospy.get_param('~kick_cell_min_points', 6))
        self.kick_max_height = float(rospy.get_param('~kick_max_height_m', 2.2))
        self.kick_ground_z = float(rospy.get_param('~kick_default_ground_z', -1.75))
        self.kick_lines_state = None   # (stamp, m_r, bk_r, m_l, bk_l) 최근 곧은 벽 기준 선감속 경계
        # ★ 2026-09-29 (19:49 백): 원거리 후보 기억.
        #   낮은 장애물(0.33~0.49 m)은 라이다(1.75 m, 링 2 deg)에 25~30 m(-3 deg 링),
        #   15~18 m(-5 deg), 11~13 m(-7 deg)에서만 맞고 18~25 m 에서는 링 사이로
        #   빠진다. 20 m 에서 '지금 보이는가'로는 12 m 에서야 선감속이 걸렸다.
        #   kick_detect_range 까지 후보를 찾아 세계좌표로 기억하고, 기억한 물체가
        #   kick_range 안(영역 안)에 들어오면 선감속한다.
        self.kick_detect_range = float(rospy.get_param('~kick_detect_range_m', 35.0))
        self.kick_memory_sec = float(rospy.get_param('~kick_memory_sec', 4.0))
        self.kick_memory_merge_m = float(rospy.get_param('~kick_memory_merge_m', 1.0))
        self.kick_memory_min_hits = int(rospy.get_param('~kick_memory_min_hits', 2))
        self.tunnel_region=read_region(rospy.get_param)
        self.common_scene_enabled=bool(rospy.get_param("/tunnel_recovery/common_scene_enabled",True))
        self.common_scene={}
        self.preslow_marker_pub=rospy.Publisher("/tunnel/preslow_markers",MarkerArray,queue_size=1)
        self.preslow_state_pub=rospy.Publisher("/tunnel/preslow_state",String,queue_size=1)
        self.accepted_selection={}
        self.accepted_selections={}
        self.selection_sub=rospy.Subscriber("/obstacle_avoidance/selection_state",String,self.selection_cb,queue_size=1)
        if rospy.get_param('/tunnel_recovery/native_scene_enabled',True):
            from occupancy_avoidance.msg import TunnelScene
            from tunnel_native_scene import scene_dict
            self.scene_sub=rospy.Subscriber('/tunnel/perception_scene_native',TunnelScene,lambda m:self.common_scene_cb(scene_dict(m)),queue_size=1,buff_size=2**24,tcp_nodelay=True)
        else:
            self.scene_sub=rospy.Subscriber("/tunnel/perception_scene",String,self.common_scene_cb,queue_size=1,buff_size=2**24)
        self.scene_timer=rospy.Timer(rospy.Duration(.1),self.common_scene_tick)
        self.map_preslow_distance=float(rospy.get_param('~map_preslow_distance_m',20.))
        self.object_risk_preslow=bool(rospy.get_param('~object_risk_preslow_enabled',True))
        self.map_preslow_memory=float(rospy.get_param('~map_preslow_memory_sec',4.))
        self.map_classification_enabled=bool(rospy.get_param('~map_classification_enabled',True)) and bool(rospy.get_param('/tunnel_recovery/enabled',True))
        self.kick_memory = []          # [wx, wy, last_seen_sec, hits]
        # ★ 2026-09-29 (20:27 백): idx 별 실측 벽/턱 경계(config/tunnel_wall_profile.yaml)로
        #   선감속 후보 중 벽 조각을 뺀다(출구에서 좁아지는 구조물이 직선 벽 영역 안으로 들어왔다).
        prof = rospy.get_param('~tunnel_wall_profile', [])
        self.wprof = None
        if len(prof) >= 6 and len(prof) % 3 == 0:
            a = np.asarray(prof, dtype=np.float64).reshape(-1, 3)
            self.wprof = (a[:, 0], a[:, 1], a[:, 2])
        self.profile_margin = float(rospy.get_param('~kick_profile_margin_m', 0.5))
        self.route = None              # (xy[N,2], idx[N], tan[N,2])
        self.route_lane = -1
        self.route_stamp = -1e9
        self.pose_stamp = -1e9
        # ★ 2026-09-29 라이다 배경맵 선감속(build_tunnel_bgmap.py).
        #   장애물 없는 주행(20:57, 16:23)으로 만든 '원래 있는 것'(벽, 턱, 구조물) 격자와
        #   지금 점군을 비교해, 배경보다 bg_margin_h 이상 튀어나온 점이 모이면 새 물체로
        #   보고 선감속한다. 벽에서 1 m 안쪽만 보던 기존 선감속과 달리 턱 앞/위(좌우 끝)도
        #   본다 - 동적 장애물은 움직이기 전까지 정적이고, 좌우 끝에서 나온다.
        #   재현(09-29 백): 장애물 없는 16:23 터널 안 오검출 0, 정적 저상 장애물 25~27 m,
        #   대향 정지차 ~24 m, 횡단 물체(13:02/20:27) 27~30 m 부터 검출.
        #   맵 범위 밖이거나 맵이 없으면 기존 방식(벽선 안쪽)으로 돌아간다.
        self.bgmap = None
        self.bg_margin_h = float(rospy.get_param('~bg_margin_h', 0.3))
        self.bg_min_h = float(rospy.get_param('~bg_min_h', 0.25)) if self.map_classification_enabled else .25
        self.bg_max_h = float(rospy.get_param('~bg_max_h', 2.5))
        self.bg_cell_m = float(rospy.get_param('~bg_cell_m', 1.0))
        self.bg_cell_min_points = int(rospy.get_param('~bg_cell_min_points', 4)) if self.map_classification_enabled else 4
        self.bg_lateral_margin = float(rospy.get_param('~bg_lateral_margin', 0.6))
        # 배경맵 후보 기억 시간. 저상 장애물은 18~25 m 에서 링 사이로 빠져 0.3 s 기억으로는
        # 25 m 에서 본 것을 잊고 13.5 m 에서야 선감속했다(19:23 백). 배경맵은 노면 오검출이
        # 없으니 길게 둔다(기존 방식 0.3 s 는 노면 오검출 때문).
        self.bg_memory_sec = float(rospy.get_param('~bg_memory_sec', 1.5))
        self.bg_default_limits = rospy.get_param('~bg_default_limits', [-4.5, 8.0])
        self.bg_novel_viz = None
        # ★ 2026-09-30 (20:07 백) 배경맵 새 물체의 움직임 판단 -> /tunnel/bg_moving.
        #   저상 동적 장애물(높이 ~0.45 m)은 /nonground 가 ~12 m 밖에서 지면으로 지워
        #   트래커가 9~10 m 에서야 봤다. 원본 점군 배경맵은 17~19 m 부터 보고 있었다
        #   (길가에 서 있다가 12~13 m 에서 건너기 시작). 선감속 기억(1 m 병합)과 별개로
        #   새 점을 0.5 m 칸 연결 성분(물체)으로 묶어 스캔마다 이어 붙이고,
        #     빠름: bg_motion_fast_window 안에 bg_motion_fast_move_m 이상
        #     느림: bg_motion_slow_window 안에 bg_motion_slow_move_m 이상(구간별 같은 방향)
        #   이고 경로 기준 횡이동 >= bg_motion_min_lat_m (종이동의 절반 이상)이면 움직이는
        #   물체로 발행한다. 종방향 이동(다가갈수록 보이는 면이 바뀌는 정적 물체, 벽 조각)은 뺀다.
        self.bg_motion_enabled = bool(rospy.get_param('~bg_motion_enabled', True))
        self.bg_motion_cell_m = float(rospy.get_param('~bg_motion_cell_m', 0.5))
        self.bg_motion_min_points = int(rospy.get_param('~bg_motion_min_points', 4))
        self.bg_motion_min_x = float(rospy.get_param('~bg_motion_min_x_m', 1.0))
