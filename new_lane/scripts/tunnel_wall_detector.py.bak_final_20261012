        self.bg_motion_slow_span = float(rospy.get_param('~bg_motion_slow_min_span', 0.8))
        self.bg_motion_slow_move = float(rospy.get_param('~bg_motion_slow_move_m', 0.5))
        self.bg_motion_min_lat = float(rospy.get_param('~bg_motion_min_lat_m', 0.4))
        self.bg_motion_slow_lat = float(rospy.get_param('~bg_motion_slow_lat_m', 0.55))
        # 판정 거리창(base_link 전방). 트래커(/nonground)가 못 보는 구간만 맡는다.
        #   8 m 안은 트래커가 본다 - 배경맵은 옆을 지나는 정적 장애물의 보이는 면이 바뀌며
        #   흐르는 것(4~11 m, 0.4~0.6 m/s)을 움직임으로 오판했다.
        #   14.5 m 밖은 링 사이로 점이 끊겨 중심이 튀었다(15~35 m 오판).
        #   8 개 백 오프라인 평가: 실제 횡단 7 건 전부 9~13 m 에서 검출, 오판 0.
        self.bg_motion_eval_min_x = float(rospy.get_param('~bg_motion_eval_min_x', 8.0))
