TEST(Approach,RandomPlacementUsesObservedGeometryInsteadOfFixedObstacleIndex){
  auto r=road();for(auto&q:r)q.idx+=2250;
  for(double distance:{18.,32.,48.})for(double side:{-.3,.3})for(double width:{.4,1.2}){
    Config solver;solver.trigger_enabled=false;Engine e(solver);e.setRoad(r,{{0,5000,4.5,4.5}});auto cloud=ground();
    for(double x=distance;x<=distance+.6;x+=.2)
      for(double y=side-width/2;y<=side+width/2+.001;y+=.1)cloud.push_back({x,y,-1.3});
    observe(e,cloud);auto result=e.plan(pose(1.2),r);
    ASSERT_TRUE(result.clear)<<distance<<","<<side<<","<<width<<":"<<result.reason;
    EXPECT_TRUE(e.validate(result.path,1.2));
    auto closest=std::min_element(result.path.begin(),result.path.end(),[&](const Reference&a,const Reference&b){
      return std::abs(a.x-(302501.1+distance))<std::abs(b.x-(302501.1+distance));});
    EXPECT_LT(side*(closest->y-4124000.),0);
    EXPECT_DOUBLE_EQ(e.config().obstacle_margin,.2);
  }
}

