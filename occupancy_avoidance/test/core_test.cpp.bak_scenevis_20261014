TEST(Approach,PlansForFarObstacleBeforeStaticMissionStart){
  auto r=road();for(auto&q:r)q.idx+=2200;
  Config solver;solver.trigger_enabled=false;Engine e(solver);e.setRoad(r,{{0,5000,3.4,5.5}});auto cloud=ground();
  cloud.push_back({48,0,-1.3});observe(e,cloud);
  auto result=e.plan(pose(1.2),r);ASSERT_TRUE(result.clear)<<result.reason;
  EXPECT_GE(result.planning_horizon,49.);EXPECT_TRUE(result.avoiding);
  EXPECT_TRUE(e.validate(result.path,1.2));
  Config old;old.trigger_enabled=false;old.length=60;old.horizon=43;old.static_planning_start_idx=2400;
  Engine previous(old);previous.setRoad(r,{{0,5000,3.4,5.5}});observe(previous,cloud);
  auto before=previous.plan(pose(1.2),r);ASSERT_TRUE(before.clear);
  EXPECT_EQ(before.planning_horizon,40.);EXPECT_FALSE(before.avoiding);
}
