 auto points=ground();for(double y=-.4;y<=.4;y+=.1)points.push_back({6,y,-1.3});
 for(int i=0;i<3;++i)e.integrate(pose(1.3+i*.1),points);
 std::vector<Reference> prefix;for(const auto&p:initial.path)if(p.x<=302520.)prefix.push_back(p);
 std::vector<Reference> connected;std::string why;EXPECT_FALSE(e.connect(pose(1.5),prefix,1.5,connected,&why));
}
