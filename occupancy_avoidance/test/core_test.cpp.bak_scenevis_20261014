TEST(Connector,RemoteCollisionDoesNotInvalidateSafeStoppingPrefix){
 Engine e;e.setRoad(road(),{{0,800,5.,5.}});observe(e,ground());
 auto initial=e.plan(pose(1.2),road());ASSERT_TRUE(initial.clear);
 auto points=ground();for(double y=-.4;y<=.4;y+=.1)points.push_back({27,y,-1.3});
 for(int i=0;i<3;++i)e.integrate(pose(1.3+i*.1),points);
 std::string why;EXPECT_FALSE(e.validate(initial.path,1.5,&why));
 std::vector<Reference> prefix;for(const auto&p:initial.path)if(p.x<=302520.)prefix.push_back(p);
 std::vector<Reference> connected;ASSERT_TRUE(e.connect(pose(1.5),prefix,1.5,connected,&why))<<why;
 EXPECT_TRUE(e.validate(connected,1.5));
 EXPECT_GE(connected.back().x-connected.front().x,8.*8./(2*2.)+1.);
}
TEST(Connector,NearCollisionCannotUseStoppingPrefix){
