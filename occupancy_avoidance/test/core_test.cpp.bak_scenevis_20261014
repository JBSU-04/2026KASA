std::vector<Reference> road(){std::vector<Reference> r;for(int i=0;i<=800;++i)r.push_back({302500.+i*.1,4124000.,0,i});return r;}
Pose pose(double stamp=1.){return {stamp,302500.,4124000.,0,0,8};}
std::vector<Point> ground(){std::vector<Point> p;for(double x=4;x<40;x+=.5)for(double y=-3;y<=3;y+=.5)p.push_back({x,y,-1.765});return p;}
void observe(Engine&e,const std::vector<Point>&p){for(int i=0;i<3;++i)e.integrate(pose(1+i*.1),p);}
}
