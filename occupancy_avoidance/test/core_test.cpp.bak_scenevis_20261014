TEST(Return,ClearRoadReturnsFromEitherSideWithoutResidualOffset){
  for(double side:{-1.,1.}){
    Engine e;auto r=road();e.setRoad(r,{{0,800,3.4,5.5}});auto p=pose();p.y+=side*1.2;
    e.integrate(p,ground());auto result=e.plan(p,r);
    ASSERT_TRUE(result.clear)<<result.reason;EXPECT_TRUE(result.returning);
    EXPECT_NEAR(result.path.front().y,p.y,.01);
    EXPECT_NEAR(result.path.back().y,4124000.,.05);
    auto at12=std::min_element(result.path.begin(),result.path.end(),[](const Reference&a,const Reference&b){return std::abs(a.x-302512.)<std::abs(b.x-302512.);});
    EXPECT_LT(std::abs(at12->y-4124000.),.35);
    EXPECT_TRUE(e.validate(result.path,p.stamp));
    for(const auto&q:result.path)EXPECT_GE(side*(q.y-4124000.),-.1001);
  }
}
