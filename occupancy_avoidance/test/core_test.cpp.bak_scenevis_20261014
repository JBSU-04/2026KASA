  for(double x=20;x<=22;x+=.15)for(double y=-1.8;y<=.1;y+=.15)p.push_back({x,y,-1.3});observe(e,p);
  auto far=e.plan(pose(1.2),r);ASSERT_TRUE(far.clear)<<far.reason;
  auto point=std::min_element(far.path.begin(),far.path.end(),[](const Reference&a,const Reference&b){return std::abs(a.x-302510.)<std::abs(b.x-302510.);});
  auto current=pose(3.2);current.x=point->x;current.y=point->y;current.yaw=point->yaw;e.integrate(current,ground());
  r.erase(r.begin(),r.begin()+100);auto near=e.plan(current,r);ASSERT_TRUE(near.clear)<<near.reason;
