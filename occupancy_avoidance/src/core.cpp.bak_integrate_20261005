  if(last_path_.size()>5){size_t j=0;double best=INF;
    for(size_t i=0;i<last_path_.size();++i){double d=std::hypot(last_path_[i].x-pose.x,last_path_[i].y-pose.y);if(d<best){best=d;j=i;}}
    std::vector<Reference> remain(last_path_.begin()+j,last_path_.end());
    double remaining=0;for(size_t i=1;i<remain.size();++i)remaining+=distance(remain[i-1],remain[i]);
    double keep_distance=std::max(15.,std::abs(pose.speed)*2);
    if(approach)keep_distance=std::max(keep_distance,out.planning_horizon-5.);
    if(best<.5&&remaining>keep_distance&&validate(remain,pose.stamp)){
      out.path=resample(remain,.1);out.clear=true;out.held=true;out.reason="held_valid_path";out.max_curvature=curvature(out.path);
      double maxd=0;for(const auto&p:out.path){const auto*r=nearestRoad(p.x,p.y);if(r)maxd=std::max(maxd,std::abs(-(p.x-r->x)*std::sin(r->yaw)+(p.y-r->y)*std::cos(r->yaw)));}
      out.avoiding=maxd>.25;out.speed_cap=std::min(out.avoiding?cfg_.target_speed:9999.,std::sqrt(cfg_.max_lateral_accel/std::max(.001,out.max_curvature)));
      // A rejected direct return must not discard a still-safe avoidance path.
