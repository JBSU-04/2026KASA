      const double a3=-10*a0-6*a1-3*a2,a4=15*a0+8*a1+3*a2,a5=-6*a0-3*a1-a2;
      std::vector<Reference> candidate;double s=0;bool dynamics=true;
      for(size_t i=0;i<nominal.size();++i){
        if(i)s+=distance(nominal[i-1],nominal[i]);
        const double u=std::min(1.,s/length);
        double d=0;
        if(s<length){
          d=a0+u*(a1+u*(a2+u*(a3+u*(a4+u*a5))));
          const double dd=(2*a2+u*(6*a3+u*(12*a4+u*20*a5)))/(length*length);
          const double ddd=(6*a3+u*(24*a4+u*60*a5))/(length*length*length);
          if(std::abs(dd)*v*v>std::max(cfg_.spatial_return_accel,std::abs(initial_bending)*v*v)+.01||
             std::abs(ddd)*v*v*v>cfg_.spatial_return_jerk+.01)dynamics=false;
          if((d0<-.2&&d>cfg_.return_overshoot)||(d0>.2&&d<-cfg_.return_overshoot))dynamics=false;
        }
