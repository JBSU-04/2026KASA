  // around its searched path. Never accept a smoothed path solely on QP success.
  std::string failure="solver_failed";
  for(int attempt=0;attempt<4;++attempt){
    StandalonePathProblem qp(N,cfg_.knot_ds,{d0,slope,initial_bending});
    auto constrained=limits;
    if(attempt>=2)for(size_t i=1;i<N;++i){double radius=attempt==2?.25:.05;
      constrained[i].first=std::max(constrained[i].first,target[i]-radius);constrained[i].second=std::min(constrained[i].second,target[i]+radius);}
    qp.set_x_bounds(constrained);qp.set_dx_bounds(-cfg_.max_slope,cfg_.max_slope);
    double bending=attempt==0?std::min(cfg_.max_curvature*.7,cfg_.max_lateral_accel/(cfg_.target_speed*cfg_.target_speed)):cfg_.max_curvature*.7;
    bending=std::max(bending,std::abs(initial_bending));
    qp.set_ddx_bounds(-bending,bending);qp.set_dddx_bound(cfg_.max_lateral_jerk);
    qp.set_weight_x(.1);qp.set_weight_dx(15);qp.set_weight_ddx(150);qp.set_weight_dddx(300);
    qp.set_x_ref(10,target);qp.set_scale_factor({1,1,1});
    if(terminal_return<N&&limits.back().first<=0&&limits.back().second>=0)
      qp.set_end_state_ref({100,50,50},{0,0,0});
    if(!qp.Optimize(3000)){
      failure="solver_status_"+std::to_string(qp.status);
      // Tightening a proven infeasible relaxed corridor cannot restore feasibility.
      // Reserve repair attempts for solutions which fail the geometric sweep.
      if(attempt>=1&&qp.status==OSQP_PRIMAL_INFEASIBLE)break;
      continue;
    }
    // Evaluate the actual continuous piecewise-jerk solution, not straight
    // chords between 1m knots (which create fictitious curvature spikes).
    std::vector<Reference> path;
    for(size_t i=0;i+1<N;++i)for(double t=0;t<cfg_.knot_ds-1e-7;t+=.1){
      Reference base=referenceAt(ref,i,t/cfg_.knot_ds);
      double jerk=(qp.opt_ddx()[i+1]-qp.opt_ddx()[i])/cfg_.knot_ds;
      double d=qp.opt_x()[i]+qp.opt_dx()[i]*t+.5*qp.opt_ddx()[i]*t*t+jerk*t*t*t/6;
