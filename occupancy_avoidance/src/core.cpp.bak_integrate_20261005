constexpr double INF=1e20;
double wrap(double a) { return std::atan2(std::sin(a),std::cos(a)); }
double distance(const Reference&a,const Reference&b){return std::hypot(a.x-b.x,a.y-b.y);}
Reference offset(Reference p,double d){p.x-=std::sin(p.yaw)*d;p.y+=std::cos(p.yaw)*d;return p;}
void headings(std::vector<Reference>& p){
  for(size_t i=0;i+1<p.size();++i)p[i].yaw=std::atan2(p[i+1].y-p[i].y,p[i+1].x-p[i].x);
  if(p.size()>1)p.back().yaw=p[p.size()-2].yaw;
}
double curvature(const std::vector<Reference>& p){
  double k=0;for(size_t i=1;i+1<p.size();++i){double ds=.5*(distance(p[i-1],p[i])+distance(p[i],p[i+1]));
    if(ds>1e-4)k=std::max(k,std::abs(wrap(p[i+1].yaw-p[i-1].yaw))/(2*ds));}return k;
}
// The same continuous nominal geometry used by the corridor optimizer. Raw
// 0.1m CSV chords can create artificial curvature spikes at their vertices.
Reference referenceAt(const std::vector<Reference>& ref,size_t i,double u){
  const size_t N=ref.size();double u2=u*u,u3=u2*u;
  const auto&a=ref[i];const auto&b=ref[i+1];
  auto prev=ref[i?i-1:i],next=ref[std::min(N-1,i+2)];
  double ax=i?(b.x-prev.x)/2:b.x-a.x,ay=i?(b.y-prev.y)/2:b.y-a.y;
  double bx=i+2<N?(next.x-a.x)/2:b.x-a.x,by=i+2<N?(next.y-a.y)/2:b.y-a.y;
  Reference base;
  base.x=(2*u3-3*u2+1)*a.x+(u3-2*u2+u)*ax+(-2*u3+3*u2)*b.x+(u3-u2)*bx;
  base.y=(2*u3-3*u2+1)*a.y+(u3-2*u2+u)*ay+(-2*u3+3*u2)*b.y+(u3-u2)*by;
  double tx=(6*u2-6*u)*a.x+(3*u2-4*u+1)*ax+(-6*u2+6*u)*b.x+(3*u2-2*u)*bx;
  double ty=(6*u2-6*u)*a.y+(3*u2-4*u+1)*ay+(-6*u2+6*u)*b.y+(3*u2-2*u)*by;
  base.yaw=std::atan2(ty,tx);base.idx=int(std::lround(a.idx+u*(b.idx-a.idx)));
  return base;
}
std::pair<int,int> bin(double x,double y){return {int(std::floor(x)),int(std::floor(y))};}
