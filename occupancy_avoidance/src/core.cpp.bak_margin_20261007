    for(size_t i=0;i<last_path_.size();++i){double d=std::hypot(last_path_[i].x-pose.x,last_path_[i].y-pose.y);
      if(d<best){best=d;j=i;}}
    std::vector<Reference> remain(last_path_.begin()+j,last_path_.end());
    double remaining=0;for(size_t i=1;i<remain.size();++i)remaining+=distance(remain[i-1],remain[i]);
    double keep_distance=std::max(15.,std::abs(pose.speed)*2);
    if(approach)keep_distance=std::max(keep_distance,out.planning_horizon-5.);
    if(best<.5&&remaining>keep_distance&&validate(remain,pose.stamp)){
      out.path=remain;out.clear=true;out.held=true;out.reason="held_spatial_return";
      return_rejection="none";
