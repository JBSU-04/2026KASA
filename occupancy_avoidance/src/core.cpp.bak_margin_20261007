Engine::Engine(Config c):cfg_(c),grid_({"static","transient","observed"}){reset();}
void Engine::reset(){
  tree_.reset(new octomap::OcTree(cfg_.resolution));tree_->setProbHit(.7);tree_->setProbMiss(.4);
  divider_hits_=0;divider_seen_=-1;
  evidence_.clear();ground_visibility_.clear();last_moving_stamp_=-1;obstacle_bins_.clear();last_path_.clear();live_.valid=false;initialized_=false;last_scan_=-1;last_pose_stamp_=-1;measured_curvature_=0;
  aligned_since_=-1;avoidance_session_=false;spatial_return_active_=false;held_trigger_.clear();certified_triggers_.clear();trigger_seen_=-1;traffic_=TrafficState();
  grid_.setFrameId("map");grid_.setGeometry(grid_map::Length(cfg_.length,cfg_.width),cfg_.resolution);
}
uint64_t Engine::key(const octomap::OcTreeKey& k) const {
  return (uint64_t(k[0])<<32)|(uint64_t(k[1])<<16)|k[2];
}
void Engine::setRoad(std::vector<Reference> road,std::vector<Edge> edges){
  road_=std::move(road);edges_=std::move(edges);base_edges_=edges_;road_tree_.clear();
  divider_hits_=0;divider_seen_=-1;applyConditionalEdges(0);
  std::vector<size_t> indices(road_.size());for(size_t i=0;i<indices.size();++i)indices[i]=i;
  buildRoad(indices,0,indices.size(),0);
}
void Engine::setConditionalDividers(std::vector<Edge> candidates){
  divider_candidates_=std::move(candidates);base_edges_=edges_;applyConditionalEdges(0);
}
std::vector<Edge> Engine::conditionalDividers(double now) const {
  std::vector<Edge> active;
  if(divider_hits_>=3&&now>=divider_seen_&&now-divider_seen_<=1.)
    for(const auto& e:divider_candidates_)if(e.first<=divider_last_&&e.last>=divider_first_)active.push_back(e);
  return active;
}
void Engine::applyConditionalEdges(double now){
  if(divider_candidates_.empty())return;edges_=base_edges_;
  for(auto& e:edges_)for(const auto& c:divider_candidates_)if(e.first==c.first)e.left=-1;
  for(const auto& c:conditionalDividers(now))for(auto& e:edges_)if(e.first==c.first)e.left=c.left;
}
void Engine::observeDividers(const Pose& pose,const std::vector<Point>& returns){
  if(divider_candidates_.empty())return;
  double c=std::cos(pose.yaw),s=std::sin(pose.yaw);std::set<int> bins,tall;
  for(const auto& q:returns){double h=q.z+cfg_.sensor_height;
    if(h<.35||h>cfg_.max_height||q.x<0||q.x>35)continue;
    double x=pose.x+c*(q.x+cfg_.sensor_x)-s*(q.y+cfg_.sensor_y),y=pose.y+s*(q.x+cfg_.sensor_x)+c*(q.y+cfg_.sensor_y);
    const auto* r=nearestRoad(x,y);if(!r)continue;double lat=-(x-r->x)*std::sin(r->yaw)+(y-r->y)*std::cos(r->yaw);
    for(const auto& e:divider_candidates_)if(r->idx>=e.first&&r->idx<=e.last&&std::abs(lat-(e.left+.1))<=.3){if(h>.95)tall.insert(r->idx/10);else if(h<=.9)bins.insert(r->idx/10);break;}
  }
  for(int b:tall)for(int db=-1;db<=1;++db)bins.erase(b+db);
  int groups=0,last=-999;for(int b:bins){if(b>last+1)++groups;last=b;}
  bool detected=bins.size()>=3&&groups>=3&&(*bins.rbegin()-*bins.begin())>=5;
  if(detected){if(pose.stamp-divider_seen_>.25)divider_hits_=0;
    ++divider_hits_;divider_seen_=pose.stamp;divider_first_=*bins.begin()*10;divider_last_=*bins.rbegin()*10+9;
  }else if(divider_hits_<3)divider_hits_=0;
  applyConditionalEdges(pose.stamp);
}
int Engine::buildRoad(std::vector<size_t>& ids,size_t a,size_t b,unsigned axis){
  if(a>=b)return -1;
  size_t mid=(a+b)/2;
  std::nth_element(ids.begin()+a,ids.begin()+mid,ids.begin()+b,[&](size_t i,size_t j){return axis?road_[i].y<road_[j].y:road_[i].x<road_[j].x;});
  int node=road_tree_.size();road_tree_.push_back({ids[mid],-1,-1,axis});
  int left=buildRoad(ids,a,mid,1-axis),right=buildRoad(ids,mid+1,b,1-axis);
  road_tree_[node].left=left;road_tree_[node].right=right;return node;
}
void Engine::queryRoad(int node,double x,double y,double& best,const Reference*& found) const{
  if(node<0)return;
  const auto&n=road_tree_[node];const auto&p=road_[n.point];
  double dx=x-p.x,dy=y-p.y,dist=dx*dx+dy*dy;if(dist<best){best=dist;found=&p;}
  double delta=n.axis?dy:dx;queryRoad(delta<0?n.left:n.right,x,y,best,found);
  if(delta*delta<best)queryRoad(delta<0?n.right:n.left,x,y,best,found);
}
const Reference* Engine::nearestRoad(double x,double y) const {
  const Reference* best=nullptr;double d=100.;if(!road_tree_.empty())queryRoad(0,x,y,d,best);return best;
}
bool Engine::liveBoundaryApplies(int idx) const {
  if(!live_.valid||std::abs(last_scan_-live_.pose.stamp)>=.5||idx<0||size_t(idx)>=road_.size())return false;
  const auto&r=road_[idx];double dx=r.x-live_.pose.x,dy=r.y-live_.pose.y;
  double x=std::cos(live_.pose.yaw)*dx+std::sin(live_.pose.yaw)*dy;
  double angle=wrap(r.yaw-live_.pose.yaw);
  return x>-6&&x<cfg_.live_boundary_distance&&
    std::abs(wrap(angle-std::atan(live_.right_slope)))<cfg_.live_boundary_heading&&
    std::abs(wrap(angle-std::atan(live_.left_slope)))<cfg_.live_boundary_heading;
}
std::string Engine::boundarySource(int idx) const {
  if(liveBoundaryApplies(idx))return "live_local";
  for(const auto&e:edges_)if(idx>=e.first&&idx<=e.last&&(e.right>0||e.left>0))return "measured_profile";
  return "open";
}
std::pair<double,double> Engine::bounds(int idx) const {
  if(liveBoundaryApplies(idx)){
    const auto&r=road_[idx];double dx=r.x-live_.pose.x,dy=r.y-live_.pose.y;
    double x=std::cos(live_.pose.yaw)*dx+std::sin(live_.pose.yaw)*dy;
    double y=-std::sin(live_.pose.yaw)*dx+std::cos(live_.pose.yaw)*dy;
    double angle=r.yaw-live_.pose.yaw;
    double cr=std::cos(angle)+live_.right_slope*std::sin(angle),cl=std::cos(angle)+live_.left_slope*std::sin(angle);
    if(cr>.5 && cl>.5){
      double br=-live_.right*std::sqrt(1+live_.right_slope*live_.right_slope);
      double bl=live_.left*std::sqrt(1+live_.left_slope*live_.left_slope);
      return {(br-y+live_.right_slope*x)/cr,(bl-y+live_.left_slope*x)/cl};
    }
  }
  double inset=cfg_.half_width+cfg_.curb_margin;
  for(const auto&e:edges_)if(idx>=e.first && idx<=e.last)
    return {e.right>0?-e.right:-cfg_.open_right-inset,e.left>0?e.left:cfg_.open_left+inset};
  return {-cfg_.open_right-inset,cfg_.open_left+inset};
}
bool Engine::boundaryKnown(int idx,bool left)const {
  if(liveBoundaryApplies(idx))return true;
  for(const auto&e:edges_)if(idx>=e.first&&idx<=e.last)return left?e.left>0:e.right>0;
  return false;
}
bool Engine::roadInside(double x,double y,double inset,double* clearance) const {
  const auto*r=nearestRoad(x,y);if(!r)return true;
  auto b=bounds(r->idx);double d=-(x-r->x)*std::sin(r->yaw)+(y-r->y)*std::cos(r->yaw);
  bool right=boundaryKnown(r->idx,false),left=boundaryKnown(r->idx,true);
  if(clearance)*clearance=std::min(right?d-b.first:INF,left?b.second-d:INF);
  return (!right||d>=b.first+inset-1e-6) && (!left||d<=b.second-inset+1e-6);
}
bool Engine::integrate(const Pose& pose,const std::vector<Point>& returns,const std::vector<Point>& ground,
                       const std::vector<DynamicRegion>& dynamic){
  if(!std::isfinite(pose.stamp+pose.x+pose.y+pose.z+pose.yaw)||returns.empty())return false;
  if(last_scan_>=0 && pose.stamp<last_scan_-.05)reset();
  if(last_scan_>=0 && pose.stamp<=last_scan_+.06)return false; // independent 10 Hz scans only
  if(initialized_ && last_pose_stamp_>=0){double dt=pose.stamp-last_pose_stamp_;
    double max_step=std::max(2.0,(std::abs(pose.speed)+5)*dt);
    if(std::hypot(pose.x-scan_pose_.x,pose.y-scan_pose_.y)>max_step ||
       std::abs(wrap(pose.yaw-scan_pose_.yaw))>std::max(.25,dt*1.5))reset();}
  if(!initialized_){origin_x_=pose.x;origin_y_=pose.y;origin_z_=pose.z;initialized_=true;}
  if(last_pose_stamp_>=0){
    const double travelled=std::hypot(pose.x-scan_pose_.x,pose.y-scan_pose_.y);
    if(travelled>.05){
      double observed=wrap(pose.yaw-scan_pose_.yaw)/travelled;
      measured_curvature_=.5*measured_curvature_+.5*std::max(-cfg_.max_curvature,std::min(cfg_.max_curvature,observed));
    }else if(std::abs(pose.speed)<.2)measured_curvature_=0;
  }
  scan_pose_=pose;last_pose_stamp_=pose.stamp;observeDividers(pose,returns);
  const double c=std::cos(pose.yaw),s=std::sin(pose.yaw);
  // GroundGrid ground samples are authoritative. Fit residual road slope in
  // gravity-aligned sensor coordinates; fallback uses only the expected road band.
  std::vector<Point> candidates;
  const auto& source=ground.empty()?returns:ground;
  for(const auto&p:source)if(p.x>-8&&p.x<20&&std::abs(p.y)<3.5&&
      std::isfinite(p.z)&&std::abs(p.z+cfg_.sensor_height)<.25)candidates.push_back(p);
  Eigen::Vector3d plane(0,0,-cfg_.sensor_height);
  if(candidates.size()>=30){
    for(int iteration=0;iteration<3;++iteration){Eigen::Matrix3d A=Eigen::Matrix3d::Zero();Eigen::Vector3d v=Eigen::Vector3d::Zero();int n=0;
      for(const auto&p:candidates){Eigen::Vector3d row(p.x,p.y,1);
        if(iteration && std::abs(row.dot(plane)-p.z)>.045)continue;
        A+=row*row.transpose();v+=row*p.z;++n;}
      if(n<20||std::abs(A.determinant())<1e-6)break;
      auto fit=A.ldlt().solve(v).eval();if(fit.allFinite()&&std::abs(fit[0])<.08&&std::abs(fit[1])<.08&&std::abs(fit[2]+cfg_.sensor_height)<.15)plane=fit;
    }
  }
  ground_plane_[0]=plane[0];ground_plane_[1]=plane[1];ground_plane_[2]=plane[2];
  // GroundGrid is a measured surface, not one plane extrapolated over 40m.
  std::map<std::pair<int,int>,std::vector<Point>> terrain_samples;
  std::map<std::pair<int,int>,Eigen::Vector3d> terrain_planes;
  for(const auto&p:ground){
    if(!std::isfinite(p.x+p.y+p.z)||std::abs(p.z-(plane[0]*p.x+plane[1]*p.y+plane[2]))>.5)continue;
    terrain_samples[{int(std::floor(p.x/2)),int(std::floor(p.y/2))}].push_back(p);
  }
  auto terrain=[&](double x,double y){
    std::pair<int,int> cell{int(std::floor(x/2)),int(std::floor(y/2))};
    auto found=terrain_planes.find(cell);if(found!=terrain_planes.end())return found->second;
    std::vector<Point> samples;
    for(int dx=-1;dx<=1;++dx)for(int dy=-1;dy<=1;++dy){
      auto it=terrain_samples.find({cell.first+dx,cell.second+dy});
      if(it!=terrain_samples.end())samples.insert(samples.end(),it->second.begin(),it->second.end());
    }
    Eigen::Vector3d local=plane;
    for(int iteration=0;iteration<3;++iteration){
      Eigen::Matrix3d A=Eigen::Matrix3d::Zero();Eigen::Vector3d v=Eigen::Vector3d::Zero();int n=0;
      for(const auto&p:samples){Eigen::Vector3d row(p.x,p.y,1);double residual=p.z-row.dot(local);
        if(iteration&&(residual>.03||residual<-.06))continue;
        A+=row*row.transpose();v+=row*p.z;++n;
      }
      if(n<6||std::abs(A.determinant())<1e-6)break;
      Eigen::Vector3d fit=A.ldlt().solve(v);
      if(!fit.allFinite()||std::abs(fit[0])>.2||std::abs(fit[1])>.2||std::abs(Eigen::Vector3d(x,y,1).dot(fit-plane))>.5)break;
      local=fit;
    }
    terrain_planes[cell]=local;return local;
  };
  std::map<uint64_t,Point> occupied;std::set<uint64_t> free_keys;octomap::KeyRay ray;
  octomap::point3d origin(float(pose.x-origin_x_+c*cfg_.sensor_x-s*cfg_.sensor_y),
    float(pose.y-origin_y_+s*cfg_.sensor_x+c*cfg_.sensor_y),float(pose.z-origin_z_+cfg_.sensor_z));
  std::set<uint64_t> endpoint_keys;
  std::vector<std::pair<octomap::point3d,bool>> endpoints;endpoints.reserve(returns.size());
  for(const auto&p:returns){
    if(!std::isfinite(p.x+p.y+p.z))continue;
    double bx=p.x+cfg_.sensor_x,by=p.y+cfg_.sensor_y;
    // Entire nearby road width; curb exterior is excluded geometrically, not by a detector box.
    if(bx< -cfg_.rear-cfg_.rear_observation_distance||bx>cfg_.length*.75||std::abs(by)>cfg_.width*.5)continue;
    if(bx>-cfg_.rear&&bx<cfg_.front&&std::abs(by)<cfg_.half_width)continue;
    // 천장(터널) 점: 차 높이 장애물 칸을 지나지 않으므로 누적·광선추적 모두 뺀다.
    if(cfg_.ceiling_skip_height>0&&p.z+cfg_.sensor_height>cfg_.ceiling_skip_height)continue;
    Point w{pose.x+c*bx-s*by,pose.y+s*bx+c*by,p.z+pose.z+cfg_.sensor_z};
    octomap::point3d end(float(w.x-origin_x_),float(w.y-origin_y_),float(w.z-origin_z_));
    octomap::OcTreeKey k;if(!tree_->coordToKeyChecked(end,k))continue;
    uint64_t code=key(k);if(!endpoint_keys.insert(code).second)continue;
    Eigen::Vector3d local=ground.empty()?plane:terrain(p.x,p.y);
    // Local GroundGrid support may correct a rising road, but must never lower
    // the established road plane and manufacture new obstacle cells.
    double global_height=plane[0]*p.x+plane[1]*p.y+plane[2];
    double surface_height=std::max(global_height,local[0]*p.x+local[1]*p.y+local[2]);
    double h=p.z-surface_height;
    if(std::abs(h)<.045)ground_visibility_[{int(std::floor(w.x/.5)),int(std::floor(w.y/.5))}]=pose.stamp;
    double edge_clearance=1e9;bool inside=roadInside(w.x,w.y,0,&edge_clearance);
    bool curb_surface=(edge_clearance<=.12 && h<=.65)||
      (cfg_.wall_surface_band>0&&edge_clearance<=cfg_.wall_surface_band);  // 터널 벽면(벽 밑동 산포 + DR 횡오차)
    bool low_certified=cfg_.certified_min_height>0&&h>=cfg_.certified_min_height&&h<cfg_.min_height&&
      nearCertified(w.x,w.y,pose.stamp);
    bool obstacle=(h>=cfg_.min_height||low_certified)&&h<=cfg_.max_height&&inside&&!curb_surface;
    if(obstacle)occupied.emplace(code,w);
    endpoints.push_back({end,obstacle});
  }
  // 2026-10-07(20:08:55 백): 정지 8 s 뒤 후진을 시도할 때 차 바로 뒤 바닥(근거리 사각)은 11 s 전에 본 것이라
  //   10 s 창에서 지워져 reverse_unobserved 로 영구 정지했다. 서 있는 시간은 나이에 넣지 않는다(최대 60 s).
  if(std::abs(pose.speed)>.2||last_moving_stamp_<0||pose.stamp<last_moving_stamp_)last_moving_stamp_=pose.stamp;
  const double horizon=visibilityHorizon(pose.stamp);
  for(auto it=ground_visibility_.begin();it!=ground_visibility_.end();)
    if(pose.stamp-it->second>horizon)it=ground_visibility_.erase(it);else ++it;
  // Raycast all returns, including ground. A beam at a different elevation cannot
  // clear a previous obstacle voxel. No-return rays are never manufactured.
  for(const auto&e:endpoints){if(tree_->computeRayKeys(origin,e.first,ray))
    for(const auto&k:ray)if(evidence_.count(key(k)))free_keys.insert(key(k));}
  for(uint64_t code:free_keys){if(occupied.count(code))continue;auto it=evidence_.find(code);if(it==evidence_.end())continue;
    auto&e=it->second;if(pose.stamp-e.last_clear<.06)continue;
    if(pose.stamp-e.last_clear>.6)e.misses=0;
    e.last_clear=pose.stamp;
    ++e.misses;
    if((!e.fixed && e.misses>=1)||e.misses>=cfg_.clear_scans){octomap::OcTreeKey k;k[0]=code>>32;k[1]=code>>16;k[2]=code;
      tree_->deleteNode(k);evidence_.erase(it);}
  }
  auto is_dynamic=[&dynamic](const Point&p){for(const auto&r:dynamic){double dx=p.x-r.x,dy=p.y-r.y;
    if(std::abs(dx*std::cos(r.yaw)+dy*std::sin(r.yaw))<=r.length/2+.3&&
       std::abs(-dx*std::sin(r.yaw)+dy*std::cos(r.yaw))<=r.width/2+.3)return true;}return false;};
  // A verified moving track also clears its previous occupied region from the
  // persistent layer. Its current returns remain immediate transient hazards.
  for(auto&kv:evidence_)if(is_dynamic(kv.second.p)){kv.second.fixed=false;kv.second.hits=0;}
  for(const auto&kv:occupied){auto&e=evidence_[kv.first];bool moving=is_dynamic(kv.second);
    if(e.hits==0||pose.stamp-e.last>cfg_.transient_sec){e.hits=0;e.first=pose.stamp;}
    ++e.hits;e.last=pose.stamp;e.misses=0;
    octomap::OcTreeKey voxel_key;voxel_key[0]=kv.first>>32;voxel_key[1]=kv.first>>16;voxel_key[2]=kv.first;
    auto center=tree_->keyToCoord(voxel_key);e.p={origin_x_+center.x(),origin_y_+center.y(),origin_z_+center.z()};
    if(!moving&&e.hits>=cfg_.confirm_scans&&pose.stamp-e.first>=.14)e.fixed=true;
    octomap::OcTreeKey k;k[0]=kv.first>>32;k[1]=kv.first>>16;k[2]=kv.first;tree_->updateNode(k,true,true);
  }
  last_scan_=pose.stamp;rebuild(pose.stamp);return true;
}
void Engine::rebuild(double now){
  obstacle_bins_.clear();
  const double c=std::cos(scan_pose_.yaw),s=std::sin(scan_pose_.yaw);
  grid_.setGeometry(grid_map::Length(std::abs(c)*cfg_.length+std::abs(s)*cfg_.width,
    std::abs(s)*cfg_.length+std::abs(c)*cfg_.width),cfg_.resolution,
    grid_map::Position(scan_pose_.x+c*cfg_.length*.25,scan_pose_.y+s*cfg_.length*.25));
  for(const auto& layer:grid_.getLayers())grid_[layer].setConstant(0);
  std::vector<octomap::OcTreeKey> erase_keys;
  for(auto it=evidence_.begin();it!=evidence_.end();){auto&e=it->second;
    double dx=e.p.x-scan_pose_.x,dy=e.p.y-scan_pose_.y;
    double forward=c*dx+s*dy,lateral=-s*dx+c*dy;
    bool outside=forward < -cfg_.length*.25||forward>cfg_.length*.75||std::abs(lateral)>cfg_.width/2;
    if(outside||(!e.fixed&&now-e.last>cfg_.transient_sec)){
      octomap::OcTreeKey k;k[0]=it->first>>32;k[1]=it->first>>16;k[2]=it->first;tree_->deleteNode(k);it=evidence_.erase(it);continue;}
    // Preserve accumulated geometry; conditional boundaries only mask collision admission.
    if(!roadInside(e.p.x,e.p.y,0)){++it;continue;}
    obstacle_bins_[bin(e.p.x,e.p.y)].push_back(e.p);
    grid_map::Index index;if(grid_.getIndex(grid_map::Position(e.p.x,e.p.y),index)){
      grid_.at(e.fixed?"static":"transient",index)=1;grid_.at("observed",index)=float(now-e.last);}
    ++it;
  }
  if(cfg_.certified_far_proxy)addCertifiedProxies(now);
  static FILE* dump=std::getenv("OCC_DUMP_BINS")?std::fopen(std::getenv("OCC_DUMP_BINS"),"w"):nullptr;
  if(dump){for(const auto&kv:obstacle_bins_)for(const auto&q:kv.second)std::fprintf(dump,"%.3f %.2f %.2f %.2f\n",now,q.x,q.y,q.z);std::fflush(dump);}
}
static bool nearPolygon(const std::vector<Point>& f,double x,double y,double m){
  bool in=false;
  for(size_t i=0,j=f.size()-1;i<f.size();j=i++){
    if(((f[i].y>y)!=(f[j].y>y))&&(x<(f[j].x-f[i].x)*(y-f[i].y)/(f[j].y-f[i].y+1e-12)+f[i].x))in=!in;
    const double ex=f[i].x-f[j].x,ey=f[i].y-f[j].y,l2=ex*ex+ey*ey;
    double u=l2>1e-12?((x-f[j].x)*ex+(y-f[j].y)*ey)/l2:0.;u=std::max(0.,std::min(1.,u));
    if(std::hypot(x-f[j].x-u*ex,y-f[j].y-u*ey)<=m)return true;
  }
  return in;
}
void Engine::addCertifiedProxies(double now){
  const double m=cfg_.certified_margin;
  for(const auto& object:certified_triggers_){
    const auto& f=object.footprint;
    if(f.size()<3||now<object.stamp-.05||now-object.stamp>cfg_.trigger_hold)continue;
    double x0=INF,x1=-INF,y0=INF,y1=-INF;
    for(const auto& p:f){x0=std::min(x0,p.x);x1=std::max(x1,p.x);y0=std::min(y0,p.y);y1=std::max(y1,p.y);}
    if(x1-x0>8.||y1-y0>8.)continue;   // 합쳐진 거대 외곽은 쓰지 않는다
    int real=0;auto b0=bin(x0-m,y0-m),b1=bin(x1+m,y1+m);
    for(int bx=std::min(b0.first,b1.first);bx<=std::max(b0.first,b1.first);++bx)
      for(int by=std::min(b0.second,b1.second);by<=std::max(b0.second,b1.second);++by){
        auto it=obstacle_bins_.find({bx,by});if(it==obstacle_bins_.end())continue;
        for(const auto& q:it->second)if(nearPolygon(f,q.x,q.y,m))++real;}
    if(real>=cfg_.certified_far_min_cells)continue;
    std::vector<Point> proxy;
    for(size_t i=0,j=f.size()-1;i<f.size();j=i++){
      const double ex=f[i].x-f[j].x,ey=f[i].y-f[j].y;int n=std::max(1,int(std::ceil(std::hypot(ex,ey)/.2)));
      for(int k=0;k<n;++k)proxy.push_back({f[j].x+ex*k/n,f[j].y+ey*k/n,0});}
    for(double x=x0;x<=x1;x+=.3)for(double y=y0;y<=y1;y+=.3)if(nearPolygon(f,x,y,0.))proxy.push_back({x,y,0});
    for(const auto& p:proxy)if(roadInside(p.x,p.y,0))obstacle_bins_[bin(p.x,p.y)].push_back(p);
  }
}
size_t Engine::staticCount() const{size_t n=0;for(const auto&kv:evidence_)n+=kv.second.fixed;return n;}
uint64_t Engine::geometryDigest() const{
  // Include full 3D points and confirmation/clearing history, not just 2D boxes.
  uint64_t h=1469598103934665603ULL;
  auto bytes=[&](const void* ptr,size_t n){const auto*b=static_cast<const unsigned char*>(ptr);for(size_t i=0;i<n;++i){h^=b[i];h*=1099511628211ULL;}};
  for(const auto&kv:evidence_){bytes(&kv.first,sizeof(kv.first));const auto&e=kv.second;
    for(double v:{e.p.x,e.p.y,e.p.z,e.first,e.last,e.last_clear})bytes(&v,sizeof(v));
    for(int v:{e.hits,e.misses,int(e.fixed)})bytes(&v,sizeof(v));}
  return h;
}
bool Engine::nearCertified(double x,double y,double stamp) const {
  // 측정점만 판정한다(상자/외곽선을 격자에 칠하지 않는다).
  const double m=cfg_.certified_margin;
  for(const auto& object:certified_triggers_){
    const auto& f=object.footprint;
    if(f.size()<3||stamp<object.stamp-.05||stamp-object.stamp>cfg_.trigger_hold)continue;
    double x0=INF,x1=-INF,y0=INF,y1=-INF;
    for(const auto& p:f){x0=std::min(x0,p.x);x1=std::max(x1,p.x);y0=std::min(y0,p.y);y1=std::max(y1,p.y);}
    if(x<x0-m||x>x1+m||y<y0-m||y>y1+m)continue;
    bool in=false;
    for(size_t i=0,j=f.size()-1;i<f.size();j=i++){
      if(((f[i].y>y)!=(f[j].y>y))&&(x<(f[j].x-f[i].x)*(y-f[i].y)/(f[j].y-f[i].y+1e-12)+f[i].x))in=!in;
      const double ex=f[i].x-f[j].x,ey=f[i].y-f[j].y,l2=ex*ex+ey*ey;
      double u=l2>1e-12?((x-f[j].x)*ex+(y-f[j].y)*ey)/l2:0.;u=std::max(0.,std::min(1.,u));
      if(std::hypot(x-f[j].x-u*ex,y-f[j].y-u*ey)<=m)return true;
    }
    if(in)return true;
  }
  return false;
}
bool Engine::bodyClear(const Reference&p,double now,std::string* reason) const {
  static const bool body_debug_c=std::getenv("OCC_BODY_DEBUG")!=nullptr;
  if(!roadInside(p.x,p.y,cfg_.half_width+cfg_.curb_margin)){if(body_debug_c)std::fprintf(stderr,"BODY curb_center\n");if(reason)*reason="curb_center";return false;}
  double c=std::cos(p.yaw),s=std::sin(p.yaw);
  // Center has the requested 1.05m inset. Corners only check the physical curb;
  // do NOT subtract half width a second time from the corner coordinates.
  for(double x:{-cfg_.rear,0.,cfg_.front})for(double y:{-cfg_.half_width,cfg_.half_width})
    if(!roadInside(p.x+c*x-s*y,p.y+s*x+c*y,0)){if(body_debug_c)std::fprintf(stderr,"BODY curb_body corner(%.1f,%.1f)\n",x,y);if(reason)*reason="curb_body";return false;}
  double rad=cfg_.front+cfg_.obstacle_margin+.15;auto b=bin(p.x,p.y);int m=int(std::ceil(rad));
  for(int dx=-m;dx<=m;++dx)for(int dy=-m;dy<=m;++dy){auto it=obstacle_bins_.find({b.first+dx,b.second+dy});
    if(it==obstacle_bins_.end())continue;
    for(const auto&q:it->second){double qx=q.x-p.x,qy=q.y-p.y;
      double a=c*qx+s*qy,d=-s*qx+c*qy;
      double pad=cfg_.obstacle_margin+cfg_.resolution*.7072;
      if(a>=-cfg_.rear-pad&&a<=cfg_.front+pad&&std::abs(d)<=cfg_.half_width+pad){
        static const bool body_debug=std::getenv("OCC_BODY_DEBUG")!=nullptr;
        if(body_debug)std::fprintf(stderr,"BODY occ at body(%.2f,%.2f) z %.2f world(%.2f,%.2f)\n",a,d,q.z,q.x,q.y);
        if(reason)*reason="occupancy";
        return false;}}}
  (void)now;return true;
}
std::vector<Reference> Engine::resample(const std::vector<Reference>& in,double ds) const {
  std::vector<Reference> out;if(in.size()<2)return in;out.push_back(in.front());double next=ds,total=0;
  for(size_t i=1;i<in.size();++i){double len=distance(in[i-1],in[i]);if(len<1e-6)continue;
    while(next<=total+len+1e-7){double u=(next-total)/len;Reference p;
      p.x=in[i-1].x+u*(in[i].x-in[i-1].x);p.y=in[i-1].y+u*(in[i].y-in[i-1].y);
      p.yaw=in[i-1].yaw+u*wrap(in[i].yaw-in[i-1].yaw);p.idx=int(std::lround(in[i-1].idx+u*(in[i].idx-in[i-1].idx)));
      out.push_back(p);next+=ds;}total+=len;}
  return out;
}
bool Engine::validate(const std::vector<Reference>& path,double now,std::string* reason,double* failure_distance) const {
  if(path.size()<2){if(reason)*reason="short_path";return false;}
  auto dense=resample(path,.15);
  // Check sweep between dense samples as well as their oriented rectangles.
  headings(dense);double travelled=0;
  for(size_t i=0;i<dense.size();++i){if(i)travelled+=distance(dense[i-1],dense[i]);
    if(!bodyClear(dense[i],now,reason)){if(failure_distance)*failure_distance=travelled;return false;}}
  if(curvature(dense)>cfg_.max_curvature){if(reason)*reason="curvature";return false;}return true;
}
void Engine::updateMotion(Result& out,const Pose& pose,const std::vector<Reference>& route){
  if(!out.clear||out.path.size()<3||route.empty())return;
  out.boundary_source=boundarySource(route.front().idx);
  const auto&r0=route.front();double d0=-(pose.x-r0.x)*std::sin(r0.yaw)+(pose.y-r0.y)*std::cos(r0.yaw);
  double travelled=0,near_offset=0,max_offset=0,first_avoid=INF,return_offset=std::abs(d0);
  const double return_distance=std::max(cfg_.return_min_distance,std::abs(pose.speed)*cfg_.return_min_time);
  bool return_sample=false;double limit=9999;
  for(size_t i=0;i<out.path.size();++i){
    if(i)travelled+=distance(out.path[i-1],out.path[i]);
    const auto*r=nearestRoad(out.path[i].x,out.path[i].y);if(!r)continue;
    double d=std::abs(-(out.path[i].x-r->x)*std::sin(r->yaw)+(out.path[i].y-r->y)*std::cos(r->yaw));
    max_offset=std::max(max_offset,d);if(travelled<=cfg_.cruise_preview)near_offset=std::max(near_offset,d);
    if(!return_sample&&travelled>=return_distance){return_offset=d;return_sample=true;}
    if(d>cfg_.cruise_path_offset){
      first_avoid=std::min(first_avoid,travelled);
      size_t a=i?i-1:i,b=std::min(i+1,out.path.size()-1);
      double ds=distance(out.path[a],out.path[b]);
      double k=ds>1e-4?std::abs(wrap(out.path[b].yaw-out.path[a].yaw))/ds:0;
      double local=std::min(cfg_.speedCeiling(),std::sqrt(cfg_.max_lateral_accel/std::max(.001,k)));
      double available=std::max(0.,travelled-std::abs(pose.speed)*cfg_.reaction);
      limit=std::min(limit,std::sqrt(local*local+2*cfg_.braking*available));
    }
  }
  bool center_clear=true;auto reference=resample(route,.5);travelled=0;
  for(size_t i=0;i<reference.size();++i){
    if(i)travelled+=distance(reference[i-1],reference[i]);
    if(travelled>cfg_.return_min_distance)break;
    if(!bodyClear(reference[i],pose.stamp)){center_clear=false;break;}
  }
  bool aligned=std::abs(d0)<=cfg_.cruise_offset&&std::abs(wrap(pose.yaw-r0.yaw))<=cfg_.cruise_heading&&
    near_offset<=cfg_.cruise_path_offset&&center_clear;
  if(std::abs(d0)>cfg_.cruise_offset||near_offset>cfg_.cruise_path_offset)avoidance_session_=true;
  if(aligned){if(aligned_since_<0)aligned_since_=pose.stamp;
    if(pose.stamp-aligned_since_>=cfg_.cruise_hold)avoidance_session_=false;
  }else aligned_since_=-1;
  out.avoiding=max_offset>cfg_.cruise_path_offset||avoidance_session_;
  out.returning=avoidance_session_&&center_clear&&return_offset<std::abs(d0);
  out.motion_state=out.returning?"RETURNING":avoidance_session_?"AVOIDING":first_avoid<INF?"APPROACH":"CRUISE";
  // Nominal curves belong to the already-tuned MPC. Only avoidance geometry
  // produces a second curvature cap; propagate future caps back by braking distance.
  if(avoidance_session_)limit=std::min(limit,cfg_.speedCeiling());
  out.speed_cap=limit;out.speed_limit_reason=limit>=500?"released_to_mpc":first_avoid<INF?"avoidance_distance_profile":"alignment_hold";
}
// Admission is deliberately read-only with respect to evidence and geometry.
void Engine::selectTrigger(const Pose& pose,const std::vector<Reference>& ref,Result& out){
  if(!cfg_.trigger_enabled){out.trigger_reason="disabled";return;}
  std::vector<double> arc(ref.size(),0);
  for(size_t i=1;i<ref.size();++i)arc[i]=arc[i-1]+distance(ref[i-1],ref[i]);
  auto location=[&](const Point& p,double* signed_d=nullptr){
    double best=INF,best_u=0;size_t best_i=0;
    // Query the supplied active reference, not a nearest index on the entire
    // CSV: a nearby parallel road or crossing must not steal object ownership.
    for(size_t i=0;i+1<ref.size();++i){
      double dx=ref[i+1].x-ref[i].x,dy=ref[i+1].y-ref[i].y,l2=dx*dx+dy*dy;
      if(l2<1e-10)continue;
      double u=((p.x-ref[i].x)*dx+(p.y-ref[i].y)*dy)/l2;
      if(i>0)u=std::max(0.,u);
      if(i+2<ref.size())u=std::min(1.,u);
      double x=p.x-ref[i].x-u*dx,y=p.y-ref[i].y-u*dy,d2=x*x+y*y;
      if(d2<best){best=d2;best_i=i;best_u=u;}
    }
    double ds=distance(ref[best_i],ref[best_i+1]);
    if(signed_d){double dx=ref[best_i+1].x-ref[best_i].x,dy=ref[best_i+1].y-ref[best_i].y;
      *signed_d=(dx*(p.y-ref[best_i].y)-dy*(p.x-ref[best_i].x))/std::max(1e-9,ds);}
    return std::make_pair(arc[best_i]+best_u*ds,std::sqrt(best));
  };
  double pad=cfg_.resolution*.7072,nearest=INF;
  std::vector<Point> current;int outside=0,far=0,unconfirmed=0,passed=0;
  double seen=trigger_seen_;
  for(const auto& kv:evidence_){const auto&e=kv.second;auto l=location(e.p);
    if(l.first+pad < -cfg_.rear-cfg_.obstacle_margin){++passed;continue;}
    if(l.second-pad>cfg_.trigger_half_width){++outside;continue;}
    if(l.first-pad>cfg_.trigger_distance){++far;continue;}
    if(!e.fixed){++unconfirmed;continue;}
    // Fixed cells survive occlusion, but that must not refresh admission time.
    if(pose.stamp-e.last>cfg_.scan_timeout)continue;
    current.push_back(e.p);nearest=std::min(nearest,l.first-pad);seen=std::max(seen,e.last);
  }
  bool certified=false;
  // Sparse 16-channel returns can visit different 0.1m voxels every scan. Reuse
  // the original object's independent temporal verification for admission; do
  // not paint its box/hull into the collision map or alter any measured point.
  for(const auto& object:certified_triggers_){
    if(object.footprint.size()<3||pose.stamp<object.stamp-.05||pose.stamp-object.stamp>cfg_.trigger_hold)continue;
    double smin=INF,smax=-INF,dmin=INF,dmax=-INF;bool inside=false;
    for(const auto& p:object.footprint){double d;auto l=location(p,&d);
      smin=std::min(smin,l.first);smax=std::max(smax,l.first);
      dmin=std::min(dmin,d);dmax=std::max(dmax,d);inside|=roadInside(p.x,p.y,0);}
    if(!inside||smax<-cfg_.rear-cfg_.obstacle_margin||smin>cfg_.trigger_distance||
       dmin>cfg_.trigger_half_width||dmax<-cfg_.trigger_half_width)continue;
    current.insert(current.end(),object.footprint.begin(),object.footprint.end());
    nearest=std::min(nearest,smin);seen=std::max(seen,object.stamp);certified=true;
  }
  if(!current.empty()){held_trigger_=current;trigger_seen_=seen;out.trigger_count=current.size();out.trigger_reason=certified?"certified_static_geometry":"confirmed_in_corridor";}
  else if(trigger_seen_>=0&&pose.stamp-trigger_seen_<=cfg_.trigger_hold){
    for(const auto&p:held_trigger_){auto l=location(p);if(l.first+pad>=-cfg_.rear-cfg_.obstacle_margin){
      nearest=std::min(nearest,l.first-pad);++out.trigger_count;}}
    out.trigger_held=out.trigger_count>0;out.trigger_reason=out.trigger_held?"held_trigger":"passed";
  }else out.trigger_reason=unconfirmed?"unconfirmed":far?"outside_trigger_distance":outside?"outside_corridor":passed?"passed":"no_trigger";
  if(!out.trigger_count)held_trigger_.clear();
  out.trigger_nearest=nearest<INF?nearest:-1;
}
// Publish only a validated nominal prefix while admission is withheld.
bool Engine::approvalPath(Result& out,const Pose& pose,const std::vector<Reference>& nominal,double stop,const std::string& reason){
  out.path.clear();out.held=false;out.corridor.clear();double arc=0;
  for(size_t i=0;i<nominal.size();++i){if(i)arc+=distance(nominal[i-1],nominal[i]);
    if(arc>stop+1e-7||!bodyClear(nominal[i],pose.stamp))break;
    out.path.push_back(nominal[i]);}
  double covered=0;for(size_t i=1;i<out.path.size();++i)covered+=distance(out.path[i-1],out.path[i]);
  out.clear=out.path.size()>2&&validate(out.path,pose.stamp);
  out.reason=out.clear?reason:reason+"_collision_stop";
  out.max_curvature=out.clear?curvature(out.path):0;
  if(!out.clear){out.path.clear();last_path_.clear();spatial_return_active_=false;out.speed_cap=0;return false;}
  last_path_=out.path;spatial_return_active_=false;
  // A full reference needs no additional cap; a prefix stops before its end.
  double full=0;for(size_t i=1;i<nominal.size();++i)full+=distance(nominal[i-1],nominal[i]);
  if(reason=="admission_reference"&&covered+.15>=full)out.reason="reference_passthrough";
  out.speed_cap=covered+0.15<full?std::sqrt(2*cfg_.braking*std::max(0.,covered-std::abs(pose.speed)*cfg_.reaction-.5)):9999;
  return true;
}
bool Engine::locate(double x,double y,Reference& out) const {
  const auto* r=nearestRoad(x,y);if(!r)return false;out=*r;return true;
}
