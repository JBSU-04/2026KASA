    }
  }
  int J=int(std::ceil((cfg_.open_left+cfg_.open_right)/cfg_.lateral_step))+1;
  std::vector<double> offsets(J);for(int j=0;j<J;++j)offsets[j]=-cfg_.open_right+j*cfg_.lateral_step;
  std::vector<std::vector<double>> cost(N,std::vector<double>(J,INF));
  std::vector<std::vector<int>> back(N,std::vector<int>(J,-1));
  std::vector<std::vector<bool>> valid(N,std::vector<bool>(J,false));
  for(size_t i=0;i<N;++i)for(int j=0;j<J;++j){auto lim=bounds(ref[i].idx);double d=offsets[j];
    if(d<lim.first+cfg_.half_width+cfg_.curb_margin||d>lim.second-cfg_.half_width-cfg_.curb_margin)continue;
    valid[i][j]=bodyClear(offset(ref[i],d),pose.stamp);}
  // Exact current state at the first knot, rather than snapping the car to the grid.
  int j0=int(std::lround((d0+cfg_.open_right)/cfg_.lateral_step));j0=std::max(0,std::min(J-1,j0));
  offsets[j0]=d0;Reference initial=offset(ref[0],d0);initial.yaw=pose.yaw;
  for(size_t i=1;i<N;++i){auto lim=bounds(ref[i].idx);
    valid[i][j0]=d0>=lim.first+cfg_.half_width+cfg_.curb_margin&&d0<=lim.second-cfg_.half_width-cfg_.curb_margin&&bodyClear(offset(ref[i],d0),pose.stamp);}
  if(!bodyClear(initial,pose.stamp,&out.reason))return finish();
  cost[0][j0]=0;valid[0][j0]=true;
  if(const char* ds=std::getenv("OCC_DEBUG_STAMP"))if(std::abs(pose.stamp-std::atof(ds))<.06){
    std::fprintf(stderr,"LATTICE d0 %.2f j0 %d speed %.2f\n",d0,j0,pose.speed);
    for(size_t i=0;i<N&&i<34;++i){auto lim=bounds(ref[i].idx);std::fprintf(stderr,"row %zu idx %d lim %.2f %.2f ",i,ref[i].idx,lim.first,lim.second);
      for(int j=0;j<J;++j)std::fputc(valid[i][j]?'#':'.',stderr);std::fputc('\n',stderr);}}
  for(size_t i=1;i<N;++i){for(int j=0;j<J;++j)if(valid[i][j]){
    double prev_target=0;bool has_previous=false;
