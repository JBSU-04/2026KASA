bool Engine::connect(const Pose& pose,const std::vector<Reference>& path,double now,
                     std::vector<Reference>& out,std::string* reason) const {
  out.clear();
  if(path.size()<3||now-last_scan_>cfg_.scan_timeout||now<last_scan_-.05){
    if(reason)*reason="connector_stale_or_short";return false;
  }
  size_t nearest=0;double best=INF;
  for(size_t i=0;i<path.size();++i){double d=std::hypot(path[i].x-pose.x,path[i].y-pose.y);
    if(d<best){best=d;nearest=i;}}
  // Direct reuse is allowed only when it already starts at this pose and heading.
  if(best<.015&&std::abs(wrap(path[nearest].yaw-pose.yaw))<.01){
    out.assign(path.begin()+nearest,path.end());out.front().x=pose.x;out.front().y=pose.y;
    if(validate(out,now,reason))return true;out.clear();
  }
  double arc=0,next_target=2.;
  std::vector<std::pair<double,std::vector<Reference>>> pending;
  static const bool conn_debug=std::getenv("OCC_CONNECT_DEBUG")!=nullptr;
  if(conn_debug)std::fprintf(stderr,"CONNECT path %zu nearest %zu best %.3f pose(%.2f,%.2f,%.3f) path0(%.2f,%.2f,%.3f)\n",
    path.size(),nearest,best,pose.x,pose.y,pose.yaw,path[0].x,path[0].y,path[0].yaw);
  for(size_t j=nearest+1;j+2<path.size();++j){
    arc+=distance(path[j-1],path[j]);if(arc<next_target)continue;
    if(arc>10.)break;next_target=arc+1.;
    const auto& end=path[j];double length=std::hypot(end.x-pose.x,end.y-pose.y);
    if(length<1.||length>12.)continue;
    double end_k=wrap(path[j+1].yaw-path[j-1].yaw)/std::max(.01,distance(path[j-1],path[j])+distance(path[j],path[j+1]));
    auto coefficients=[&](double start,double finish,double v0,double v1,double a0,double a1){
      std::array<double,6> c{{start,v0,a0/2,0,0,0}};
      double d=finish-c[0]-c[1]-c[2],v=v1-c[1]-2*c[2],a=a1-2*c[2];
      c[3]=10*d-4*v+a/2;c[4]=-15*d+7*v-a;c[5]=6*d-3*v+a/2;return c;
    };
    auto x=coefficients(pose.x,end.x,length*std::cos(pose.yaw),length*std::cos(end.yaw),
      -length*length*measured_curvature_*std::sin(pose.yaw),-length*length*end_k*std::sin(end.yaw));
    auto y=coefficients(pose.y,end.y,length*std::sin(pose.yaw),length*std::sin(end.yaw),
      length*length*measured_curvature_*std::cos(pose.yaw),length*length*end_k*std::cos(end.yaw));
    std::vector<Reference> candidate;int n=std::max(20,int(std::ceil(length/.1)));
    bool forward=true;
    for(int i=0;i<n;++i){double t=double(i)/n;
      auto value=[&](const std::array<double,6>& c){double v=c[5];for(int k=4;k>=0;--k)v=v*t+c[k];return v;};
      auto derivative=[&](const std::array<double,6>& c){double v=5*c[5];for(int k=4;k>=1;--k)v=v*t+k*c[k];return v;};
      double dx=derivative(x),dy=derivative(y);
      if(std::hypot(dx,dy)<.1||dx*std::cos(pose.yaw)+dy*std::sin(pose.yaw)<=0){forward=false;break;}
      candidate.push_back({value(x),value(y),std::atan2(dy,dx),end.idx});
    }
    if(!forward){if(conn_debug)std::fprintf(stderr,"  cand j %zu len %.2f backward\n",j,length);continue;}
    candidate.insert(candidate.end(),path.begin()+j,path.end());
    if(cfg_.connector_smooth){
      // 2026-10-06: 가장 짧은 연결은 추종 오차를 2~4 m 안에서 급히 꺾어 맞춘다. 후보를 모아 최대 곡률 순으로 검증한다.
      double peak=0;size_t m=candidate.size()-(path.size()-j);
      for(size_t i=1;i+1<m;++i)peak=std::max(peak,std::abs(wrap(candidate[i+1].yaw-candidate[i-1].yaw))/
        std::max(.01,distance(candidate[i-1],candidate[i])+distance(candidate[i],candidate[i+1])));
      pending.emplace_back(peak,std::move(candidate));continue;
    }
    if(validate(candidate,now,reason)){out=std::move(candidate);return true;}
  }
  std::stable_sort(pending.begin(),pending.end(),[](const auto& a,const auto& b){return a.first<b.first;});
  for(auto& c:pending){if(validate(c.second,now,reason)){out=std::move(c.second);return true;}
    if(conn_debug)std::fprintf(stderr,"  cand peak %.3f invalid: %s\n",c.first,reason?reason->c_str():"");}
  if(conn_debug)std::fprintf(stderr,"  pending %zu arc_end %.2f\n",pending.size(),arc);
  if(reason&&reason->empty())*reason="no_valid_connector";
  return false;
}
Result Engine::evaluateEscape(const Pose& pose,const std::vector<Reference>& route) const {
  auto trial=recoverySnapshot();trial->avoidance_session_=true;
  trial->cfg_.trigger_enabled=false;trial->measured_curvature_=0;
  return trial->plan(pose,route);
}
bool Engine::validateReverse(const std::vector<Reference>& path,double now,std::string* reason) const {
  if(path.empty()||now-last_scan_>cfg_.scan_timeout||now<last_scan_){if(reason)*reason="stale_geometry";return false;}
  Engine trial(cfg_);trial.obstacle_bins_=obstacle_bins_;trial.road_=road_;trial.edges_=edges_;
  trial.road_tree_=road_tree_;trial.live_=live_;trial.last_scan_=last_scan_;
  trial.cfg_.obstacle_margin=.5;
  // Keep vehicle headings; reversing a tangent must not flip the front/rear body.
  for(const auto& p:resample(path,.2)){
    if(!trial.bodyClear(p,now,reason))return false;
    // Occupancy is not evidence of visibility. Require ray-cleared cells behind
    // the rear axle across the full swept width; unknown space cannot authorize R.
    for(double lat:{-cfg_.half_width,0.,cfg_.half_width}){
      double x=p.x-std::cos(p.yaw)*(cfg_.rear+.5)-std::sin(p.yaw)*lat;
      double y=p.y-std::sin(p.yaw)*(cfg_.rear+.5)+std::cos(p.yaw)*lat;
      bool known=false;int ix=int(std::floor(x/.5)),iy=int(std::floor(y/.5));
      for(int dx=-1;dx<=1;++dx)for(int dy=-1;dy<=1;++dy){
        auto it=ground_visibility_.find({ix+dx,iy+dy});
        if(it!=ground_visibility_.end()&&now>=it->second&&now-it->second<=visibilityHorizon(now))known=true;
      }
      if(!known){if(reason)*reason="reverse_unobserved";return false;}
    }
  }
  return true;
}
Result Engine::plan(const Pose& pose,const std::vector<Reference>& route){
  applyConditionalEdges(pose.stamp);
  auto begin=std::chrono::steady_clock::now();Result out;out.static_voxels=staticCount();out.transient_voxels=count()-out.static_voxels;
  const bool tunnel=!route.empty()&&route.front().idx>=7000&&route.front().idx<=9000;
  const bool approach=!route.empty()&&route.front().idx>=cfg_.static_planning_start_idx&&route.front().idx<cfg_.static_zone_min_idx;
  // Additional clearance for partially observed first-obstacle surfaces only.
  // Restore it on every exit: map evidence and later missions retain their size.
  struct MarginGuard { double& value;double saved;~MarginGuard(){value=saved;} } guard{cfg_.obstacle_margin,cfg_.obstacle_margin};
  if(approach)cfg_.obstacle_margin=std::max(cfg_.obstacle_margin,cfg_.approach_obstacle_margin);
  std::string return_rejection="not_requested";
  const bool actual_offset=!route.empty()&&(std::abs(-(pose.x-route.front().x)*std::sin(route.front().yaw)+(pose.y-route.front().y)*std::cos(route.front().yaw))>cfg_.cruise_offset||std::abs(wrap(pose.yaw-route.front().yaw))>cfg_.cruise_heading);
  const double current_reference_curvature=route.size()>1?wrap(route[1].yaw-route[0].yaw)/std::max(.01,distance(route[0],route[1])):0;
  const bool already_avoiding=avoidance_session_||actual_offset||std::abs(measured_curvature_-current_reference_curvature)>.003;
  bool admission_limited=false;double admission_cap=9999;
  bool partial_approach=false;
  auto finish=[&](){
    if(!out.clear&&(approach||tunnel)&&!approach_fallback_in_progress_&&out.reason=="no_connected_corridor"&&
        out.failure_distance>cfg_.front+cfg_.obstacle_margin+(approach?14.:6.)){
      const double blockage=out.failure_distance;
      double& horizon=approach?cfg_.approach_horizon:cfg_.horizon;
      const double saved_horizon=horizon;
      horizon=std::min(cfg_.horizon,blockage-cfg_.front-cfg_.obstacle_margin-2.);
      approach_fallback_in_progress_=true;auto prefix=plan(pose,route);
      approach_fallback_in_progress_=false;horizon=saved_horizon;
      if(prefix.clear){out=prefix;out.reason=(approach?"approach_safe_prefix_":"tunnel_safe_prefix_")+prefix.reason;
        out.approach_blockage_distance=blockage;return_rejection=prefix.return_rejection_reason;partial_approach=true;}
    }
    out.return_rejection_reason=return_rejection;
    // Turning-state continuity may invoke the solver while centered. It must
    // not accidentally admit a remote/unconfirmed obstacle through that path.
    if(out.clear&&cfg_.trigger_enabled&&!avoidance_session_&&!actual_offset&&out.trigger_count==0){
      bool new_shift=false;
      for(const auto&p:out.path){const auto*r=nearestRoad(p.x,p.y);if(!r)continue;
        double d=std::abs(-(p.x-r->x)*std::sin(r->yaw)+(p.y-r->y)*std::cos(r->yaw));
        if(d>cfg_.cruise_path_offset){new_shift=true;break;}}
      if(new_shift){approvalPath(out,pose,resample(route,.1),INF,"admission_reference");
        admission_limited=true;admission_cap=out.speed_cap;}
    }
    if(out.traffic_held){admission_limited=true;admission_cap=std::min(admission_cap,out.speed_cap);}
    if(out.clear&&!out.traffic_held&&!actual_offset&&out.trigger_count>0&&traffic_.enabled&&traffic_.seen&&
       traffic_.distance>=0&&traffic_.distance<=cfg_.traffic_range){
      const bool fresh=pose.stamp-traffic_.distance_stamp<=cfg_.traffic_timeout&&pose.stamp-traffic_.required_stamp<=cfg_.traffic_timeout&&
        pose.stamp>=traffic_.distance_stamp&&pose.stamp>=traffic_.required_stamp;
      out.traffic_stop_target=traffic_.stop_target;
      if(!fresh||traffic_.required){
        double arc=0,last_shift=-1,full=0,need=0;
        for(size_t i=0;i<out.path.size();++i){if(i)arc+=distance(out.path[i-1],out.path[i]);
          const auto*r=nearestRoad(out.path[i].x,out.path[i].y);if(!r)continue;
          double d=std::abs(-(out.path[i].x-r->x)*std::sin(r->yaw)+(out.path[i].y-r->y)*std::cos(r->yaw));
          need=std::max(need,d);
          if(d>cfg_.cruise_offset||std::abs(wrap(out.path[i].yaw-r->yaw))>cfg_.cruise_heading)last_shift=arc;
        }full=arc;
        double completion=last_shift>=0?last_shift+cfg_.return_min_distance:0;
        out.return_complete_distance=completion;
        bool completed=completion<=full&&completion<=traffic_.stop_target;
        if(!fresh||!completed){
          double ratio=std::max(0.,std::min(1.,(need-.35)/(1.85-.35)));
          double gap=cfg_.traffic_gap_min+ratio*(cfg_.traffic_gap_max-cfg_.traffic_gap_min);
          double stop=std::max(0.,std::min(traffic_.stop_target,out.trigger_nearest-gap));
          auto reference=resample(route,.1);
          approvalPath(out,pose,reference,stop,fresh?"traffic_return_space_hold":"traffic_input_stale_hold");
          out.traffic_held=true;admission_limited=true;
          admission_cap=std::min(out.speed_cap,std::sqrt(2*cfg_.traffic_decel*std::max(0.,stop-std::abs(pose.speed)*cfg_.reaction)));
        }
      }
    }
    if(out.clear)updateMotion(out,pose,route);
    if(out.clear&&admission_limited){out.speed_cap=std::min(out.speed_cap,admission_cap);out.speed_limit_reason=out.traffic_held?"traffic_avoidance_hold":"admission_path_coverage";}

    double coverage=0;for(size_t i=1;i<out.path.size();++i)coverage+=distance(out.path[i-1],out.path[i]);
    if(out.clear&&(approach||tunnel)&&(partial_approach||coverage+5<out.planning_horizon)){
      double cover=std::max(0.,coverage-std::abs(pose.speed)*cfg_.reaction-2.);
      double cap=std::sqrt(2*cfg_.braking*cover);
      if(cap<out.speed_cap){out.speed_cap=cap;out.speed_limit_reason=approach?"approach_visible_coverage":"tunnel_safe_prefix_coverage";}
    }
    out.compute_ms=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-begin).count();return out;
  };
  if(route.size()<2){out.reason="short_reference";return finish();}
  if(!initialized_||pose.stamp-last_scan_>cfg_.scan_timeout||pose.stamp<last_scan_-.05){out.reason="stale_lidar";return finish();}
  auto ref=resample(route,cfg_.knot_ds);if(ref.size()<6){out.reason="short_reference";return finish();}
  double mapped_horizon=std::min(approach?cfg_.approach_horizon:cfg_.horizon,
    cfg_.length*.75-cfg_.front-cfg_.obstacle_margin);
  const size_t N=std::min(ref.size(),size_t(mapped_horizon/cfg_.knot_ds)+1);ref.resize(N);
  out.planning_horizon=(N-1)*cfg_.knot_ds;
  double d0=-(pose.x-ref[0].x)*std::sin(ref[0].yaw)+(pose.y-ref[0].y)*std::cos(ref[0].yaw);
  const double max_heading=std::atan(cfg_.max_slope);
  double slope=std::tan(std::max(-max_heading,std::min(max_heading,wrap(pose.yaw-ref[0].yaw))));
  const double reference_curvature=wrap(ref[1].yaw-ref[0].yaw)/cfg_.knot_ds;
  const double initial_bending=std::max(-cfg_.max_curvature*.7,std::min(cfg_.max_curvature*.7,
    (measured_curvature_-reference_curvature)*std::pow(1+slope*slope,1.5)));
  // Nominal clear runs guide future avoidance tails. Actual post-pass return
  // is handled separately by the frozen spatial quintic below.
  double return_distance=std::max(cfg_.return_min_distance,std::abs(pose.speed)*cfg_.return_min_time);
  std::vector<bool> center_return(N,false),center_free(N,false);std::vector<double> return_ramp(N,1.);
  const double ramp_len=cfg_.return_ramp_time>0?std::max(cfg_.return_ramp_min_m,std::abs(pose.speed)*cfg_.return_ramp_time):0.;
  for(size_t i=0;i<N;++i)center_free[i]=bodyClear(ref[i],pose.stamp);
  bool return_available=false,prefix_return=false;size_t terminal_return=N,terminal_start=N;
  for(size_t start=0;start<N;){
    if(!center_free[start]){++start;continue;}
    size_t end=start+1;while(end<N&&center_free[end])++end;
    // 2026-10-07(20:38~20:41 백 3개): 두 장애물 사이 중앙이 12 m 정도 잠깐 비자 복귀를 켰다가 곧 다시 피해야 해서
    //   좌/우 통과 쪽이 프레임마다 바뀌고 -20 도 넘게 꺾다 장애물 앞/옆에서 영구정지했다. 빈 구간 뒤에 또 막힌
    //   중앙이 있으면(end<N) 복귀 거리 + 차 길이 + 5 m 가 비어 있을 때만 복귀한다. 아니면 지금 쪽에 머문다.
    const double needed=end<N?return_distance+cfg_.front+cfg_.rear+5.:return_distance;
    if((end-start-1)*cfg_.knot_ds>=needed){
      return_available=true;if(start==0)prefix_return=true;
      size_t begin=std::min(end,start+size_t(std::ceil(1./cfg_.knot_ds)));
      for(size_t i=begin;i<end;++i){center_return[i]=true;
        // 복귀 시작 직후부터 서서히(0 -> 1). 이미 중앙 근처에서 시작하는 구간(start==0)은 그대로.
        if(ramp_len>0&&start>0)return_ramp[i]=std::min(1.,(double(i-begin)+1)*cfg_.knot_ds/ramp_len);}
      if(end==N){terminal_return=begin;terminal_start=start;}
    }start=end;
