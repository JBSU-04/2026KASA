      std::abs(slope)>.005||std::abs(initial_bending)>=.003)){
    const double v=std::max(std::abs(pose.speed),cfg_.spatial_return_min_speed);
    const double ta=std::sqrt(5.774*std::abs(d0)/std::max(.1,cfg_.spatial_return_accel));
    const double tj=std::cbrt(60*std::abs(d0)/std::max(.1,cfg_.spatial_return_jerk));
    const double initial_length=std::max(cfg_.spatial_return_min_length,
      std::min(cfg_.spatial_return_max_length,v*std::max(.8,std::max(ta,tj))));
