#include <fstream>
#include <iostream>
#include <chrono>
#include <algorithm>
using namespace occupancy_avoidance;
template<class T> bool read(std::istream&s,T&v){return bool(s.read(reinterpret_cast<char*>(&v),sizeof(v)));}
