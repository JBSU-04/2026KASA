Panels:
  - Class: rviz/Displays
    Help Height: 0
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /1 RAW1
        - /2 GROUND1
        - /3 NONGROUND1
        - /4 DETECTION1
      Splitter Ratio: 0.5
    Tree Height: 720
  - Class: rviz/Selection
    Name: Selection
  - Class: rviz/Tool Properties
    Name: Tool Properties
  - Class: rviz/Views
    Expanded:
      - /Current View1
    Name: Views
    Splitter Ratio: 0.5
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.3
      Cell Size: 5
      Class: rviz/Grid
      Color: 100; 100; 100
      Enabled: true
      Line Style:
        Line Width: 0.03
        Value: Lines
      Name: Grid 5m
      Normal Cell Count: 0
      Offset: {X: 0, Y: 0, Z: 0}
      Plane: XY
      Plane Cell Count: 40
      Reference Frame: velodyne
      Value: true

    - Class: rviz/TF
      Enabled: false
      Name: TF
      Show Arrows: false
      Show Axes: true
      Show Names: true
      Marker Scale: 2
      Value: false

    # ---------- 1. RAW : 원본 점군 (높이 색상) ----------
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 130; 130; 130
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: false
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: 0.5
      Min Color: 0; 0; 0
      Min Intensity: -1.7
      Name: 1 RAW /velodyne_points
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic: /velodyne_points
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: false

    # ---------- 2. GROUND : GroundGrid가 지면으로 판정한 점 ----------
    - Alpha: 0.55
      Class: rviz/PointCloud2
      Color: 70; 130; 70
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: 2 GROUND /groundgrid/ground
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: false
      Size (Pixels): 2
      Size (m): 0.02
      Style: Points
      Topic: /groundgrid/ground
      Unreliable: false
      Use Fixed Frame: true
      Value: true

    # ---------- 3. NONGROUND : 장애물 후보 (높이별 색상) ----------
    #  파랑=지면높이(잔차 의심)  초록=12~35cm(라바콘/박스)  빨강=그 이상
    - Alpha: 1
      Autocompute Intensity Bounds: false
      Axis: Z
      Channel Name: z
      Class: rviz/PointCloud2
      Color: 255; 255; 255
      Color Transformer: AxisColor
      Decay Time: 0
      Enabled: true
      Invert Rainbow: false
      Max Color: 255; 255; 255
      Max Intensity: -1.2
      Min Color: 0; 0; 0
      Min Intensity: -1.6
      Name: 3 NONGROUND /nonground
      Position Transformer: XYZ
      Queue Size: 2
      Selectable: true
      Size (Pixels): 4
      Size (m): 0.04
      Style: Points
      Topic: /nonground
      Unreliable: false
      Use Fixed Frame: true
      Use rainbow: true
      Value: true

    # ---------- 4. DETECTION : 확정된 장애물 박스 ----------
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /obstacle_markers
      Name: 4 DETECTION /obstacle_markers
      Namespaces: {}
      Queue Size: 100
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /obstacle_markers_far
      Name: 4B FAR PROPOSAL /obstacle_markers_far
      Namespaces: {}
      Queue Size: 20
      Value: true

    # ---------- 5. TTC 트래커 (고주로) ----------
    - Class: rviz/MarkerArray
      Enabled: false
      Marker Topic: /tracked_objects_markers
      Name: 5 TTC /tracked_objects_markers
      Namespaces: {}
      Queue Size: 100
      Value: false

    # ---------- 7. 회전교차로 트래커 (M5) ----------
    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /perception/roundabout/tracker_markers
      Name: 7 ROUNDABOUT /tracker_markers
      Namespaces: {}
      Queue Size: 100
      Value: true

    - Class: rviz/MarkerArray
      Enabled: true
      Marker Topic: /perception/roundabout/roi_markers
      Name: 7B ROUNDABOUT ROI
      Namespaces: {}
      Queue Size: 10
      Value: true

    # ---------- 6. 경로 ----------
    - Alpha: 1
      Buffer Length: 1
      Class: rviz/Path
      Color: 255; 200; 0
      Enabled: true
      Head Diameter: 0
      Line Style: Lines
      Line Width: 0.1
      Name: 6 local_path
      Offset: {X: 0, Y: 0, Z: 0}
      Pose Style: None
      Queue Size: 10
      Radius: 0.03
      Shaft Diameter: 0
      Topic: /local_path
      Unreliable: false
      Value: true

  Enabled: true
  Global Options:
    Background Color: 20; 20; 24
    Default Light: true
    Fixed Frame: velodyne
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz/Interact
      Hide Inactive Objects: true
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/Measure
  Value: true
  Views:
    Current:
      Angle: -1.5708
      Class: rviz/TopDownOrtho
      Enable Stereo Rendering:
        Stereo Eye Separation: 0.06
        Stereo Focal Distance: 1
        Swap Stereo Eyes: false
        Value: false
      Invert Z Axis: false
      Name: Current View
      Near Clip Distance: 0.01
      Scale: 18
      Target Frame: velodyne
      X: 12
      Y: 0
    Saved:
      - Angle: -1.5708
        Class: rviz/TopDownOrtho
        Name: TOP 근거리(정동적)
        Near Clip Distance: 0.01
        Scale: 28
        Target Frame: velodyne
        X: 10
        Y: 0
      - Angle: -1.5708
        Class: rviz/TopDownOrtho
        Name: TOP 원거리(고주로)
        Near Clip Distance: 0.01
        Scale: 7
        Target Frame: velodyne
        X: 35
        Y: 0
      - Class: rviz/Orbit
        Distance: 30
        Focal Point: {X: 12, Y: 0, Z: 0}
        Name: 3D 측면(높이 확인)
        Near Clip Distance: 0.01
        Pitch: 0.12
        Target Frame: velodyne
        Yaw: 3.14
Window Geometry:
  Displays:
    collapsed: false
  Height: 1000
  Hide Left Dock: false
  Hide Right Dock: true
  Width: 1800
  X: 60
  Y: 30
