# =============================================================================
#  라이다 장착 기준값 — 모든 인지 노드가 여기서 받아간다
# =============================================================================
#
#  같은 물리량을 노드마다 다른 값으로 쓰고 있었다(1.25 / 1.686 / -1.68 / 1.592).
#  한 곳을 고쳐도 나머지에 반영이 안 돼서, 실제로 obstacle_perception 의
#  ground_z 가 9.4cm 틀어진 채 12~20cm 저상 장애물을 통째로 떨어뜨리고 있었다.
#  기준값은 여기 한 곳에서만 관리한다.
#
#  ★ 두 값의 '기준면'이 다르다. 헷갈리면 안 된다.
#     x, y, z            : 차량 원점(후륜축) 기준.  TF(base_link->velodyne)용.
#                          MORAI SensorInfo 의 pos 와 같은 기준이다.
#     z_from_ground      : 지면 기준.  지면 제거·고도 판정은 전부 이 값을 쓴다.
#     차량 원점은 지면이 아니므로(서스펜션·타이어·바디 오프셋) 둘이 같을 수 없다.
# =============================================================================

lidar_extrinsic:
  # --- 차량 원점 기준 (TF용). MORAI SensorInfo pos 와 일치시킨다 ---
  x: 1.1
  y: 0.0
  # 1.30 -> 1.33 (2026-09-17). MORAI SensorInfo 의 Lidar3DList pos.z 도
  # 같은 값으로 바꿔야 한다 - 둘이 어긋나면 TF 와 실제 점군이 틀어진다.
  z: 1.33
  yaw_deg: 0.0

  # --- 지면 기준 장착고 (지면제거/고도판정용) ---
  #  2026-09-14 재측정. MORAI 센서를 차량기준 z 1.35 -> 1.30 으로 내렸다.
  #  측정: 09-14 heavy 백 3개(19:37 / 19:43 / 19:47)의 /groundgrid/ground 를
  #        반경 3~12 m 로 잘라 프레임마다 평면(z = ax+by+c) 피팅, 절편 c 의
  #        중앙값을 센서 원점의 노면 높이로 봤다. 180 프레임.
  #          19:37  1.744 m     19:43  1.745 m     19:47  1.761 m
  #          전체 중앙값        1.7457 m
  #        (이전 config 1.730 은 실측보다 16 mm 낮게 잡혀 있었다.)
  #  그 백들은 z=1.35 로 주행한 것이므로, 차량원점->지면 오프셋은
  #        1.7457 - 1.35 = 0.3957 m
  #  새 장착고 = 1.30 + 0.3957 = 1.6957 -> 1.696 m
  #
  #  2026-09-16 재확인(z=1.30 주행 백, 15:18 heavy, 120 프레임):
  #        중앙값 1.6853 m (평균 1.6794, 표준편차 0.0231)
  #        -> 기록값 1.696 과 1 cm 차이. 노면 굴곡 범위 안이라 유지했다.
  #
  #  2026-09-17 실시간 재측정(z=1.33): /groundgrid/ground 를 반경 3~12m로
  #  잘라 프레임별 평면을 피팅했다. 8프레임 절편 중앙값 -1.7535m,
  #  표준편차 0.0004m. 거리 구간별 결과도 1.753~1.758m로 일치했다.
  z_from_ground: 1.754
