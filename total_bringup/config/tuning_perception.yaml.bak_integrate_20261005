# =============================================================================
#  미션별 인지·클러스터 튜닝 파일
# =============================================================================
#
#  적용:  roslaunch total_bringup tuning_perception.launch
#         (값 바꾼 뒤 런치 재시작. rosparam set 은 노드가 시작할 때만 읽으므로 안 먹는다)
#
#  화면 보는 법 (perception_tuning.rviz):
#     3 NONGROUND 레이어 색 = 높이.  파랑=지면높이  초록=12~35cm  빨강=그 이상
#       - 노면인데 파란 점이 깔린다      -> groundgrid/config/kcity_vlp16.yaml 조정
#       - 라바콘/박스가 안 보인다        -> 같은 파일의 높이 문턱 조정
#       - 점은 있는데 4 DETECTION 박스 X -> 검출필터가 기각 -> B, C 확인
#
#  ★ 표시가 주 조정 대상. 나머지는 그걸로 안 될 때만 만진다.
# =============================================================================

# -----------------------------------------------------------------------------
#  0. 센서 기준값  —  절대 임의로 바꾸지 말 것
# -----------------------------------------------------------------------------
#  지면이 센서 좌표계에서 갖는 z. 모든 높이 판정의 기준선이라 이게 틀어지면
#  아래 모든 고도 값이 통째로 밀린다.
#  2026-09-17: MORAI 센서를 차량기준 z=1.33으로 변경한 뒤 실시간
#  /groundgrid/ground 평면 피팅 결과 지면 기준 장착고는 1.7535m였다.
#  설정에는 mm 단위로 반올림한 1.754m를 사용한다.
#  아래 두 섹션에 같은 값이 들어간다. 하나만 고치면 안 되고 둘 다 맞춰야 한다.
#     obstacle_perception_node.ground_z = -1.754
#  단일 기준값은 total_bringup/config/lidar_extrinsic.yaml 이다.

# -----------------------------------------------------------------------------
#  B. 장애물 검출 (정동적 구간)  ->  src/yolo_test/launch/obstacle_perception.launch
# -----------------------------------------------------------------------------
obstacle_perception_node:
  # Applied after the shared ground removal. M3 and M8 share early crossing
  # observation; tunnel clustering is independently tunable. Restart to load.
  mission_filter_profiles:
    # 2026-09-23: 좌측 회피 상한을 4.5 -> 5.5 m 로 넓혔다(반대 차로 활용).
    #   차 중심 5.5 + 차체반폭 0.95 + 충돌반경 여유까지 물체가 보여야 한다.
    #   기본 수집폭 4.0 이면 그 밖의 물체는 클러스터 자체가 안 생겨 회피
    #   경로가 그 위로 그려질 수 있다. 동적 프로파일은 이미 8.0 을 쓴다.
    #   순서: roi_y >= gather >= collision.
    # 2026-09-25: 좌측 상한 5.5 -> 6.0(road_width_profile, 연석 실측 - 1.10).
    #   6.0 + 충돌반경 1.35 = 7.35 까지 보여야 하므로 7.0 -> 7.5 (roi 8.0).
    static:
      roi_y_min: -8.0
      roi_y_max: 8.0
      path_corridor_gather_half_width: 7.5
      collision_corridor_half_width: 7.5
    dynamic:
      roi_y_min: -8.0
      roi_y_max: 8.0
      path_corridor_gather_half_width: 8.0
      collision_corridor_half_width: 8.0
    tunnel:
      # 실측 터널 단면에 맞춘다. obstacle_stop_node 는 이미 예측충돌 분기에서
      #   if tunnel and (oy < -2.4 or oy > 5.5): tunnel_wall_roi
      # 로 실측 단면 밖을 버리는데, 인지는 ±8.0 을 코리도로 잡고 있어
      # 벽 바깥까지 전부 올려보냈다.
      #   실측 2026-09-13(16:08 백) M8 구간 collision_objects 7358개의
      #   횡분포: |y| 6~8 m 에 2553개(35%). 실측 단면 밖이라 사실상 벽이다.
      #   같은 구간 트리거 목록은 407개뿐 - 충돌목록의 대부분이 벽이었다.
      # 벽을 하류(obstacle_stop)에서 거르는 건 그 분기에만 있는 보호라,
      # 회피(new_lane 은 collision_corridor_half_width 로 판정)에는 적용되지
      # 않아 벽이 회피 후보를 계속 막는다. 애초에 안 올리는 쪽으로 바꾼다.
      # 대향차 판정 상한(y <= 5.5)과도 같은 단면을 보게 된다.
      # 순서 주의: roi_y >= gather >= collision 이어야 클러스터가 안 잘린다.
      roi_y_min: -6.0
      roi_y_max: 6.0
      path_corridor_gather_half_width: 6.0
      collision_corridor_half_width: 5.5
      cluster_eps: 0.38
      cluster_max_points: 20000
      cluster_voxel_m: 0.08
      min_points_for_confirm: 3
      # 전역값(0.12)과 맞춘다. 터널도 같은 파이프라인이다.
      min_obstacle_elevation: 0.12
      min_obstacle_elevation_outside: 0.12
      # 코리도 밖의 길고 얇은 종방향 터널 벽 조각 제거 기준.
      # 벽이 여러 군집으로 끊겨도 제거되도록 공용 연석 기준보다 완화한다.
      curb_linear_min_length: 2.0
      curb_linear_max_width: 0.8
      low_obstacle_max_length: 100.0
  # 스캔 timestamp의 odom 보간. 버퍼 밖 자세는 0.15초까지만 허용.
  pose_max_age: 0.15
  # 속도 불확실 시 unknown. 단기 관측 이동은 별도 observed_velocity로 전달.
  kf_vel_std_max: 2.0
  # ground_relative 필드가 없는 비상 입력에서만 쓰는 센서 지면 기준값.
  # 2026-09-22 재측정: -1.754 -> -1.765 (3주행 일관, 자세한 근거는
  # lidar_extrinsic.yaml 참고). 기준값은 그 파일 하나다.
  ground_z: -1.765

  # ★ B-1. 주 조정 대상.
  #   지면 위 최고점이 이 높이(m) 미만이면 노면 잔차로 기각.
  #   실측 분포 - 진짜 장애물 0.16~0.38m(박스), 노면 잔차 0.04~0.05m
  #   내리면 : 12cm 급 저상 물체를 살린다, 대신 잔차가 올라온다
  #   올리면 : 잔차 차단, 대신 낮은 라바콘이 죽는다
  # ★ 2026-09-09: 0.12 -> 0.20 으로 올렸다.
  #   실측 근거(최근 3개 주행 82개 트랙의 고도 분포):
  #     0.00~0.15 : 24개   <- 노면 잔차
  #     0.15~0.25 :  9개   <- 노면 잔차
  #     0.25~0.35 :  2개   <- 거의 빔 (자연 경계)
  #     0.35~     : 47개   <- 실물
  #   잔차와 실물이 0.25~0.35 에서 갈린다. 카고박스 실측 높이는 1.06m 라
  #   (2026-09-09 점군 측정) 0.20 으로 올려도 여유가 크다.
  #   더 올리려면 0.25 까지는 근거가 있다 - 다만 라이다 관측 고도는 링이
  #   물체 상단을 스칠 때 실제보다 낮게 나오므로 여유를 둔다.
  # ★ 2026-09-09 실시간 튜닝으로 확정: 0.12
  #   정지 상태(주행 오염 배제)에서 문턱만 바꿔가며 측정:
  #     0.16 -> 검출 1.4개 (장애물 하나가 간헐적으로 사라짐)
  #     0.12 -> 검출 2.0개 트랙 2  (실제 장애물 2개와 정확히 일치) ★
  #     0.10 -> 검출 2.0개 이지만 노견(0.09~0.13)과 겹쳐 위험
  #   실측 고도: 장애물 0.21~0.30 / 노면표식 0.17~0.22 / 노견 0.09~0.13
  #   ※ 거리가 멀수록 관측 고도가 낮아진다(15m 0.33 -> 17m 0.15).
  #     먼 거리를 커버하려면 문턱이 낮아야 한다.
  #   장애물과 노면표식은 0.21~0.22 에서 겹쳐 고도로는 못 가른다 -
  #   그건 SVD 형상 필터와 low_obstacle_max_length 가 맡는다.
  # GroundGrid의 지면 상대높이를 사용하므로 급제동 피치를 흡수하면서
  # 12 cm 저상 장애물을 보존한다.
  # ★ 2026-09-10 GroundGrid 실측으로 0.12 재확정.
  #   기준이 '고정 평면(z+1.598)' -> 'ground_relative' 로 바뀌었고, 후자가
  #   0.16~0.21 작게 나온다(물체 밑동이 지면 추정에 섞여 지면을 끌어올림).
  #     실측 ground_relative: 카고박스 13.2m 0.23~0.28 / 배리케이드 0.64~0.66
  #     문턱별 카고박스 여유: 0.12 -> +0.11 / 0.16 -> +0.07 / 0.19 -> +0.04
  #   0.16 이상은 여유가 7cm 이하라 더 작거나 먼 물체를 놓친다.
  #   ※ 실효 검출 한계는 약 14~15m 다(16채널 물리 한계, 자세한 근거는
  #     groundgrid/config/kcity_vlp16.yaml 상단 주석 참고).
  # ★ 2026-09-15: 0.12 -> 0.10. 라이다를 z 1.35 -> 1.30 으로 내린 뒤
  #   지면 추정이 좋아져 잔차가 사라졌다.
  #     실측(09-14 20:00 heavy 백, 전방 3~25m |y|<6, ground_relative):
  #       <0.05 (노면 잔차) : 0.0%   0점/프레임
  #       <0.12 (문턱 미만) : 1.7%   3점/프레임   (기존 z=1.35 에선 3.9% / 14점)
  #     문턱 아래 점이 프레임당 3개뿐이라 0.10 으로 내려도 잔차가 올라올
  #     여지가 작다. 대신 10~12cm 급 저상 물체를 더 살린다.
  #   ※ 오탐(노면을 장애물로)이 늘면 되돌릴 첫 번째 값이다.
  # ★ 2026-09-15: 0.10 -> 0.08. 저상 장애물을 더 살린다.
  #   같은 백 기준 0.08~0.10 대역은 1.2점/프레임뿐이라 잔차 증가가 미미하다
  #   (<0.08 은 0.6점/프레임). 노견(실측 0.09~0.13)이 문턱 위로 올라오므로
  # ★ 2026-09-18: 0.08 -> 0.12. 지면제거 바닥 상향 (도심구간 노면 잔차 차단)
  min_obstacle_elevation: 0.12

  # ★ B-2. 클러스터 반경(m).
  #   0.55m -> 0.38m 피팅: 나란히 서 있는 카고박스(0.46m 간격)가 단일 장애물로 뭉개지는 것을 방지하여 개별 분리
  cluster_eps: 0.38

  # ★ B-3. 확정에 필요한 최소 점 개수.
  #   내리면 : 원거리/작은 물체를 잡는다, 대신 노이즈가 물체가 된다
  min_points_for_confirm: 3
  # ★ 2026-09-09 실시간 튜닝으로 확정: 1.5 -> 2.2
  #   주행 중 정지 물체의 world 위치가 1.0~1.9m 흔들린다(거리에 비례하는
  #   yaw 오차 + ring 하나만 닿는 물체의 클러스터 중심 이동). 1.5 로는
  #   매칭에 실패해 같은 물체가 계속 새 트랙이 된다.
  #     실측(동일 주행 조건): 1.5 -> 트랙 58개 / 2.2 -> 23개 / 3.0 -> 29개
  #   상한은 인접 장애물 간격(실측 2.7m)이다 - 그보다 크면 둘이 붙는다.
  max_association_dist: 2.2

  # 1차 높이 컷 (센서 좌표계 z). ground_z(-1.765) + 0.04 = -1.725.
  # ground_z 를 바꾸면 이것도 같이 옮겨야 한다.
  roi_z_min: -1.725
  roi_z_max: 0.9

  min_range: 1.5
  # 25.0 -> 40.0 (2026-09-21). 랩타임 목적의 원거리 인지 확장.
  #
  # 이게 실효 상한이다. roi_x_max 를 30 으로 올려둬도 max_range 가 원형으로
  # 먼저 자르므로 25m 에서 걸렸다. 실측(09-21 17:05 백)에서 /obstacle_info
  # 최대 검출거리가 정확히 24.7m 였다.
  #
  # 점군은 그 너머에도 충분히 있다. 같은 백 heavy 120 프레임에서 전방
  # 코리도(|y|<2.8m) 점 수는 20-25m 2.9개/프레임, 25-30m 2.7, 30-40m 2.9,
  # 40-60m 3.1 로 밀도가 떨어지지 않는다. 지금 검출이 나오는 20-25m 와
  # 같은 수준이므로 상한만 올리면 그대로 잡힌다.
  #
  # 주행차로 안(|y|<1.9m)에도 실제로 점이 있다(120 프레임 합계):
  #   20-25m 5점 / 25-30m 50점 / 30-40m 69점
  # 25m 너머가 오히려 많은 것은 지금 그 구간이 통째로 버려지고 있어서다.
  #
  # 오검출 위험: 25~40m 신규 클러스터를 이미지에 투영해 확인한 결과
  # 가로등 기둥 밑동 같은 노견 구조물이 섞인다. 다만 이들은
  # path_corridor_half_width(2차 판정)와 cluster_max_points(350) 에서
  # 걸러지는 대상이고, 고도 0.30m 이상 비율이 82% 로 노면 잔차와는 구분된다.
  # 되돌리려면 tuning_perception.yaml.bak_range40_20260921 를 복사한다.
  max_range: 40.0 # 정동적 탐지 거리
  roi_x_min: -3.5
  # 2차 ROI 전방 한계. max_range 와 같이 올려야 원형 컷이 사각형에 안 잘린다.
  roi_x_max: 40.0
  # 자차 기준 직사각형의 횡 범위. 경로 코리도와 별개로 걸리는 안전망이라
  # 넉넉히 둔다(경로가 휘면 정면 기준으로는 크게 벗어난다 - 실측 2.17m).
  #   좁히는 역할은 path_corridor_half_width 가 한다.
  roi_y_min: -6.0
  roi_y_max: 6.0

  cluster_max_points: 350 # 이보다 큰 덩어리는 가드레일 등으로 보고 버림

  # ★ 클러스터 크기 상한(m). '차로를 가로지르는 병합' 방어용이지
  #   실물 크기 상한이 아니다.
  #   2.2 -> 3.2 (2026-09-21). 버스를 거리와 무관하게 전량 기각하고 있었다.
  #     실측(18:36:03 백, 정면 버스): span_y 2.68~2.87 m 로 매 프레임
  #     2.2 를 넘겼다. 17 m 에서 81점 / 폭 2.39 m 단일 클러스터로 깔끔히
  #     잡히고 SVD 형상 필터 3종도 전부 통과하는데, 여기서만 버려졌다.
  #     그래서 가까워져 클러스터가 조각난 뒤(9.5 m)에야 폭 0.35 짜리
  #     파편 하나가 통과했고, 플래너는 버스를 작은 기둥으로 보고 그대로
  #     들이받았다(3주행 연속 -277 ~ -332 m/s^2).
  #   3.2 는 버스 실측 최대(2.87)에 0.33 여유를 두면서 차로 폭(3.5)보다
  #   작아, 옆 차로 물체까지 한 덩어리로 묶는 일은 여전히 막는다.
  #   종방향 가드레일 방어는 span_x 와 SVD 선형 필터가 그대로 맡는다.
  cluster_max_span_y: 3.2
  cluster_max_span_x: 4.5
  # ★ 이 높이(지면상대 m) 이상인 클러스터는 위 크기/점수 상한에서 면제한다.
  #   옆에서 본 버스는 형상만으로 가드레일과 구분이 안 된다. 실측
  #   2026-09-21(19:25:47 백) 버스 측면: span_x 6.8~11.2 m, span_y
  #   2.7~5.4 m, voxel 후 501~778 점 - 세 상한(350 / 3.2 / 4.5)에 전부
  #   걸려 통째로 기각됐다. 점은 5,979 개나 살아남았는데 장애물이 안
  #   잡힌 이유가 이것이다(폭 0.35 파편만 간헐 통과).
  #   구분자는 높이다: 같은 백 3개에서 span_x>4.5 인 긴 클러스터 146 개를
  #   전수 조사한 결과 최고점이 전부 2.05 m 이상(중앙 2.59)이었다.
  #   가드레일·연석은 이 높이가 안 나오므로 낮고 긴 것만 계속 기각된다.
  #   1.2 는 승용차 지붕(~1.4)보다 낮게 잡아 차량류를 모두 살리는 값이다.
  cluster_tall_keep_top: 1.2

  # 병합 문턱. ★ 의미가 바뀌었다 - 중심간 거리가 아니라 '표면 간 거리(gap)' 다.
  #   중심거리는 물체가 클수록 같이 커져서, 폭 1.75m 카고박스가 두 클러스터로
  #   갈라졌을 때 중심거리 0.45m > 0.35 로 병합이 거부됐다(실측 2026-09-09,
  #   그 결과 플래너가 물체를 2개로 보고 각각 1.5m 로 축소해 계획 -> 충돌).
  #   gap 기준은 크기와 무관하므로 같은 값으로 큰 물체도 붙는다.
  #   인접 드럼 오병합 방지는 아래 y_span 상한(2.6)이 맡는다.
  merge_cluster_dist: 0.35

  # 자차 footprint 제거 (라이다 프레임). 아이오닉 5 전폭(1.89m, 반폭 0.95m) 및 사이드미러 고려
  self_x_min: -2.09
  self_x_max: 2.95
  self_y_min: -1.15
  self_y_max: 1.15

  # --- 기준경로 코리도 (넓게 모으고 -> 좁게 판정) ---
  # 자차 기준 직사각형(roi_*)만으로는 곡선에서 경로가 박스를 벗어난다.
  # 실제로 봐야 하는 건 '내가 갈 경로' 좌우다.
  #
  #   1차 gather(점 수집, 넓게) : 경로 좌우 이 폭 안의 점을 모은다.
  #       여기서 버린 점은 다시 못 본다. 좁히면 물체가 반쯤 잘려서 크기·형상
  #       판정이 망가지고, 경로가 휘거나 측위가 흔들릴 때 진짜 장애물이
  #       사라진다. 그래서 넉넉히 잡는다.
  #   2차 half_width(물체 판정, 좁게) : 클러스터가 만들어진 뒤 그 '중심' 이
  #       경로에서 이 안에 있어야 내 경로 위 장애물로 인정한다.
  #       물체 몸통이 경로를 침범하면(중심이 밖이어도) 남긴다.
  #
  #   ★ 실제로 반응할 대상을 정하는 건 2차(path_corridor_half_width) 다.
  #     1차는 후보를 모으는 그물이라 넓을수록 안전하다(연산량만 늘어난다).
  #
  #   실측(2026-09-08 무장애물 주행): 12~20cm 대역 오탐은 전부 갓길
  #   연석(|y| 중앙값 2.32m, p90 2.61m)이었고, 코리도 1.4m 판정이 그걸
  #   걷어낸다(25m 이내 오탐 1.5점/프레임 -> 0).
  # ★ 인지는 넓게, 회피/정지 판단은 하류가 자기 기준으로 한다.
  #   하류가 이미 각자 코리도를 갖고 있다:
  #     obstacle_avoidance_node.path_corridor_radius = 1.75m  (회피)
  #     obstacle_stop_node.stop_corridor_radius      = 3.2m   (정지)
  #   여기를 1.4 로 두면 둘 다보다 좁아서 하류가 볼 것을 미리 지워버린다.
  #   실측(2026-09-08 17:xx): 24m 갓길 카고박스(0.9x0.9x0.83m, 경로거리 2.81m)가
  #   점군·지면제거를 다 통과했는데 여기서 off_path 로 잘려 정지 판단에 도달조차
  #   못 했다. stop 기준 3.2m 안이라 원래는 봐야 하는 물체다.
  #   그래서 인지는 하류 최대치(3.2)보다 여유 있게 잡고, 실제 반응 범위는
  #   각 미션 노드가 정하게 둔다.
  #   ※ src_최적(kcity2026_stack)의 |y|<10 / |y|<7 과는 역할이 다르다.
  #     저쪽 값은 'low_obstacle.py' 라는 저상박스 전용 보조 모듈의 내부
  #     작업 범위이고(지면 평면을 맞추려면 주변 노면이 필요해서 넓게 받는다),
  #     그 모듈은 static_obstacle_priority 구간에서만 돈다. 메인 경로는
  #     remove_ground(h_min=0.30) 이라 별도 코리도가 없다.
  #     여기 값은 '이 물체에 반응할 것인가' 를 정하는 판정 코리도라 성격이
  #     달라서 그 숫자를 그대로 옮기면 안 된다(7m 로 넓히면 양쪽 차선 밖
  #     갓길 구조물이 전부 올라온다 - 4.0m 에서도 이미 검출 49개였다).
  use_path_corridor: true
  path_corridor_gather_half_width: 4.0 # 1차 점 수집 - 넓게
  # ★ 회피 트리거 코리도. '장애물 몸통 가장자리 ~ 기준경로' 거리 기준.
  #   new_lane/obstacle_avoidance.launch 의 path_corridor_radius 와 반드시
  #   같은 값이어야 한다 - 같은 양을 재고, 여기서 판정한 in_trigger_corridor
  #   태그를 회피 노드가 그대로 쓴다. 한쪽만 고치면 고친 쪽이 무시된다.
  #   1.4 는 차로 반폭(~1.6) 안쪽 값이다. new_lane 의 robot_radius(충돌로 볼
  #   최소 간격)와는 별개 손잡이다 - 값이 비슷해도 역할이 다르다.
  path_corridor_half_width: 1.5
  # ★ 자차 전방 코리도(기준경로 코리도와 OR). 회피로 차가 경로에서 벗어나
  #   있는 동안에도 '내 앞 물체'를 트리거로 유지한다.
  #     실측 2026-09-09(16:52): 차량 d 가 +0.90 -> +1.23 이 되는 순간
  #     트리거 장애물 3개가 동시에 사라졌다(두번째 장애물 미인식의 원인).
  #   반폭은 path_corridor_half_width 를 그대로 쓴다.
  ego_corridor_enabled: true
  ego_corridor_range: 20.0
  # ★ 근거리 2차 병합. 이 거리 안에서는 병합 문턱을 near_merge_dist 로 키운다.
  #   가까워지면 한 물체가 링마다 갈라져 조각 간 거리가 커 보이고, 조각이
  #   각각 새 트랙이 된다(실측: 한 물체 자리에 트랙 3개, 상호 0.66~0.69m).
  #   회피는 먼 조각으로 계획되는데 실제 가장자리는 가까운 조각이라 긁는다.
  # ★ 8.0 -> 20.0 (2026-09-21). 조각남은 근거리 전용 현상이 아니었다.
  #   실측(17:53:49 heavy 백, 버스 1대): 11~19 m 에서 4조각으로 갈렸고
  #   조각 간 gap 이 0.47 / 0.50 / 0.50 m 라 merge_cluster_dist(0.35)로는
  #   전부 병합 거부됐다. 그 결과 버스 한 대가 트랙 3개(id 13/24/25)로
  #   발행됐고 각각 length 0.65~1.57 의 작은 물체로 보여, 플래너가 그
  #   사이를 지나갈 수 있다고 판단했다.
  #   near_merge_range 를 늘려 그 구간에 near_merge_dist(0.9)가 걸리게 한다.
  #   merge_cluster_dist 자체를 올리지 않는 이유: 그 값은 간격 0.46m 로
  #   나란히 선 카고박스를 가르는 기준이라(2026-09-09 실측) 올리면 근거리
  #   분리 성능이 같이 무너진다. 여기를 늘리면 근거리 기준은 그대로다.
  #   오병합 방어는 combined_y_span <= 2.6 가드가 그대로 맡는다.
  near_merge_range: 20.0
  # ★ 0.9 -> 1.15 (2026-09-22). 첫 장애물 과회피의 직접 원인.
  #   실측(09-21 19:31:54 백) 한 물체의 조각 간 gap 이 0.75 와 1.00 두
  #   값만 나왔다. 문턱 0.90 이 정확히 그 사이라 프레임마다 붙었다
  #   떨어졌다를 반복했고(8.83 / 9.03 / 9.37 에서 분리), 그때마다 합산
  #   횡폭이 0.65 -> 2.02 -> 3.89 m 로 부풀었다. 조각마다 robot_radius
  #   (1.35)가 더해져 실물보다 훨씬 넓게 돌았다.
  #   gap 이 이산적인 이유: 물체 높이가 0.2m 남짓이라 VLP-16 링이 1~2개만
  #   닿고, 인접 링이 지면에 0.75~1.00 m 간격으로 떨어진다.
  #   1.15 로 올리면 1.00 도 붙어 병합이 안정된다. 상한 근거는 인접
  #   카고박스 실측 간격(2.7m)이라 여유가 크고, 오병합 방어는
  #   combined_y_span(2.6) 가드가 그대로 맡는다.
  #   검증(백 재생): 분리 프레임 3곳이 모두 단일 그룹으로 합쳐졌다.
  near_merge_dist: 1.15
  # ★ 원거리 최소 점 수 완화.
  #   VLP-16 은 높이 h 물체에 두 링이 닿는 거리가 ~28*h 이내뿐이다. 그보다
  #   멀면 링 1개만 닿고, 그게 물체 모서리를 스치면 점이 2개로 떨어져
  #   min_points_for_confirm(3)을 못 채운다.
  #     실측 2026-09-09(17:08): 고도 0.79m 물체가 9.3m 에서야 잡혔다(같은
  #     자리 다른 물체는 24m). 두번째 장애물 인지 지연의 원인.
  #   2점 클러스터는 SVD 형상검사(>=4점)를 못 받으므로, 대신
  #   far_low_point_elevation 로 고도를 요구해 노면 잔차를 막는다.
  # 12.0 -> 8.0 (2026-09-14). 저상 장애물을 더 멀리서 잡기 위해 완화 시작
  # 거리를 앞당긴다.
  #   두 링이 닿는 한계는 ~28*h 다: h=0.40 m 면 11.2 m, h=0.30 m 면 8.4 m.
  #   즉 저상 물체가 '처음 보이기 시작하는' 구간이 바로 8~12 m 인데,
  #   완화가 12 m 부터라 그 구간에서는 여전히 3점을 요구했다.
  #     실측 2026-09-14(18:07 백): 고도 0.40 m 카고박스(id20)가 정확히
  #     11.0 m 에서야 처음 잡혔다(이론 한계 11.2 m 와 일치). 4.5 m/s 에서
  #     2.4초 여유뿐이라 회피 판단이 늦었고 결국 충돌했다.
  #     같은 백 거리대역 검출수: 0-8m 1480 / 8-12m 109 / 12-16m 352.
  #     8~12 m 대역만 유독 비어 있다.
  # 노면 잔차 방어는 far_low_point_elevation(0.30)이 그대로 맡는다 -
  # 2점 클러스터는 지면 위 0.30 m 이상이어야 통과하므로, 실측 노면 잔차
  # (0.04~0.20 m)는 이 문턱을 못 넘는다.
  far_cluster_range: 8.0
  far_min_points: 2
  far_low_point_elevation: 0.30
  # 위 문턱의 거리 완화 (2026-09-21). 저상 장애물이 원거리에서 통째로
  # 기각되던 문제. 15m 까지는 0.30 그대로, 30m 이상은 0.18, 사이는 선형.
  #   근거(09-21 17:10 heavy, 118 프레임)
  #     저상대역 점의 0.30 통과율: 10-15m 52.5% -> 30-40m 17.6%
  #     노면잔차(0.35m 미만 점) 프레임당: 5-10m 4.36 -> 30-40m 0.25 (17배 감소)
  #   즉 원거리는 잔차가 적어 문턱을 낮춰도 위험이 늘지 않는다.
  # far_elev_relax_min 을 0 으로 두면 기존 고정 문턱(0.30)으로 돌아간다.
  far_elev_relax_start_m: 15.0
  far_elev_relax_end_m: 30.0
  far_elev_relax_min: 0.18
  # 완화를 '경로 위' 물체로 한정한다(2026-09-21, 2차 수정).
  # 제한 없이 걸었더니 교차로 신호등 기둥 밑동/표지판 지주가 통과해
  # AEB 긴급 90회 + 완전정지 2회(09-21 17:16 백). 유발 물체는 경로
  # 횡거리 2.3m 라 회피 코리도(1.5) 밖인데 정지 노드만 3.2m 를 써서
  # 반응했다. path_corridor_half_width(1.7) 와 같은 값을 쓴다.
  # 0 이하로 두면 횡방향 제한 없음.
  far_elev_relax_max_lateral_m: 1.7

  # --- 조각 정렬 검사 (쪼개진 연석/노견) ---
  # ★ SVD 형상 필터는 클러스터 하나씩만 본다. 연석이 조각나면 각 조각이
  #   짧아서 curb_linear_min_length(2.5)를 못 넘고 전부 통과한다.
  #   near_merge 로 붙이기엔 조각 간격이 1~3m 로 너무 넓다.
  #   그래서 '여러 조각이 한 직선에 정렬됐는가'로 판정한다.
  #     실측 2026-09-10: 검출 8개가 5.6~18.1m 에 늘어섰고
  #       y = -0.116*거리 - 0.109 (상관 -0.97) - 거의 완벽한 직선
  #       전부 W=L=0.35(최소 클램핑) + trigger 였다.
  #     이게 동적 구간 "가다 서다 반복"의 원인이었다(피치가 아니다).
  #   경로 코리도 안(in_trigger) 물체가 묶음에 섞이면 건드리지 않는다 -
  #   줄지어 놓인 라바콘이 경로 위에 있으면 살려야 한다.
  align_reject_enabled: true
  align_min_count: 4        # 이 개수 이상 정렬돼야 구조물
  align_min_length: 6.0     # 묶음 주축 길이 하한(m)
  # ★ 직교 퍼짐 상한(m). 2026-09-10 실측으로 1.2 -> 2.5.
  #   노면 점은 '한 줄'이 아니라 여러 링이 바닥을 스캔한 '띠'다.
  #   실측 19개의 주축이 19.3m x 1.81m 로, 1.2 에서는 "직선이 아니다"로
  #   통과해 버렸다(검출 20개, 전부 노면).
  #   2.5 로 올리니 검출 20 -> 2.2개, trigger 2 -> 0 이 됐다.
  #   폭을 넓혀도 안전한 이유: 실제 판별은 align_min_height_slope 가 한다
  #   (노면은 고도가 거리에 비례 상승, 실물은 고도 일정).
  align_max_width: 2.5
  align_min_offset: 0.4     # 중심선에서 이만큼 치우친 것만 검사
  # ★ 실물 보호: 기준경로에서 이보다 가까운 클러스터는 라인 판정에서 빼둔다.
  #   예전에는 'in_trigger(코리도 안)' 물체가 섞이면 검사를 통째로 스킵했는데,
  #   노면 라인이 경로 0.7~2.5m 에 걸쳐 있어 그 조건이 항상 발동했다.
  #     실측 2026-09-10: 경로상 실물 0개인데 검출 9개(전부 노면),
  #     그 중 7개가 in_trigger 라 정렬 검사가 영구히 꺼져 있었다.
  #   진짜 물체는 라인 위에 정렬되지 않으므로 SVD 폭 조건이 보호 역할을 하고,
  #   경로 중앙에 있는 것만 이 값으로 따로 지킨다.
  align_protect_lateral: 0.6
  # ★ 노면 라인 vs '일렬로 놓인 실물' 판별.
  #   피치로 기운 노면은 고도가 거리에 비례해 오르고, 줄지어 놓인 라바콘은
  #   고도가 거리와 무관하게 일정하다.
  #     실측 2026-09-10: 노면 고도 = 0.036*dist - 0.112 (상관 +0.91, 2.06deg)
  #                      라바콘 줄 고도 기울기 0, 표준편차 0
  #   이 값보다 완만하면 노면이 아니라고 보고 기각하지 않는다.
  #   올리면: 실물 보호 강화(노면 누출 증가) / 내리면: 노면 제거 강화(실물 위험)
  align_min_height_slope: 0.015
  # 충돌 검사 전용 코리도. 이 안(트리거 밖)의 물체는 collision_objects
  # 목록에만 담겨 나간다 - 회피를 시작시키진 않지만, 회피 경로가 그 위로
  # 지나가지 못하게 막는다. new_lane/collision_corridor_radius 와 쌍.
  #   ★ 1차 수집(path_corridor_gather_half_width=4.0)보다 크면 의미가 없다.
  #     4m 밖의 점은 1차에서 이미 잘려서 클러스터가 존재하지 않는다.
  #     1차를 넓히면 점 수가 배로 늘고 이 노드는 이미 콜백 주기가 라이다
  #     10Hz 보다 느려서 실시간성을 잃는다 - 그래서 1차를 4.0 으로 두고
  #     여기를 맞춘다(회피 폭 4.5 전체를 못 덮는 건 이 제약 때문이다).
  collision_corridor_half_width: 4.0 # ★ 2차 물체 판정 - 실제 반응 범위
  # 경로를 못 받았을 때(측위 실패 등) 코리도를 건너뛸지. true 가 안전하다 -
  # 경로가 없다고 장애물을 통째로 무시하면 위험하다.
  path_corridor_skip_if_no_path: true
  # 경로를 솎을 때 유지할 점 간격(m). 인덱스가 아니라 실제 거리 기준이다.
  #   예전 인덱스 방식(5칸)은 CSV 경로(0.1m 간격) 전제였는데, 회피가 켜지면
  #   /local_path 가 프레넷 경로(간격 0.35m)로 바뀌어 5칸이 1.75m 가 됐다.
  #   그 결과 '경로까지 최단거리' 가 7배 과대평가돼(1.08 -> 7.22m) 경로
  #   정중앙 장애물이 off_path 로 기각됐다(실측 2026-09-08).
  path_corridor_decimate_m: 0.5

  # --- RViz 마커 구간 필터 (시각화 전용, 주행 로직 영향 없음) ---
  # 다른 미션 파이프라인이 잡은 장애물까지 한 화면에 섞이면 튜닝 때 무엇을
  # 보는지 알 수 없다. 현재 waypoint idx 가 아래 범위 안일 때만 마커를 낸다.
  # false 로 두면 전 구간 표시(원래 거동).
  # ★ 대회에서는 false 로 둔다. 이 노드는 정동적 구간 밖에서도 장애물을
  #   계속 잡고 있고(회피/정지 판단은 미션 노드가 따로 한다), 화면에서만
  #   숨기면 상황 파악이 어려워진다.
  #   튜닝할 때 특정 구간만 보고 싶으면 true 로 켠다.
  marker_filter_by_section: false
  section_start_idx: 2400 # competition.launch 의 obstacle_avoid_start_idx
  section_end_idx: 4900 # competition.launch 의 obstacle_stop_end_idx
  static_dynamic_split_idx: 3700 # 이 앞=정적회피, 뒤=동적정지

  # --- 형상 필터 (연석 vs 라바콘) ---
  # ★ C-1. 길이/폭 비가 이보다 크면 연석으로 보고 기각.
  #   라바콘/박스는 3 이하, 연석은 10 이상 나온다.
  #   내리면 : 연석 확실히 차단, 대신 비스듬히 보이는 차량 옆면도 버린다
  curb_max_aspect: 8.0
  # 길이가 이보다 길면서 폭이 이보다 좁으면 선형 구조물로 기각
  curb_linear_min_length: 2.5
  curb_linear_max_width: 0.35
  # 저상 물체 판정: 최고점이 이 높이 미만이면 아래 두 조건을 추가로 본다
  low_obstacle_top_m: 0.35
  low_obstacle_min_thickness: 0.06 # 수직 두께. 노면 잔차는 납작하다
  low_obstacle_min_points: 3
  # 평면(두께 없음) 검사를 적용할 최대 거리(m).
  #   8.0 일 때 11~16m 노면 표식(정지선/화살표)이 검사를 건너뛰고 장애물로
  #   올라왔다(실측 2026-09-08: 고도 0.15~0.18m, 두께 0.01m, 링 1개).
  #   실측상 24m 카고박스(높이 0.83m)는 -3deg/-1deg 두 링에 맞아 두께 0.83m 가
  #   관측되므로, 30m 까지 두께로 갈라도 진짜 장애물은 안 잘린다.
  flat_check_max_range: 30.0
  # 두께 검사를 적용할 고도 상한(m). 이보다 높으면 두께를 안 본다.
  low_obstacle_flat_top_m: 0.20
  # ★ VLP-16 링 간 수직각(2deg)의 tan. 거리 r 에서 두 링의 높이차 = 0.035*r.
  #   물체 높이가 그보다 낮으면 링이 하나만 닿아 두께가 구조적으로 0 이다
  #   (14m 에서 0.49m, 20m 에서 0.70m 미만). 그런 물체에 두께 0.06 을
  #   요구하면 '보이는데 버린다' - 그래서 이 경우 두께 검사를 건너뛴다.
  #     실측 2026-09-09(16:41): 고도 0.20 물체가 15.9m, 0.35 가 14.2m 에서야
  #     잡혔다. 같은 고도 0.32 가 경로 위에서는 24.5m 였다 - 두께 게이트가
  #     검출 거리를 들쭉날쭉하게 만들고 있었다.
  #   올리면: 두께 검사가 더 자주 걸린다(노면 방어 강화, 저상 검출 약화)
  #   내리면: 저상 물체를 더 멀리서 잡는다(노면 오탐 위험 증가)
  ring_vert_sep_tan: 0.035

  # --- 첫 프레임 즉시 확정 조건 (src_최적 LowObservationConfirmation 참고) ---
  # 예전에는 '점 6개 이상' 이면 첫 프레임에 confirmed 였는데, 노면 표식이
  # 그 문턱을 쉽게 넘었다(실측 2026-09-08: 정지 유발 표식 7점, 다른 표식
  # 27점/18점 - 셋 다 즉시 확정). 노면은 넓게 퍼져 있어 오히려 점이 많다.
  # 점 개수 우회로를 없애고 고도만 남긴다. 이 값을 못 넘는 물체는 다음
  # 프레임에 같은 자리에서 다시 보여야 확정된다 - 노면 표식은 프레임마다
  # 위치가 흔들려 매칭이 안 되고, 실물은 map 좌표가 고정이라 붙는다.
  init_confirm_elevation: 0.30

  # 저상 물체(top < low_obstacle_top_m)의 길이 상한(m).
  # 라바콘/카고박스는 1m 안팎, 노면 표식·연석은 길게 이어진다
  # (실측: 16.4m 표식이 폭 1.12m 로 퍼져 있었다).
  low_obstacle_max_length: 1.8

  # --- 구간별 고도 문턱 (src_최적 ground_h_min 이원화 구조) ---
  # src_최적은 저상 박스를 살려야 하는 정적 구간에서만 문턱을 낮추고
  # (h_min=0.10), 그 밖에서는 0.30 으로 올려 노면 누출을 막는다.
  # 우리는 전 구간에 0.12 를 써서 정적 구간 밖에서도 노면 표식
  # (실측 2026-09-08: 고도 0.14~0.18m)이 장애물로 올라왔다.
  #   min_obstacle_elevation          = 정적 구간 안 (위에 정의, 0.12)
  #   min_obstacle_elevation_outside  = 그 밖
  # idx 를 못 받으면(측위 실패) 안전하게 낮은 쪽을 쓴다.
  min_obstacle_elevation_outside: 0.30
  # ★ 동적 구간(3700~4900) 전용. 보행자/더미가 대상이라 저상 박스를 살릴
  #   이유가 없어 높게 잡는다.
  #   동적 구간은 obstacle_stop_node 가 motion_state/confirmed 를 보지 않고
  #   '코리도 안 모든 물체'에 정지를 걸기 때문에, 잔차 하나가 곧 급정지다.
  #     실측 2026-09-09(17:14): 고도 0.13m 잔차가 신호등 앞 3.7초 정지를
  #     유발했다(MPC 는 가속 중이었고 /ctrl_cmd 가 brake=1.0 으로 덮였다).
  # ★ 2026-09-09 실시간 튜닝으로 0.30 -> 0.12.
  #   0.30 을 넣은 근거(당시 고도 분포에서 0.25~0.35 가 비어 보임)는
  #   line_search_angle 0.1 로 실물 하단이 대량 삭제된 상태의 데이터였다.
  #   실측으로 다시 재니 실물 하단이 0.15~0.21 로 관측되고, 거리가 멀수록
  #   더 낮아진다(17m 에서 0.15). 0.30 이면 그걸 통째로 놓친다.
  #   동적 구간은 더미 종류가 랜덤이라 고도를 가정할 수 없고, 놓치면
  #   곧 충돌이므로 정적과 같은 값으로 낮춘다.
  #   노면 잔차로 인한 오정지는 TTC 판정(obstacle_stop_node)이 맡는다 -
  #   고정 구조물은 시간이 겹치지 않아 자동 배제된다.
  min_obstacle_elevation_dynamic: 0.12  # 정적과 같은 값 유지 (0.08 -> 0.12)
  # 정적/동적 경계. competition.launch 의 static_dynamic_split_idx 와 맞춘다.
  static_dynamic_split_idx: 3700
  # 정동적 미션 구간 전체(정적 회피 + 동적 정지). 이 안에서만 낮은 문턱을 쓴다.
  #   2400 = competition.launch obstacle_avoid_start_idx (정적 시작)
  #   4900 = competition.launch obstacle_stop_end_idx    (동적 끝)
  #   (3700 = static_dynamic_split_idx 는 정적/동적 경계일 뿐 여기선 안 쓴다)
  static_zone_min_idx: 2400
  static_zone_max_idx: 4900

# -----------------------------------------------------------------------------
#  C. 형상 필터 (연석 vs 라바콘 판별)
#     전에는 코드에 하드코딩돼 있어 현장에서 못 만졌다. 이제 파라미터다.
# -----------------------------------------------------------------------------
# -----------------------------------------------------------------------------
#  D. 고주로 원거리 (lidar_ttc_tracker)  ->  src/lidar_ttc_tracker/launch/...
#     정동적과 요구가 정반대다. 정동적 튜닝하다가 여기 건드리지 말 것.
# -----------------------------------------------------------------------------
lidar_ttc_tracker:
  # 차량 원점 기준 장착고(TF용). lidar_extrinsic.yaml 의 z 와 같은 기준이라
  # 이 값 자체는 맞다 - 지면 기준값은 아래 ground_z_below_sensor 다.
  lidar_z: 1.33
  # 지면 기준 장착고. lidar_extrinsic.yaml 의 z_from_ground 와 같아야 한다.
  # 2026-09-17 /groundgrid/ground 평면 피팅 실측값.
  ground_z_below_sensor: 1.765
  ground_clearance: 0.38
  ground_bin_size: 2.0

  # 링 연속성 (원거리 차량 복원). 검출거리 19.8m -> 55.3m 로 늘린 로직.
  ring_continuity_enabled: true
  ring_min_range: 18.0 # 이 거리 밖에서만 적용
  ring_range_step_m: 1.0 # 내리면 원거리 민감 / 올리면 보수적
  ring_flat_tol_m: 0.25
  ring_min_run_points: 4 # 이어진 점이 이 미만이면 버림(노면 오탐 방어선)

  # --- 링 기반 원거리 노면 제거 (_ring_ground_mask) ---
  # bin 퍼센타일이 무너지는 구간(링 사이에 노면 점이 없는 원거리)에서 노면을
  # 점 단계에서 지운다. 링 k 는 평지에서 반경 (센서고/tan|각도|) 의 원을
  # 그리므로, 섹터별 관측 중앙값을 기준으로 삼아 그 근처 점을 노면으로 본다.
  #   실측(2026-09-08, 장애물 없는 상태): 18m 밖 317점 중 259점(82%)을
  #   노면으로 제거. 남은 58점은 절반이 1m 이상 높이(벽/표지판=진짜 물체)이고
  #   놓친 노면은 12점뿐이었다.
  #   경사 보정을 위해 이론값이 아니라 섹터별 실측 중앙값을 쓴다 - 실측상
  #   섹터 내 산포는 작고(ring6 까지 1.2m) 섹터 간 편차가 크다(ring5 6.2m).
  # ★ false. 실측(2026-09-08 17:12, 회전교차로 앞 정지)에서 36~38m 차량의
  #   점 30개 중 28개(93%)를 노면으로 오판해 지웠다.
  #   원인: 그 거리대에서 ring7 점의 대부분이 차량이라 '섹터 중앙값'이 차량
  #   쪽으로 끌려간다. "노면이 다수라 중앙값이 안전하다"는 전제가 원거리에서는
  #   성립하지 않는다(노면 반사가 원거리에서 희박해지기 때문).
  #   원거리 노면 배제는 이미 _far_single_ring_detection 의 3중 게이트
  #   (현길이/접선성/고도)가 담당하고 있고, 그쪽이 실측에서 차량은 1.00 점,
  #   노면·기둥은 0.00 점으로 정확히 갈랐다.
  ring_ground_enabled: false
  ring_ground_min_range: 18.0 # 이 밖에서만 적용(근거리는 bin 방식이 74% 로 잘 됨)
  ring_ground_sectors: 36 # 방위각 10도 단위
  ring_ground_tolerance_m: 1.5 # 섹터 노면반경 ± 이 값이면 노면
  ring_ground_min_points: 5 # 기준을 세울 최소 점수(적으면 물체에 끌려감)

  # --- 차량 확정 판정 완화 (2026-09-11 실측) ---
  #   raw 점군과 /tracked_objects 프레임별 대조: 트래커 ROI 안 후방
  #   차량크기 클러스터 277개 중 트랙 103개(37%)뿐이었다.
  #   검출/미검출을 가른 건 거리가 아니라 점 개수다:
  #     검출됨 점수 중앙 81 / 높이 1.10m     미검출 점수 중앙 50 / 높이 0.81m
  #   후방 차량은 뒷면만 보여 점이 적고, 4프레임 연속 판정을 못 채운다.
  #   고주로 차선변경이 이 입력에 의존한다 - 실측 t=19~48 에서 SMPC 가
  #   본 인접 차량이 vehicles=2/nearby=2 뿐이었다.
  #   ※ 완화라 오검출이 늘 수 있다. far_min_box_width 0.6 이 마지막 방어선이니
  #     그건 내리지 말 것(0.0 으로 풀면 트랙 5->125, 94%가 노면 '선'이었다).
  vehicle_confirm_score: 0.50 # 0.60 -> 0.50
  vehicle_confirm_hits: 2 # 4 -> 2
  # 확정 진입과 해제 문턱을 분리한다. 10 Hz 기준 0.7초 동안 계속 0.25
  # 아래일 때만 차량 상태를 해제해 원거리 부분 관측의 순간 탈락을 막는다.
  vehicle_release_score: 0.25
  vehicle_release_frames: 7

  # RViz 전용. 확정 차량=파랑, 지속 원거리 후보=주황, 일반 unknown=회색으로
  # 분리한다. /tracked_objects 및 주행 판단에는 영향을 주지 않는다.
  marker_vehicles_only: false
  marker_far_candidate_min_range: 25.0
  marker_far_candidate_min_hits: 3
  marker_far_candidate_min_obstacle_confidence: 0.55

  # 16채널 원거리 부분 관측: 차량 전체 폭 대신 0.8m 이상 보이는 현부터
  # 후보로 점수를 부여한다. 접선성/지면 위 고도/시간 지속 조건은 유지한다.
  far_chord_soft_min: 0.8
  far_chord_ideal_min: 1.2

  # 원거리 박스 크기 게이트. 링 한 줄만 닿으면 높이가 0 이라 풀 수밖에 없고,
  # 그만큼 폭이 유일한 방어선이다.
  #   실측 경고: far_min_box_width 를 0.0 으로 풀었더니 트랙이 5개 -> 125개로
  #   폭증했고 그중 94% 가 폭 0.16m 짜리 노면 '선' 이었다. 0.6 밑으로 내리지 말 것.
  far_size_gate_range_m: 25.0 #기존 25.0
  far_min_box_height: 0.0
  far_min_box_width: 0.6 #기존 0.6
  far_max_aspect_ratio: 4.0

# -----------------------------------------------------------------------------
#  E. 회전교차로 차량 검출 및 클러스터링 (roundabout_lidar_tracker) -> M5 미션
#     정동적 구간과 요구가 완전히 다르다.
#     - 지면제거: 공통 GroundGrid의 /nonground 를 직수 (input_mode: sensor_nonground)
#     - 클러스터링: 15~50m 원거리에서 회전하는 중·대형 차량을 점 묶음
#     - 핫 리로드: 노드 재시작 없이 rosparam load 로 1초 내 즉시 갱신
# -----------------------------------------------------------------------------
roundabout_lidar_tracker:
  lidar_tracker:
    # 지면 제거 모드: sensor_nonground (GroundGrid /nonground 직수)
    input_mode: sensor_nonground

    # ★ E-1. 점군 다운샘플링 복셀 크기 (m).
    #   원거리(30~50m) 차량 점군 보존을 위해 0.10 권장.
    voxel_size: 0.10

    # ★ E-2. 클러스터링(점 묶기) 파라미터.
    #   tolerance: 같은 물체로 묶을 점 간 최대 거리(m).
    #     원거리 빔 확산으로 점이 벌어지므로 1.1~1.3m 로 넓혀야 차량 한 대가 쪼개지지 않는다.
    #   min_points: 유효 클러스터 최소 점수.
    #     35~45m 원거리 차량은 3~4점만 들어오므로 3으로 완화하여 조기 검출.
    #   max_points: 차량 상한 점수 (가드레일 등 거대 클러스터 배제)
    cluster:
      tolerance: 1.25
      min_points: 3
      max_points: 3000

    # ★ E-2b. 고정 구조물 제외 영역 (map 프레임 원). 점군 단계에서 버린다.
    #   양보선 앞 중앙분리대. 4개 풀랩 백에서 매번 같은 자리에 잡혔다:
    #     09-18 15:47 (302493.32, 4124465.40)  09-18 16:08 (302493.34, 4124465.06)
    #     09-18 16:27 (302493.3,  4124465.1 )  KASA        (302493.3,  4124465.1 )
    #   중심 반경 23.4m 로 순환차로(outer 21.5m) 밖이고, 자차 경로에서 2.82m
    #   떨어져 있어 실제 차량과 겹칠 여지가 없다.
    #   형상 필터로는 못 거른다 - 링 하나만 스쳐 길이 0.43~1.20m 라
    #   linear_min_length(2.0)에 미달하고, 폭이 0.25~1.50m 로 출렁인다.
    #   그 크기 변동이 중심을 끌고 다녀 09-18 15:47 백에서는 누적 이동이
    #   moving_distance_threshold(1.0)를 넘겨 has_moved=true 까지 갔다
    #   (실제 속도는 0.01~0.31 m/s 로 내내 정지). 그날은 반경 필터가
    #   2차로 막아줬을 뿐이라 require_movement_confirmation 단독 방어는
    #   위험하다. 위치가 확정적이므로 좌표로 제거한다.
    #   반경 2.5m = 관측 산포(최대 1.62m) + 여유.
    exclusion_zones:
      - { x: 302493.34, y: 4124465.06, radius: 2.5 }

    # ★ E-3. 차량 형상 필터 (가드레일 vs 차량 분리).
    #   PCA 주축 분석으로 회전교차로 선회 차량을 보존하고 선형 가드레일만 기각.
    vehicle_filter:
      min_length: 0.33
      max_length: 14.0
      min_width: 0.15
      max_width: 3.5
      min_height: 0.12
      max_height: 4.5
      reject_low_linear: true
      linear_min_length: 2.0
      linear_max_width: 0.30
      linear_max_height: 0.6 # 1.3 -> 0.6: 원거리 차량 측면 오제거 방지
      linear_min_aspect_ratio: 8.0
      # ★ 지붕만 보이는 차량 (2026-09-29, 12:50 백). 중앙섬에 가려 상류 차량이
      #   라이다 한 줄(지붕)로만 찍혀 높이 폭 0.03 m < min_height 로 탈락했다
      #   (-42 m 부터 점이 있었는데 -25 m 에서야 추적). 원형 차로 띠(inner~outer)
      #   안에서 윗면이 지면 위 min_top~max_top 이면 차량 지붕으로 본다.
      thin_top:
        enabled: true
        min_top: 0.9
        max_top: 2.2
        min_length: 0.8
        min_points: 5
        ground_z_sensor: -1.754

    # ★ E-4. 트래킹 및 속도 추정 (Kalman-like Centroid Tracker).
    #   min_confirm_hits: 트랙 확정에 필요한 연속 검출 횟수 (2회 -> 빠른 조기 감지)
    #   min_velocity_hits: 속도 유효 판정에 필요한 검출 횟수 (2회 -> 빠른 TTC 계산)
    #   확정 이동 차량은 차폐 시 3초 보존하되 새 검출로 취급하지 않는다.
    #   이 통합 설정이 site YAML보다 나중에 로드되므로 속도 추정값도 여기서 관리한다.
    tracking:
      association_distance: 3.0
      position_alpha: 0.7
      velocity_alpha: 0.25
      circular_velocity_enabled: true # 회전 중심각의 다중 프레임 회귀로 원호속도 추정
      velocity_window_size: 20
      velocity_min_span: 0.3
      robust_circular_velocity: true
      velocity_window_seconds: 1.8
      velocity_pair_min_span: 0.6
      velocity_extent_tolerance: 0.5
      velocity_hold_seconds: 0.6 # 이미 이동 확인된 차량의 일시적인 검출 면 변경만 보완
      confirmed_hold_seconds: 3.0
      retained_confidence_floor: 0.45
      confirmed_size_shrink_alpha: 0.02
      expiry_guard_seconds: 0.6 # 1.0 -> 0.6: 가려졌던 확정 차량이 사라진 뒤 진입을 막는 시간(16:24:06 백: 두 번 1 s 차단)
      size_alpha: 0.5
      stale_seconds: 1.5
      max_prediction_seconds: 1.0
      max_object_speed: 30.0
      min_confirm_hits: 2
      min_velocity_hits: 2
      moving_speed_threshold: 0.8
      moving_distance_threshold: 1.0
      moving_confirm_hits: 2

# Shared Apollo original measurement core. Profiles are deliberately separate.
# Legacy association/position filters remain; this is not the full Apollo MLF.
motion_tracking:
  backend: apollo_measurement  # legacy restores the previous velocity backend
  dynamic:
    # VLP-16 8~10 Hz: two-to-three scans. Risk logic also requires a signed
    # three-scan ego-lateral rate before an outside object can trigger.
    baseline: 0.12
    max_gap: 0.40
    smoothing: 0.12
    position_sigma: 0.08
    max_speed: 12.0
    max_std: 1.5
  highway:
    baseline: 0.40
    # 2026-09-25: 새 트랙은 이력이 0.40 s 쌓이기 전까지 0.20 s 간격으로 먼저 속도를 낸다
    # (속도 유효 p50 0.31 -> 약 0.1~0.2 s). 0.40 s 이력이 생기면 원래 간격으로 돌아가
    # 정상 추종 중 잡음은 그대로다. baseline 자체를 0.20 으로 줄이면 앞차 속도가
    # 트랙 내내 9~14 m/s 로 흔들렸다(1.5 m/s 넘는 튐 5 -> 22 건).
    startup_baseline: 0.20
    max_gap: 0.50
    smoothing: 0.25
    position_sigma: 0.15
    max_speed: 45.0
    max_std: 2.5
  dynamic_risk:
    enabled: true
    lateral_range: 8.0
    horizon: 4.0
    margin: 0.35
    uncertainty_sigma: 2.0
    uncertainty_cap: 1.5
    fast_lateral_min: 1.2
    slow_lateral_min: 0.50  # requires coherent pose-compensated motion evidence
