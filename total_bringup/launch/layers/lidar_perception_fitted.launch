<launch>
  <arg name="cloud_topic" default="/velodyne_points"/>
  <arg name="imu_topic" default="/imu"/>
  <arg name="odom_topic" default="/odom"/>

  <!-- Compatibility entry point: all LiDAR missions use the same GroundGrid
       terrain estimate and keep mission-specific clustering downstream. -->
  <include file="$(find groundgrid)/launch/kcity_ground_pipeline.launch">
    <arg name="raw_cloud_topic" value="$(arg cloud_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="nonground_topic" value="/nonground"/>
  </include>

  <include file="$(find yolo_test)/launch/obstacle_perception.launch">
    <arg name="lidar_topic" value="/nonground"/>
    <arg name="ground_relative_field" value="ground_relative"/>
  </include>
</launch>
