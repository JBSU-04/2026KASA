#!/usr/bin/env python3
"""Convert MORAI GPS/IMU/vehicle speed into Autoware EKF measurements.

Linear acceleration is deliberately not integrated. IMU yaw-rate drives the
vehicle model through the twist measurement and the quaternion supplies an
absolute wrapped-yaw observation at each GPS update.
"""

import bisect
import math
import threading
from collections import deque

import rospy
import tf
from geometry_msgs.msg import PoseWithCovarianceStamped, TwistWithCovarianceStamped
from morai_msgs.msg import EgoVehicleStatus, GPSMessage
from sensor_msgs.msg import Imu
from std_msgs.msg import Bool, Float32, Float64, String

from morai_sensor_fusion.measurement import (
    CourseBiasEstimator, GpsIntegrityMonitor, bicycle_sideslip, gps_to_base,
    interpolate_angle, normalize_angle, position_variance)

try:
    from pyproj import Proj
except ImportError:
    Proj = None


class MeasurementAdapter:
    def __init__(self):
        if Proj is None:
            raise RuntimeError('python3-pyproj is required')

        self.frame_id = rospy.get_param('~frame_id', 'map')
        self.base_frame = rospy.get_param('~base_frame', 'base_link')
        self.imu_ned = bool(rospy.get_param('~imu_ned', False))
        self.yaw_offset = float(rospy.get_param('~yaw_offset', 0.0))
        self.utm_zone = int(rospy.get_param('~utm_zone', 52))
        self.default_east_offset = float(rospy.get_param('~east_offset', 302595.0))
        self.default_north_offset = float(rospy.get_param('~north_offset', 4124145.0))
        self.use_full_utm = bool(rospy.get_param('~use_full_utm', True))
        self.lever_x = float(rospy.get_param('~gps_lever_x', 0.08))
        self.lever_y = float(rospy.get_param('~gps_lever_y', 0.0))

        self.gps_sigma = float(rospy.get_param('~gps_position_stddev', 0.35))
        self.yaw_sigma = float(rospy.get_param('~imu_yaw_stddev', 0.05))
        self.speed_sigma = float(rospy.get_param('~speed_stddev', 0.15))
        self.wz_sigma = float(rospy.get_param('~yaw_rate_stddev', 0.02))
        self.timestamp_sigma = float(rospy.get_param('~timestamp_stddev', 0.02))
        self.max_imu_alignment = float(rospy.get_param('~max_imu_alignment', 0.12))
        self.max_clock_offset = float(rospy.get_param('~max_clock_offset', 5.0))
        self.gps_timeout = float(rospy.get_param('~gps_timeout', 1.0))
        self.imu_timeout = float(rospy.get_param('~imu_timeout', 0.20))
        self.speed_timeout = float(rospy.get_param('~speed_timeout', 0.35))
        self.cur_speed_is_kmh = bool(rospy.get_param('~cur_speed_is_kmh', True))

        # MORAI shaded areas may repeat a coordinate with a valid status and
        # fresh timestamps.  Detect that from GPS displacement versus the
        # independent vehicle speed, then keep the EKF in twist prediction.
        self.gps_integrity = GpsIntegrityMonitor(
            min_speed=rospy.get_param('~gps_freeze_min_speed', 1.0),
            freeze_ratio=rospy.get_param('~gps_freeze_step_ratio', 0.15),
            freeze_abs_step=rospy.get_param('~gps_freeze_abs_step', 0.03),
            freeze_hits=rospy.get_param('~gps_freeze_confirm_hits', 4),
            recover_min_ratio=rospy.get_param('~gps_recover_min_step_ratio', 0.25),
            recover_max_ratio=rospy.get_param('~gps_recover_max_step_ratio', 2.5),
            recover_margin=rospy.get_param('~gps_recover_step_margin', 0.25),
            recover_hits=rospy.get_param('~gps_recover_confirm_hits', 5))
        self.gps_reacquire_correction_rate = float(rospy.get_param(
            '~gps_reacquire_correction_rate_mps', 0.5))
        self.gps_reacquire_finish_error = float(rospy.get_param(
            '~gps_reacquire_finish_error_m', 0.05))
        self.course_correction_enabled = bool(rospy.get_param(
            '~course_correction_enabled', True))
        # course bias 적용 여부(위 주석 참고). false 면 sideslip 만 쓴다.
        self.course_bias_apply = bool(rospy.get_param(
            '~course_bias_apply', False))
        self.steering_in_degrees = bool(rospy.get_param(
            '~steering_in_degrees', True))
        self.steering_sign = float(rospy.get_param('~steering_sign', -1.0))
        self.rear_axle_fraction = float(rospy.get_param(
            '~rear_axle_fraction', 0.50))
        # FROZEN 진입 시 확정한 bias(rad). NORMAL 복귀 시 None 으로 되돌린다.
        self.frozen_course_bias = None
        self.course_bias = CourseBiasEstimator(
            min_speed=rospy.get_param('~course_bias_min_speed_mps', 2.0),
            min_distance=rospy.get_param('~course_bias_min_distance_m', 1.5),
            max_dt=rospy.get_param('~course_bias_max_dt_sec', 1.5),
            alpha=rospy.get_param('~course_bias_alpha', 0.18),
            max_abs_bias=math.radians(rospy.get_param(
                '~course_bias_max_abs_deg', 5.0)),
            hold_samples=rospy.get_param('~course_bias_hold_samples', 40),
            hold_max_std=math.radians(rospy.get_param(
                '~course_bias_hold_max_std_deg', 0.30)))
        self.dr_pose_rate = float(rospy.get_param('~dr_pose_rate', 20.0))
        self.dr_position_sigma = float(rospy.get_param(
            '~dr_position_stddev', 0.15))
        self.dr_position_sigma_rate = float(rospy.get_param(
            '~dr_position_stddev_rate', 0.03))
        self.dr_position_sigma_max = float(rospy.get_param(
            '~dr_position_stddev_max', 1.5))
        self.dr_position = None
        self.dr_stamp = None
        self.dr_yaw = None
        self.outage_start = None
        self.last_dr_pose_pub = None
        self.status_outage = False
        self.valid_fix_hits = 0
        self.last_reacquire_stamp = None

        self.proj = Proj(proj='utm', zone=self.utm_zone, ellps='WGS84',
                         preserve_units=False)
        self.lock = threading.RLock()
        self.imu_buffer = deque(maxlen=int(rospy.get_param('~imu_buffer_size', 400)))
        self.speed = None
        self.speed_stamp = None
        self.cur_speed = None
        self.cur_speed_stamp = None
        self.steering = 0.0
        self.gps_derived_speed = None
        self.gps_derived_stamp = None
        self.prev_gps_pos = None
        self.prev_gps_time = None
        self.last_gps = None
        self.last_imu = None
        self.last_twist = None

        self.tunnel_camera_yaw_enabled = bool(rospy.get_param(
            '~tunnel_camera_yaw_enabled', True))
        self.tunnel_nominal_heading = math.radians(float(rospy.get_param(
            '~tunnel_nominal_heading_deg', -151.84)))
        self.camera_yaw_timeout = float(rospy.get_param(
            '~camera_yaw_timeout', 0.5))
        self.tunnel_exit_x_utm = float(rospy.get_param(
            '~tunnel_exit_x_utm', 302530.0))
        self.tunnel_entry_x_utm = float(rospy.get_param(
            '~tunnel_entry_x_utm', 302635.0))
        self.tunnel_min_y_utm = float(rospy.get_param(
            '~tunnel_min_y_utm', 4123550.0))
        self.tunnel_max_y_utm = float(rospy.get_param(
            '~tunnel_max_y_utm', 4123750.0))
        self.tunnel_imu_bias = None
        self.camera_yaw_error = None
        self.camera_yaw_valid = False
        self.camera_yaw_stamp = None

        self.pose_pub = rospy.Publisher(
            '/in_pose_with_covariance', PoseWithCovarianceStamped, queue_size=10)
        self.twist_pub = rospy.Publisher(
            '/in_twist_with_covariance', TwistWithCovarianceStamped, queue_size=30)
        self.health_pub = rospy.Publisher(
            '/localization/sensors_valid', Bool, queue_size=1, latch=True)
        self.gps_frozen_pub = rospy.Publisher(
            '/localization/gps_frozen', Bool, queue_size=1, latch=True)
        self.gps_reacquiring_pub = rospy.Publisher(
            '/localization/gps_reacquiring', Bool, queue_size=1, latch=True)
        self.dr_pose_pub = rospy.Publisher(
            '/localization/dr_pose', PoseWithCovarianceStamped, queue_size=10)
        self.course_bias_pub = rospy.Publisher(
            '/localization/course_bias_deg', Float32, queue_size=5)
        self.reacquire_error_pub = rospy.Publisher(
            '/localization/reacquire_error_m', Float32, queue_size=5)
        self.gps_mode_pub = rospy.Publisher(
            '/localization/gps_mode', String, queue_size=1, latch=True)
        self.camera_dr_active_pub = rospy.Publisher(
            '/tunnel/camera_dr_active', Bool, queue_size=1, latch=True)

        gps_topic = rospy.get_param('~gps_topic', '/gps')
        imu_topic = rospy.get_param('~imu_topic', '/imu')
        speed_topic = rospy.get_param('~speed_topic', '/Competition_topic')
        cur_speed_topic = rospy.get_param('~cur_speed_topic', '/cur_speed')
        camera_yaw_topic = rospy.get_param('~camera_yaw_topic', '/tunnel/camera_yaw_error')
        camera_valid_topic = rospy.get_param('~camera_valid_topic', '/tunnel/camera_yaw_valid')
        rospy.Subscriber(gps_topic, GPSMessage, self.gps_callback, queue_size=20)
        rospy.Subscriber(imu_topic, Imu, self.imu_callback, queue_size=100)
        rospy.Subscriber(speed_topic, EgoVehicleStatus, self.speed_callback, queue_size=50)
        rospy.Subscriber(cur_speed_topic, Float32, self.cur_speed_callback, queue_size=50)
        rospy.Subscriber(camera_yaw_topic, Float64, self.camera_yaw_callback, queue_size=5)
        rospy.Subscriber(camera_valid_topic, Bool, self.camera_valid_callback, queue_size=5)
        self.health_timer = rospy.Timer(rospy.Duration(0.05), self.health_callback)

    def camera_yaw_callback(self, message):
        with self.lock:
            self.camera_yaw_error = float(message.data)
            self.camera_yaw_stamp = rospy.Time.now()

    def camera_valid_callback(self, message):
        with self.lock:
            self.camera_yaw_valid = bool(message.data)

    def message_time(self, stamp):
        now = rospy.Time.now()
        if stamp.to_sec() <= 0.0 or abs((now - stamp).to_sec()) > self.max_clock_offset:
            return now
        return stamp

    @staticmethod
    def quaternion_yaw(quaternion):
        norm = math.sqrt(quaternion.x ** 2 + quaternion.y ** 2
                         + quaternion.z ** 2 + quaternion.w ** 2)
        if norm < 1.0e-6:
            return None
        values = [quaternion.x / norm, quaternion.y / norm,
                  quaternion.z / norm, quaternion.w / norm]
        return tf.transformations.euler_from_quaternion(values)[2]

    def convert_yaw_rate(self, raw_yaw, raw_wz):
        if self.imu_ned:
            return (normalize_angle(math.pi / 2.0 - raw_yaw + self.yaw_offset),
                    -raw_wz)
        return normalize_angle(raw_yaw + self.yaw_offset), raw_wz

    def speed_callback(self, message):
        value = float(math.hypot(message.velocity.x, message.velocity.y))
        if not math.isfinite(value) or abs(value) > 55.0:
            rospy.logwarn_throttle(1.0, '[fusion_adapter] invalid speed %.3f ignored', value)
            return
        stamp = self.message_time(message.header.stamp)
        with self.lock:
            if self.speed_stamp is not None and stamp < self.speed_stamp:
                return
            self.speed = value
            self.speed_stamp = stamp
            steering = float(getattr(message, 'front_steer_angle', 0.0))
            self.steering = (math.radians(steering)
                             if self.steering_in_degrees else steering)

    def motion_beta(self):
        if not self.course_correction_enabled:
            return 0.0
        with self.lock:
            steering = self.steering
        return bicycle_sideslip(
            steering, self.rear_axle_fraction, self.steering_sign)

    def enter_gps_outage(self, stamp, reason):
        with self.lock:
            if self.gps_integrity.mode == GpsIntegrityMonitor.NORMAL:
                self.gps_integrity.mark_outage()
                self.outage_start = stamp
                self.last_dr_pose_pub = None
                self.status_outage = True
                self.valid_fix_hits = 0
                self.course_bias.reset_anchor()
                rospy.logwarn('[fusion_adapter] GPS outage (%s); dead reckoning active',
                              reason)
            elif reason == 'invalid_fix':
                # Recovery confirmation must be consecutive. An invalid fix
                # between valid candidates restarts the confirmation window.
                self.status_outage = True
                self.valid_fix_hits = 0

    def make_pose(self, stamp, x, y, yaw, pos_var, yaw_var):
        output = PoseWithCovarianceStamped()
        output.header.stamp = stamp
        output.header.frame_id = self.frame_id
        output.pose.pose.position.x = x
        output.pose.pose.position.y = y
        quaternion = tf.transformations.quaternion_from_euler(0.0, 0.0, yaw)
        output.pose.pose.orientation.x = quaternion[0]
        output.pose.pose.orientation.y = quaternion[1]
        output.pose.pose.orientation.z = quaternion[2]
        output.pose.pose.orientation.w = quaternion[3]
        output.pose.covariance[0] = pos_var
        output.pose.covariance[7] = pos_var
        output.pose.covariance[14] = 10000.0
        output.pose.covariance[21] = 10000.0
        output.pose.covariance[28] = 10000.0
        output.pose.covariance[35] = max(yaw_var, self.yaw_sigma ** 2)
        return output

    def publish_dead_reckoning_pose(self, stamp, yaw, yaw_var):
        with self.lock:
            if (self.gps_integrity.mode == GpsIntegrityMonitor.NORMAL or
                    self.dr_position is None):
                return
            if (self.last_dr_pose_pub is not None and self.dr_pose_rate > 0.0 and
                    (stamp - self.last_dr_pose_pub).to_sec() < 1.0 / self.dr_pose_rate):
                return
            age = (0.0 if self.outage_start is None else
                   max(0.0, (stamp - self.outage_start).to_sec()))
            sigma = min(self.dr_position_sigma_max,
                        self.dr_position_sigma + self.dr_position_sigma_rate * age)
            x, y = self.dr_position

            # When camera VP yaw is active during GPS freeze in straight tunnel, use camera-aligned yaw
            pose_yaw = yaw
            in_straight_tunnel = ((self.tunnel_exit_x_utm <= x <= self.tunnel_entry_x_utm) and
                                  (self.tunnel_min_y_utm <= y <= self.tunnel_max_y_utm))
            in_tunnel_area = (self.tunnel_min_y_utm <= y <= self.tunnel_max_y_utm)
            camera_active = (self.tunnel_camera_yaw_enabled and
                             self.gps_integrity.mode == GpsIntegrityMonitor.FROZEN and
                             in_straight_tunnel and
                             self.camera_yaw_valid and self.camera_yaw_stamp is not None and
                             (stamp - self.camera_yaw_stamp).to_sec() <= self.camera_yaw_timeout and
                             self.camera_yaw_error is not None)
            if camera_active:
                pose_yaw = normalize_angle(self.tunnel_nominal_heading + self.camera_yaw_error)
            elif self.tunnel_imu_bias is not None and self.gps_integrity.mode == GpsIntegrityMonitor.FROZEN and in_tunnel_area:
                # Outside straight tunnel: smoothly follow gyro with held bias!
                pose_yaw = normalize_angle(yaw - self.tunnel_imu_bias)

            output = self.make_pose(stamp, x, y, pose_yaw, sigma ** 2, yaw_var)
            self.last_dr_pose_pub = stamp
        # This corrected DR pose supplies continuous absolute IMU yaw and a
        # course-aware position observation while the GPS pose is unavailable.
        self.pose_pub.publish(output)
        self.dr_pose_pub.publish(output)

    def cur_speed_callback(self, message):
        value = float(message.data)
        if self.cur_speed_is_kmh:
            value /= 3.6
        if not math.isfinite(value) or abs(value) > 55.0:
            return
        stamp = rospy.Time.now()
        with self.lock:
            self.cur_speed = value
            self.cur_speed_stamp = stamp

    def get_effective_speed(self, stamp):
        now = stamp if stamp is not None else rospy.Time.now()
        with self.lock:
            if self.speed is not None and self.speed_stamp is not None:
                if abs((now - self.speed_stamp).to_sec()) <= self.speed_timeout:
                    return self.speed, self.speed_sigma
            if self.cur_speed is not None and self.cur_speed_stamp is not None:
                if abs((now - self.cur_speed_stamp).to_sec()) <= self.speed_timeout:
                    return self.cur_speed, self.speed_sigma
            if self.gps_derived_speed is not None and self.gps_derived_stamp is not None:
                if abs((now - self.gps_derived_stamp).to_sec()) <= 0.50:
                    return self.gps_derived_speed, 0.35
        return 0.0, 0.50

    def imu_callback(self, message):
        raw_yaw = self.quaternion_yaw(message.orientation)
        raw_wz = float(message.angular_velocity.z)
        if raw_yaw is None or not math.isfinite(raw_wz):
            rospy.logwarn_throttle(1.0, '[fusion_adapter] invalid IMU ignored')
            return
        yaw, wz = self.convert_yaw_rate(raw_yaw, raw_wz)
        stamp = self.message_time(message.header.stamp)
        yaw_var = (message.orientation_covariance[8]
                   if message.orientation_covariance[8] > 0.0 else self.yaw_sigma ** 2)
        wz_var = (message.angular_velocity_covariance[8]
                   if message.angular_velocity_covariance[8] > 0.0 else self.wz_sigma ** 2)

        with self.lock:
            if self.imu_buffer and stamp <= self.imu_buffer[-1][0]:
                rospy.logwarn_throttle(1.0, '[fusion_adapter] non-increasing IMU stamp ignored')
                return
            self.imu_buffer.append((stamp, yaw, wz, yaw_var, wz_var))
            self.last_imu = rospy.Time.now()

        speed, eff_speed_sigma = self.get_effective_speed(stamp)
        # Keep an independent, continuous dead-reckoning position.  In normal
        # operation each trusted GPS fix anchors it.  Once GPS freezes this
        # state continues from exact simulator speed and absolute IMU yaw, so
        # reacquisition can be blended without jumping the canonical /odom.
        with self.lock:
            if self.dr_position is not None and self.dr_stamp is not None:
                dt = (stamp - self.dr_stamp).to_sec()
                if 0.0 < dt <= 0.5:
                    heading = (yaw if self.dr_yaw is None else
                               interpolate_angle(self.dr_yaw, yaw, 0.5))

                    x_curr, y_curr = self.dr_position[0], self.dr_position[1]
                    in_straight_tunnel = ((self.tunnel_exit_x_utm <= x_curr <= self.tunnel_entry_x_utm) and
                                          (self.tunnel_min_y_utm <= y_curr <= self.tunnel_max_y_utm))
                    in_tunnel_area = (self.tunnel_min_y_utm <= y_curr <= self.tunnel_max_y_utm)

                    camera_active = (self.tunnel_camera_yaw_enabled and
                                     self.gps_integrity.mode == GpsIntegrityMonitor.FROZEN and
                                     in_straight_tunnel and
                                     self.camera_yaw_valid and self.camera_yaw_stamp is not None and
                                     (stamp - self.camera_yaw_stamp).to_sec() <= self.camera_yaw_timeout and
                                     self.camera_yaw_error is not None)

                    if camera_active:
                        # Inside straight tunnel: calibrate IMU bias and track tunnel centerline
                        cam_heading = normalize_angle(self.tunnel_nominal_heading + self.camera_yaw_error)
                        measured_bias = normalize_angle(yaw - cam_heading)
                        if self.tunnel_imu_bias is None:
                            self.tunnel_imu_bias = measured_bias
                        else:
                            self.tunnel_imu_bias = normalize_angle(
                                0.95 * self.tunnel_imu_bias + 0.05 * measured_bias)

                        heading = normalize_angle(cam_heading + self.motion_beta())
                        rospy.loginfo_throttle(
                            2.0,
                            '[fusion_adapter] Tunnel Camera VP active! heading=%.2f deg, imu_bias=%.2f deg' %
                            (math.degrees(heading), math.degrees(self.tunnel_imu_bias)))
                    elif self.tunnel_imu_bias is not None and self.gps_integrity.mode == GpsIntegrityMonitor.FROZEN and in_tunnel_area:
                        # Exited straight tunnel (e.g. exit curve before GPS recovery): smoothly track gyro with held bias!
                        # This eliminates the heading discontinuity at tunnel exit!
                        heading = normalize_angle(yaw - self.tunnel_imu_bias + self.motion_beta())
                        rospy.loginfo_throttle(
                            1.0,
                            '[fusion_adapter] Tunnel exit curve! Tracking gyro yaw=%.2f deg with held bias=%.2f deg' %
                            (math.degrees(yaw), math.degrees(self.tunnel_imu_bias)))
                    elif self.course_correction_enabled:
                        # course bias 는 '장착 오차' 같은 상수가 아니라
                        # 주행 구간마다 변한다. 실측(2026-09-17):
                        #   15:35 백 구간별 평균 +0.000 / +0.468 / -0.137 / -0.375
                        #   15:56 백 hold 가 -0.863 deg 를 골랐는데, 그 값이
                        #   만들 오차는 -1.80 m 였고 실제 복귀오차는 0.69 m -
                        #   다른 오차와 우연히 상쇄된 것뿐이다.
                        # 잘못 잡으면 오차를 '만드는' 쪽으로 작용하므로
                        # 기본적으로 끈다. sideslip(motion_beta)은 물리 모델이라
                        # 그대로 쓴다.
                        bias = 0.0
                        if self.course_bias_apply:
                            bias = (self.frozen_course_bias
                                    if self.frozen_course_bias is not None
                                    else self.course_bias.bias)
                        heading = normalize_angle(
                            heading + bias + self.motion_beta())
                    self.dr_position = (
                        self.dr_position[0] + speed * math.cos(heading) * dt,
                        self.dr_position[1] + speed * math.sin(heading) * dt)
                if dt > 0.0:
                    self.dr_stamp = stamp
                    self.dr_yaw = yaw
        output = TwistWithCovarianceStamped()
        output.header.stamp = stamp
        output.header.frame_id = self.base_frame
        output.twist.twist.linear.x = speed
        output.twist.twist.angular.z = wz
        output.twist.covariance[0] = eff_speed_sigma ** 2
        output.twist.covariance[35] = max(wz_var, self.wz_sigma ** 2)
        self.twist_pub.publish(output)
        self.course_bias_pub.publish(Float32(
            data=math.degrees(self.course_bias.bias)))
        self.publish_dead_reckoning_pose(stamp, yaw, yaw_var)
        with self.lock:
            x_c = self.dr_position[0] if self.dr_position is not None else 0.0
            y_c = self.dr_position[1] if self.dr_position is not None else 0.0
            in_tunnel_c = ((self.tunnel_exit_x_utm <= x_c <= self.tunnel_entry_x_utm) and
                           (self.tunnel_min_y_utm <= y_c <= self.tunnel_max_y_utm))
            camera_active_flag = (self.tunnel_camera_yaw_enabled and
                                  self.gps_integrity.mode == GpsIntegrityMonitor.FROZEN and
                                  in_tunnel_c and
                                  self.camera_yaw_valid and self.camera_yaw_stamp is not None and
                                  (stamp - self.camera_yaw_stamp).to_sec() <= self.camera_yaw_timeout and
                                  self.camera_yaw_error is not None)
            self.camera_dr_active_pub.publish(Bool(data=camera_active_flag))
            self.last_twist = rospy.Time.now()

    def imu_at(self, stamp):
        with self.lock:
            samples = list(self.imu_buffer)
        if not samples:
            return None
        times = [item[0].to_sec() for item in samples]
        target = stamp.to_sec()
        index = bisect.bisect_left(times, target)
        if index == 0:
            sample = samples[0]
            if abs(times[0] - target) > self.max_imu_alignment:
                return None
            return sample[1:]
        if index >= len(samples):
            sample = samples[-1]
            dt = target - times[-1]
            if dt > self.max_imu_alignment:
                return None
            return (normalize_angle(sample[1] + sample[2] * dt),
                    sample[2], sample[3] + dt * dt * sample[4], sample[4])
        before, after = samples[index - 1], samples[index]
        if min(target - times[index - 1], times[index] - target) > self.max_imu_alignment:
            return None
        span = max(times[index] - times[index - 1], 1.0e-9)
        ratio = (target - times[index - 1]) / span
        return (interpolate_angle(before[1], after[1], ratio),
                before[2] + ratio * (after[2] - before[2]),
                max(before[3], after[3]), max(before[4], after[4]))

    def gps_callback(self, message):
        if (not math.isfinite(message.latitude) or not math.isfinite(message.longitude)
                or (message.latitude == 0.0 and message.longitude == 0.0)
                or int(message.status) <= 0):
            self.enter_gps_outage(rospy.Time.now(), 'invalid_fix')
            rospy.logwarn_throttle(1.0, '[fusion_adapter] invalid GPS fix ignored')
            return
        stamp = self.message_time(message.header.stamp)
        imu = self.imu_at(stamp)
        if imu is None:
            rospy.logwarn_throttle(1.0, '[fusion_adapter] GPS waits for timestamp-aligned IMU')
            return
        yaw, _wz, yaw_var, _wz_var = imu
        if self.use_full_utm:
            east_offset = 0.0
            north_offset = 0.0
        else:
            east_offset = (float(message.eastOffset) if message.eastOffset != 0.0
                           else self.default_east_offset)
            north_offset = (float(message.northOffset) if message.northOffset != 0.0
                            else self.default_north_offset)
        utm_x, utm_y = self.proj(message.longitude, message.latitude)
        x, y = gps_to_base(utm_x - east_offset, utm_y - north_offset,
                           yaw, self.lever_x, self.lever_y)

        with self.lock:
            if self.prev_gps_pos is not None and self.prev_gps_time is not None:
                dt = (stamp - self.prev_gps_time).to_sec()
                if 0.01 <= dt <= 0.35:
                    dist = math.hypot(x - self.prev_gps_pos[0], y - self.prev_gps_pos[1])
                    v_gps = dist / dt
                    if 0.0 <= v_gps <= 55.0:
                        self.gps_derived_speed = v_gps
                        self.gps_derived_stamp = stamp
            self.prev_gps_pos = (x, y)
            self.prev_gps_time = stamp

        speed, _ = self.get_effective_speed(stamp)
        with self.lock:
            previous_mode = self.gps_integrity.mode
            if (self.status_outage and
                    previous_mode == GpsIntegrityMonitor.FROZEN):
                # status/timeout dropouts can recover while the car is stopped;
                # require several consecutive valid fixes instead of requiring
                # a displacement-based recovery step.
                self.valid_fix_hits += 1
                if self.valid_fix_hits >= self.gps_integrity.recover_hits_required:
                    self.gps_integrity.mark_reacquiring()
                mode = self.gps_integrity.mode
            else:
                mode = self.gps_integrity.update(stamp.to_sec(), x, y, speed)

            if previous_mode == GpsIntegrityMonitor.NORMAL:
                self.course_bias.update(
                    stamp.to_sec(), x, y, yaw, speed, self.motion_beta())

            if previous_mode != mode:
                rospy.logwarn('[fusion_adapter] GPS integrity: %s -> %s',
                              previous_mode, mode)
                if mode == GpsIntegrityMonitor.FROZEN:
                    self.outage_start = stamp
                    self.last_dr_pose_pub = None
                    # 음영구간 내내 쓸 bias 를 여기서 한 번 확정한다.
                    # EMA(self.course_bias.bias)를 그대로 쓰면 GPS 가
                    # 끊기는 순간 한 샘플의 잡음이 전체 궤적을 기울인다.
                    #   실측(2026-09-17 15:35 백): 학습 평균 +0.043 deg 인데
                    #   끊긴 순간 EMA 가 -0.367 deg 였고, 113 m 주행에서
                    #   그 차이만으로 횡오차 0.73 m 가 생겼다.
                    self.frozen_course_bias = self.course_bias.hold_value()
                    rospy.logwarn(
                        '[fusion_adapter] course bias hold: %.3f deg '
                        '(EMA %.3f deg)',
                        math.degrees(self.frozen_course_bias),
                        math.degrees(self.course_bias.bias))
                    self.course_bias.reset_anchor()
                elif mode == GpsIntegrityMonitor.NORMAL:
                    self.frozen_course_bias = None
                    self.tunnel_imu_bias = None

            if mode == GpsIntegrityMonitor.FROZEN:
                # Do not feed repeated coordinates into the EKF.  Twist input
                # remains live, so its 50 Hz prediction continues normally.
                return

            if mode == GpsIntegrityMonitor.REACQUIRING:
                if self.dr_position is None:
                    self.dr_position = (x, y)
                    self.dr_stamp = stamp
                    self.dr_yaw = yaw
                correction_dt = 0.05
                if self.last_reacquire_stamp is not None:
                    correction_dt = max(0.01, min(
                        0.35, (stamp - self.last_reacquire_stamp).to_sec()))
                self.last_reacquire_stamp = stamp
                error_x = x - self.dr_position[0]
                error_y = y - self.dr_position[1]
                error = math.hypot(error_x, error_y)
                self.reacquire_error_pub.publish(Float32(data=error))
                max_step = self.gps_reacquire_correction_rate * correction_dt
                if error > max_step and error > 1.0e-9:
                    scale = max_step / error
                    self.dr_position = (
                        self.dr_position[0] + error_x * scale,
                        self.dr_position[1] + error_y * scale)
                else:
                    self.dr_position = (x, y)
                remaining = math.hypot(x - self.dr_position[0],
                                       y - self.dr_position[1])
                out_x, out_y = self.dr_position
                if remaining <= self.gps_reacquire_finish_error:
                    self.gps_integrity.mark_normal()
                    self.last_reacquire_stamp = None
                    self.dr_position = (x, y)
                    self.outage_start = None
                    self.status_outage = False
                    self.valid_fix_hits = 0
                    self.tunnel_imu_bias = None
                    out_x, out_y = x, y
                    rospy.loginfo('[fusion_adapter] GPS reacquisition complete')
            else:
                # Noise-free simulator GPS is the absolute anchor.
                self.dr_position = (x, y)
                self.dr_stamp = stamp
                self.dr_yaw = yaw
                self.last_reacquire_stamp = None
                self.outage_start = None
                self.status_outage = False
                self.valid_fix_hits = 0
                out_x, out_y = x, y

        pos_var = position_variance(
            self.gps_sigma, speed, self.timestamp_sigma,
            self.lever_x, self.lever_y, math.sqrt(max(yaw_var, 0.0)))

        output = self.make_pose(stamp, out_x, out_y, yaw, pos_var, yaw_var)
        self.pose_pub.publish(output)
        with self.lock:
            # Reacquiring measurements are intentionally smooth but are not yet
            # declared globally valid until they converge to raw GPS.
            if self.gps_integrity.mode == GpsIntegrityMonitor.NORMAL:
                self.last_gps = rospy.Time.now()

    def health_callback(self, _event):
        now = rospy.Time.now()
        with self.lock:
            gps = self.last_gps
            imu = self.last_imu
            twist = self.last_twist
            gps_mode = self.gps_integrity.mode
        if (gps_mode == GpsIntegrityMonitor.NORMAL and gps is not None and
                (now - gps).to_sec() > self.gps_timeout):
            self.enter_gps_outage(now, 'timeout')
            with self.lock:
                gps_mode = self.gps_integrity.mode
        valid = (gps is not None and imu is not None and twist is not None
                 and gps_mode == GpsIntegrityMonitor.NORMAL
                 and (now - gps).to_sec() <= self.gps_timeout
                 and (now - imu).to_sec() <= self.imu_timeout
                 and (now - twist).to_sec() <= self.speed_timeout)
        self.health_pub.publish(Bool(data=valid))
        self.gps_frozen_pub.publish(Bool(
            data=gps_mode != GpsIntegrityMonitor.NORMAL))
        self.gps_reacquiring_pub.publish(Bool(
            data=gps_mode == GpsIntegrityMonitor.REACQUIRING))
        self.gps_mode_pub.publish(String(data=gps_mode))


def main():
    rospy.init_node('morai_measurement_adapter')
    MeasurementAdapter()
    rospy.loginfo('[fusion_adapter] GPS + IMU yaw + Competition speed ready; accel integration disabled')
    rospy.spin()


if __name__ == '__main__':
    main()
