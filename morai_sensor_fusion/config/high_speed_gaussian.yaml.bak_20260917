# MORAI K-City/Sangam baseline for 60 km/h urban and 100 km/h gentle highway.
# Variances must be retuned from rosbag residuals when simulator noise changes.
predict_frequency: 50.0
extend_state_step: 100
enable_yaw_bias_estimation: true
publish_tf: false
use_pose_with_covariance: true
use_twist_with_covariance: true
pose_rate: 20.0
twist_rate: 50.0
# 재수신 GPS는 adapter가 DR 위치로 천천히 수렴시키므로, 정상 상태의
# 명백한 이상치만 걸러내는 범위로 pose gate를 둔다.
pose_gate_dist: 9.21
twist_gate_dist: 25.0
pose_additional_delay: 0.0
twist_additional_delay: 0.0
pose_measure_uncertainty_time: 0.02
proc_stddev_yaw_c: 0.003
proc_stddev_yaw_bias_c: 0.0001
proc_stddev_vx_c: 0.8
proc_stddev_wz_c: 0.10
