<?xml version="1.0"?>
<package format="2">
  <name>morai_sensor_fusion</name>
  <version>0.2.0</version>
  <description>MORAI measurement adapters and odometry output for Autoware EKF.</description>
  <maintainer email="kuuve@todo.todo">kuuve</maintainer>
  <license>MIT</license>
  <buildtool_depend>catkin</buildtool_depend>
  <depend>ekf_localizer</depend>
  <depend>geometry_msgs</depend>
  <depend>visualization_msgs</depend>
  <exec_depend>mission_supervisor</exec_depend>
  <depend>morai_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rospy</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf</depend>
  <exec_depend>python3-pyproj</exec_depend>
  <exec_depend>python3-rospkg</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <test_depend>python3-nose</test_depend>
  <export/>
</package>
