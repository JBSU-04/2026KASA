<?xml version="1.0"?>
<package format="2">
  <name>yolo_distance_pkg</name>
  <version>0.1.0</version>
  <description>YOLO segmentation and monocular depth based distance estimation.</description>

  <maintainer email="kuuve@example.com">kuuve</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <exec_depend>python3</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-torch</exec_depend>
  <exec_depend>python3-torchvision</exec_depend>
  <exec_depend>rospy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>morai_msgs</exec_depend>

  <export/>
</package>
