<launch>
  <arg name="use_rviz" default="false"/>
  <!-- 통합 런치에서는 total_bringup이 TF를 소유한다. 단독 실행 시에만 true -->
  <arg name="publish_lidar_tf" default="false"/>
  <arg name="raw_cloud_topic" default="/velodyne_points"/>
  <arg name="imu_topic" default="/imu"/>
  <arg name="odom_topic" default="/odom"/>
  <!-- 이 패키지의 클러스터/트래커는 음영구간 호환용이다. 지면 제거는
       전 미션과 동일한 공식 GroundGrid 파이프라인을 사용한다. -->
  <arg name="enable_clustering" default="false"/>
  <arg name="enable_tracking"   default="false"/>

  <!-- Publish static TF from base_link to velodyne for MORAI LiDAR data.
       z 는 total_bringup/config/lidar_extrinsic.yaml 의 차량원점 기준 값과
       맞춘다(1.35 -> 1.33, 2026-09-21). 어긋나면 TF 와 실제 점군이 틀어진다. -->
  <node if="$(arg publish_lidar_tf)" pkg="tf2_ros" type="static_transform_publisher"
        name="base_link_to_velodyne" args="1.10 0 1.33 0 0 0 base_link velodyne" />

  <include file="$(find groundgrid)/launch/kcity_ground_pipeline.launch">
    <arg name="raw_cloud_topic" value="$(arg raw_cloud_topic)"/>
    <arg name="imu_topic" value="$(arg imu_topic)"/>
    <arg name="odom_topic" value="$(arg odom_topic)"/>
    <arg name="nonground_topic" value="/nonground"/>
  </include>
  <node if="$(arg enable_clustering)" pkg="lidar_perception_pkg" type="clustering_node" name="clustering_node" output="screen">
    <rosparam command="load" file="$(find lidar_perception_pkg)/config/clustering.yaml"/>
  </node>
  <node if="$(arg enable_tracking)" pkg="lidar_perception_pkg" type="object_tracking_node" name="object_tracking_node" output="screen">
    <rosparam command="load" file="$(find lidar_perception_pkg)/config/object_tracking.yaml"/>
  </node>
  <node if="$(arg use_rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find lidar_perception_pkg)/rviz/lidar_perception.rviz"/>
</launch>
