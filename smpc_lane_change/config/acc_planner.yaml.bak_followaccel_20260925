ego_length_m: 4.8
ego_width_m: 1.9
acc_max_range_m: 100.0     # 70km/h에서 약 5.1초 전방까지 ACC 추종
# 7.0 -> 8.0 / 0.45 -> 0.60 (2026-09-14). 조금 더 여유 있게 잡는다.
#   목표간격 = standstill_gap_m + time_headway_sec * v
#     18 m/s(65km/h): 15.1 -> 18.8 m   (+3.7)
#     20 m/s        : 16.0 -> 20.0 m   (+4.0)
#   실측(13:00 / 12:57 백) 실제 추종 간격은 22~29 m 로 이미 목표보다 넉넉히
#   떨어져 있었고, 최근접도 22.8 m 였다. 목표를 그 실측 대역 쪽으로 끌어
#   올리는 것이라 거동이 크게 바뀌지 않으면서 여유만 늘어난다.
#   time_headway 0.60 은 흔히 쓰는 1.0~2.0 s 보다 여전히 짧아 과하지 않다.
# 2026-09-14 2차 조정: 앞차와 더 여유를 둔다.
#   목표간격 = standstill_gap_m + time_headway_sec * v
#     18 m/s(65km/h): 18.8 -> 22.4 m
#     20 m/s        : 20.0 -> 24.0 m
#   실측(13:00 / 12:57 백) 실제 추종 간격이 22~29 m 였으므로 목표를 그
#   대역에 맞춘다. time_headway 0.8 은 통상 권장(1.0~2.0)보다 여전히 짧다.
standstill_gap_m: 8.0      # 정차 간격
time_headway_sec: 0.80     # 65km/h(18m/s) 주행 시 8.0 + 0.80 * 18 = 22.4m 유지
gap_gain: 0.4              # 거리 오차에 대한 반응 완화 (기존 1.0 -> 0.4: 부드러운 거리 유지 및 속도 요동 방지)
# 0.6 -> 0.8. 접근 중일 때만 상대속도에 비례해 목표 간격을 더 준다
# (상대 4 m/s 면 +0.8 m). 정속 추종 중에는 상대속도가 0 이라 영향 없다.
# 예전 2.0 은 목표 간격이 과하게 팽창했던 값이라 그쪽으로는 안 돌아간다.
closing_speed_gap_time_sec: 0.8 # 접근 시 목표 간격 가산
# Used by the follow-speed/braking-distance guards. A smaller assumed value
# makes normal ACC begin reducing target speed earlier.
braking_decel_mps2: 1.8
# 4.0 -> 4.5. 늘어난 목표 간격(18.8 m)을 늦게 회복하지 않도록 부드러운
# 감속을 조금 일찍 시작한다. hard_ttc(2.0)/critical_ttc(1.0)은 그대로 두어
# 강한 개입 시점은 바꾸지 않는다.
soft_ttc_sec: 4.5          # 부드러운 감속 시작 TTC
hard_ttc_sec: 2.0          # (기존 2.5 -> 2.0)
min_speed_mps: 0.0
# 가감속을 더 부드럽게. 목표속도 변화율 자체를 낮춰 승차감과 추종
# 안정성을 높인다.
max_accel_mps2: 1.6        # 2.2 -> 1.6
lane_change_max_accel_mps2: 3.0
max_decel_mps2: 1.5        # 2.0 -> 1.5 (일반 감속 더 완만)

# 고주로 주행 중 앞차 거리유지 감속 비율 및 속도 하강 폭 완화
highway_follow_max_decel_mps2: 1.2      # 1.5 -> 1.2 (고주로 추종 감속 더 완만)
highway_max_follow_speed_drop_mps: 1.5  # 고주로 앞차 거리유지 시 앞차 속도 대비 최대 감속 폭 (기존 4.0m/s -> 1.5m/s)

# Keep normal ACC following behavior, but let the filtered speed target drop
# faster when ego is rapidly closing on a much slower/stopped front vehicle.
# Smooth progressive deceleration without harsh kick.
closing_decel_boost_enabled: true
closing_decel_boost_start_mps: 3.0       # 미세한 상대속도 접근 시 부스트 비활성화 (기존 1.0 -> 3.0 m/s)
closing_decel_boost_full_mps: 8.0
closing_decel_boost_max_decel_mps2: 3.0  # 3.5 -> 3.0 (부스트 감속도 한 단계 완화)
# 고주로에서 위 부스트가 올라갈 수 있는 상한 = highway_follow_max_decel_mps2 * 이 값.
# 1.3 이면 상한이 1.56 뿐인데 도심은 같은 함수를 상한 없이 써서 3.0 까지 쓴다 -
# 더 빠른 고주로가 더 약하게 제동하는 역전이었다.
#   실측(2026-09-15 18:01 백, t=280~284): 앞차가 4.6 m/s 느린데 목표속도
#   16.1 -> 12.7 하강에 2.6 초가 걸렸고, 그 사이 24 m 를 다 소진해 4.3 m 에서
#   hard brake(0.47)가 걸렸다. 2.5 면 같은 구간이 1.9 초로 줄어든다.
# closing_decel_boost_start_mps(3.0) 이하의 폐쇄속도에서는 아무 효과가 없어
# 정속 추종 승차감은 highway_follow_max_decel_mps2 그대로 유지된다.
# 일반 추종 시 부스트 상한 배수(= highway_follow_max_decel_mps2 * 이 값).
#   실측(20:25 백 t=18~22): 앞차가 8.4 m/s 느린데 1.3 배(1.56 m/s^2)로는
#   18.6 -> 10.2 수렴에 5.4 초가 걸려 보유 간격 23.5 m 를 거의 다 소진하고
#   1.9 m 까지 붙었다. 2.5 배면 2.8 초/11.8 m 로 절반만 쓴다.
# time_headway 를 올려도 이 한도가 그대로면 더 먼 지점에서 같은 일이
# 반복되므로, 목표 간격이 아니라 여기가 손잡이다.
highway_closing_decel_boost_scale: 2.5
# 차선변경 준비/진행 중에만 쓰는 낮은 배수.
#   실측(20:17 백): 2.5 배를 변경 판단 중에도 쓰니 자차가 10.8 -> 5.9 m/s 로
#   끌려 내려가 블렌드 경로가 ref_pts 357 -> 100, ref_preview 0(무효)이 되어
#   변경 자체가 막혔다. 변경 중에는 속도를 지켜야 경로가 만들어진다.
highway_closing_decel_boost_scale_lane_change: 1.3

# 앞차 속도 추정 신뢰도. LiDAR 트래커는 원거리/부분가림에서 velocity_valid=false
# 와 함께 무의미한 v_long 을 낸다(실측 18:01 백: v_long=4.3 / -0.7, std=45).
# 이 문턱을 넘거나 velocity_valid 가 false 면 직전 유효값을 hold_sec 동안
# 유지하고, 그것도 없으면 ego 속도로 가정한다(폐쇄속도 0 = 추가 감속 요구 없음).
# SMPC 의 target_front_early_yield_max_velocity_std_mps(3.0) 와 같은 기준이다.
# 3.0 -> 1.0 (2026-09-16 실측). 중앙차분 기준 오차를 구간별로 재보니
#   std 0.0~1.0 : RMS 1.05 m/s   (n=293, 전체의 56%)
#   std 1.0~2.0 : RMS 1.45
#   std 2.0~5.0 : RMS 1.81
#   std 5.0~    : RMS 1.72
# 1.0 을 넘으면 오차가 급격히 커지므로 거기서 자른다. 걸러진 프레임은
# 아래 hold(직전 유효값) 로 메운다 - 버리는 게 아니라 최근값을 쓴다.
lead_max_velocity_std_mps: 1.0
lead_speed_hold_sec: 1.0

# 간격 미분 기반 폐쇄속도 - 비활성화(false).
#   착안: 거리는 직접 측정이라 정확하니 그 미분이 속도 추정보다 나을
#   것이라 봤다. 실측(2026-09-16 15:18 백)에서 반대였다.
#     프레임간 변동:  간격미분 2.09 m/s  vs  칼만기반 0.584 m/s
#   원인은 front_delta_s(클러스터 앞면 경계)가 프레임마다 +-1.8 m 튄다는
#   것이다. 0.12 s 로 나누면 15 m/s 짜리 노이즈가 된다. 창을 1.2 s 로
#   늘려도 변동이 1.78 로 칼만보다 3 배 나빠 쓸 수 없었다.
#   (클러스터 경계 안정화가 선행되면 다시 볼 만하다.)
gap_closing_enabled: false


hard_brake_decel_mps2: 5.5
hard_brake_bypass_filter: false
emergency_gap_m: 8.0       # 15m 추종 중 8m 이내 좁혀지면 비상 감속 개입

# ACC following behavior: emergency_gap is now a strong-following zone, not an
# automatic stop.  A full hard stop is reserved for truly critical distance/TTC.
critical_gap_m: 6.0
emergency_stop_gap_m: 4.0
critical_ttc_sec: 1.0       # (기존 1.5 -> 1.0)
max_follow_speed_drop_mps: 4.0
lead_moving_speed_thresh_mps: 0.5

# Rapid response for a lead that is first seen in front of ego (cut-in,
# occlusion release, or delayed LiDAR detection).
# In highway driving, disabled to prevent sudden jerk to 0.
rapid_lead_brake_enabled: false
rapid_lead_ttc_sec: 2.5
rapid_lead_min_closing_speed_mps: 4.0
rapid_lead_required_decel_mps2: 5.0

target_timeout_sec: 0.8
decision_request_timeout_sec: 0.5
publish_rate_hz: 20.0

# MPC publishes the CSV mission_state speed target here.  Keep the speed policy
# in mpc_path_tracking/config/mpc_params.yaml; SMPC only consumes it.
mission_speed_topic: "/control_feedback/mission_speed_target_mps"
mission_speed_timeout_sec: 0.5
mission_speed_fallback_mps: 18.06 # 65km/h; fresh MPC mission speed has priority

# High-level SMPC preparation request.  ACC remains the sole publisher of
# /smpc/target_speed_mps: this request is only an extra speed cap after all
# lead/TTC/lane-end safety limits have been applied.
# Apply validated YIELD/HOLD preparation caps after normal ACC safety limits.
behavior_request_enabled: true
behavior_request_topic: "/smpc/behavior_longitudinal_request"
behavior_request_timeout_sec: 0.35
behavior_status_topic: "/smpc/behavior_longitudinal_status"
behavior_request_apply_while_lane_change: true
# Positive acceleration candidates are evaluated by SMPC but initially kept
# in shadow mode.  YIELD/HOLD caps are active.
# 기본은 계속 false(가속 요청 무시). 다만 아래 예외 창에서만 허용한다.
behavior_request_apply_accel: false
# 양보를 막 해제한 직후 짧게만 가속 요청을 받아들인다 (2026-09-16).
#   양보로 속도를 내준 뒤 앞차가 안전영역을 벗어나 길이 열렸는데도 가속을
#   못 하면, 낮아진 속도 그대로 합류하거나 기회를 놓친다.
#   창을 짧게 둬 '밀어붙이는 가속'이 되지 않게 하고, 새 뒤차가 들어오면
#   SMPC 가 다시 YIELD/WAIT 를 보내므로 이 경로는 자연히 닫힌다.
accel_after_yield_release_enabled: true
accel_release_window_sec: 1.5
# 양보 후 따라가기(2026-09-25): 양보/대기 중 목표 차로 앞차가 자차 앞(범퍼 간격 >=
# yield_follow_min_gap_m)에서 자차보다 yield_follow_min_rel_speed_mps 이상 빠르게 멀어지면
# 양보 상한 대신 그 차를 앞차로 ACC 한다(우리 차로 앞차가 있으면 더 느린 쪽).
# 목표 차로 뒤차가 rear_block_gap_m 안에서 rear_block_rel_speed_mps 이상 빠르면 양보 유지.
# 차선변경 시작부터 새 차로 앞차를 약하게 추종(가속 차단, 감속 target_front_overlap_soft_max_decel
# 이하). 목표 차로에 걸치기 시작하면(|d_target| <= target_front_overlap_soft_acc_start_abs_d_m)
# 급제동 권한도 준다. 19:34 백: 이 앞차를 1.8 s 무시하고 가속해 3.6 m 까지 붙었다.
lc_target_lead_soft_from_start: true
yield_follow_enabled: true
yield_follow_min_gap_m: 2.0
yield_follow_min_rel_speed_mps: 0.5
yield_follow_release_rel_speed_mps: -0.5
yield_follow_rear_block_gap_m: 15.0
yield_follow_rear_block_rel_speed_mps: 1.0

# When waypoint_system uses its endpoint connector to hand off an exhausted
# source CSV to the target lane, limit the ACC target to a moderate crawl
# speed. 5.0 m/s and a 3.0 m/s^2 recovery limit shorten the exposed low-speed
# interval while the connector remains active. The Bool has no header, so true
# must be refreshed within this timeout; stale or missing state never applies
# this cap.
endpoint_connector_speed_cap_mps: 5.0
# Only while the endpoint connector is actively tracked, restore the target
# speed at the connector-specific acceleration limit. Normal ACC recovery
# remains max_accel_mps2 above.
endpoint_connector_max_accel_mps2: 3.0
endpoint_connector_status_timeout_sec: 0.5

# Target-lane gap and lane-end fallback braking.
min_target_front_gap_m: 12.0
min_target_rear_gap_m: 18.0

# Do not let target-lane front vehicles trigger ACC braking before ego has
# actually entered the target lane.  This prevents target_front:hard from
# killing merge momentum during the initial lane-change phase.
target_front_acc_requires_target_lane_entry: true
target_front_acc_entry_abs_d_m: 0.75
# The highway mission requires every source lane to merge left.  Treat the
# intended target-lane front vehicle as a soft ACC lead from the start of that
# mandatory merge, even before ego overlaps the target lane.  Hard/TTC braking
# authority is still withheld until target-lane entry is established below.
# A non-positive distance disables the lane-end range gate; acc_max_range_m
# remains the physical look-ahead limit.
target_front_preentry_soft_acc_enabled: true
target_front_preentry_soft_acc_distance_to_end_m: 0.0

# During an active lane change, start gently following target_front when ego's
# body first reaches the target lane.  With a 3.5 m lane and 1.9 m ego width,
# 2.7 m is the target-center offset at which the ego footprint crosses the
# lane boundary.  Full target-front hard/rapid braking stays disabled until
# abs(ego_d_target) <= target_front_acc_entry_abs_d_m above.
target_front_overlap_soft_acc_enabled: true
target_front_overlap_soft_acc_start_abs_d_m: 2.7
target_front_overlap_soft_max_decel_mps2: 3.5

# Keep ACC aligned with the SMPC rear-safety policy: do not relax a target-lane
# rear gap while ego is preparing or executing a highway merge.
merge_priority_enabled: false
merge_priority_rear_safe_gap_m: 4.5
merge_priority_rear_min_gap_m: 4.0
merge_priority_rear_max_closing_mps: 3.5
merge_priority_rear_min_ttc_sec: 1.8

# In multi-lane merge zones, do not let side-lane vehicles that are entering
# ego's current lane become ACC leads too early. If they are already close in
# front, the normal ACC emergency/lead logic still applies.
ego_lane_priority_enabled: true
ego_lane_priority_current_max_abs_d_m: 1.25
ego_lane_priority_front_hard_gap_m: 8.0

lane_end_stop_margin_m: 2.0
lane_end_comfort_decel_mps2: 3.0
lane_end_merge_creep_speed_mps: 4.0
lane_end_hard_stop_distance_m: 6.0
# For lanes 0,1,2, if SMPC cannot approve the next-left merge, use this
# pre-end buffer as a holding line.  Stopping here keeps /local_path long
# enough for MPC polyfit while gap/risk evaluation continues.
lane_end_merge_wait_stop_enabled: true
lane_end_merge_wait_stop_distance_m: 15.0
stop_at_lane_end_enabled: true
# Lanes 0,1,2 use the SMPC lane-end deadline to change left if the target gap is safe.
# Lane 3 is the final highway lane and stops at its CSV endpoint.
lane_end_stop_lane_ids: [3]
lane_end_stop_prepare_distance_m: 45.0
lane_end_stop_prepare_time_sec: 4.0

# Enable exactly one nearby safety use: a vehicle whose bbox overlaps ego both
# longitudinally and laterally in the current/target lane Frenet corridor.
# Other nearby_front/rear candidates remain excluded from ACC and from SMPC
# behavior risk (risk_include_nearby_vehicles=false).
use_nearby_vehicles: true
use_nearby_overlap_as_acc_lead: true
nearby_acc_overlap_only: true
nearby_overlap_lateral_margin_m: 0.20
# This threshold applies only when nearby_acc_overlap_only is false.
nearby_acc_lead_max_abs_d_m: 1.35
nearby_merge_front_range_m: 120.0
nearby_merge_rear_range_m: 20.0
use_all_nearby_when_lane_end_pressure: false

# A target rear vehicle is not an ACC deceleration lead.  It remains in
# SMPC's merge-safety decision, while ACC lane-end waiting reacts only to a
# target-front blocker.
lane_end_wait_gap_front_only: true

# During lane-change waiting/active merge, avoid losing all momentum just to
# yield. Keep rolling unless there is a close front blocker or a critical
# collision condition. This makes it easier to enter the next usable gap.
# 차선 변경 도중 전방 차량과의 충돌 방지를 위해 강제 가속 플로어(merge_keep_rolling) 비활성화
merge_keep_rolling_enabled: false
merge_keep_rolling_min_speed_mps: 0.0
merge_keep_rolling_front_block_gap_m: 16.0
merge_keep_rolling_low_speed_lead_mps: 0.0
merge_keep_rolling_low_speed_lead_max_gap_m: 80.0
