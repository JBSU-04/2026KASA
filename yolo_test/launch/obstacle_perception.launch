<launch>
  <arg name="lidar_topic" default="/nonground"/>
  <arg name="ground_relative_field" default="ground_relative"/>

  <!-- ★ 인지 튜닝 값은 이 파일이 아니라 아래 한 곳에서 관리한다.
       total_bringup/config/tuning_perception.yaml
       (ground_z, min_obstacle_elevation, cluster_eps, roi_*, 형상필터 등)
       yaml 의 최상위 키가 노드 이름이라, 전역으로 올리면 각 노드가 자기
       private param 으로 읽는다. 노드 태그보다 먼저 와야 이긴다. -->
  <rosparam command="load"
            file="$(find total_bringup)/config/tuning_perception.yaml" />

  <node name="obstacle_perception_node" pkg="yolo_test" type="obstacle_perception_node.py" output="screen" respawn="true">

    <!-- 라이다 탐지 거리. 실제 velodyne 유효거리는 훨씬 김 -> 늘려서 더 먼
         거리의 점도 클러스터링 후보에 들어오게 함(더 빨리 확정될 여지) -->

    <!-- 클러스터 확정 기준: 저상 장애물(박스/라바콘) 보존을 위해 3점으로 완화 (SVD 형상 필터로 노이즈 방어) -->

    <!-- 자기 차량 자신을 클러스터링하지 않도록 제외하는 박스 (ego 기준, m).
         아이오닉 전장(~4.5m) 감안해서 보닛/범퍼까지 확실히 덮도록 넓힘. -->
    <!-- 라이다 프레임 기준 자차 footprint. 장착 x=1.1 기준으로 차체
         (후축 -0.790..3.845) 가 -1.89..2.745 이고 여유 0.2 를 더한 값.
         장착을 옮기면 반드시 같이 바꿔야 한다 - 이 값이 실제보다 크면
         센서 앞쪽 실제 장애물이 '자차'로 지워진다. -->

    <!-- 관심영역(ROI): 도로 주행차선 폭(~3.2m)을 고려하여 연석/인도 원거리 잡음 배제 (+-2.8m) -->

    <!-- GroundGrid 비지면 점군과 셀별 지면 상대높이 입력. -->
    <param name="lidar_topic" value="$(arg lidar_topic)" />
    <param name="ground_relative_field" value="$(arg ground_relative_field)" />
    <!-- 지면 대비 노면 바닥층 1차 차단. ground_z(-1.696) + 0.04 = -1.656.
         카고박스(35cm)/라바콘/저상 장애물(15~20cm)은 이 위로 살아남는다. -->
    <!-- 지면 위 최소 고도. 이 값 미만의 클러스터 최고점은 노면 잔차로 기각.
         실측 분포: 진짜 장애물 0.16~0.38m(박스), 노면 잔차 0.04~0.05m. -->
    <!-- ★ 센서 좌표계에서 지면이 갖는 z. 모든 고도 판정(top = z_max - ground_z)의
         기준선이라 이 값이 틀어지면 min_obstacle_elevation 이 통째로 밀린다.
         2026-09-11 /groundgrid/ground 40프레임 평면 피팅값이다
         (센서 원점 절편 중앙값 -1.7299m, p10~p90 -1.7311~-1.7205m). -->

    <!-- 클러스터 최대 점 개수: 가드레일/연석 등 거대 환경 클러스터 배제 (350) -->

    <!-- 신호등 지주 제외 데드존 - 비활성화(2026-09-03).
         M2에서 지주 오인식(0.86m 거리)을 막으려고 넣었는데, M3 동적 장애물이
         교차로 신호등 근처에 서있다가 출발하는 시나리오라 이 반경 안에 있는
         동안은 트랙 자체가 안 생겨서 실제 사람이 반경을 벗어나 이미 가까워진
         뒤에야 처음 잡혔다(실측: 최초 감지 4.93m, 그 직후 충돌). 반경 0 =
         필터 사실상 비활성 - json 은 남겨두되(나중에 다시 켤 수 있게) 반경만 끈다. -->
    <param name="traffic_light_json_path"
           value="$(find kcity_localizer)/data/traffic_light_set.json" />
    <param name="infra_exclusion_radius_m" value="0.0" />

    <!-- 클러스터 병합 거리: 0.5m로 설정하여 인접 드럼/박스를 단일 거대 장애물로 오병합 방지 -->

    <!-- 트래킹 -->
    <!-- 3.0m는 카메라-라이다 융합 시절 근접 시차 노이즈 때문에 넉넉하게 잡은
         값인데, 라이다 단독으로 바뀌면서 그 노이즈 원인 자체가 없어짐.
         오히려 넉넉한 값 때문에 주변 잡음 클러스터끼리 트랙이 잘못 옮겨붙는
         (ID가 엉뚱한 물체로 튀는) 문제가 생겨서 다시 타이트하게 줄임.
         -> 그런데 너무 타이트(1.0)하면 반대 문제: 사람(9km/h~2.5m/s)이 콜백 주기
         (~0.6~0.7s, 클러스터링 부하로 라이다 10Hz보다 느림)당 1.5~1.7m씩 움직여서
         매 프레임 매칭 실패 -> 트랙이 계속 끊기고 새 ID로 재생성 -> history가 매번
         리셋되어 dynamic_streak이 쌓일 기회가 없이 영원히 static/unknown으로만 찍힘.
         (obstacle_stop 로그에서 static -> unknown으로 되돌아가는 게 이 트랙 재생성의 증거) -->
    <param name="max_association_dist" value="2.2" />      <!-- 이전 프레임 트랙과 새 검출을 같은 물체로 볼 최대 거리(m) -->
    <!-- 클러스터링 반경: 0.55m로 드럼/라바콘 분리력 확보 및 연석 체이닝 방지 -->
    <param name="track_timeout" value="2.5" />             <!-- 이 시간(s) 이상 못 보면 트랙 삭제 (1.5 -> 2.5: 회피 중 음영 구역 보존) -->

    <!-- 정적/동적 판단 기준 (world 좌표 기준 속도, m/s) -->
    <param name="static_speed_threshold" value="1.7" />
    <!-- 트랙이 막 생성/재확정된 직후엔 이력 기간(baseline)이 너무 짧아서 표본 수
         조건(3개)만으론 위치노이즈가 속도로 증폭되는 걸 못 막음 -> 최소 경과시간
         요구, 그 전까진 안전하게 static 취급 -->
    <param name="min_motion_baseline_sec" value="0.15" />
    <!-- 노이즈로 threshold를 한 번 넘겼다고 바로 dynamic으로 뒤집지 않도록,
         연속으로 이 횟수만큼 계속 넘겨야만 dynamic으로 확정 (히스테리시스) -->
    <param name="dynamic_confirm_count" value="3" />
    <!-- 속도 추정 시 "가장 오래된 이력(history[0])"을 그대로 기준점(p0)으로 쓰면,
         정지해있던 물체가 막 움직이기 시작했을 때 그 오래된 정지 시절 위치가
         한동안(콜백 주기가 느릴수록 더 길게) 평균 속도를 계속 희석시켜서 실제로
         움직인 지 1초 넘게 지나야 threshold를 넘는 지연이 있었음. 이 시간(s)
         이내의 가장 오래된 샘플만 p0로 써서 그 지연을 줄인다.
         min_motion_baseline_sec보다는 커야 함(그보다 작으면 baseline 자체가 안 채워짐). -->
    <!-- ★ 0.6 -> 1.0. z-score 판정의 표본 간 시간차가 이 값의 절반이라,
         짧으면 진짜 보행자도 변위가 작아 z 가 안 오른다.
           보행자 1.4m/s 의 예상 z: 0.6s 윈도우 -> 1.7 / 1.0s 윈도우 -> 2.8
         반응 지연이 그만큼 늘지만, 오판으로 인한 오정지가 더 위험하다. -->
    <param name="motion_speed_window_sec" value="1.0" />
    <!-- ★ 분산 정규화 판정(z-score). 0 이면 끈다.
         속도를 절대 문턱과만 비교하면 정적 물체의 관측 흔들림이 그 문턱을
         넘나드는 구간(jitter band)에서 반드시 오판이 난다.
           실측 2026-09-09: 정적 물체의 프레임간 속도가 90% 분위에서 이미
           2.09 m/s 로 보행자 속도대와 겹쳤다. 절대 문턱만으로는 오판이
           53% 아래로 안 줄었다.
         '얼마나 움직였나'를 '얼마나 흔들리나'로 나눠서 판정한다.
           실측 문턱별(윈도우 1.0s): z>=1.5 -> 45% 제거, 2.0 -> 51%,
           3.0 -> 68%. 다만 3.0 은 보행자 1.4m/s(z≈2.8)를 차단한다.
           2.0 이 오판 제거와 보행자 통과의 균형점이다.
         참고: arxiv 2606.09350 (Uncertainty-Aware LiDAR Motion Classification) -->
    <param name="motion_z_threshold" value="2.0" />
    <!-- 위치 산포 바닥값(m). 산포가 0 이면 z 가 무한대가 된다. -->
    <param name="motion_z_var_floor" value="0.15" />
    <!-- ★ 2026-09-10 의미 변경. 예전엔 '이 속도를 넘으면 버퍼를 통째로
         버리고 static 고정'이었다(점프거부). 지금은 칼만 필터 출력의
         클램프 상한일 뿐이다 - 버리지 않는다.

         폐기 이유(실측 2026-09-10, 12:43:42 백):
           점프거부가 횡단체의 속도를 전부 죽였다. 대향차로 사람(id16,
           26프레임)과 인도쪽 강아지(id24, 64프레임) 둘 다 speed 가
           전 프레임 정확히 0.00, motion_state 전부 static 이었다.
           velocity=[0,0] 이면 정지 노드의 TTC 가 아예 성립하지 않는다.
           동적 구간 정지/가속 반복의 직접 원인이 이것이었다.

         3.0 -> 6.0 근거: 강아지의 칼만 추정 횡속도가 6.63 m/s 까지
         나왔다(실측). 3.0 클램프는 이걸 절반으로 깎아 TTC 예측을
         틀리게 만든다. 보행자 상한이 아니라 '횡단하는 작은 동물'
         상한으로 잡아야 한다.

         ※ 문턱을 올려도 고정물 오판이 늘지 않는 이유: 연석 중심
           미끄러짐은 경로 방향(v_lon)으로 일어나고 횡방향(v_lat)으로는
           거의 없다(실측 id19: v_lon_p90 3.15 / v_lat_p90 0.75).
           정지 판정은 v_lat 으로 y_at 을 계산하므로 미끄러짐이 자동으로
           걸러진다. 실측 고정물 23/25 가 TTC conflict 0 프레임이었다. -->
    <param name="max_plausible_speed" value="6.0" />

  </node>

</launch>
