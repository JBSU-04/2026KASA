# world <-> ego(base_link) 좌표 변환 헬퍼
# ============================================================
def ego_to_world(ego_xy, ego_pose):
    """ego_xy: [x, y] (전방=x, 좌측=y). ego_pose: (world_x, world_y, yaw)."""
    wx, wy, yaw = ego_pose
    c, s = math.cos(yaw), math.sin(yaw)
    x = wx + c * ego_xy[0] - s * ego_xy[1]
    y = wy + s * ego_xy[0] + c * ego_xy[1]
    return np.array([x, y], dtype=np.float64)


def world_to_ego(world_xy, ego_pose):
    wx, wy, yaw = ego_pose
    dx = world_xy[0] - wx
    dy = world_xy[1] - wy
    c, s = math.cos(yaw), math.sin(yaw)
    x = c * dx + s * dy
    y = -s * dx + c * dy
    return np.array([x, y], dtype=np.float64)


def pointcloud2_to_xyz_array_fast(msg, relative_field=''):
    """pc2.read_points()로 점 하나씩 파이썬 for문 돌리면 벨로다인 프레임당 수만
    점을 언패킹하느라 프레임당 수백ms가 걸려서, /obstacle_info 실제 발행 주기가
    라이다 10Hz가 아니라 ~1.5Hz(0.6~0.7초)까지 떨어지는 원인이었음(동적 장애물
    확정에 필요한 dynamic_confirm_count 프레임 수를 채우는 데 그만큼 시간이 더
    걸려서 정지가 늦어짐). np.frombuffer로 numpy 레벨에서 한 번에 변환한다."""
    field_offset = {f.name: f.offset for f in msg.fields}
    if not all(k in field_offset for k in ('x', 'y', 'z')):
        return np.empty((0, 3), dtype=np.float32)

    names = ['x', 'y', 'z']
    if relative_field and relative_field in field_offset:
        names.append(relative_field)
    dtype = np.dtype({
        'names': names,
        'formats': [np.float32] * len(names),
        'offsets': [field_offset[name] for name in names],
        'itemsize': msg.point_step,
    })
    n = len(msg.data) // msg.point_step
    arr = np.frombuffer(msg.data, dtype=dtype, count=n)
    pts = np.stack([arr[name] for name in names], axis=-1).astype(np.float32)
    pts = pts[~np.isnan(pts).any(axis=1)]
    return pts


def estimate_extent(points_xy):
    """점군(N,2)의 ego 기준 bounding extent -> (length, width, radius).
    외곽 잡음 점(outlier)에 의한 크기 폭발을 막기 위해 분위수를 사용하고,
    도로 주행 장애물 물리적 상한을 적용한다."""
    if len(points_xy) >= 6:
        p_min = np.percentile(points_xy, 5, axis=0)
        p_max = np.percentile(points_xy, 95, axis=0)
        length = float(p_max[0] - p_min[0])
        width = float(p_max[1] - p_min[1])
    else:
        length = float(points_xy[:, 0].max() - points_xy[:, 0].min())
        width = float(points_xy[:, 1].max() - points_xy[:, 1].min())

    # 상한은 '오인식 방어'용이지 실물 축소용이 아니다.
    #   실측 2026-09-09 (15:11 주행, competition_heavy bag):
    #   카고박스 실제 폭 1.75m / 높이 1.06m 인데 상한 1.5 에 걸려 1.50 으로
    #   깎였다. 회피 노드는 그 값으로 장애물 사각형을 만들어 계획했고,
    #   실제보다 0.25m 좁게 본 만큼 경로가 물체를 관통해 차가 박았다
    #   (통과 시 장애물 ego_y=+0.48m < 차체 반폭 0.95m).
    #   물체가 클수록 더 많이 깎이므로, 큰 장애물일 때 가장 위험해진다.
    # 상한을 차선 폭 수준으로 올려 실물을 그대로 전달하고, 비정상 거대
    # 클러스터(연석/벽 병합)는 _reject_ground_residue 의 SVD 형상 필터가
    # 따로 거른다 - 그게 원래 그 필터의 역할이다.
    length = max(0.35, min(length, 3.0))
    width = max(0.35, min(width, 2.6))
    radius = 0.5 * math.hypot(length, width)
    radius = max(0.25, min(radius, 2.0))
    return length, width, radius


def _cluster_gap(pts_a, pts_b):
    """두 클러스터의 '표면 간 최단거리'(gap). 중심거리와 달리 물체 크기에
    영향받지 않아서, 큰 물체가 쪼개진 경우도 작은 물체와 같은 기준으로
    병합할 수 있다. 점 수가 많으면 O(NM) 이 부담이라 바운딩박스 간 거리로
    먼저 걸러낸다(박스가 겹치면 gap=0)."""
    a, b = pts_a[:, :2], pts_b[:, :2]
    amin, amax = a.min(axis=0), a.max(axis=0)
    bmin, bmax = b.min(axis=0), b.max(axis=0)
    # 축별 바운딩박스 간격 - 겹치면 0
    dx = max(0.0, max(amin[0] - bmax[0], bmin[0] - amax[0]))
    dy = max(0.0, max(amin[1] - bmax[1], bmin[1] - amax[1]))
    box_gap = math.hypot(dx, dy)
    # 박스 기준으로도 이미 먼 쌍은 정확한 계산이 필요 없다(호출부 문턱보다
    # 크면 어차피 병합 안 된다). 박스 간격은 실제 gap 의 하한이다.
    if box_gap > 1.0:
        return box_gap
    # 가까운 쌍만 정확히. 점이 많으면 솎아서 비용을 제한한다.
    sa = a[::max(1, len(a) // 60)]
    sb = b[::max(1, len(b) // 60)]
    d2 = ((sa[:, None, :] - sb[None, :, :]) ** 2).sum(axis=2)
    return float(np.sqrt(d2.min()))


def merge_close_clusters(clusters, merge_dist, near_range=0.0, near_dist=0.0):
    """가까이서 볼수록 라이다가 차체 표면 디테일(범퍼/휠/거울 등)을 더 세밀하게
    찍어서, eps를 아무리 조절해도 물체 하나가 여러 클러스터로 쪼개지는 걸 못
    막는다. 클러스터링 다음 단계에서, 중심점끼리 merge_dist보다 가까운
    클러스터들은 같은 물체의 파편으로 보고 하나로 합친다."""
    n = len(clusters)
    if n < 2:
        return clusters

    centers = np.array([c[0][:2] for c in clusters])
    parent = list(range(n))

    def find(x):
        while parent[x] != x:
            parent[x] = parent[parent[x]]
            x = parent[x]
        return x

    def union(a, b):
        ra, rb = find(a), find(b)
        if ra != rb:
            parent[ra] = rb

    for i in range(n):
        for j in range(i + 1, n):
            # 중심간 거리로만 재면 큰 물체가 쪼개진다 - 폭 1.75m 카고박스가
            # 두 클러스터로 갈라지면 중심거리가 0.45m 로 merge_dist(0.35)를
            # 넘어 병합이 거부됐다(실측 2026-09-09). 중심거리는 물체 크기에
            # 비례해 커지므로, 물체의 '표면 간 거리(gap)'로 재야 크기와
            # 무관하게 일관된다.
            gap = _cluster_gap(clusters[i][1], clusters[j][1])
            # 근거리(자차 기준)에서는 문턱을 키운다 - 같은 물체가 링마다
            # 갈라져 조각 간 거리가 커 보이는 구간이다.
            thr = merge_dist
            if near_range > 0.0:
                ri = float(np.linalg.norm(centers[i][:2]))
                rj = float(np.linalg.norm(centers[j][:2]))
                if min(ri, rj) <= near_range:
                    thr = max(thr, near_dist)
            if gap < thr:
                # 합쳤을 때 횡방향(좌우 y) 폭이 상한을 넘으면 연석-장애물
                # 병합이나 지그재그 배치된 두 드럼이 하나로 뭉개지는 것이므로
                # 병합하지 않는다. 다만 1.8 은 실측 카고박스(1.75) 를 간신히
                # 넘는 값이라 위험했다 - 차선 폭까지 올린다.
                combined_y_span = max(clusters[i][1][:, 1].max(), clusters[j][1][:, 1].max()) - \
                                  min(clusters[i][1][:, 1].min(), clusters[j][1][:, 1].min())
                if combined_y_span <= 2.6:
                    union(i, j)

    groups = {}
    for i in range(n):
        groups.setdefault(find(i), []).append(i)

    merged = []
    for idx_list in groups.values():
        pts = np.concatenate([clusters[i][1] for i in idx_list], axis=0)
        center = pts.mean(axis=0)
        merged.append((center, pts))
    return merged


def cluster_lidar_points(points, eps, min_cluster_points, max_cluster_points,
                         far_range=0.0, far_min_points=0, preserve_large=False,
                         max_span_y=2.2, max_span_x=4.5):
    """points: (N,3) ego 기준 필터링된 라이다 점. eps 이내로 연결된 점들을 하나의
    클러스터로 묶는다(Union-Find). min_cluster_points 미만인 클러스터는 버린다.
    max_cluster_points를 넘는 클러스터도 버린다 - 가드레일/연석처럼 길게 이어진
    라인이 통째로 하나의 거대 클러스터로 뭉쳐서 엉뚱한 위치에 중심점이 찍히는
    것을 막기 위함.
    반환: [(center_xyz, cluster_pts), ...]"""
    n = len(points)
    if n < min_cluster_points:
        return []

    tree = cKDTree(points[:, :2])
    pairs = tree.query_pairs(r=eps, output_type='ndarray')

    # 파이썬 for문 기반 union-find는 밀집한 프레임(pairs 수만 개)에서 여전히
    # 병목이 됨. scipy의 C 구현 connected_components로 대체 (결과는 동일).
    if len(pairs) > 0:
        row, col = pairs[:, 0], pairs[:, 1]
        adj = coo_matrix((np.ones(len(row), dtype=bool), (row, col)), shape=(n, n))
        _, labels = connected_components(adj, directed=False)
    else:
        labels = np.arange(n)

    results = []
    for root in np.unique(labels):
        idx = np.nonzero(labels == root)[0]
        cluster_pts = points[idx]
        # ★ 원거리에서는 최소 점 수를 낮춘다.
        #   VLP-16 은 링 간 수직각이 2deg 라, 높이 h 물체에 두 링이 동시에
        #   닿는 거리는 h/tan(2deg) ~ 28*h 이내뿐이다. 그보다 멀면 링이 하나만
        #   닿고, 그 하나가 물체 상단 모서리를 스치면 점이 2개 이하로 떨어져
        #   min_cluster_points(3)를 못 채운다.
        #     실측 2026-09-09(17:08): 고도 0.79m 물체(id10)가 9.3m 에서야
        #     처음 잡혔다. 같은 자리 다른 물체(id11/12)는 24m 에 잡혔다 -
        #     링이 물체 중앙을 지난 운 좋은 경우였다. 즉 경계선에서 검출이
        #     들쭉날쭉했고, 그래서 두번째 장애물 인지가 늦었다.
        #   원거리 노면 잔차 방어는 고도 문턱/형상 필터가 따로 맡는다.
        n_pts = len(idx)
        min_req = min_cluster_points
        if far_range > 0.0 and far_min_points > 0:
            r = float(np.linalg.norm(cluster_pts[:, :2].mean(axis=0)))
            if r >= far_range:
                min_req = min(min_req, far_min_points)
        if n_pts < min_req or n_pts > max_cluster_points:
            continue
        # 도로 연석이나 긴 가드레일/벽면처럼 비정상적으로 길게 늘어진 클러스터 제외.
        # ★ span_y 상한은 '차로를 가로지르는 병합'만 막아야 한다. 실물 상한이
        #   아니다 - 버스/트럭은 정면에서 보면 횡폭이 2.5~2.9m 다.
        #     실측 2026-09-21(18:36 백): 버스 span_y 가 2.68~2.87m 로 매
        #     프레임 2.2 를 넘겨, 17m 에서 81점 폭 2.4m 단일 클러스터로
        #     깔끔히 잡혔는데도 거리와 무관하게 전량 기각됐다. 그 결과
        #     가까워져 클러스터가 조각난 뒤에야(9.5m) 폭 0.35 짜리 파편
        #     하나가 통과했고, 플래너는 버스를 '작은 기둥'으로 보고 그대로
        #     들이받았다(3주행 연속, -277~-332 m/s^2).
        #   종방향 가드레일 방어는 span_x(4.5)와 SVD 선형 필터가 맡는다 -
        #   가드레일은 진행방향으로 길지 횡으로 2~3m 를 채우지 않는다.
        span_x = float(cluster_pts[:, 0].max() - cluster_pts[:, 0].min())
        span_y = float(cluster_pts[:, 1].max() - cluster_pts[:, 1].min())
        if not preserve_large and (span_y > max_span_y or span_x > max_span_x):
            continue
        center = cluster_pts.mean(axis=0)
        results.append((center, cluster_pts))
    return results


