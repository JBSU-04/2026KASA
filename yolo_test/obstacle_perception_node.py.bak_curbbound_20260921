        self.curb_max_aspect = rospy.get_param('~curb_max_aspect', 8.0)
        self.curb_linear_min_length = rospy.get_param('~curb_linear_min_length', 2.5)
        self.curb_linear_max_width = rospy.get_param('~curb_linear_max_width', 0.35)
        self.low_obstacle_top_m = rospy.get_param('~low_obstacle_top_m', 0.35)
        self.low_obstacle_min_thickness = rospy.get_param('~low_obstacle_min_thickness', 0.06)
        self.low_obstacle_min_points = rospy.get_param('~low_obstacle_min_points', 3)
        # 평면(두께 없음) 검사를 적용할 최대 거리.
        # 8.0 이었을 때 11~16m 노면 표식(정지선/화살표)이 검사를 건너뛰고
        # 장애물로 올라왔다(실측 2026-09-08: 고도 0.15~0.18m, 두께 0.01m).
        # 원거리에서 두께가 0 이 되는 건 링이 한 줄만 닿을 때인데, 실측상
        # 24m 카고박스(높이 0.83m)는 -3deg(지면교차 30.5m)와 -1deg 두 링에
        # 맞아 두께 0.83m 가 관측된다. 30m 까지는 두께로 갈라도 안전하다.
        self.flat_check_max_range = rospy.get_param('~flat_check_max_range', 30.0)
        # 두께 검사를 적용할 고도 상한. 이보다 높은 물체는 두께를 안 본다.
        self.low_obstacle_flat_top_m = rospy.get_param('~low_obstacle_flat_top_m', 0.20)
        # VLP-16 링 간 수직각(2deg)의 tan. 거리 r 에서 두 링의 높이차 추정에
        # 쓴다 - 물체 높이가 그보다 작으면 링이 하나만 닿아 두께가 0 이 되므로
        # 두께 검사를 건너뛴다(구조적으로 못 만족하는 조건을 요구하지 않는다).
        self.ring_vert_sep_tan = rospy.get_param('~ring_vert_sep_tan', 0.035)
        # 첫 프레임에 바로 confirmed 로 볼 최소 고도(m). 이보다 낮은 물체는
        # 2프레임 연속 같은 자리에서 보여야 확정된다. 노면 표식(고도 0.14~0.18m)
        # 을 걸러내는 주 방어선이라, 카고박스(0.83m)·라바콘보다는 낮게 둔다.
        self.init_confirm_elevation = rospy.get_param('~init_confirm_elevation', 0.30)
        # 저상 물체(top < low_obstacle_top_m)의 길이 상한(m).
        # 라바콘/카고박스는 1m 안팎, 노면 표식·연석은 그보다 길게 이어진다.
        self.low_obstacle_max_length = rospy.get_param('~low_obstacle_max_length', 1.8)
        # 정적 장애물 구간 밖에서 쓸 고도 문턱(m).
        # src_최적(kcity2026_stack)이 같은 구조를 쓴다 - 저상 박스를 살려야 하는
        # 정적 구간에서만 문턱을 낮추고(h_min=0.10), 그 밖에서는 0.30 으로 올려
        # 노면 누출을 막는다. 우리는 전 구간에 0.12 를 써서 정적 구간 밖에서도
        # 노면 표식(실측 고도 0.14~0.18m)이 장애물로 올라왔다.
        self.min_obstacle_elevation_outside = rospy.get_param(
            '~min_obstacle_elevation_outside', 0.20)
        # 정동적 미션 구간(정적 회피 + 동적 정지). 이 안에서만 낮은 문턱을 쓴다.
        self.static_zone_min_idx = rospy.get_param('~static_zone_min_idx', 2400)
        self.static_zone_max_idx = rospy.get_param('~static_zone_max_idx', 4900)

        # 공통 GroundGrid의 비지면 점군과 셀별 지면 상대높이를 받는다.
        # 앞단 IMU 보정이 급가감속 피치를 제거하고, 이 노드는 미션별 ROI와
        # 클러스터 형상 판정만 담당한다.
        self.lidar_topic = rospy.get_param('~lidar_topic', '/nonground')
        self.ground_relative_field = rospy.get_param(
            '~ground_relative_field', 'ground_relative')
        self.use_ground_relative = bool(self.ground_relative_field)

        # 신호등 지주(pole) 제외. K-City 실주행 로그(2026-09-03)에서 확인됨:
        # M2 정적 회피 구간에서 정지 판정된 static 클러스터 하나가 mgeo
        # 신호등 노드(C1256W000070)에서 0.86m 거리 - 라이다가 지주 하단을
        # 그대로 장애물로 잡은 것. 지주는 노선 설계상 경로 corridor 안에
        # 있을 수 있는데(교차로 모서리), 미션이 요구하는 회피 대상(드럼 등)이
        # 아니므로 알려진 위치는 트랙 생성 자체에서 제외한다.
        # mgeo 좌표는 로컬 프레임이라 프로젝트 공통 원점(302595.0, 4124145.0)을
        # 더해 UTM 절대좌표로 변환한다(kcity_roundabout_utm.yaml과 동일 변환).
        self.infra_exclusion_radius_m = rospy.get_param('~infra_exclusion_radius_m', 2.0)

        # --- 미션 구간별 마커 필터 (RViz 시각화 전용) ---
        # 다른 미션 파이프라인이 잡은 것까지 한 화면에 뜨면 튜닝 때 뭘 보는지
        # 알 수 없다. 현재 waypoint idx 가 정동적 구간 안일 때만 마커를 낸다.
        self.marker_filter_by_section = rospy.get_param(
            '~marker_filter_by_section', True)
        self.section_gating_enabled = rospy.get_param(
            '~section_gating_enabled', True)
        self.section_start_idx = rospy.get_param('~section_start_idx', 2400)
        self.section_end_idx = rospy.get_param('~section_end_idx', 4900)
        # 이 idx 를 경계로 앞은 정적 회피, 뒤는 동적 정지 구간이다.
        self.static_dynamic_split_idx = rospy.get_param(
            '~static_dynamic_split_idx', 3700)
        self.current_wp_idx = -1
        self.current_lane = -1
        self.active_section_msg = None
        self.active_section_t = 0.0
        try:
            from mission_supervisor.msg import SectionState as _SecState
            rospy.Subscriber('/mission/active_section', _SecState,
                             self.active_section_callback, queue_size=1)
        except Exception:
            rospy.logwarn('[obstacle_perception] /mission/active_section 구독 생략')

        # --- 1차 선별: 기준경로 코리도 ---
        # 자차 기준 직사각형(roi_*)만으로는 곡선에서 경로가 박스를 벗어난다.
        # 실제로 봐야 하는 건 '내가 갈 경로' 좌우이므로, /local_path 로부터의
        # 횡거리로 먼저 거르고 그 다음에 직사각형 ROI 를 적용한다.
        # (new_lane/obstacle_avoidance_node 의 path_corridor_radius 와 같은 개념)
        self.use_path_corridor = rospy.get_param('~use_path_corridor', True)
        # 1차(점 수집) 폭: 넓게 잡는다. 여기서 버린 점은 다시 못 보므로,
        # 경로가 휘거나 측위가 흔들려도 진짜 장애물이 안 잘리게 여유를 준다.
        # 클러스터를 온전한 모양으로 만들려면 물체 전체가 들어와야 한다.
        self.path_corridor_gather_half_width = rospy.get_param(
            '~path_corridor_gather_half_width', 4.0)
        # 2차(판정) 폭: 클러스터 중심이 경로에서 이 안이어야 '내 경로 위
        # 장애물'로 인정한다. 실제로 반응할 대상을 여기서 고른다.
        self.path_corridor_half_width = rospy.get_param(
            '~path_corridor_half_width', 1.7)
        # 3차(충돌): 회피 후보 경로가 지나갈 수 있는 폭까지 장애물을 남긴다.
        #   트리거 코리도(1.4m)로 걸러버리면, 회피를 시작한 뒤 회피 경로가
        #   지나가는 자리에 있는 장애물이 목록에 없어서 프레넷이 그걸 '없는 것'
        #   으로 보고 그 위로 경로를 그린다(실제로 박았다).
        #   new_lane 의 max_road_width_left(4.5) + robot_radius 여유만큼 잡는다.
        self.collision_corridor_half_width = rospy.get_param(
            '~collision_corridor_half_width', 6.0)
        # 경로를 못 받았을 때 코리도 필터를 건너뛸지(True) 막을지(False).
        # True 가 안전한 기본값 - 경로가 없다고 장애물을 통째로 무시하면 위험하다.
        self.path_corridor_skip_if_no_path = rospy.get_param(
            '~path_corridor_skip_if_no_path', True)
        # 경로점 솎기 간격(원본 0.1m 간격 기준). 크면 빠르지만 곡선에서
        # 코리도가 각져서 바깥쪽을 조금 놓친다. 5 = 0.5m 간격.
        # 경로를 솎을 때 유지할 점 간격(m). 인덱스가 아니라 실제 거리 기준이라
        # CSV 경로(0.1m 간격)든 프레넷 경로(0.35m 간격)든 같은 해상도가 된다.
        self.path_corridor_decimate_m = float(rospy.get_param(
            '~path_corridor_decimate_m', 0.5))
        self.path_xy = None          # ego 프레임 경로점 (N,2)
        self.path_stamp = 0.0
        self.infra_points = self._load_infra_points(
            rospy.get_param('~traffic_light_json_path', ''),
            rospy.get_param('~infra_map_origin_x', 302595.0),
            rospy.get_param('~infra_map_origin_y', 4124145.0))

        self.pose_history = deque(maxlen=300)
        self.scan_pose = None
        self.path_world = None
        self.pose_max_age = float(rospy.get_param('~pose_max_age', 0.15))
        self.motion_backend = rospy.get_param('/motion_tracking/backend', 'legacy')
        self.motion_config = rospy.get_param('/motion_tracking/dynamic', {})
        self.cluster_voxel_m = float(rospy.get_param('~cluster_voxel_m', 0.0))
        self.mission_filter_profiles = validate_profiles(rospy.get_param(
            '~mission_filter_profiles', {}))
        self.filter_defaults = {key: getattr(self, key) for key in FILTER_KEYS}
        self.filter_profile = None
        self.mission_zone = 'out_of_section'
        self.boundary_objects = []
        if self.motion_backend == 'apollo_measurement':
            load_library()
        self.latest_ego_pose = None  # (world_x, world_y, yaw), /odom 에서 갱신
        self.tracks = []

        self.info_pub = rospy.Publisher('/obstacle_info', String, queue_size=10)
        self.marker_pub = rospy.Publisher('/obstacle_markers', MarkerArray, queue_size=10)

        rospy.Subscriber('/odom', Odometry, self.odom_callback, queue_size=1)
        # 현재 waypoint idx. 미션 구간별 마커 필터에 쓴다(시각화 전용이라
        # 검출/추적 로직에는 영향이 없다).
        from waypoint_maker.msg import Lane as _WpLane2
        try:
            from waypoint_maker.msg import State as _WpState
            rospy.Subscriber('/gps_state', _WpState,
                             self.gps_state_callback, queue_size=1)
        except Exception:
            rospy.logwarn('[obstacle_perception] /gps_state 구독 실패 - '
                          '미션 구간 마커 필터가 꺼진다')
        # GroundGrid 결과를 구독하고 roi_z_min/max는 남은 잡음을 거르는
        # 느슨한 안전망으로만 쓴다.
        # 기준경로. 장애물 1차 선별(경로 코리도)에 쓴다.
        # ★ 인지는 계획의 결과(/local_path = 회피 경로)를 읽지 않는다.
        #   회피가 켜지면 /local_path 가 회피 경로로 바뀌는데, 그걸 코리도
        #   기준으로 쓰면 '피할수록 그 장애물이 코리도 밖으로 밀려나 사라지는'
        #   폐루프가 생긴다(회피 -> 미검출 -> 해제 -> 재검출 반복).
        #   기준은 회피와 무관한 원본 경로여야 한다. /final_waypoint 는
        #   local_path_publisher 가 CSV + 차선변경 블렌딩만 반영해 내는
        #   경로라 회피 영향을 받지 않는다(그 노드 주석에도 명시돼 있다).
        #   같은 토픽에서 현재 waypoint idx/lane 도 같이 꺼낸다(구간별 고도
        #   문턱, 마커 필터용). /gps_state 에는 waypoint_index 가 없다
        #   (current_state, lane_number, dist, parking_dist 뿐).
        try:
            rospy.Subscriber('/final_waypoint', _WpLane2,
                             self.final_waypoint_callback, queue_size=1)
        except Exception:
            rospy.logwarn('[obstacle_perception] /final_waypoint 구독 실패 - '
                          '경로 코리도와 구간별 고도 문턱이 모두 꺼진다')
        rospy.Subscriber(self.lidar_topic, PointCloud2, self.lidar_callback, queue_size=1)

        rospy.loginfo("Obstacle Perception node started (lidar-only). infra_points=%d",
                      len(self.infra_points))
        rospy.spin()

    @staticmethod
    def _load_infra_points(json_path, origin_x, origin_y):
        """mgeo 신호등 노드 좌표를 UTM 절대좌표 Nx2 배열로 로드한다.
        경로가 비었거나 못 읽으면 빈 배열(필터 사실상 비활성)을 반환한다."""
        if not json_path:
            return np.empty((0, 2), dtype=np.float64)
        try:
            with open(json_path, 'r') as f:
                data = json.load(f)
            pts = [(item['point'][0] + origin_x, item['point'][1] + origin_y)
                   for item in data if item.get('point')]
            return np.array(pts, dtype=np.float64) if pts else np.empty((0, 2))
        except Exception as e:
            rospy.logwarn("[obstacle_perception] infra json load failed (%s): %s",
                          json_path, e)
            return np.empty((0, 2), dtype=np.float64)

    def _near_known_infra(self, pos_world):
        if self.infra_points.shape[0] == 0:
            return False
        d = np.linalg.norm(self.infra_points - pos_world[:2], axis=1)
        return bool(np.min(d) <= self.infra_exclusion_radius_m)

    def odom_callback(self, msg):
        q = msg.pose.pose.orientation
        _, _, yaw = tft.euler_from_quaternion([q.x, q.y, q.z, q.w])
        self.latest_ego_pose = (
            msg.pose.pose.position.x,
            msg.pose.pose.position.y,
            yaw,
        )
        stamp = msg.header.stamp.to_sec() or rospy.Time.now().to_sec()
        if self.pose_history and stamp <= self.pose_history[-1][0]:
            if stamp < self.pose_history[-1][0]:
                self.pose_history.clear()
                self.tracks.clear()
            else:
                return
        self.pose_history.append((stamp, self.latest_ego_pose))

    def _pose_at(self, stamp):
        samples = list(self.pose_history)
        if not samples:
            return None
        if stamp <= samples[0][0]:
            return samples[0][1] if samples[0][0] - stamp <= self.pose_max_age else None
        for (ta, a), (tb, b) in zip(samples, samples[1:]):
            if ta <= stamp <= tb:
                f = (stamp - ta) / max(tb - ta, 1e-9)
                dyaw = math.atan2(math.sin(b[2]-a[2]), math.cos(b[2]-a[2]))
                return (a[0]+f*(b[0]-a[0]), a[1]+f*(b[1]-a[1]), a[2]+f*dyaw)
        return samples[-1][1] if stamp - samples[-1][0] <= self.pose_max_age else None

