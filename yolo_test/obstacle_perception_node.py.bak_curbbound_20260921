        #   실측(12:43:42 백) 횡단체 4.77~6.26 / 고정물 최대 1.26 → 문턱 2.0
        self.ego_rate_window_sec = rospy.get_param('~ego_rate_window_sec', 0.6)
        # 분산 정규화 판정(z-test). 0 이면 끈다(절대 속도 문턱만 사용).
