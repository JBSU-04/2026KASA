            self.far_low_point_elevation = float(rospy.get_param(
                '~far_low_point_elevation', self.far_low_point_elevation))
            self.far_elev_relax_start_m = float(rospy.get_param(
                '~far_elev_relax_start_m', self.far_elev_relax_start_m))
            self.far_elev_relax_end_m = float(rospy.get_param(
                '~far_elev_relax_end_m', self.far_elev_relax_end_m))
            self.far_elev_relax_min = float(rospy.get_param(
                '~far_elev_relax_min', self.far_elev_relax_min))
            self.far_elev_relax_max_lateral_m = float(rospy.get_param(
                '~far_elev_relax_max_lateral_m',
                self.far_elev_relax_max_lateral_m))
            self.collision_corridor_half_width = float(rospy.get_param(
                '~collision_corridor_half_width', self.collision_corridor_half_width))
            self.ego_corridor_range = float(rospy.get_param(
                '~ego_corridor_range', self.ego_corridor_range))
            self.near_merge_range = float(rospy.get_param(
                '~near_merge_range', self.near_merge_range))
            self.near_merge_dist = float(rospy.get_param(
                '~near_merge_dist', self.near_merge_dist))
            self.align_reject_enabled = bool(rospy.get_param(
                '~align_reject_enabled', self.align_reject_enabled))
            self.align_min_count = int(rospy.get_param(
                '~align_min_count', self.align_min_count))
            self.align_min_length = float(rospy.get_param(
                '~align_min_length', self.align_min_length))
            self.align_max_width = float(rospy.get_param(
                '~align_max_width', self.align_max_width))
            self.align_min_offset = float(rospy.get_param(
                '~align_min_offset', self.align_min_offset))
            self.align_protect_lateral = float(rospy.get_param(
                '~align_protect_lateral', self.align_protect_lateral))
            self.align_min_height_slope = float(rospy.get_param(
                '~align_min_height_slope', self.align_min_height_slope))
        except Exception:
            pass

    def active_section_callback(self, msg):
        self.active_section_msg = msg
        self.active_section_t = rospy.Time.now().to_sec()

    def lidar_callback(self, msg):
        for key, value in self.filter_defaults.items():
            setattr(self, key, value)
        self._sync_params()
        self.filter_defaults = {key: getattr(self, key) for key in FILTER_KEYS}
        if self.latest_ego_pose is None:
            return  # world 좌표 변환 불가 -> odom 아직 없으면 보류

        in_section, zone = self._in_mission_section()
        self.mission_zone = zone
        self.boundary_objects = []
        # Restore defaults before applying each profile, so tunnel tuning never
        # leaks back into M2/M3. GroundGrid and its input remain shared.
        profile = self.mission_filter_profiles.get(zone, {})
        for key, value in self.filter_defaults.items():
            setattr(self, key, profile.get(key, value))
        if self.filter_profile != zone:
            self.tracks.clear()
            self.filter_profile = zone
            rospy.loginfo('[obstacle_perception] filter profile=%s', zone)
        if self.section_gating_enabled and not in_section:
            # 정동적 구간 외: 점군 클러스터링 연산 스킵 및 마커/트랙 완전 소거
            # 단, downstream 노드(obstacle_stop_node)의 stale timeout(급제동) 방지를 위해
            # 빈 obstacles 정보를 담은 /obstacle_info는 정상 발행한다.
            if len(self.tracks) > 0:
                self.tracks = []
            self.publish_tracks()
            self.publish_empty_markers()
            return

        now = msg.header.stamp.to_sec() or rospy.Time.now().to_sec()
        self.scan_pose = self._pose_at(now)
        if self.scan_pose is None:
            rospy.logwarn_throttle(1.0, '[obstacle_perception] no synchronized odom for scan')
            self._age_out_tracks(rospy.Time.now().to_sec())
            self.publish_tracks()
            return
        if self.path_world is not None:
            self.path_xy = np.array([world_to_ego(p, self.scan_pose) for p in self.path_world])
        arr = pointcloud2_to_xyz_array_fast(msg, self.ground_relative_field)
        if len(arr) == 0:
            self._age_out_tracks(rospy.Time.now().to_sec())
            self.publish_tracks()
            self.publish_markers()
            return
        dist = np.linalg.norm(arr[:, :2], axis=1)
        self_filter = (
            (arr[:, 0] >= self.self_x_min) & (arr[:, 0] <= self.self_x_max) &
            (arr[:, 1] >= self.self_y_min) & (arr[:, 1] <= self.self_y_max)
        )
        roi_filter = (
            (arr[:, 0] >= self.roi_x_min) & (arr[:, 0] <= self.roi_x_max) &
            (arr[:, 1] >= self.roi_y_min) & (arr[:, 1] <= self.roi_y_max) &
            (arr[:, 2] >= self.roi_z_min) & (arr[:, 2] <= self.roi_z_max)
        )
        # 1차(수집): 기준경로 좌우를 '넓게' 잡아 후보 점을 모은다. 여기서
        #   버린 점은 다시 못 보므로 좁히지 않는다. 클러스터가 온전한 모양을
        #   갖추려면 물체 전체가 들어와야 하고, 경로가 휘거나 측위가 흔들려도
        #   진짜 장애물이 잘리면 안 된다.
        #   좁히는 판정은 클러스터가 만들어진 뒤 _filter_ground_residue 에서
        #   중심 기준으로 한다(2차).
        corridor = self._path_corridor_mask(
            arr, self.path_corridor_gather_half_width)
        mask = ((dist > self.min_range) & (dist < self.max_range) &
                (~self_filter) & roi_filter & corridor)
        filtered = arr[mask]
        if self.cluster_voxel_m > 0.0 and len(filtered):
            # Keep real 3D representatives (and ground-relative fields), not
            # averaged points that flatten low obstacles into the road.
            cells = np.floor(filtered[:, :3] / self.cluster_voxel_m).astype(np.int64)
            _, indices = np.unique(cells, axis=0, return_index=True)
            filtered = filtered[indices]

        # 필터 통과한 원본 점(클러스터링 이전)이 거리 구간별로 몇 개 찍히는지 확인.
        # 이걸로 "10m 밖에서 라이다 반사 자체가 없는지" vs "점은 있는데
        # min_points_for_confirm을 못 채워서 버려지는지"를 구분한다.
        ahead_mask = (filtered[:, 0] > 0) & (np.abs(filtered[:, 1]) < 3.0)
        ahead = filtered[ahead_mask]
        if len(ahead) > 0:
            ahead_dist = np.linalg.norm(ahead[:, :2], axis=1)
            bins = [(15, 20), (10, 15), (7, 10), (5, 7), (3, 5), (0, 3)]
            counts = {f"{lo}-{hi}m": int(np.sum((ahead_dist >= lo) & (ahead_dist < hi)))
                      for lo, hi in bins}
            rospy.loginfo_throttle(0.3,
                "[obstacle_perception] DEBUG raw point count by distance (전방, |y|<3m): %s", counts)

        clusters = cluster_lidar_points(filtered, self.cluster_eps,
                                         self.min_points_for_confirm, self.cluster_max_points,
                                         far_range=self.far_cluster_range,
                                         far_min_points=self.far_min_points,
                                         preserve_large=(zone == 'tunnel'),
                                         max_span_y=self.cluster_max_span_y,
                                         max_span_x=self.cluster_max_span_x)
        clusters = merge_close_clusters(clusters, self.merge_cluster_dist)
        # ★ 근거리 2차 병합.
        #   가까워지면 같은 물체가 링 여러 개에 걸리면서 수직으로 갈라지고,
        #   그 조각들이 각각 새 트랙으로 등록된다.
        #     실측 2026-09-09(16:52): 한 물체 자리에 트랙 3개(id7 21m,
        #     id11 11m, id12 5.6m)가 생겼고 상호거리는 0.66~0.69m 였다.
        #     회피는 id7 로 계획했는데 실제 가장자리는 id12 쪽이라 0.16m
        #     긁었다. 5.6m 에서 처음 뜬 id12 는 이미 피할 수 없는 거리다.
        #   거리가 가까울수록 한 물체의 조각이 멀어 보이므로(각 분해능),
        #   근거리에서만 문턱을 키워 다시 붙인다.
        if self.near_merge_range > 0.0:
            clusters = merge_close_clusters(
                clusters, self.merge_cluster_dist,
                near_range=self.near_merge_range,
                near_dist=self.near_merge_dist)
        clusters = self._reject_ground_residue(clusters)
        self.associate_and_update_tracks(clusters, now)
        self.publish_tracks()
        self.publish_markers()

    def _reject_ground_residue(self, clusters):
        """지면에 붙어 있는 클러스터(=노면 잔차 및 연석)를 버린다.

        판정은 클러스터의 '최고점(top)', '수직 두께(cluster_h)', 그리고 '2D 주축 형상(SVD)'으로 한다.
        실제 장애물(카고박스 h>=0.35m, 드럼 h>=0.85m, 저상 장애물 h>=0.15m)은
        입체적 두께를 형성하며 종횡비(aspect ratio)가 크지 않다.
        반면 노면 잔차나 연석은 2~3점짜리 납작한 평면(cluster_h < 0.06m)이거나 가늘고 긴 선형(aspect > 8.0)이다.
        """
        self.boundary_objects = []
        if not clusters:
            return clusters

        # --- 2차(판정): 클러스터 중심이 기준경로에서 얼마나 떨어졌나 ---
        # 1차는 점을 넓게 모으는 단계였고, 실제로 '내 경로 위 장애물'인지는
        # 물체 단위로 여기서 가린다. 점 단위로 좁히면 물체가 반쯤 잘려서
        # 크기·형상 판정이 망가지지만, 중심으로 재면 물체는 온전한 채로
        # 경로에서 벗어난 것만 버릴 수 있다.
        lateral = None
        if self.use_path_corridor and clusters:
            centers = np.array([c[:2] for c, _ in clusters], dtype=np.float64)
            lateral = self._path_lateral_dist(centers)

        # 구간별 고도 문턱. idx 를 못 받았으면(측위 실패 등) 안전하게 낮은 쪽을
        # 써서 장애물을 놓치지 않는다 - 오탐이 늘어도 못 보는 것보다 낫다.
        # ★ 구간을 셋으로 나눈다. 예전에는 static_zone(2400~4900) 하나로 묶여
        #   정적/동적이 같은 문턱(0.12)을 썼다. 그래서 동적 구간에서도 노면
        #   잔차가 장애물로 올라왔고, obstacle_stop_node 가 동적 구간에서는
        #   motion_state/confirmed 를 안 보기 때문에 그게 곧 급정지였다.
        #     실측 2026-09-09(17:14): 고도 0.13m 잔차(id28)가 x=4.8m 에
        #     2.4초간 고정돼 신호등 앞에서 3.7초 정지를 유발했다.
        #   정적 구간만 낮은 문턱이 필요하다(저상 카고박스를 살려야 한다).
        #   동적 구간은 보행자/더미가 대상이라 높아도 된다.
        idx = self.current_wp_idx
        in_static_zone = (self.static_zone_min_idx <= idx
                          <= self.static_dynamic_split_idx)
        in_dynamic_zone = (self.static_dynamic_split_idx < idx
                           <= self.static_zone_max_idx)
        if self.mission_zone == 'tunnel':
            elev_min = self.min_obstacle_elevation
        elif idx < 0:
            # 측위 실패 - 가장 낮은 문턱으로 안전하게(놓치지 않는 쪽)
            elev_min = self.min_obstacle_elevation
        elif in_static_zone:
            elev_min = self.min_obstacle_elevation
        elif in_dynamic_zone:
            elev_min = self.min_obstacle_elevation_dynamic
        else:
            elev_min = self.min_obstacle_elevation_outside
        in_mission_zone = in_static_zone or in_dynamic_zone

        kept = []
        dropped = []
        for ci, (center, pts) in enumerate(clusters):
            # ★ 원거리 저점수(2점) 클러스터는 SVD 형상 검사(>=4점 필요)를
            #   받지 못한다. 그 방어를 고도로 대신한다 - 노면 잔차는 지면에
            #   붙어 있고(실측 0.11~0.20m), 진짜 장애물은 솟아 있다.
            #   far_min_points 완화로 들어온 클러스터에만 적용한다.
            if (len(pts) < self.min_points_for_confirm
                    and self.far_low_point_elevation > 0.0):
                top_q = (float(np.max(pts[:, 3])) if self.use_ground_relative
                         and pts.shape[1] > 3
                         else float(np.max(pts[:, 2])) - self.ground_z)
                # 거리에 따라 문턱을 낮춘다(2026-09-21).
                #
                # 고정 0.30 이면 원거리 저상 장애물이 통째로 기각된다.
                # VLP-16 은 링 간격 2 deg 라 0.35 m 짜리 콘에 맞는 링이
                # 10 m 에서 1.0 개, 20 m 0.5 개, 30 m 0.3 개로 줄어든다.
                # 링이 물체 윗부분을 못 맞으면 측정된 top 이 실제 높이보다
                # 낮게 나오고, 그대로 0.30 에 걸린다.
                #   실측(09-21 17:10 heavy, 118 프레임, 저상대역 점의
                #   0.30 통과율): 10-15m 52.5% -> 25-30m 31.4%
                #   -> 30-40m 17.6%. 30 m 너머는 82% 가 버려진다.
                #
                # 문턱을 낮춰도 안전한 이유는 노면 잔차 자체가 원거리에서
                # 급감하기 때문이다. 같은 백에서 지면상대 0.35 m 미만 점은
                # 프레임당 5-10m 4.36 개 -> 20-25m 0.14 -> 30-40m 0.25 로
                # 약 17 배 줄어든다. 링이 성기어 잔차가 생길 자리도 적다.
                #
                # ★ 완화는 '경로 위' 물체에만 준다(2026-09-21).
                #   완화를 횡방향 제한 없이 걸었더니 교차로 신호등 기둥
                #   밑동/표지판 지주가 대량으로 통과했다. 실측(09-21 17:16
                #   백): AEB 긴급 90회, 9.85 m/s 에서 완전정지 2회.
                #   유발 물체는 경로 횡거리 2.3 m 부근이라 회피 코리도(1.5)
                #   밖인데, 정지 노드만 stop_corridor_radius 3.2 m 를 써서
                #   혼자 반응했다(회피는 미작동, /ctrl_cmd_raw 는 accel 0.49
                #   인데 AEB 가 brake 1.00 으로 덮었다).
                #   저상 장애물은 어차피 경로 위에 있어야 의미가 있으므로,
                #   완화 혜택만 경로 근처로 한정하고 갓길 구조물은 기존
                #   0.30 문턱으로 계속 기각한다. 정지 노드의 3.2 m 그물
                #   자체는 건드리지 않는다(갓길 큰 물체는 계속 본다).
                # far_elev_relax_* 를 0 으로 두면 기존 고정 문턱 그대로다.
                near_path = True
                if (self.far_elev_relax_max_lateral_m > 0.0
                        and lateral is not None and ci < len(lateral)):
                    near_path = (abs(float(lateral[ci]))
                                 <= self.far_elev_relax_max_lateral_m)
                dist_xy = float(np.hypot(center[0], center[1]))
                elev_gate = self.far_low_point_elevation
                if (near_path
                        and self.far_elev_relax_end_m > self.far_elev_relax_start_m
                        and self.far_elev_relax_min > 0.0):
                    span = (self.far_elev_relax_end_m
                            - self.far_elev_relax_start_m)
                    ratio = (dist_xy - self.far_elev_relax_start_m) / span
                    ratio = min(1.0, max(0.0, ratio))
                    elev_gate = (self.far_low_point_elevation
                                 + ratio * (self.far_elev_relax_min
                                            - self.far_low_point_elevation))
                if top_q < elev_gate:
                    dropped.append((center, top_q,
                                    f"far_lowpts_{len(pts)}_elev_{top_q:.2f}"
                                    f"_gate_{elev_gate:.2f}"))
                    continue

            in_trigger = True
            if lateral is not None:
                # 중심이 코리도 밖이어도 물체 몸통이 경로를 침범하면 남긴다.
                # 중심만 보면 옆으로 비스듬히 걸친 큰 물체를 놓친다.
                half_extent = 0.5 * float(np.ptp(pts[:, :2], axis=0).max())
                edge = lateral[ci] - half_extent
                if self.mission_zone == 'tunnel':
                    # A 20m-long side wall is not 10m wide. Test its actual
                    # lateral footprint rather than an enclosing circle.
                    edge = float(np.min(self._path_lateral_dist(pts[:, :2])))
                if edge > self.collision_corridor_half_width:
                    # 회피 폭 밖 - 어떤 후보 경로도 여기로 안 간다. 버린다.
                    dropped.append((center, 0.0,
                                    f"off_path_{lateral[ci]:.1f}m"))
                    continue
                # 충돌 코리도 안이지만 트리거 코리도 밖이면 '충돌 검사 전용'
                # 으로만 남긴다(회피를 새로 시작시키지는 않는다).
                in_trigger = (edge <= self.path_corridor_half_width)
                # ★ 기준경로 코리도만 보면, 회피로 차가 옆으로 나가 있는 동안
                #   '내 앞에 있는' 물체가 트리거에서 빠진다. 기준은 고정돼도
                #   차량이 1.5m 밀려나 있으면 경로 기준 1.5m 안의 물체가
                #   차에서는 3m 라, 다음 장애물이 목록에서 사라진다.
                #     실측 2026-09-09(16:52): 차량 d 가 +0.90 -> +1.23 으로
                #     커지는 순간 트리거 장애물 3개(T7/T11/T12)가 한꺼번에
                #     사라졌다. "첫 장애물은 피하는데 두번째는 인식이 안 된다"
                #     의 원인이다.
                #   그래서 '차량 진행 경로(ego 전방)' 기준으로도 본다 -
                #   둘 중 하나라도 안에 들면 트리거로 취급한다.
                if not in_trigger and self.ego_corridor_enabled:
                    # center 는 ego 프레임이다(x 전방, y 좌측).
                    ex, ey = float(center[0]), float(center[1])
                    if 0.0 < ex <= self.ego_corridor_range:
                        ego_edge = (float(np.min(np.abs(pts[:, 1])))
                                    if self.mission_zone == 'tunnel'
                                    else abs(ey) - half_extent)
                        if ego_edge <= self.path_corridor_half_width:
                            in_trigger = True
            z_max = float(np.max(pts[:, 2]))
            z_min = float(np.min(pts[:, 2]))
            top = (float(np.max(pts[:, 3])) if self.use_ground_relative
                   and pts.shape[1] > 3 else z_max - self.ground_z)
            cluster_h = z_max - z_min
            n_pts = len(pts)

            # 1. 지면 위 최고점(top) 기준 미달 시 탈락.
            #    정적 장애물 구간에서만 낮은 문턱(카고박스/라바콘 보존),
            #    그 밖에서는 높은 문턱(노면 표식 배제). src_최적과 같은 구조다.
            if top < elev_min:
                dropped.append((center, top, "elevation"))
                continue

            # 2. 2D 주축 형상 검사 (SVD): 연석 조각(가늘고 긺) 및 거대 선형 구조물 기각
            xy = pts[:, :2] - pts[:, :2].mean(axis=0)
            if len(xy) >= 4:
                _, s, axes = np.linalg.svd(xy, full_matrices=False)
                ext = np.ptp(xy @ axes.T, axis=0)
                length, width = float(max(ext)), float(min(ext))
                aspect = length / max(width, 0.05)

                # 터널 주행 코리도 밖의 길고 얇은 종방향 군집은 벽면이다.
                # 보이는 벽 구간의 중심이 프레임마다 움직이면 동적 장애물처럼
                # 추적될 수 있으므로 판단/충돌 점군에서 제거한다. 코리도에
                # 침입한 물체와 횡방향 장벽은 아래 일반 장애물 처리에 남긴다.
                if (self.mission_zone == 'tunnel' and not in_trigger and
                        length > self.curb_linear_min_length and
                        width < self.curb_linear_max_width and
                        abs(float(axes[0, 0])) > 0.75):
                    dropped.append((center, top,
                                    f"tunnel_wall_len_{length:.1f}"))
                    continue

                # 주축 방향 분석:
                # - 연석/가드레일: 도로 방향(longitudinal, 시선 방향)으로 뻗어 있음.
                # - 전방 장애물(박스, 바리케이드, 차량 등): 차선을 가로막는 횡방향(transverse, 시선 직교 방향).
                # VLP-16은 8m 이상 원거리에서 0.4~0.5m 높이 물체에 1개 링만 닿으므로,
                # 정면을 향한 평면/박스도 점군 두께가 ~0이라 종횡비가 20~40으로 계산된다.
                # 따라서 시선 직교(차선 횡단) 형상은 연석 종횡비로 기각하면 안 된다.
                r_norm = np.linalg.norm(center[:2])
                if r_norm > 1e-3:
                    r_unit = center[:2] / r_norm
                    t_unit = np.array([-r_unit[1], r_unit[0]])
                    cos_t = abs(float(np.dot(axes[0], t_unit)))
                    is_transverse = (cos_t >= 0.707)  # 시선 직교(차선 가로막음)
                else:
                    is_transverse = False

                # 2-1. 비정상적으로 긴 선형 구조물(연석, 가드레일, 벽체, 길이 2.5m 이상) 기각
                if (length > self.curb_linear_min_length and
                        width < self.curb_linear_max_width and
                        self.mission_zone != 'tunnel'):
                    dropped.append((center, top, f"linear_curb_len_{length:.1f}"))
                    continue

                # 2-1b. 저상 물체는 길이 상한도 본다. 라바콘·카고박스는 1m 안팎인데
                #       연석·노면 표식은 훨씬 길게 이어진다(실측 2026-09-08:
                #       16.4m 표식이 폭 1.12m 로 옆으로 퍼져 있었다).
                #       폭 조건(2-1)만으로는 '길지만 두꺼운' 노면 패치를 못 거른다.
                #       높이 있는 물체(top >= low_obstacle_top_m)는 이 검사에서 뺀다.
                if (top < self.low_obstacle_top_m and
                        length > self.low_obstacle_max_length):
                    dropped.append((center, top, f"low_too_long_{length:.1f}"))
                    continue

                # 2-2. 도로를 따라 길게 뻗은(종방향) 연석 조각 기각
                #      (차선을 가로막는 횡방향 물체나 높이 35cm 이상의 확실한 장애물은 제외)
                if not is_transverse and top < self.low_obstacle_top_m:
                    if aspect > self.curb_max_aspect and self.mission_zone != 'tunnel':
                        dropped.append((center, top, f"curb_aspect_{aspect:.1f}"))
                        continue

            # 3. 저상 장애물 후보: 카고박스처럼 낮은 물체는 점이 적어도 최소 개수 이상이어야 함
            if top < self.low_obstacle_top_m:
                # 근거리(<8m) 및 극저상(<20cm)에서만 수직 두께 검사 적용.
                # 원거리(>=8m)는 VLP-16 단일 링 히트로 물리적 수직 두께(cluster_h)가
                # 0.01m 이하가 되므로, 수직 두께 대신 지면 대비 고도(top >= 0.12m)로 신뢰성 확보.
                dist_to_ego = np.linalg.norm(center[:2])
                # ★ 두께 검사는 '링이 2개 이상 닿을 수 있는 거리'에서만 쓴다.
                #   VLP-16 은 링 간 수직 간격이 2deg 라, 거리 r 에서 두 링의
                #   높이차는 r*tan(2deg) ~ 0.035*r 이다. 즉 물체 높이가 그보다
                #   작으면 링이 하나만 닿아 두께가 구조적으로 0 이 된다
                #   (예: 14m 에서 0.49m, 20m 에서 0.70m 보다 낮은 물체).
                #   그런 물체에 두께 0.06 을 요구하면 '있는데 버린다'.
                #     실측 2026-09-09(16:41): 고도 0.20 물체가 15.9m 에서야
                #     잡혔고 0.35 물체는 14.2m 였다. 반면 같은 고도 0.32 물체가
                #     경로 위(|y|<1.1)에서는 24.5m 에 잡혔다 - 점이 더 많이
                #     모여 우연히 두 링에 걸린 경우다. 즉 이 게이트가
                #     거리/횡위치에 따라 검출을 들쭉날쭉하게 만들고 있었다.
                #   노면 잔차 방어는 고도 문턱(min_obstacle_elevation)과
                #   형상 필터(SVD)가 이미 맡는다.
                ring_sep_m = self.ring_vert_sep_tan * max(dist_to_ego, 1.0)
                thickness_meaningful = (top >= ring_sep_m)
                if (dist_to_ego < self.flat_check_max_range
                        and top < self.low_obstacle_flat_top_m
                        and thickness_meaningful):
                    if cluster_h < self.low_obstacle_min_thickness:
                        dropped.append((center, top, f"flat_residue_h_{cluster_h:.2f}"))
                        continue
                if n_pts < self.low_obstacle_min_points:
                    dropped.append((center, top, f"too_few_pts_{n_pts}"))
                    continue

            kept.append((center, pts, in_trigger))

        # ★ 조각 정렬 검사: 여러 클러스터가 한 직선 위에 늘어서 있으면
        #   그건 개별 물체가 아니라 '쪼개진 선형 구조물'(연석/노견/가드레일)이다.
        #
        #   SVD 형상 필터는 클러스터 하나씩만 보므로, 연석이 조각나면 각
        #   조각이 짧아서 curb_linear_min_length(2.5m)를 못 넘고 전부 통과한다.
        #   near_merge 로 붙이기에는 조각 간격이 1~3m 로 너무 넓다.
        #     실측 2026-09-10 (정지 상태, 급가감속 무관):
        #       검출 8개가 5.6m~18.1m 에 걸쳐 일정 패턴으로 늘어섰다.
        #         y    = -0.116 * 거리 - 0.109   (상관 -0.97)
        #         고도 = +0.030 * 거리 - 0.017   (상관  0.79, 1.74deg 상승)
        #       전부 W=L=0.35(최소 클램핑)이고 trigger 였다 - 이게 동적 구간
        #       "가다 서다 반복"의 원인이었다.
        #   이 단계의 노견은 실제 지면보다 높기 때문에 지면제거 문제가
        #   아니라 형상 판정 문제다.
        if self.align_reject_enabled and len(kept) >= self.align_min_count:
            # lateral 은 원본 clusters 인덱스 기준이라 kept 와 어긋난다.
            # kept 중심으로 다시 계산해 넘긴다.
            kept_lat = None
            if self.use_path_corridor:
                kc = np.array([c[:2] for c, _p, _t in kept], dtype=np.float64)
                kept_lat = self._path_lateral_dist(kc)
            kept = self._reject_aligned_chain(kept, dropped, kept_lat)

        if dropped:
            rospy.loginfo_throttle(
                1.0,
                "[obstacle_perception] 노면 잔차/연석 %d개 제외 (idx=%d %s, 고도<%.2fm "
                "또는 두께<0.06m/SVD): %s",
                len(dropped), self.current_wp_idx,
                "정동적구간" if in_mission_zone else "구간밖", elev_min,
                ", ".join("(%.1f,%.1f h=%.2f reason=%s)" % (c[0], c[1], t, r)
                          for c, t, r in dropped[:4]))
        return kept

    def _reject_aligned_chain(self, kept, dropped, lateral=None):
        """한 직선 위에 정렬된 클러스터 묶음을 선형 구조물로 보고 기각한다.

        판정: 전체 점을 모아 SVD 주축을 구하고
          - 주축 길이가 충분히 길다(align_min_length)
          - 직교 방향 퍼짐이 좁다(align_max_width)
          - 구성 클러스터가 align_min_count 개 이상
        이면 그 묶음 전체를 버린다.

        경로 위 실물은 보호한다 - 기준경로 코리도 안(in_trigger)인 클러스터가
        묶음에 섞여 있으면 그건 버리지 않는다. 연석은 경로 옆에 있고, 줄지어
        놓인 라바콘도 코리도 안이면 살려야 하기 때문이다.
        """
        # 자차 기준 '한쪽 옆'으로 제한한다. 좌우를 섞으면 서로 다른 구조물이
        # 한 직선으로 보일 수 있다.
        for side in (-1, 1):
            idxs = [i for i, (c, _p, _t) in enumerate(kept)
                    if (c[1] * side) > self.align_min_offset]
            if len(idxs) < self.align_min_count:
                continue
            # ★ 실물 보호 조건을 '코리도 안(in_trigger)' 으로 걸면 안 된다.
            #   노면 라인은 기준경로에서 0.7~2.5m 에 걸쳐 있어 코리도(1.5m)
            #   안에 상당수가 들어온다. 그러면 이 조건이 '항상' 발동해서
            #   검사 자체가 영구히 스킵된다.
            #     실측 2026-09-10: 경로상 실물 0개인데 검출 9개(전부 노면).
            #     그 중 7개가 in_trigger=True 라 검사가 통째로 꺼져 있었다.
            #   대신 '직선에서 벗어난 것'으로 실물을 보호한다 - 진짜 물체는
            #   라인 위에 정렬되지 않으므로 아래 SVD 폭 조건이 그 역할을 한다.
            #   경로 중앙(|lateral| 작음)에 있는 것만 별도로 지킨다.
            if lateral is not None:
                on_path = [i for i in idxs
                           if lateral[i] < self.align_protect_lateral]
                if on_path:
                    # 경로 중앙에 있는 건 라인이 아니라 실물일 수 있다.
                    # 그것만 빼고 나머지로 라인 판정을 계속한다.
                    idxs = [i for i in idxs if i not in set(on_path)]
                    if len(idxs) < self.align_min_count:
                        continue
            cs = np.array([kept[i][0][:2] for i in idxs], dtype=np.float64)
            ctr = cs.mean(axis=0)
            X = cs - ctr
            if len(X) < 3:
                continue
            _u, _sv, axes = np.linalg.svd(X, full_matrices=False)
            ext = np.ptp(X @ axes.T, axis=0)
            length, width = float(max(ext)), float(min(ext))
            if length < self.align_min_length or width > self.align_max_width:
                continue
            # ★ 노면 라인과 '일렬로 놓인 실물'을 가른다.
            #   피치로 기운 노면은 고도가 거리에 비례해 오른다.
            #   라바콘/드럼을 줄지어 놓은 것은 고도가 거리와 무관하게 일정하다.
            #     실측 2026-09-10:
            #       노면 9개  : 고도 = 0.036*dist - 0.112 (상관 +0.91, 2.06deg)
            #       라바콘 줄 : 고도 기울기 0, 표준편차 0
            #   이 조건이 없으면 경로 옆에 일렬로 놓인 라바콘이 전부 기각된다.
            dists = np.array([float(np.linalg.norm(kept[i][0][:2])) for i in idxs])
            tops = np.array([(float(np.max(kept[i][1][:, 3]))
                              if self.use_ground_relative and kept[i][1].shape[1] > 3
                              else float(np.max(kept[i][1][:, 2])) - self.ground_z)
                             for i in idxs])
            if len(dists) >= 3 and float(np.ptp(dists)) > 1e-3:
                slope = float(np.polyfit(dists, tops, 1)[0])
                # 고도가 거리에 따라 충분히 '오르지' 않으면 노면이 아니다.
                if slope < self.align_min_height_slope:
                    continue
            for i in idxs:
                c = kept[i][0]
                dropped.append((c, 0.0,
                                "aligned_chain_n%d_L%.1f_W%.2f"
                                % (len(idxs), length, width)))
            keep_set = set(range(len(kept))) - set(idxs)
            kept = [kept[i] for i in sorted(keep_set)]
            rospy.loginfo_throttle(
                1.0,
                "[obstacle_perception] 정렬된 선형 구조물 %d조각 기각 "
                "(%s, 주축 %.1fm x %.2fm)",
                len(idxs), "우측" if side < 0 else "좌측", length, width)
        return kept

    def associate_and_update_tracks(self, clusters, now):
        # Global assignment with a separate unmatched choice for every detection.
        pose = self.scan_pose or self.latest_ego_pose
        detections = []
        for item in clusters:
            center, pts = item[:2]
            world = ego_to_world(center[:2], pose)
            if self._near_known_infra(world):
                continue
            top = float(np.max(pts[:, 3])) if pts.shape[1] > 3 else float(np.max(pts[:, 2])) - self.ground_z
            thickness = float(np.ptp(pts[:, 2]))
            detections.append((item, world, top, thickness))
        n, m = len(detections), len(self.tracks)
        costs = np.full((n, m+n), 12.0)
        for i, (item, world, top, thickness) in enumerate(detections):
            length, width, _ = estimate_extent(item[1][:, :2])
            for j, track in enumerate(self.tracks):
                dt = now - track.last_seen
                if dt <= 0 or dt > self.track_timeout:
                    costs[i, j] = 1e6
                    continue
                pred = track.position.copy()
                covariance = np.eye(2) * 0.25
                if track.kf is not None:
                    F = np.array([[1,0,dt,0], [0,1,0,dt]], dtype=float)
                    pred = F @ track.kf.x
                    covariance = F @ track.kf.P @ F.T
                delta = world - pred
                distance = float(np.linalg.norm(item[0][:2]))
                covariance += np.eye(2) * (self.kf_r_base + self.kf_r_slope * distance**2)
                mahal = float(delta @ np.linalg.solve(covariance, delta))
                shape = abs(length-track.length) + abs(width-track.width)
                dh = abs(top-track.top_elevation) if track.top_elevation is not None else 0.0
                if np.linalg.norm(delta) > self.max_association_dist or mahal > 9.21 or dh > 0.65:
                    costs[i, j] = 1e6
                else:
                    costs[i, j] = mahal + 2.0 * shape + 4.0 * dh
        assignments = dict(zip(*linear_sum_assignment(costs))) if n else {}
        used_track_ids = set()
        for i, (item, pos_world, top_elev, thickness) in enumerate(detections):
            center, cluster_pts = item[:2]
            in_trigger = bool(item[2]) if len(item) > 2 else True
            z = float(center[2])
            length, width, radius = estimate_extent(cluster_pts[:, :2])
            j = assignments.get(i, m)
            best_track = self.tracks[j] if j < m and costs[i, j] < 12.0 else None
            if best_track is not None:
                # 2프레임 이상 매칭 성공 시 confirmed
                best_track.update(pos_world, z, now, confirmed=True, source='lidar_only',
                                   length=length, width=width, radius=radius,
                                   position_ego=center[:2],
                                   dist_to_ego=float(np.linalg.norm(center[:2])))
                best_track.top_elevation = top_elev
                best_track.vertical_thickness = thickness
                best_track.in_trigger_corridor = in_trigger
                used_track_ids.add(best_track.id)
            else:
                # 최초 발견 프레임에 즉시 confirmed 로 볼지.
                #
                # 예전에는 '점 6개 이상' 이면 통과시켰는데, 노면 표식·차선이
                # 그 문턱을 쉽게 넘는다(실측 2026-09-08: 정지 유발 표식 7점,
                # 11.7m 표식 27점, 16.4m 표식 18점 - 셋 다 즉시 확정됐다).
                # 점 개수는 '실재하는가' 의 근거가 못 된다 - 노면은 넓게 퍼져
                # 있어서 오히려 점이 많다.
                #
                # 실재 여부의 근거는 '높이' 다. 노면 표식은 지면에 붙어 있고
                # (실측 고도 0.14~0.18m), 진짜 장애물은 솟아 있다. 그래서
                # 고도 문턱만 남기고 점 개수 우회로는 없앤다. 그 문턱을 못 넘는
                # 물체는 다음 프레임에 같은 자리에서 다시 보이면 확정된다
                # (아래 best_track 매칭 경로) - 노면 표식은 프레임마다 위치가
                # 흔들려 매칭이 잘 안 되고, 실물은 map 좌표가 고정이라 붙는다.
                top_elev = (float(np.max(cluster_pts[:, 3]))
                            if self.use_ground_relative and cluster_pts.shape[1] > 3
                            else float(np.max(cluster_pts[:, 2])) - self.ground_z)
                init_confirmed = top_elev >= self.init_confirm_elevation
                new_track = ObstacleTrack('obstacle', pos_world, z, now,
                                           confirmed=init_confirmed, source='lidar_only',
                                           static_speed_threshold=self.static_speed_threshold,
                                           min_motion_baseline_sec=self.min_motion_baseline_sec,
                                           dynamic_confirm_count=self.dynamic_confirm_count,
                                           motion_speed_window_sec=self.motion_speed_window_sec,
                                           max_plausible_speed=self.max_plausible_speed,
                                           motion_z_threshold=self.motion_z_threshold,
                                           motion_z_var_floor=self.motion_z_var_floor,
                                           length=length, width=width, radius=radius,
                                           kf_enabled=self.kf_enabled,
                                           kf_q_accel=self.kf_q_accel,
                                           kf_r_base=self.kf_r_base,
                                           kf_r_slope=self.kf_r_slope,
                                           kf_vel_std_max=self.kf_vel_std_max,
                                           ego_rate_window_sec=self.ego_rate_window_sec,
                                           position_ego=center[:2])
                new_track.top_elevation = top_elev
                new_track.vertical_thickness = thickness
                new_track.in_trigger_corridor = in_trigger
                self.tracks.append(new_track)
                used_track_ids.add(new_track.id)

            if self.motion_backend == 'apollo_measurement':
                target = best_track if best_track is not None else new_track
                if not hasattr(target, 'motion_observation'):
                    target.motion_observation = MotionObservation('dynamic', **self.motion_config)
                c, sn = math.cos(pose[2]), math.sin(pose[2])
                world_points = np.asarray(cluster_pts[:, :3], dtype=np.float64).copy()
                world_points[:, :2] = cluster_pts[:, :2] @ np.array([[c, sn], [-sn, c]]) + np.asarray(pose[:2])
                motion = target.motion_observation
                motion.update(world_points, now, pose[2])
                if target.kf is not None:
                    adopt_velocity(target.kf, motion)
                # The legacy update has already advanced the classification once.
                # Publish the measured vector independently of that label, so TTC
                # need not wait for dynamic_confirm_count.
                target.velocity = motion.velocity.copy()
                target.speed = float(np.linalg.norm(motion.velocity))
                target.velocity_valid = bool(motion.valid)
                # Keep short-window, pose-compensated centroid regression as
                # separate evidence. Do not overwrite it with the box estimate.
                if not motion.valid:
                    target.motion_state = 'unknown'
                    target.apollo_dynamic_streak = 0
                    target.apollo_static_since = None
                elif target.speed > target.static_speed_threshold:
                    target.apollo_static_since = None
                    target.apollo_last_moving = now
                    target.apollo_dynamic_streak = getattr(target, 'apollo_dynamic_streak', 0) + 1
                    target.motion_state = ('dynamic' if target.apollo_dynamic_streak >= target.dynamic_confirm_count else 'unknown')
                else:
                    target.apollo_dynamic_streak = 0
                    if getattr(target, 'apollo_static_since', None) is None:
                        target.apollo_static_since = now
                    recently_moving = now - getattr(target, 'apollo_last_moving', -1e9) < 2.0
                    target.motion_state = ('dynamic' if recently_moving else
                        ('static' if now-target.apollo_static_since >= 0.8 else 'unknown'))

        self._age_out_tracks(now)

    def _age_out_tracks(self, now):
        kept_tracks = []
        for t in self.tracks:
            if not t.is_stale(now, self.track_timeout):
                kept_tracks.append(t)
                continue
            # 확정된 정적 장애물이 자차 측면(-2.8 <= ego_x <= 2.5)에 위치해 있다면,
            # 센서 음영/차체 간섭으로 점군이 잠시 끊겨도 조기 삭제하지 않고 보존
            if self.latest_ego_pose is not None and t.confirmed and t.motion_state == 'static':
                pe = world_to_ego(t.position, self.latest_ego_pose)
                if -2.8 <= pe[0] <= 2.5 and abs(pe[1]) <= 4.5 and (now - t.last_seen) < 4.0:
                    kept_tracks.append(t)
                    continue
        self.tracks = kept_tracks

    def publish_tracks(self):
        if self.latest_ego_pose is None:
            return

        # ★ 목록 분리.
        #   obstacles          : 트리거 코리도(기준경로 1.4m) 안 - "회피를 시작할까"
        #   collision_objects  : 충돌 코리도(6.0m) 안 전체 - "이 후보 경로가 안전한가"
        #   분리 이유: 트리거 목록만 넘기면, 회피를 시작한 뒤 회피 경로가
        #   지나가는 자리(기준경로에서 2~4m 옆)의 장애물이 목록에 없어서
        #   프레넷이 그 위로 경로를 그린다. 실제로 박았다.
        obstacles = []
        collision_objects = []
        for track in self.tracks:
            position_ego = world_to_ego(track.position, self.latest_ego_pose)
            # 자차 전장(~4.8m) 및 라이다 위치를 고려하여, 장애물이 차체 후미 완전히 뒤로 빠졌을 때만 passed 처리
            passed = bool(position_ego[0] < -2.8)
            entry = {
                'id': track.id,
                'class_name': track.class_name,
                'position_ego': [float(position_ego[0]), float(position_ego[1]), float(track.z)],
                'position_world': [float(track.position[0]), float(track.position[1])],
                'length': round(track.length, 2),
                'width': round(track.width, 2),
                'radius': round(track.radius, 2),
                'speed': round(track.speed, 3),
                # world(UTM) 기준 속도 벡터. 정지 노드가 '내 경로 쪽으로
                # 접근하는가'를 판정하는 데 쓴다 - 속도 크기만으로는 지나가는
                # 물체와 다가오는 물체를 구분할 수 없다.
                'velocity': [float(track.velocity[0]), float(track.velocity[1])],
                'motion_state': track.motion_state,
                'velocity_valid': bool(track.velocity_valid),
                'velocity_backend': self.motion_backend,
                'direction_std_rad': (track.motion_observation.direction_std
                    if hasattr(track, 'motion_observation') and track.motion_observation.valid
                    and track.speed >= 0.1 else None),
                'ego_yaw': float(self.latest_ego_pose[2]),
                'velocity_covariance': (track.motion_observation.covariance.reshape(-1).tolist()
                    if hasattr(track, 'motion_observation') else
                    (track.kf.P[2:4, 2:4].reshape(-1).tolist() if track.kf is not None else [])),
                'observed_velocity': track.observed_velocity.tolist(),
                'observed_motion_valid': bool(track.observed_motion_valid),
                'observation_age': max(0.0, rospy.Time.now().to_sec() - track.last_seen),
                'top_elevation': track.top_elevation,
                'vertical_thickness': track.vertical_thickness,
                'dynamic_streak': track.dynamic_streak,
                'last_seen': track.last_seen,
                'source': track.source,
                'passed': passed,
                'confirmed': track.confirmed,
                'in_trigger_corridor': bool(track.in_trigger_corridor),
                # 같은 자리에 머문 시간(s). 영구 구조물(연석/폴)과 출발 대기
                # 중인 보행자 더미를 가르는 데 쓴다 - obstacle_stop_node 참고.
                'stationary_sec': round(float(getattr(track, 'stationary_sec', 0.0)), 2),
                # ego 기준 횡위치 변화율 p90 [m/s]. 진단·시각화용.
                #   정지 판정은 이 값을 쓰지 않는다 - 칼만 velocity 를
                #   경로 접선 기준으로 돌린 횡속도를 쓴다(같은 양을 더
                #   정확하게 재는 것이고, 실측 분리도 동등했다:
                #   ego_y_rate 3.79배 / |v_lateral| 3.76배).
                #   오검출을 추적할 때 둘을 비교하면 원인이 빨리 갈린다.
                'ego_y_rate': round(float(getattr(track, 'ego_y_rate', 0.0)), 3),
                'ego_y_rate_signed': round(float(
                    getattr(track, 'ego_y_rate_signed', 0.0)), 3),
                # 칼만 속도 추정의 불확실도. 큰 값이면 속도를 믿지 말 것.
                'vel_std': round(track.motion_observation.std if hasattr(track, 'motion_observation')
                                 else (float(track.kf.vel_std) if track.kf is not None else -1.0), 3),
            }
            collision_objects.append(entry)
            if track.in_trigger_corridor:
                obstacles.append(entry)

        collision_objects.extend(self.boundary_objects)
        msg = String()
        msg.data = json.dumps({'obstacles': obstacles,
                               'collision_objects': collision_objects,
                               'mission_mode': self.mission_zone,
                               'stamp': rospy.Time.now().to_sec()})
        self.info_pub.publish(msg)
        n_extra = len(collision_objects) - len(obstacles)
        if n_extra:
            rospy.loginfo_throttle(
                1.0,
                "[obstacle_perception] 충돌검사 전용 %d개 (트리거 %d개, "
                "코리도 %.1f/%.1fm)", n_extra, len(obstacles),
                self.path_corridor_half_width,
                self.collision_corridor_half_width)

    def reference_path_callback(self, msg):
        """기준경로(reference_path)를 ego 프레임으로 옮겨 둔다.

        회피 경로가 아니라 원본 경로를 쓴다 - 구독 지점의 주석 참고.
        map(UTM) 좌표라 점군(ego 프레임)과 직접 비교할 수 없어 odom 의
        ego pose 로 역변환해 저장한다. 경로는 20Hz, 점군은 10Hz 라 매 점군마다
        다시 계산하지 않고 여기서 한 번만 만든다.
        """
        if self.latest_ego_pose is None or not msg.waypoints:
            return
        ex, ey, eyaw = self.latest_ego_pose
        pts = np.array([[w.pose.pose.position.x, w.pose.pose.position.y]
                        for w in msg.waypoints], dtype=np.float64)
        self.path_world = pts
        d = pts - np.array([ex, ey])
        c, s_ = math.cos(-eyaw), math.sin(-eyaw)
        self.path_xy = np.stack([c * d[:, 0] - s_ * d[:, 1],
                                 s_ * d[:, 0] + c * d[:, 1]], axis=1)
        self.path_stamp = rospy.Time.now().to_sec()

    def _path_lateral_dist(self, pts_xy):
        """각 점의 '기준경로까지 최단 횡거리'. 경로가 없으면 None."""
        fresh = (self.path_xy is not None and
                 (rospy.Time.now().to_sec() - self.path_stamp) < 1.0 and
                 len(self.path_xy) >= 2)
        if not fresh:
            return None
        path = self._decimated_path()
        d2 = ((np.asarray(pts_xy)[:, None, :2] - path[None, :, :]) ** 2).sum(axis=2)
        return np.sqrt(d2.min(axis=1))

    def _decimated_path(self):
        """경로를 '실제 간격' 기준으로 솎는다.

        예전에는 인덱스 기준(path_xy[::5])으로 솎았는데, 그건 CSV 원본 경로
        (451점, 0.1m 간격)를 전제한 값이었다. 회피가 켜지면 /local_path 가
        프레넷 경로(71점, 간격 0.35m, 최대 3.61m)로 바뀌고, 거기서 5칸을
        건너뛰면 간격이 1.75m 가 된다. 점과 점 사이가 벌어진 만큼 '경로까지
        최단거리' 가 과대평가된다.
          실측 2026-09-08: 경로 정중앙(GT 16.4m, +0.3m)에 고정한 카고박스가
          stride=1 이면 1.08m, stride=5 면 7.22m 로 계산돼 코리도 1.4m 밖으로
          기각됐다(로그 reason=off_path_2.3~3.9m). 7배 과대평가다.
        간격으로 자르면 경로 종류가 바뀌어도 해상도가 유지된다.
        """
        p = self.path_xy
        if len(p) <= 2:
            return p
        seg = np.linalg.norm(np.diff(p, axis=0), axis=1)
        med = float(np.median(seg)) if len(seg) else 0.0
        if med <= 1e-6:
            return p
        step = max(1, int(self.path_corridor_decimate_m / med))
        out = p[::step]
        return out if len(out) >= 2 else p

    def _path_corridor_mask(self, arr, half_width=None):
        """경로에서 half_width 안에 있는 점만 남기는 마스크.

        경로가 없거나 오래됐으면 정책에 따라 전부 통과(기본) 또는 전부 차단.
        점 N x 경로점 M 을 다 재면 비싸므로, 경로를 일정 간격으로 솎아 쓰고
        (KD-tree 없이) 브로드캐스팅 한 번으로 최소거리를 구한다.
        """
        if not self.use_path_corridor:
            return np.ones(len(arr), dtype=bool)
        fresh = (self.path_xy is not None and
                 (rospy.Time.now().to_sec() - self.path_stamp) < 1.0 and
                 len(self.path_xy) >= 2)
        if not fresh:
            return (np.ones(len(arr), dtype=bool)
                    if self.path_corridor_skip_if_no_path
                    else np.zeros(len(arr), dtype=bool))

        # 경로점이 0.1m 간격이라 그대로 쓰면 수천 개다. 솎아서 쓴다.
        path = self._decimated_path()
        r = float(self.path_corridor_half_width
                  if half_width is None else half_width)

        # N x M 브로드캐스팅은 8000점 x 90경로점에서 18ms 나온다(실측). 이
        # 노드는 이미 콜백 주기가 라이다 10Hz 보다 느려서 그대로 얹으면 안 된다.
        # 경로의 축정렬 바운딩박스 + 여유로 후보를 먼저 줄이고, 살아남은 점에만
        # 정확한 거리 계산을 돌린다. 도로 위 점은 대부분 여기서 걸러진다.
        # 솎은 간격의 절반을 여유에 더해야 구간 중간에서 놓치지 않는다.
        seg = self.path_corridor_decimate_m
        pad = r + seg
        out = np.zeros(len(arr), dtype=bool)
        near_box = (
            (arr[:, 0] >= path[:, 0].min() - pad) &
            (arr[:, 0] <= path[:, 0].max() + pad) &
            (arr[:, 1] >= path[:, 1].min() - pad) &
            (arr[:, 1] <= path[:, 1].max() + pad)
        )
        if not near_box.any():
            return out
        cand = arr[near_box, :2]
        d2 = ((cand[:, None, :] - path[None, :, :]) ** 2).sum(axis=2)
        out[near_box] = d2.min(axis=1) <= (r * r)
        return out

    def final_waypoint_callback(self, msg):
        """현재 waypoint idx/lane + 기준경로. 둘 다 /final_waypoint 에서 온다."""
        if msg.waypoints:
            self.current_wp_idx = int(msg.waypoints[0].waypoint_index)
            self.current_lane = int(getattr(msg.waypoints[0], 'lane_number', -1))
        self.reference_path_callback(msg)

    def gps_state_callback(self, msg):
        """현재 waypoint idx / lane. 마커 필터 판정에만 쓴다."""
        self.current_wp_idx = int(getattr(msg, 'waypoint_index', -1))
        self.current_lane = int(getattr(msg, 'lane_number', -1))

    def _in_mission_section(self):
        """지금이 정동적(정적회피/동적정지) 미션 구간인가."""
        if not self.section_gating_enabled and not self.marker_filter_by_section:
            return True, 'all'

        # 1. /mission/active_section 토픽 수신 시 최우선 사용
        if self.active_section_msg is not None and (rospy.Time.now().to_sec() - self.active_section_t) < 1.5:
            sec_id = getattr(self.active_section_msg, 'section_id', '')
            execs = getattr(self.active_section_msg, 'executors', [])
            if sec_id == 'M8':
                return True, 'tunnel'
            if sec_id in ('M2', 'M3') or 'static_obstacle' in execs or 'dynamic_obstacle' in execs:
                zone = 'static' if (sec_id == 'M2' or 'static_obstacle' in execs) else 'dynamic'
                return True, zone
            return False, 'out_of_section'

        # 2. 폴백: CSV 인덱스 및 lane 기준
        if self.mission_zone == 'tunnel' and self.current_lane == 3:
            # Section loss during GPS shadow must not disable perception.
            # A fresh router message above is required to exit tunnel mode.
            return True, 'tunnel'
        idx = self.current_wp_idx
        if self.current_lane not in (-1, 0):
            return False, 'other_lane'
        if idx < 0:
            return False, 'no_idx'
        start_idx = min(self.section_start_idx, 2400)
        if not (start_idx <= idx <= self.section_end_idx):
            return False, 'out_of_section'
        zone = 'static' if idx < self.static_dynamic_split_idx else 'dynamic'
        return True, zone

    def publish_empty_markers(self):
        arr = MarkerArray()
        clear = Marker()
        clear.header.frame_id = "map"
        clear.header.stamp = rospy.Time.now()
        clear.action = Marker.DELETEALL
        arr.markers.append(clear)
        self.marker_pub.publish(arr)

    def publish_markers(self):
        in_section, zone = self._in_mission_section()

        # 구간 밖이면 마커를 완전히 소거하여 타 미션 시각화와 간섭 방지
        if not in_section:
            self.publish_empty_markers()
            return

        arr = MarkerArray()

        clear = Marker()
        clear.header.frame_id = "map"
        clear.action = Marker.DELETEALL
        arr.markers.append(clear)

        for track in self.tracks:
            # 아직 확정 안 된 트랙은 노이즈일 수 있어 흐리게만 표시한다.
            confirmed = getattr(track, 'confirmed', True)

            m = Marker()
            m.header.frame_id = "map"
            m.header.stamp = rospy.Time.now()
            m.ns = "obstacles"
            m.id = track.id
            m.type = Marker.CYLINDER
            m.action = Marker.ADD
            m.pose.position.x = float(track.position[0])
            m.pose.position.y = float(track.position[1])
            m.pose.position.z = 0.5
            m.pose.orientation.w = 1.0
            m.scale.x = max(track.width, track.length, 0.3)
            m.scale.y = max(track.width, track.length, 0.3)
            m.scale.z = 1.0
            # 트리거 코리도 밖(= 충돌 검사 전용)은 더 흐리게 그려서, 화면에서
            # "이건 회피를 시작시키는 물체가 아니다"가 바로 보이게 한다.
            # 이게 구분 안 되면 옆 차로 물체를 회피 대상으로 오해하게 된다.
            in_trig = bool(getattr(track, 'in_trigger_corridor', True))
            m.color.a = (0.75 if confirmed else 0.25) * (1.0 if in_trig else 0.4)
            if track.motion_state == 'dynamic':
                m.color.r, m.color.g, m.color.b = 1.0, 0.35, 0.0   # 주황: 동적
            elif track.motion_state == 'static':
                m.color.r, m.color.g, m.color.b = 0.1, 0.5, 1.0    # 파랑: 정적
            else:
                m.color.r, m.color.g, m.color.b = 0.55, 0.55, 0.55  # 회색: 미확정
            m.lifetime = rospy.Duration(0.3)
            arr.markers.append(m)

            # 동적 트랙은 속도 벡터를 화살표로 같이 보여준다 - 정적 오판을
            # 눈으로 잡아내려면 방향이 있어야 한다.
            if track.motion_state == 'dynamic' and track.speed > 0.1:
                vel = getattr(track, 'velocity', None)
                if vel is not None and len(vel) >= 2:
                    ar = Marker()
                    ar.header = m.header
                    ar.ns = "obstacle_velocity"
                    ar.id = track.id
                    ar.type = Marker.ARROW
                    ar.action = Marker.ADD
                    ar.scale.x = 0.12          # shaft
                    ar.scale.y = 0.25          # head
                    ar.scale.z = 0.25
                    ar.color.a = 0.9
                    ar.color.r, ar.color.g, ar.color.b = 1.0, 0.35, 0.0
                    p0 = Point(float(track.position[0]), float(track.position[1]), 1.0)
                    p1 = Point(p0.x + float(vel[0]), p0.y + float(vel[1]), 1.0)
                    ar.points = [p0, p1]
                    ar.lifetime = rospy.Duration(0.3)
                    arr.markers.append(ar)

            label = Marker()
            label.header = m.header
            label.ns = "obstacle_labels"
            label.id = track.id
            label.type = Marker.TEXT_VIEW_FACING
            label.action = Marker.ADD
            label.pose.position.x = m.pose.position.x
            label.pose.position.y = m.pose.position.y
            label.pose.position.z = 1.5
            label.scale.z = 0.45
            label.color.a = 1.0
            if track.motion_state == 'dynamic':
                label.color.r, label.color.g, label.color.b = 1.0, 0.6, 0.3
            elif track.motion_state == 'static':
                label.color.r, label.color.g, label.color.b = 0.5, 0.8, 1.0
            else:
                label.color.r = label.color.g = label.color.b = 0.8
            state_kr = {'dynamic': '동적', 'static': '정적'}.get(
                track.motion_state, '미확정')
            mark = '' if confirmed else '?'
            label.text = f"#{track.id}{mark} {state_kr} {track.speed:.1f}m/s"
            label.lifetime = rospy.Duration(0.3)
            arr.markers.append(label)

        # 지금 어느 구간을 보고 있는지 화면에 띄운다.
        banner = Marker()
        banner.header.frame_id = "map"
        banner.header.stamp = rospy.Time.now()
        banner.ns = "section_banner"
        banner.id = 0
        banner.type = Marker.TEXT_VIEW_FACING
        banner.action = Marker.ADD
        ex, ey = (self.latest_ego_pose[0], self.latest_ego_pose[1]) \
            if self.latest_ego_pose else (0.0, 0.0)
        banner.pose.position.x = ex
        banner.pose.position.y = ey
        banner.pose.position.z = 3.0
        banner.scale.z = 0.7
        banner.color.a = 0.9
        if zone == 'static':
            banner.color.r, banner.color.g, banner.color.b = 0.4, 0.8, 1.0
            zname = "정적 회피 구간"
        elif zone == 'dynamic':
            banner.color.r, banner.color.g, banner.color.b = 1.0, 0.6, 0.3
            zname = "동적 정지 구간"
        else:
            banner.color.r = banner.color.g = banner.color.b = 0.9
            zname = "구간필터 off"
        banner.text = f"[{zname}] idx={self.current_wp_idx}  트랙 {len(self.tracks)}개"
        banner.lifetime = rospy.Duration(0.5)
        arr.markers.append(banner)

        self.marker_pub.publish(arr)


if __name__ == '__main__':
    try:
        ObstaclePerceptionNode()
    except rospy.ROSInterruptException:
        pass
