cmake_minimum_required(VERSION 3.0.2)
project(mission_planner)

add_compile_options(-std=c++14 -Wall -Wextra -Wpedantic)

find_package(catkin REQUIRED COMPONENTS
  geometry_msgs
  mission_planner_msgs
  nav_msgs
  roscpp
  std_msgs
  tf2
  visualization_msgs
)

catkin_package(
  INCLUDE_DIRS include
  LIBRARIES mission_planner_core
  CATKIN_DEPENDS geometry_msgs mission_planner_msgs nav_msgs roscpp
                 std_msgs tf2 visualization_msgs
)

include_directories(
  include
  ${catkin_INCLUDE_DIRS}
)

add_library(mission_planner_core
  src/geometry.cpp
  src/gap_selector.cpp
  src/roundabout_mission.cpp
)
target_link_libraries(mission_planner_core ${catkin_LIBRARIES})

add_executable(roundabout_mission_node src/roundabout_mission_node.cpp)
add_dependencies(roundabout_mission_node ${catkin_EXPORTED_TARGETS})
target_link_libraries(roundabout_mission_node
  mission_planner_core
  ${catkin_LIBRARIES}
)

if(CATKIN_ENABLE_TESTING)
  find_package(rosbag REQUIRED)
  find_package(yaml-cpp REQUIRED)
  add_executable(replay_roundabout_bag test/replay_roundabout_bag.cpp)
  add_dependencies(replay_roundabout_bag ${catkin_EXPORTED_TARGETS})
  target_include_directories(replay_roundabout_bag PRIVATE ${rosbag_INCLUDE_DIRS})
  target_link_libraries(replay_roundabout_bag mission_planner_core ${rosbag_LIBRARIES} yaml-cpp)
  add_executable(replay_entry_snapshot test/replay_entry_snapshot.cpp)
  target_link_libraries(replay_entry_snapshot mission_planner_core)
  catkin_add_gtest(test_roundabout_mission test/test_roundabout_mission.cpp)
  if(TARGET test_roundabout_mission)
    target_link_libraries(test_roundabout_mission mission_planner_core)
  endif()
  catkin_add_gtest(test_gap_selector test/test_gap_selector.cpp)
  if(TARGET test_gap_selector)
    target_link_libraries(test_gap_selector mission_planner_core)
  endif()
endif()

install(TARGETS mission_planner_core roundabout_mission_node
  ARCHIVE DESTINATION ${CATKIN_PACKAGE_LIB_DESTINATION}
  LIBRARY DESTINATION ${CATKIN_PACKAGE_LIB_DESTINATION}
  RUNTIME DESTINATION ${CATKIN_PACKAGE_BIN_DESTINATION}
)
install(DIRECTORY include/${PROJECT_NAME}/
  DESTINATION ${CATKIN_PACKAGE_INCLUDE_DESTINATION}
)
install(DIRECTORY config launch rviz
  DESTINATION ${CATKIN_PACKAGE_SHARE_DESTINATION}
)
