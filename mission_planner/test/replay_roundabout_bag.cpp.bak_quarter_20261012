int main(int argc, char** argv) {
  if (argc < 3) { std::cerr << "usage: replay_roundabout_bag BAG SITE_YAML [--sensor-bag HEAVY_BAG] [--route CSV] [--velocity-hold] [--diagnostics]\n"; return 1; }
  bool simulate_ego=false;
  bool velocity_hold = false, diagnostics = false;std::string tracks_file, route_file, sensor_file;
  for (int i = 3; i < argc; ++i) {
    const std::string option(argv[i]);
    if(option=="--sensor-bag"&&i+1<argc)sensor_file=argv[++i];
    else if(option=="--tracks"&&i+1<argc)tracks_file=argv[++i];
    else if(option=="--route"&&i+1<argc)route_file=argv[++i];
    else if(option=="--simulate-ego")simulate_ego=true;
    else if (option == "--velocity-hold") velocity_hold = true;
    else if (option == "--diagnostics") diagnostics = true;
    else { std::cerr << "unknown option " << option << '\n'; return 1; }
  }
  ros::Time::init();
  const auto site = YAML::LoadFile(argv[2]);
  auto config = loadConfig(site);
  ObservationTransform observation_tf;double observation_resolution=.5,observation_height=1.765;
  if(site["lidar_tracker"] && site["lidar_tracker"]["sensor_extrinsic"]) {
    const auto ex=site["lidar_tracker"]["sensor_extrinsic"];
    read(ex,"x",observation_tf.sensor_x);read(ex,"y",observation_tf.sensor_y);read(ex,"z",observation_tf.sensor_z);
    double yaw=0;read(ex,"yaw_deg",yaw);observation_tf.sensor_yaw=yaw*M_PI/180;
  }
  if(site["roundabout"]["observation"]) {
    const auto o=site["roundabout"]["observation"];read(o,"resolution_m",observation_resolution);
    read(o,"ground_height_below_sensor_m",observation_height);
  }
  std::deque<std::pair<double,ObservationTransform>> observation_poses;
  std::deque<sensor_msgs::PointCloud2::ConstPtr> raw_scans,ng_scans;
  double observation_ms=0.;size_t observation_count=0;
  RoundaboutMission mission(config);
  RoundaboutInput input;
  std::vector<Point2> reference_route;
  if (!route_file.empty()) {
    std::ifstream file(route_file);std::string row;
    if(!file)throw std::runtime_error("Cannot read offline reference route");
    while(std::getline(file,row)) {
      std::istringstream line(row);std::string index,x,y;
      if(std::getline(line,index,',')&&std::getline(line,x,',')&&std::getline(line,y,','))
        reference_route.push_back({std::stod(x),std::stod(y)});
    }
    if(reference_route.size()<2)throw std::runtime_error("Offline reference route too short");
    input.route=reference_route;
  }
  input.prediction_accel_limit = 2.2; // Recorded MPC ramp; no controller runs here.
  input.prediction_speed_limit = config.circulation_speed;
  double recorded_mission_speed=config.circulation_speed;
  input.localization_valid = true;
  double last_tracker = -1.0, last_odom = -1.0;
  bool tracker_valid = false;
  double first_old = -1.0, first_new = -1.0;
  int old_roi_leads = 0, new_roi_leads = 0, previous = -1, aborted = 0;
  int preparation_frames=0,candidate_frames=0,approved_stop_frames=0;
  std::map<std::string,int> rejection_counts;
  double min_confidence = 0.4;
  if (site["tracked_objects"]) read(site["tracked_objects"], "min_confidence", min_confidence);
  std::map<int, TrackedObject> objects;
  std::map<int, double> last_valid_velocity;
  double last_diagnostic = -1.0;
  std::vector<double> decision_ms;
  bool sim_ready=false;double sim_s=0.0,sim_v=0.0,sim_last=-1.0,sim_brake_since=-1.0;
  double sim_min_separation=1e9,sim_front_separation=1e9,sim_clear=-1.0;
  std::vector<Point2> sim_path;std::vector<double> sim_arc;
  auto set_sim_pose=[&]() {
    auto it=std::upper_bound(sim_arc.begin(),sim_arc.end(),sim_s);
    const size_t i=std::min(sim_path.size()-1,std::max<size_t>(1,it-sim_arc.begin()));
    const double f=std::max(0.0,std::min(1.0,(sim_s-sim_arc[i-1])/std::max(1e-6,sim_arc[i]-sim_arc[i-1])));
    input.ego.position={sim_path[i-1].x+f*(sim_path[i].x-sim_path[i-1].x),sim_path[i-1].y+f*(sim_path[i].y-sim_path[i-1].y)};
    input.ego.yaw=std::atan2(sim_path[i].y-sim_path[i-1].y,sim_path[i].x-sim_path[i-1].x);input.ego.speed=sim_v;
  };

  rosbag::Bag bag(argv[1], rosbag::bagmode::Read);
  std::vector<std::string> topics{
    "/odom", "/local_path", "/localization/valid", "/perception/roundabout/tracked_objects",
    "/mission/roundabout/state", "/mission/constraints/roundabout", "/mission/roundabout/gap_markers",
    "/control_feedback/curvature_capacity_speed_mps", "/control_feedback/mission_speed_target_mps"};
  if(!tracks_file.empty())topics.erase(std::remove(topics.begin(),topics.end(),"/perception/roundabout/tracked_objects"),topics.end());
  if(sensor_file.empty() && config.gs_observed_entry_enabled) {
    topics.push_back("/perception/points_gravity");topics.push_back("/nonground");
  }
  rosbag::View view(bag, rosbag::TopicQuery(topics));
  std::unique_ptr<rosbag::Bag> sensor_bag;
  if(!sensor_file.empty()) {
    sensor_bag.reset(new rosbag::Bag(sensor_file,rosbag::bagmode::Read));
    view.addQuery(*sensor_bag,rosbag::TopicQuery(std::vector<std::string>{"/perception/points_gravity","/nonground"}));
  }
  std::unique_ptr<rosbag::Bag> replay_tracks;
  if(!tracks_file.empty()){replay_tracks.reset(new rosbag::Bag(tracks_file,rosbag::bagmode::Read));view.addQuery(*replay_tracks,rosbag::TopicQuery(std::vector<std::string>{"/replay/tracked_objects"}));}
  const double start = view.getBeginTime().toSec();
  auto inRoi = [&](const TrackedObject& o) {
    const double radius = std::hypot(o.position.x - config.center.x, o.position.y - config.center.y);
    return (config.vehicle_roi_inner_radius < 0.0 || radius >= config.vehicle_roi_inner_radius) &&
           (config.vehicle_roi_outer_radius < 0.0 || radius <= config.vehicle_roi_outer_radius);
  };
  for (const auto& message : view) {
    if (auto m = message.instantiate<nav_msgs::Odometry>()) {
      if (!sim_ready) {input.ego.position = {m->pose.pose.position.x, m->pose.pose.position.y};
      const auto q = m->pose.pose.orientation;
      input.ego.yaw = std::atan2(2.0 * (q.w * q.z + q.x * q.y), 1.0 - 2.0 * (q.y*q.y + q.z*q.z));
      input.ego.speed = std::hypot(m->twist.twist.linear.x, m->twist.twist.linear.y);
      }
      last_odom = message.getTime().toSec();
      auto pose=observation_tf;pose.x=m->pose.pose.position.x;pose.y=m->pose.pose.position.y;
      pose.z=m->pose.pose.position.z;
      const auto oq=m->pose.pose.orientation;
      pose.yaw=std::atan2(2*(oq.w*oq.z+oq.x*oq.y),1-2*(oq.y*oq.y+oq.z*oq.z));
      observation_poses.push_back({m->header.stamp.isZero()?last_odom:m->header.stamp.toSec(),pose});
      while(observation_poses.size()>60)observation_poses.pop_front();
    } else if (auto m = message.instantiate<sensor_msgs::PointCloud2>()) {
      auto& queue=message.getTopic()=="/perception/points_gravity"?raw_scans:ng_scans;
      queue.push_back(m);while(queue.size()>4)queue.pop_front();
      if(!config.gs_observed_entry_enabled || observation_poses.empty())continue;
      for(const auto& raw:raw_scans) {
        const double stamp=raw->header.stamp.toSec();
        if(stamp<=0 || raw->header.frame_id!="velodyne_ground" ||
            (!input.observation.frames.empty() && stamp<=input.observation.frames.back()->stamp) ||
            std::abs(message.getTime().toSec()-stamp)>config.gs_observation_timeout)continue;
        sensor_msgs::PointCloud2::ConstPtr ng;double best=.031;
        for(const auto& cloud:ng_scans) {
          const double dt=std::abs(cloud->header.stamp.toSec()-stamp);
          if(cloud->header.frame_id=="velodyne_ground" && dt<best){ng=cloud;best=dt;}
        }
        if(!ng)continue;
        const auto pose=std::min_element(observation_poses.begin(),observation_poses.end(),
            [stamp](const auto& a,const auto& b){return std::abs(a.first-stamp)<std::abs(b.first-stamp);});
        if(std::abs(pose->first-stamp)>.15 || std::hypot(pose->second.x-config.center.x,pose->second.y-config.center.y)>80.)continue;
        std::vector<ObservationPoint> rays,occupied;
        if(!observationPoints(*raw,pose->second,&rays) || !observationPoints(*ng,pose->second,&occupied) || rays.size()<100)continue;
        const auto origin=pose->second.origin();const auto clock=std::chrono::steady_clock::now();
        input.observation.add(buildRoundaboutObservation(config.center.x,config.center.y,config.outer_radius+(config.gs_preparation_enabled?config.gs_entry_commit_distance+5.:3.),
            observation_resolution,stamp,origin,origin.z-observation_height,rays,occupied));
        observation_ms+=std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-clock).count();++observation_count;
      }
    } else if (auto m = message.instantiate<nav_msgs::Path>()) {
      if (!sim_ready && reference_route.empty()) {input.route.clear();
      for (const auto& pose : m->poses) input.route.push_back({pose.pose.position.x, pose.pose.position.y});}
    } else if (auto m = message.instantiate<std_msgs::Bool>()) {
      input.localization_valid = m->data;
    } else if (auto m = message.instantiate<std_msgs::Float64>()) {
      if(message.getTopic()=="/control_feedback/mission_speed_target_mps")recorded_mission_speed=m->data;
      else input.prediction_speed_limit = m->data;
    } else if (auto m = message.instantiate<mission_planner_msgs::TrackedObjectArray>()) {
      input.objects.clear(); objects.clear();
      for (const auto& o : m->objects) {
        if (o.confidence < min_confidence) continue;
        TrackedObject track;
        track.id = o.id; track.position = {o.position.x, o.position.y};
        track.velocity_x = o.velocity.x; track.velocity_y = o.velocity.y;
        track.length = std::max(0.1, std::max(o.size.x, o.size.y));
        track.aabb_x=o.size.x;track.aabb_y=o.size.y;
        track.height=o.size.z;track.width=std::min(o.size.x,o.size.y);track.confidence=o.confidence;
        track.has_moved = o.has_moved; track.velocity_valid = o.velocity_valid;
        const double stamp = m->header.stamp.toSec();
        if (o.velocity_valid) last_valid_velocity[o.id] = stamp;
        // Approximation only: old bags lack the tracker's last real-evidence
        // timestamp. Never change the recorded position or stored velocity.
        if (velocity_hold && o.has_moved && last_valid_velocity.count(o.id) &&
            stamp - last_valid_velocity.at(o.id) <= 0.6)
          track.velocity_valid = true;
        track.confirmed = o.has_moved && track.velocity_valid; track.hit_count = o.hit_count;
        input.objects.push_back(track); objects[track.id] = track;
      }
      last_tracker = message.getTime().toSec();
      input.objects_stamp = m->header.stamp.toSec(); tracker_valid = m->valid;
    } else if (auto m = message.instantiate<mission_planner_msgs::BehaviorConstraint>()) {
      if (m->lead_vehicle_active && objects.count(m->lead_vehicle_id) &&
          !inRoi(objects.at(m->lead_vehicle_id))) ++old_roi_leads;
    } else if (auto m = message.instantiate<mission_planner_msgs::MissionState>()) {
      input.now = message.getTime().toSec();
      input.ego.valid = last_odom >= 0.0 && input.now - last_odom <= 0.4;
      input.tracker_stream_fresh = last_tracker >= 0.0 && input.now - last_tracker <= 0.5;
      input.tracker_stream_valid = tracker_valid && input.tracker_stream_fresh;
      const auto decision_start=std::chrono::steady_clock::now();
      const auto out = mission.update(input);
      if(out.entry_phase=="preparing")++preparation_frames;
      if(out.acceleration_start_delay>=0 && !out.approval_latched)++candidate_frames;
      if(out.approval_latched && out.constraint.stop_required)++approved_stop_frames;
      for(const auto& gap:out.gaps)if(gap.selected && !out.approval_latched && !gap.feasible)
        ++rejection_counts[gap.failure_reason.substr(0,gap.failure_reason.find('@'))];
      const int state = static_cast<int>(out.state);
      if(state==2 || state==3)decision_ms.push_back(std::chrono::duration<double,std::milli>(std::chrono::steady_clock::now()-decision_start).count());
      if (m->state == 3 && first_old < 0.0) first_old = input.now - start;
      if (state == 3 && first_new < 0.0) first_new = input.now - start;
      if (out.constraint.lead_vehicle_active && objects.count(out.constraint.lead_vehicle_id) &&
          !inRoi(objects.at(out.constraint.lead_vehicle_id))) ++new_roi_leads;
      if(simulate_ego && !sim_ready && input.route.size()>=2 &&
          (config.gs_spatial_gap_enabled
              ? ((state==1||state==2) && out.distance_to_yield<=config.activation_distance)
              : (state==2 && input.ego.speed<.1 && out.distance_to_yield<1))) {
        sim_path=input.route;sim_arc.assign(sim_path.size(),0.0);
        for(size_t i=1;i<sim_path.size();++i)sim_arc[i]=sim_arc[i-1]+distance(sim_path[i-1],sim_path[i]);
        sim_s=projectToPolyline(sim_path,input.ego.position).s;sim_v=input.ego.speed;sim_last=input.now;sim_ready=true;
      }
      if(sim_ready) {
        if(state==5 && sim_clear<0)sim_clear=input.now-start;
        double cap=out.constraint.max_speed<0?recorded_mission_speed:out.constraint.max_speed;
        if(input.prediction_speed_limit>0)cap=std::min(cap,input.prediction_speed_limit);
        if(out.constraint.stop_required)cap=std::min(cap,std::sqrt(4*std::max(0.0,out.constraint.stop_distance)));
        if(out.constraint.lead_vehicle_active) {
          const double usable=std::max(0.0,out.constraint.lead_distance-config.gs_prediction_follow_standstill_gap);
          const double headway=std::max(.1,config.gs_prediction_follow_time_gap);
          cap=std::min(cap,std::max(0.0,out.constraint.lead_speed+(usable-headway*sim_v)/headway));
        }
        if(cap<sim_v && sim_brake_since<0)sim_brake_since=input.now;
        if(cap>=sim_v)sim_brake_since=-1.0;
        const double dt=std::max(0.0,std::min(.1,input.now-sim_last));
        const bool delay=(first_new>=0 && input.now-start-first_new<config.gs_ego_start_delay) ||
          (sim_brake_since>=0 && input.now-sim_brake_since<.3);
        const double next=delay?sim_v:(sim_v<cap?std::min(cap,sim_v+3.2*dt):std::max(cap,sim_v-2*dt));
        sim_s=std::min(sim_arc.back(),sim_s+.5*(sim_v+next)*dt);sim_v=next;sim_last=input.now;set_sim_pose();
        if(first_new>=0)for(const auto& o:input.objects) {
          if(!o.has_moved || distance(input.ego.position,o.position)>15)continue;
          const bool world=o.aabb_x>0 && o.aabb_y>0;
          const double yaw=world?0.0:std::atan2(o.velocity_y,o.velocity_x);
          const double separation=boxSeparation(input.ego.position,input.ego.yaw,
              config.gs_ego_length,config.gs_ego_width,o.position,yaw,
              world?o.aabb_x:std::max(4.0,o.length),world?o.aabb_y:std::max(1.9,o.width));
          if(separation<sim_min_separation) {
            sim_min_separation=separation;
            if(diagnostics)std::cout<<"SIM_MIN t="<<input.now-start<<" id="<<o.id<<" sep="<<separation<<" ego_v="<<sim_v<<" npc_v="<<std::hypot(o.velocity_x,o.velocity_y)<<" size="<<o.length<<","<<o.width<<" radial="<<radiusFrom(config.center,o.position)<<" state="<<state<<'\n';
          }
          const double forward=(config.counter_clockwise?1.0:-1.0)*normalizeAngle(angleFrom(config.center,o.position)-angleFrom(config.center,input.ego.position))*config.nominal_radius;
          if(forward>=0 && separation<sim_front_separation) {
            sim_front_separation=separation;
            if(diagnostics)std::cout<<"SIM_FRONT t="<<input.now-start<<" id="<<o.id<<" sep="<<separation<<" ahead="<<forward<<" state="<<state<<'\n';
          }
        }
      }
      if (state != previous) {
        if (previous == 3 && state == 2) ++aborted;
        std::cout << input.now - start << " state=" << state << ' ' << out.reason << '\n';
        previous = state;
      }
      if (diagnostics && (state == 2 || state == 3) && input.now - last_diagnostic >= 0.2) {
        std::cout << input.now - start << " wait=" << out.gap_depart_delay << " cap="
                  << out.ego_prediction_speed << " " << out.reason
                  << " future_departure="<<out.future_departure<<" switch="<<out.gap_switch_reason
                  << " duplicates="<<out.duplicate_track_ids.size()
                  << " physical_gap="<<out.physical_gap_length<<" phase="<<out.entry_phase<<" trajectory_observation="<<out.trajectory_observation<<" creep="<<out.preparation_speed<<" boundary="<<out.preparation_stop_distance
                  << " observed_free="<<out.observed_free_length<<" observation="<<out.observation_state<<" fixed="<<out.approval_latched
                  << " command_cap="<<out.constraint.max_speed
                  << " predicted_entry="<<out.ego_zone_time<<" predicted_reference="<<out.ego_reference_time<<" predicted_clear="<<out.ego_clear_time
                  << " delay="<<out.ego_delay_remaining<<" leader_limited="<<out.ego_leader_limited<<" curve_limited="<<out.ego_curve_limited;
        for(const auto& gap:out.gaps)if(gap.selected)
          std::cout<<" candidate="<<(gap.preview?"PREVIEW":(gap.feasible?"CONFIRM":"BLOCKED"));
        for (const auto& vehicle : out.stream)
          std::cout << " [" << vehicle.id << " p=" << vehicle.pos << " v=" << vehicle.speed
                    << " confirmed=" << vehicle.confirmed << ']';
        std::cout << '\n';
        last_diagnostic = input.now;
      }
    }
  }
  std::cout << "first_commit recorded=" << first_old << " replay=" << first_new
            << " ROI_rejected_lead_frames recorded=" << old_roi_leads << " replay=" << new_roi_leads
            << " replay_aborts=" << aborted << '\n';
  std::cout<<"preparation_frames="<<preparation_frames<<" candidate_frames="<<candidate_frames
           <<" approved_stop_frames="<<approved_stop_frames<<'\n';
  for(const auto& reason:rejection_counts)std::cout<<"rejected "<<reason.first<<" frames="<<reason.second<<'\n';
  if(!decision_ms.empty()) {
    std::sort(decision_ms.begin(),decision_ms.end());
    const auto quantile=[&](double q){return decision_ms[static_cast<size_t>(q*(decision_ms.size()-1))];};
    std::cout<<"decision_ms frames="<<decision_ms.size()<<" p50="<<quantile(.5)<<" p95="<<quantile(.95)<<" p99="<<quantile(.99)<<" max="<<decision_ms.back()<<'\n';
  }
  if(simulate_ego)std::cout<<"sim_exit="<<sim_clear<<" sim_observed_box_min_sep="<<sim_min_separation<<" sim_front_box_min_sep="<<sim_front_separation<<" Assumed ego acceleration3.2/decel2/response0.3; raw world AABB proxies; recorded mission/curvature limits; NPCs follow recorded trajectories; not MORAI closed loop.\n";
  if(!simulate_ego)std::cout << "Fixed recorded trajectories; does not reproduce changed ego motion or NPC reactions.\n";
  if(!tracks_file.empty())std::cout<<"Uses raw-cloud replay tracks, recorded ego trajectory unchanged.\n";
  if (velocity_hold) std::cout << "Velocity-valid hold approximated from old validity flags, not raw LiDAR replay.\n";
  std::cout<<"observation_frames="<<observation_count<<" mean_observation_ms="<<(observation_count?observation_ms/observation_count:0)<<"\n";
  return 0;
}
