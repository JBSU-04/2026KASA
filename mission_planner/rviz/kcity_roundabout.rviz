Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Background Color: 32; 32; 32
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
      Cell Size: 2
      Plane Cell Count: 40
      Color: 90; 90; 90
    - Class: rviz/MarkerArray
      Name: KCityMap
      Enabled: true
      Marker Topic: /localization/map_markers
      Queue Size: 10
    - Class: rviz/Path
      Name: LocalPath
      Enabled: true
      Topic: /local_path
      Queue Size: 5
      Line Style: Lines
      Line Width: 0.25
      Color: 0; 200; 255
      Pose Style: None
    - Class: rviz/PointCloud2
      Name: LidarContours_TrackerAligned
      Enabled: true
      Topic: /perception/roundabout/aligned_cloud
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Size (m): 0.02
      Alpha: 0.55
      Color Transformer: Intensity
      Channel Name: intensity
      Autocompute Intensity Bounds: true
      Use rainbow: true
      Invert Rainbow: false
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
      # 트래커와 같은 odom+센서 외부 파라미터로 map 변환된 한 스캔만 표시한다.
      Decay Time: 0
    - Class: rviz/PointCloud2
      Name: VehicleCandidateCloud
      Enabled: true
      Topic: /perception/roundabout/vehicle_cloud
      Queue Size: 5
      Style: Flat Squares
      Size (m): 0.12
      Alpha: 1
      Color Transformer: FlatColor
      Color: 255; 0; 220
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
      Decay Time: 0.25
    - Class: rviz/PointCloud2
      Name: FullRingROI_Debug
      Enabled: false
      Topic: /perception/roundabout/roi_cloud
      Queue Size: 5
      Style: Points
      Size (Pixels): 2
      Alpha: 0.35
      Color Transformer: FlatColor
      Color: 255; 80; 80
      Position Transformer: XYZ
      Selectable: true
      Use Fixed Frame: true
      Decay Time: 0.15
    - Class: rviz/MarkerArray
      Name: VehicleTracks
      Enabled: true
      Marker Topic: /perception/roundabout/tracker_markers
      Queue Size: 10
    - Class: rviz/MarkerArray
      Name: VehicleROI
      Enabled: true
      Marker Topic: /perception/roundabout/roi_markers
      Queue Size: 10
    - Class: rviz/MarkerArray
      Name: MissionGeometryState
      Enabled: true
      Marker Topic: /mission/roundabout/markers
      Queue Size: 10
    - Class: rviz/MarkerArray
      Name: GapSelect
      Enabled: true
      Marker Topic: /mission/roundabout/gap_markers
      Queue Size: 10
    - Class: rviz/Marker
      Name: Ego
      Enabled: true
      Marker Topic: /localization/ego_marker
      Queue Size: 5
    - Class: rviz/TF
      Name: TF
      Enabled: false
  Tools:
    - Class: rviz/Interact
    - Class: rviz/MoveCamera
    - Class: rviz/Select
    - Class: rviz/FocusCamera
    - Class: rviz/Measure
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
    - Class: rviz/PublishPoint
      Topic: /clicked_point
      Single click: true
  Views:
    Current:
      Class: rviz/Orbit
      Name: Ego Top View
      Target Frame: Ego
      Distance: 48
      Pitch: 1.05
      Yaw: 3.14
      Focal Point:
        X: 0
        Y: 0
        Z: 0
      Near Clip Distance: 0.01
      Field of View: 0.785398
