namespace mission_planner {

struct Point2 {
  double x = 0.0;
  double y = 0.0;
};

struct EgoState {
  Point2 position;
  double yaw = 0.0;
  double speed = 0.0;
  bool valid = false;
};

struct TrackedObject {
  int id = -1;
  Point2 position;
  double velocity_x = 0.0;
  double velocity_y = 0.0;
  double length = 4.5;
  bool velocity_valid = false;
  bool has_moved = false;
  // false = 속도/이동 확인 전 트랙(gap_select 의 미확정 뒤차 처리용).
  //   기존 판단(evaluateGap)과 순환 앞차 탐색은 이런 트랙을 쓰지 않는다.
  bool confirmed = true;
  int hit_count = 0;
  double height = 1.5, width = 1.8, confidence = 1.0;
  double aabb_x = 0.0, aabb_y = 0.0; // Original world-axis bounds; never rotate them as an OBB.
  int collision_parent_id = -1; // Duplicate fragment: keep geometry, not a second gap vehicle.
};

enum class RoundaboutState : std::uint8_t {
  kIdle = 0,
  kApproach = 1,
  kYield = 2,
  kCommit = 3,
  kCirculate = 4,
  kExit = 5,
  kFailsafe = 6,
};

