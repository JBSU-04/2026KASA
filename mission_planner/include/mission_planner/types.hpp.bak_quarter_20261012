  // 앞차 대기/진입 중단 정지점은 원형 차로 판정 반경(outer_radius + 이 값) 밖에 둔다 [m]
  double gs_circle_stop_margin = 0.5;
  double gs_confirm_seconds = 0.1;    // 출발 판단 연속 유지 [s]
  // ★ 거리 기준 진입(2026-10-02, roundabout_mission.cpp evaluateZoneRule 주석).
  //   차량별 순간 속도로 미래를 예측하지 않고, 지금 위치와 흐름 속도 하나로 판단한다.
  bool gs_zone_rule_enabled = false;   // false = 기존 순차 예측 로직
  double gs_zone_front_gap = 2.5;      // 합류 시 앞차와 남길 범퍼 간격 [m]
  double gs_zone_rear_gap = 3.0;       // 합류 시 뒤차와 남길 범퍼 간격 [m]
  double gs_zone_front_time = 0.75;    // 앞차가 정지 유지선을 벗어난 뒤 자차 도착까지 여유 [s]
  double gs_zone_vehicle_length = 4.6; // 순환 차량 길이 기본값: 차량별 추정이 불가능할 때만 쓴다 [m]
  // ★ 차량별 길이(2026-10-02). NPC 차종은 주행마다 랜덤이라(관측 4.0~7.0 m) 고정값을 쓰지 않는다.
  //   프레임별 관측 길이는 보이는 면에 따라 1.9~6.8 m 로 흔들리므로 차량 id별 창 안의
  //   백분위수를 쓰고, 표본이 부족한 차는 스트림 prior(중앙값)와 비교해 큰 쪽을 쓴다.
  bool gs_zone_length_estimate = false;   // false = 모든 차량에 gs_zone_vehicle_length
  double gs_zone_length_percentile = 0.8; // 0~1. 최대값은 병합 클러스터에, 중앙값은 부분 관측에 끌려간다
  double gs_zone_length_window = 8.0;     // 길이 표본 보관 시간 [s]
  int gs_zone_length_min_samples = 10;    // 이 이상이면 자기 추정을 신뢰한다
  double gs_zone_length_max = 7.5;        // 합쳐진 클러스터 방어 상한 [m]
  double gs_zone_length_prior_memory = 60.0; // 지나간 차량의 길이 추정을 prior 로 기억하는 시간 [s]
  // ★ 대기 완화(2026-10-02). YIELD 대기가 start 를 넘기면 초당 rate [m] 만큼 앞/뒤 간격을
  //   줄인다(뒤 간격을 먼저, 하한 floor). rate = 0 이면 끈다.
  double gs_zone_relax_start = 5.0;       // [s]
  // 2026-10-05(20:38 백): true 면 완화 시간을 YIELD 진입이 아니라 의무 정지 완료부터 잰다
  //   (정지 직후 처음 보는 틈부터 같은 기준이 줄어들게). 의무 정지가 없으면 기존(YIELD 진입) 기준.
  bool gs_zone_relax_from_stop = false;
  double gs_zone_relax_rate = 0.0;        // [m/s]
  double gs_zone_rear_gap_floor = 1.0;    // 뒤 간격 하한 [m]
  double gs_zone_front_gap_floor = 2.0;   // 앞 간격 하한(시간 항 포함 전체) [m]
  // ★ 상호 대기 해소(2026-10-02). 자차가 기다리는 동안 계속 서 있던 순환 차량은 양보 중으로 보고
  //   하드 차단에서 뺀다. 진입 중 속도가 abort_speed 를 넘으면 침범으로 본다.
  bool gs_stationary_yield_enabled = false;
  double gs_stationary_yield_start = 8.0;       // YIELD 대기 시간 하한 [s]
  double gs_stationary_yield_confirm = 3.0;     // 그 차가 계속 서 있던 시간 [s]
  double gs_stationary_yield_min_distance = 8.0; // 합류점 상류 거리 하한(차체 앞끝 기준) [m]
  double gs_stationary_yield_abort_speed = 1.5; // 해제된 차가 이 속도를 넘으면 침범 [m/s]
  double gs_zone_confirm_seconds = 0.2;   // 출발 판단 연속 유지 [s]
  // 2026-10-05(20:02 백): 확인을 '같은 앞/뒤 차 쌍이 연속으로 가능한 시간'으로 재서, 앞차가 앞 경계를
  //   지나는 순간 바로 출발한다(출발 창 (간격-W)/v 가 0.2~0.3 s 인 틈도 놓치지 않게).
  bool gs_zone_preconfirm = true;
  // 확인을 마친 쌍은 간격 부족이 이 값 이내면 계속 가능(트랙 위치 튐 대비). 완화 하한을 넘지 않게 잘린다.
  double gs_zone_pair_tolerance = 0.8;
  double gs_zone_commit_tolerance = 1.5;  // COMMIT 중 구간 침범 허용(위치 오차/자차 모델 오차) [m]
  double gs_stream_speed_min_travel = 15.0; // 이만큼 이동한 차량만 흐름 속도 표본 [m]
  double gs_stream_speed_memory = 30.0;     // 지나간 차량의 표본을 기억하는 시간 [s]
  int gs_velocity_hold_min_hits = 20;  // 이동 확인 + 이 이상 추적된 차는 속도 무효여도 차단하지 않음
  // 추적 위치 편차 보정표: [호 위치, 편차, 호 위치, 편차, ...] (호 위치 오름차순).
  // 편차 = 추적 위치 - 실제 차 중심. 비우면 보정하지 않는다.
  std::vector<double> gs_zone_position_bias;
  double gs_switch_margin = 0.5;      // 고른 틈을 바꾸는 최소 이득 [s]
  // 가림 대비: 상류 관측 끝에 보이지 않는 차량을 가정(기본 끔).
  bool gs_phantom_enabled = false;
  double gs_phantom_arc = 22.0;       // 상류 관측 한계 호 거리 [m]
  double gs_phantom_speed = 5.0;      // 가정 차량 속도 [m/s]
  // ★ 미확정 상류 트랙을 뒤차로 넣는다(2026-09-29, 12:50 백: -22.8 m 에서 막
  //   생긴 트랙이 속도 미확정이라 빠졌고, 그 차와 0.54 s 간격으로 합류했다).
  //   hit_count <= unconfirmed_max_hits 인 '갓 생긴' 트랙만(오래 안 움직이면 시설물).
  //   속도는 max(측정, unconfirmed_speed).
  bool gs_unconfirmed_enabled = true;
  double gs_unconfirmed_range = 40.0;   // 상류 호 거리 [m]
  double gs_unconfirmed_speed = 5.0;    // 가정 속도 하한 [m/s]
  int gs_unconfirmed_max_hits = 45;     // 이보다 오래된 미확정 트랙은 무시(15 Hz ~3 s)
  // ★ COMMIT 중 들어가던 틈이 무너지면(늦게 잡힌 뒤차 등) 링 앞에서 편하게
  //   설 수 있을 때 다시 양보한다. 서는 위치 = 합류 구역 앞 abort_margin.
  bool gs_commit_abort_enabled = true;
  double gs_commit_abort_confirm = 0.2; // 무너짐 연속 유지 [s]
  double gs_abort_margin = 0.5;         // 합류 구역 앞 여유 [m]
  double gs_viz_range = 35.0;           // 틈 시각화 범위(합류점 기준 +-) [m]
  // 합류점/출구 자동 판정. 경로(route)와 원형 차로에서 구한다.
  bool auto_conflict_point = false;   // 경로가 nominal+margin 반경 안으로 처음 들어가는 점
  double auto_conflict_radius_margin = 1.0;
  bool auto_exit = false;             // 순환 중 반경이 outer+margin 을 넘으면 EXIT
  double auto_exit_radius_margin = 0.5;
};

