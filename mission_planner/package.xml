<?xml version="1.0"?>
<package format="2">
  <name>mission_planner</name>
  <version>0.1.0</version>
  <description>Portable roundabout mission decision logic for ROS 1 vehicles.</description>

  <maintainer email="kuuve@todo.todo">kuuve</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>mission_planner_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>
  <depend>tf2</depend>
  <depend>visualization_msgs</depend>

  <exec_depend>mission_manager</exec_depend>
  <exec_depend>roundabout_lidar_tracker</exec_depend>

  <test_depend>rostest</test_depend>
  <test_depend>rosbag</test_depend>
  <test_depend>yaml-cpp</test_depend>

  <export />
</package>
