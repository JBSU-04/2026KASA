constexpr std::uint8_t kSpeedPriority = 50;
constexpr std::uint8_t kYieldPriority = 100;
constexpr std::uint8_t kEmergencyPriority = 200;
constexpr double kMinimumApproachSpeed = 0.5;

double clampNonnegative(double value) { return std::max(0.0, value); }


// ★ 거리 기준 진입 판단(2026-10-02).
//   순환 차량은 한 주행 안에서 모두 같은 속도로 등속 주행한다(값은 주행마다 다름).
//   그런데 트래커는 LiDAR 에 '보이는 점들의 중심'을 위치로 써서, 차가 원을 돌며 보이는
//   면이 바뀌면 기준점이 차체 위에서 +-2 m 미끄러진다. 그 미끄러짐이 속도에 더해져
//   실제 5.56 m/s 인 차량이 3.5~7.2 m/s 로 보고됐다(01:10 백). 순차 예측 로직은 그 순간
//   속도로 '앞차가 빠져나가는 시각'과 뒤 여유를 계산하는데, 출발 시점이 정확히 앞차가
//   느리게 보이는 구간(-12 m 안쪽)이라 매 주기 예측이 무너져 27 초 동안 못 들어갔다.
//
//   여기서는 차량별 속도를 쓰지 않는다. 지금 위치와 흐름 속도 v 하나로 판단한다.
//     1) 틈 검사: 연속한 두 차의 중심 간 거리 >= W
//          W = 자차 길이 + 차량 길이 + 앞 간격 + 뒤 간격   (속도와 무관)
//     2) 출발: 그 틈의 앞차가 합류점 상류 D_lead 를 지나면 출발
//          D_lead = v * t_zone + entry_zone - 앞 간격 - 차량 반길이
//          t_zone = 자차 앞끝이 합류 구역(합류점 - entry_zone)에 닿는 시간
//        그 순간 뒤차는 D_rear = D_lead + W 보다 멀다.
//   둘을 합치면 "합류점 상류 [D_lead, D_rear] 에 차가 없으면 출발"이다. 속도는 이
//   구간의 위치만 옮기므로 v 가 10 % 틀려도 약 1.4 m 움직일 뿐이다.
// 추적 위치 편차 보정(표의 선형 보간). 표: [위치, 편차, 위치, 편차, ...].
double zoneBiasAt(const std::vector<double>& table, double pos) {
  const size_t n = table.size() / 2;
  if (n == 0) return 0.0;
  if (pos <= table[0]) return table[1];
  for (size_t i = 1; i < n; ++i) {
    const double x0 = table[2 * (i - 1)], x1 = table[2 * i];
    if (pos <= x1) {
      const double r = x1 > x0 ? (pos - x0) / (x1 - x0) : 0.0;
      return table[2 * (i - 1) + 1] + r * (table[2 * i + 1] - table[2 * (i - 1) + 1]);
    }
  }
  return table[2 * (n - 1) + 1];
}

struct ZoneRuleInput {
  double stream_speed = 5.0;
  double t_zone = 0.0;
  double entry_zone = 1.0;
  double ego_length = 4.6;
  double vehicle_length = 4.6;
  double front_gap = 2.5;
  double rear_gap = 3.0;
  bool locked = false;          // COMMIT: 고른 차량 쌍을 유지
  int locked_leader = -1;
  int locked_follower = -1;
  double commit_tolerance = 1.5;
};

SequentialResult evaluateZoneRule(const std::vector<StreamVehicle>& stream,
                                  const ZoneRuleInput& z, double* d_lead_out,
                                  double* d_rear_out) {
  SequentialResult out;
  const double v = std::max(0.5, z.stream_speed);
  const double half_v = 0.5 * std::max(0.1, z.vehicle_length);
  const double d_lead = v * z.t_zone + z.entry_zone - z.front_gap - half_v;
  const double d_rear = v * z.t_zone + z.entry_zone + z.ego_length + z.rear_gap + half_v;
  const double width = d_rear - d_lead;
  if (d_lead_out) *d_lead_out = d_lead;
  if (d_rear_out) *d_rear_out = d_rear;

  auto fill = [&](const StreamVehicle* ld, const StreamVehicle* fl) {
    out.gap.leader_id = ld ? ld->id : -1;
    out.gap.follower_id = fl ? fl->id : -1;
    out.gap.leader_pos = ld ? ld->pos : 0.0;
    out.gap.leader_speed = ld ? v : 0.0;
    out.gap.leader_length = ld ? z.vehicle_length : 0.0;
    out.gap.follower_pos = fl ? fl->pos : 0.0;
    out.gap.follower_speed = fl ? v : 0.0;
    out.gap.follower_length = fl ? z.vehicle_length : 0.0;
    out.gap.merge_time = z.t_zone;
    out.resolved_leader = out.target_leader = out.gap.leader_id;
    out.resolved_follower = out.gap.follower_id;
    out.rear_ttc = 1e9;
  };

  if (z.locked) {
    // 진입 중: 고른 쌍을 유지하고, 구간 안에 다른 차(또는 뒤차)가 들어오면 무너진 것.
    // 앞차는 기존 '앞차 통과 대기' 정지 목표가 맡으므로 침범 판정에서 뺀다.
    const StreamVehicle* ld = nullptr;
    const StreamVehicle* fl = nullptr;
    const StreamVehicle* intruder = nullptr;
    for (const auto& car : stream) {
      if (car.id == z.locked_leader) ld = &car;
      if (car.id == z.locked_follower) fl = &car;
      if (car.id != z.locked_leader &&
          car.pos >= -d_rear + z.commit_tolerance && car.pos <= -d_lead) {
        if (!intruder || car.pos > intruder->pos) intruder = &car;
      }
    }
    fill(ld, fl);
    out.gap.leader_id = out.resolved_leader = out.target_leader = z.locked_leader;
    out.gap.follower_id = out.resolved_follower = z.locked_follower;
    out.rear_margin = fl ? (-d_rear - fl->pos) : 1e9;
    if (intruder) {
      out.gap.limit_side = "zone_intrusion";
      out.rear_margin = -d_rear - intruder->pos;
      return out;
    }
    out.feasible = true;
    out.departure_ready = true;
    out.gap.feasible = true;
    out.gap.depart_delay = 0.0;
    return out;
  }

  std::vector<const StreamVehicle*> ahead, behind;  // 구간 앞쪽 경계(-D_lead) 기준
  for (const auto& car : stream) (car.pos > -d_lead ? ahead : behind).push_back(&car);
  std::sort(ahead.begin(), ahead.end(),
            [](const StreamVehicle* a, const StreamVehicle* b) { return a->pos < b->pos; });
  std::sort(behind.begin(), behind.end(),
            [](const StreamVehicle* a, const StreamVehicle* b) { return a->pos > b->pos; });
  const StreamVehicle* nearest_ahead = ahead.empty() ? nullptr : ahead.front();

  if (behind.empty() || behind.front()->pos < -d_rear) {
    // 구간이 비었다: 지금 출발하면 앞/뒤 간격을 모두 지킨다.
    const StreamVehicle* fl = behind.empty() ? nullptr : behind.front();
    fill(nearest_ahead, fl);
    out.rear_margin = fl ? (-d_rear - fl->pos) : 1e9;
    out.feasible = true;
    out.departure_ready = true;
    out.gap.feasible = true;
    out.gap.depart_delay = 0.0;
    return out;
  }
  // 구간 안에 차가 있다. 그 차부터 차례로 '이 차 뒤 틈'의 폭을 검사한다.
  for (size_t i = 0; i < behind.size(); ++i) {
    const StreamVehicle* ld = behind[i];
    const StreamVehicle* fl = i + 1 < behind.size() ? behind[i + 1] : nullptr;
    const double spacing = fl ? ld->pos - fl->pos : 1e9;
    if (spacing + 1e-6 >= width) {
      fill(ld, fl);
      out.rear_margin = fl ? spacing - width : 1e9;
      out.feasible = true;
      out.departure_ready = false;
      out.gap.feasible = true;
      out.gap.depart_delay = std::max(0.0, (-d_lead - ld->pos) / v);
      return out;
    }
    out.skipped.push_back(fl->id);
  }
  fill(behind.front(), behind.size() > 1 ? behind[1] : nullptr);
  out.gap.limit_side = "zone_width";
  return out;
}

