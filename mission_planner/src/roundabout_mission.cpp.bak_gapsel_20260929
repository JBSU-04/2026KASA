#include "mission_planner/roundabout_mission.hpp"

#include <algorithm>
#include <cmath>
#include <sstream>

#include "mission_planner/geometry.hpp"

namespace mission_planner {
namespace {

constexpr std::uint8_t kSpeedPriority = 50;
constexpr std::uint8_t kYieldPriority = 100;
constexpr std::uint8_t kEmergencyPriority = 200;
constexpr double kMinimumApproachSpeed = 0.5;

double clampNonnegative(double value) { return std::max(0.0, value); }

}  // namespace

RoundaboutMission::RoundaboutMission(const RoundaboutConfig& config)
    : config_(config) {}

void RoundaboutMission::setConfig(const RoundaboutConfig& config) {
  config_ = config;
}

void RoundaboutMission::reset(double now) {
  state_ = RoundaboutState::kIdle;
  state_enter_time_ = now;
  safe_since_ = -1.0;
  mandatory_stop_since_ = -1.0;
  mandatory_stop_completed_ = false;
  have_previous_ego_ = false;
  failsafe_reason_ = "localization invalid";
}

const char* RoundaboutMission::stateName(RoundaboutState state) {
  switch (state) {
    case RoundaboutState::kIdle:
      return "IDLE";
    case RoundaboutState::kApproach:
      return "APPROACH";
    case RoundaboutState::kYield:
      return "YIELD";
    case RoundaboutState::kCommit:
      return "COMMIT";
    case RoundaboutState::kCirculate:
      return "CIRCULATE";
    case RoundaboutState::kExit:
      return "EXIT";
    case RoundaboutState::kFailsafe:
      return "FAILSAFE";
  }
  return "UNKNOWN";
}

double RoundaboutMission::distanceToYield(
    const RoundaboutInput& input) const {
  const PolylineProjection ego_projection =
      projectToPolyline(input.route, input.ego.position);
  const PolylineProjection yield_projection =
      projectToPolyline(input.route, config_.yield_point);

  if (ego_projection.valid && yield_projection.valid &&
      ego_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.s >= ego_projection.s - 1.0) {
    return clampNonnegative(yield_projection.s - ego_projection.s);
  }
  return distance(input.ego.position, config_.yield_point);
}

bool RoundaboutMission::entryHeadingMatches(const EgoState& ego) const {
  return std::abs(normalizeAngle(ego.yaw - config_.entry_heading)) <=
         config_.entry_heading_tolerance;
}

bool RoundaboutMission::egoInsideCircle(const EgoState& ego) const {
  const double radius = radiusFrom(config_.center, ego.position);
  return radius >= config_.inner_radius && radius <= config_.outer_radius;
}

double RoundaboutMission::yieldRelaxation(double now) const {
  if (state_ != RoundaboutState::kYield) {
    return 0.0;
  }
  const double dwell = std::max(0.0, now - state_enter_time_);
  const double active_dwell =
      std::max(0.0, dwell - std::max(0.0, config_.gap_relax_start_seconds));
  return active_dwell * std::max(0.0, config_.gap_relax_rate);
}

double RoundaboutMission::relaxedThreshold(double configured, double floor,
                                           double relaxation) const {
  const double nonnegative_configured = std::max(0.0, configured);
  const double bounded_floor =
      std::min(nonnegative_configured, std::max(0.0, floor));
  return std::max(bounded_floor, nonnegative_configured - relaxation);
}

bool RoundaboutMission::isCirculatingObject(const TrackedObject& object,
                                            double* angle,
                                            double* tangential_speed) const {
  const double object_radius = radiusFrom(config_.center, object.position);
  if (object_radius < config_.inner_radius ||
      object_radius > config_.outer_radius) {
    return false;
  }

  const double object_angle = angleFrom(config_.center, object.position);
  const double speed = std::hypot(object.velocity_x, object.velocity_y);
  const double expected_yaw =
      tangentYaw(object_angle, config_.counter_clockwise);

  if (object.velocity_valid && speed > config_.stationary_speed) {
    const double velocity_yaw =
        std::atan2(object.velocity_y, object.velocity_x);
    if (std::abs(normalizeAngle(velocity_yaw - expected_yaw)) >
        config_.tangent_heading_tolerance) {
      return false;
    }
  }

  const double tangent_x = std::cos(expected_yaw);
  const double tangent_y = std::sin(expected_yaw);
  if (angle != nullptr) {
    *angle = object_angle;
  }
  if (tangential_speed != nullptr) {
    *tangential_speed = std::max(
        0.0, object.velocity_x * tangent_x + object.velocity_y * tangent_y);
  }
  return true;
}

RoundaboutMission::GapResult RoundaboutMission::evaluateGap(
    const RoundaboutInput& input, double distance_to_yield) const {
  GapResult result;
  if (config_.require_tracker_stream && !input.tracker_stream_valid) {
    result.reason = "LiDAR tracker stream stale";
    return result;
  }

  result.safe = true;
  result.reason = "gap accepted";
  const double conflict_angle =
      angleFrom(config_.center, config_.conflict_point);
  const double ego_arrival_time =
      clampNonnegative(distance_to_yield) /
          std::max(kMinimumApproachSpeed, config_.approach_speed) +
      config_.ego_merge_time;
  // 일반 모드는 합류 완료 뒤 rear_time만큼의 추가 여유를 요구한다.
  // K-City처럼 rear_time을 최종 TTC 기준으로 직접 튜닝하는 현장은
  // rear_time_is_total_ttc=true로 두어 화면 값과 설정값을 일치시킨다.
  double configured_rear_ttc =
      config_.rear_time_is_total_ttc ? config_.rear_time_gap
                                     : ego_arrival_time + config_.rear_time_gap;

  // YIELD 대기가 길어지면 진입 기준을 설정된 하한까지 점진 완화한다.
  // 트래커 단절, 속도 미확정 객체, 정지 차량 차단 조건에는 적용하지 않는다.
  const double relaxation = yieldRelaxation(input.now);
  const double rear_relaxation =
      std::min(std::max(0.0, config_.rear_ttc_relax_max), relaxation);
  configured_rear_ttc = relaxedThreshold(
      configured_rear_ttc, config_.rear_ttc_relax_floor, rear_relaxation);

  // 예측 불확실성은 실제 TTC에서 숨겨서 빼지 않고 비교 기준에 더한다.
  // 동작은 같지만 RViz에는 센서로 계산한 실제 TTC가 그대로 표시된다.
  const double required_rear_ttc =
      configured_rear_ttc + config_.prediction_uncertainty_time;

  for (const TrackedObject& object : input.objects) {
    double object_angle = 0.0;
    double tangential_speed = 0.0;
    if (!isCirculatingObject(object, &object_angle, &tangential_speed)) {
      continue;
    }

    const double vehicle_half_length = 0.5 * std::max(0.1, object.length);
    const double upstream_arc = clampNonnegative(
        circleArcDistance(object_angle, conflict_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        vehicle_half_length);
    const double downstream_arc = clampNonnegative(
        circleArcDistance(conflict_angle, object_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        vehicle_half_length);

    // 추적 초기에는 속도를 모르므로 충돌점 부근 객체를 안전 쪽으로 처리한다.
    if (!object.velocity_valid) {
      if (std::min(upstream_arc, downstream_arc) <=
          config_.uncertain_object_block_distance) {
        result.safe = false;
        result.blocking_object_id = object.id;
        result.reason = "object motion not confirmed";
      }
      continue;
    }

    if (tangential_speed <= config_.stationary_speed) {
      // 움직인 이력이 없는 정지 클러스터는 시설물일 가능성이 높다.
      if (!object.has_moved) {
        continue;
      }
      if (upstream_arc <= config_.stationary_block_distance) {
        result.safe = false;
        result.blocking_object_id = object.id;
        result.next_npc_ttc = 0.0;
        result.reason = "stationary vehicle near conflict";
      }
    }

    // 충돌점 통과 직후 차량은 진입할 앞 공간을 제한한다.
    if (downstream_arc <= config_.front_check_distance &&
        downstream_arc < result.front_gap) {
      result.front_gap = downstream_arc;
    }
    // 양보선에서 완전정지한 뒤 출발하므로 접근 제한속도를 곧바로 쓰지
    // 않고 출발 구간의 평균속도 비율을 적용한다. K-City는 0.5로 두어
    // 등가속 출발의 평균속도(approach_speed / 2)를 사용한다.
    const double departure_average_speed =
        std::max(0.0, config_.approach_speed) *
        std::max(0.0, config_.front_departure_speed_ratio);
    const double effective_front_time = relaxedThreshold(
        config_.front_time_gap, config_.front_time_relax_floor, relaxation);
    const double required_front_gap =
        std::max(0.0, config_.front_standstill_distance) +
        effective_front_time * departure_average_speed;
    if (downstream_arc <= config_.front_check_distance &&
        downstream_arc < required_front_gap) {
      result.safe = false;
      result.blocking_object_id = object.id;
      std::ostringstream reason;
      reason.setf(std::ios::fixed);
      reason.precision(2);
      reason << "front ID " << object.id << ": gap " << downstream_arc
             << "m < limit " << required_front_gap << "m";
      result.reason = reason.str();
    }

    if (tangential_speed <= config_.stationary_speed) {
      continue;
    }

    const double npc_ttc = upstream_arc / tangential_speed;
    if (npc_ttc < result.next_npc_ttc) {
      result.next_npc_ttc = npc_ttc;
    }
    if (npc_ttc < required_rear_ttc) {
      result.safe = false;
      result.blocking_object_id = object.id;
      std::ostringstream reason;
      reason.setf(std::ios::fixed);
      reason.precision(2);
      reason << "rear ID " << object.id << ": TTC " << npc_ttc
             << "s < limit " << required_rear_ttc << "s\narc "
             << upstream_arc << "m / " << tangential_speed << "m/s";
      result.reason = reason.str();
    }
  }

  return result;
}

RoundaboutMission::LeadResult RoundaboutMission::findLeadVehicle(
    const RoundaboutInput& input) const {
  LeadResult result;
  result.distance = config_.lead_search_distance;
  const double ego_angle = angleFrom(config_.center, input.ego.position);

  for (const TrackedObject& object : input.objects) {
    double object_angle = 0.0;
    double tangential_speed = 0.0;
    if (!object.velocity_valid ||
        !isCirculatingObject(object, &object_angle, &tangential_speed) ||
        (!object.has_moved &&
         tangential_speed <= config_.stationary_speed)) {
      continue;
    }
    const double arc = clampNonnegative(
        circleArcDistance(ego_angle, object_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        0.5 * std::max(0.1, object.length));
    if (arc > 0.2 && arc < result.distance) {
      result.active = true;
      result.id = object.id;
      result.distance = arc;
      result.speed = tangential_speed;
    }
  }
  return result;
}

void RoundaboutMission::transition(RoundaboutState next, double now) {
  if (state_ == next) {
    return;
  }
  state_ = next;
  state_enter_time_ = now;
  safe_since_ = -1.0;
}

MissionConstraint RoundaboutMission::baseConstraint(
    double max_speed, const std::string& reason) const {
  MissionConstraint constraint;
  constraint.active = true;
  constraint.priority = kSpeedPriority;
  constraint.max_speed = std::max(0.0, max_speed);
  constraint.comfortable_decel = config_.comfortable_decel;
  constraint.emergency_decel = config_.emergency_decel;
  constraint.reason = reason;
  return constraint;
}

RoundaboutOutput RoundaboutMission::update(const RoundaboutInput& input) {
  RoundaboutOutput output;
  output.tracked_object_count = static_cast<int>(input.objects.size());

  if (!config_.enabled) {
    if (state_ != RoundaboutState::kIdle) {
      reset(input.now);
    }
    output.reason = "mission disabled";
    return output;
  }

  if (input.ego.valid && have_previous_ego_ &&
      distance(input.ego.position, previous_ego_position_) >
          config_.reset_jump_distance) {
    reset(input.now);
  }
  if (input.ego.valid) {
    previous_ego_position_ = input.ego.position;
    have_previous_ego_ = true;
  }

  output.ego_radius = radiusFrom(config_.center, input.ego.position);
  output.ego_angle = angleFrom(config_.center, input.ego.position);
  output.distance_to_yield = input.ego.valid
                                 ? distanceToYield(input)
                                 : std::numeric_limits<double>::infinity();

  const bool localization_ok =
      input.ego.valid && (!config_.require_localization ||
                          input.localization_valid);
  if (state_ != RoundaboutState::kIdle && !localization_ok) {
    failsafe_reason_ = "localization invalid";
    transition(RoundaboutState::kFailsafe, input.now);
  }

  if (state_ == RoundaboutState::kIdle && input.ego.valid &&
      output.distance_to_yield <= config_.activation_distance &&
      entryHeadingMatches(input.ego)) {
    if (localization_ok) {
      transition(RoundaboutState::kApproach, input.now);
    } else {
      failsafe_reason_ = "localization invalid near roundabout";
      transition(RoundaboutState::kFailsafe, input.now);
    }
  }

  if (state_ == RoundaboutState::kFailsafe && localization_ok) {
    transition(egoInsideCircle(input.ego) ? RoundaboutState::kCirculate
                                          : RoundaboutState::kApproach,
               input.now);
  }

  if (state_ == RoundaboutState::kCommit &&
      input.now - state_enter_time_ >= config_.commit_timeout_seconds &&
      !egoInsideCircle(input.ego)) {
    failsafe_reason_ = "entry commit timeout";
    transition(RoundaboutState::kFailsafe, input.now);
  }

  const GapResult gap = evaluateGap(input, output.distance_to_yield);
  output.gap_safe = gap.safe;
  output.blocking_object_id = gap.blocking_object_id;
  output.next_npc_ttc = gap.next_npc_ttc;
  output.front_gap = gap.front_gap;
  const double required_safe_confirm_seconds = relaxedThreshold(
      config_.safe_confirm_seconds, config_.safe_confirm_relax_floor,
      yieldRelaxation(input.now));

  std::string mandatory_stop_reason;
  bool mandatory_stop_pending =
      config_.mandatory_stop_seconds > 0.0 &&
      !mandatory_stop_completed_ &&
      (state_ == RoundaboutState::kApproach ||
       state_ == RoundaboutState::kYield);
  if (mandatory_stop_pending) {
    const double distance_to_stop_target = std::max(
        0.0, output.distance_to_yield - config_.stop_buffer);
    const bool at_stop_target =
        distance_to_stop_target <=
        config_.mandatory_stop_position_tolerance;
    const bool fully_stopped =
        input.ego.speed <= config_.mandatory_stop_speed_threshold;

    if (at_stop_target && fully_stopped) {
      if (mandatory_stop_since_ < 0.0) {
        mandatory_stop_since_ = input.now;
      }
      const double elapsed =
          std::max(0.0, input.now - mandatory_stop_since_);
      if (elapsed >= config_.mandatory_stop_seconds) {
        mandatory_stop_completed_ = true;
        mandatory_stop_pending = false;
      } else {
        std::ostringstream reason;
        reason.setf(std::ios::fixed);
        reason.precision(1);
        reason << "mandatory stop " << elapsed << "/"
               << config_.mandatory_stop_seconds << "s\n" << gap.reason;
        mandatory_stop_reason = reason.str();
      }
    } else {
      mandatory_stop_since_ = -1.0;
      mandatory_stop_reason = at_stop_target
                                  ? "mandatory stop: waiting for 0 km/h"
                                  : "approaching mandatory stop line";
    }
  }

  // 진입한 뒤 정지 명령이 생기지 않도록 물리적 위치가 우선한다.
  if ((state_ == RoundaboutState::kApproach ||
       state_ == RoundaboutState::kYield ||
       state_ == RoundaboutState::kCommit) &&
      localization_ok && egoInsideCircle(input.ego)) {
    transition(RoundaboutState::kCirculate, input.now);
  }

  if (state_ == RoundaboutState::kApproach ||
      state_ == RoundaboutState::kYield) {
    if (mandatory_stop_pending) {
      safe_since_ = -1.0;
      if (output.distance_to_yield <= config_.decision_distance) {
        transition(RoundaboutState::kYield, input.now);
      }
    } else if (!gap.safe) {
      safe_since_ = -1.0;
      if (output.distance_to_yield <= config_.decision_distance) {
        transition(RoundaboutState::kYield, input.now);
      }
    } else {
      if (safe_since_ < 0.0) {
        safe_since_ = input.now;
      }
      if (input.now - safe_since_ >= required_safe_confirm_seconds) {
        transition(RoundaboutState::kCommit, input.now);
      }
    }
  }

  if (state_ == RoundaboutState::kCommit && !egoInsideCircle(input.ego)) {
    // 아직 원형 차로에 진입하기 전(양보선 부근)이고 저속인 상태에서
    // 순환 차량이 급접근(위험 gap 또는 TTC 임계 이하)하는 경우 안전하게 다시 YIELD로 복귀
    if (output.distance_to_yield > 1.0 && input.ego.speed < 2.5 && !gap.safe) {
      transition(RoundaboutState::kYield, input.now);
    }
  }

  if (state_ == RoundaboutState::kCirculate &&
      input.now - state_enter_time_ >= config_.minimum_circulate_seconds &&
      distance(input.ego.position, config_.exit_point) <=
          config_.exit_detection_radius) {
    transition(RoundaboutState::kExit, input.now);
  }

  if (state_ == RoundaboutState::kExit &&
      input.now - state_enter_time_ >= config_.exit_hold_seconds &&
      distance(input.ego.position, config_.exit_point) >=
          config_.exit_clear_distance) {
    reset(input.now);
  }

  output.state = state_;
  switch (state_) {
    case RoundaboutState::kIdle:
      output.reason = "outside mission zone";
      break;
    case RoundaboutState::kApproach:
    case RoundaboutState::kYield: {
      output.constraint = baseConstraint(config_.approach_speed, gap.reason);
      const bool confirmed = gap.safe && safe_since_ >= 0.0 &&
                             input.now - safe_since_ >=
                                 required_safe_confirm_seconds;
      if (mandatory_stop_pending || !gap.safe || !confirmed) {
        output.constraint.priority = kYieldPriority;
        output.constraint.stop_required = true;
        // ★ 의무 정지 전에는 양보선(stop_buffer) 기준으로 세우고, 정지를
        //   마친 뒤에는 creep_buffer 위치까지 전진해서 기다린다.
        //   양보선 뒤에서는 중앙분리대에 가려 순환 차량이 105° 밖에
        //   안 보인다(실측 2026-09-10). 규정 정지는 지키되 관측은
        //   시야가 열리는 앞에서 한다.
        const double hold_buffer = mandatory_stop_pending
                                       ? config_.stop_buffer
                                       : config_.creep_buffer;
        output.constraint.stop_distance =
            std::max(0.0, output.distance_to_yield - hold_buffer);
        if (mandatory_stop_pending) {
          output.constraint.reason = mandatory_stop_reason;
        } else if (gap.safe) {
          output.constraint.reason = "confirming safe gap";
        }
      }
      output.reason = output.constraint.reason;
      break;
    }
    case RoundaboutState::kCommit:
      if (config_.require_tracker_stream && !input.tracker_stream_valid) {
        output.constraint = baseConstraint(
            std::min(config_.circulation_speed, config_.degraded_speed),
            "entry committed; LiDAR tracker degraded");
      } else {
        output.constraint = baseConstraint(config_.circulation_speed,
                                           "entry committed");
      }
      output.reason = output.constraint.reason;
      break;
    case RoundaboutState::kCirculate:
    case RoundaboutState::kExit: {
      const bool exiting = state_ == RoundaboutState::kExit;
      const bool tracker_degraded =
          config_.require_tracker_stream && !input.tracker_stream_valid;
      const double normal_speed =
          exiting ? config_.exit_speed : config_.circulation_speed;
      output.constraint = baseConstraint(
          tracker_degraded ? std::min(normal_speed, config_.degraded_speed)
                           : normal_speed,
          tracker_degraded
              ? "LiDAR tracker degraded; low-speed circulation"
              : (exiting ? "leaving roundabout" : "circulating"));
      const LeadResult lead =
          tracker_degraded ? LeadResult() : findLeadVehicle(input);
      if (lead.active) {
        output.constraint.lead_vehicle_active = true;
        output.constraint.lead_vehicle_id = lead.id;
        output.constraint.lead_distance = lead.distance;
        output.constraint.lead_speed = lead.speed;
      }
      output.reason = output.constraint.reason;
      break;
    }
    case RoundaboutState::kFailsafe:
      output.constraint = baseConstraint(0.0, failsafe_reason_);
      output.constraint.priority = kEmergencyPriority;
      output.constraint.stop_required = true;
      output.constraint.stop_distance = 0.0;
      output.reason = output.constraint.reason;
      break;
  }

  return output;
}

