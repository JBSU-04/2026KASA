        auto immediate=evaluate_candidate(now_params,sp0,target,config_.gs_preparation_enabled);
        if(config_.gs_preparation_enabled) {
          if(immediate.feasible && (!r0.feasible || immediate.clear_time<r0.clear_time))r0=immediate;
        } else if (immediate.feasible && immediate.departure_ready) {r0=immediate;break;}
      }
    }
    // 뒤차가 이미 합류점을 지났으면(틈이 지나감) 확인 없이 넘긴다.
    bool follower_passed = false;
    if (r0.resolved_follower >= 0) {
      follower_passed = true;
      for (const StreamVehicle& sv : stream) {
        if (sv.id == r0.resolved_follower && (opportunity
            ? sv.pos+.5*sv.length<sp.approach_pos-config_.gs_spatial_rear_gap
            : sv.pos<0.0)) follower_passed = false;
      }
    }
    if (sp.lock_gap) {
      // Keep the committed identity even when unsafe/missing. Do not skip to
      // another pair and accidentally approve its unrelated GO result.
      seq = r0;
      seq_target_leader_ = committed_leader_;
    } else if (r0.gap.limit_side == "wait_horizon") {
      // A distant slot is still our target; it is not a rejected rear gap.
      seq = r0;
      seq_target_leader_ = r0.target_leader;
      seq_infeasible_since_ = -1.0;
    } else if (r0.feasible || (opportunity && r0.future_departure>=0.0)) {
      seq = r0;
      seq_target_leader_ = r0.target_leader;
      seq_infeasible_since_ = -1.0;
      seq_last_feasible_time_ = input.now;
    } else {
      if (seq_infeasible_since_ < 0.0) seq_infeasible_since_ = input.now;
      // 2026-10-05(16:13 백 198.5 s): 확인 중이던 틈이 뒤차 조건 경계값 흔들림으로 0.3 s 만에
      // 다음 틈(L9/F10)으로 넘어가 2.8 s 더 기다렸다. 직전까지 가능하던 틈은 더 길게 지켜본다(승인은 여전히 feasible 일 때만).
      const bool was_feasible = seq_last_feasible_time_ >= 0.0 &&
          seq_infeasible_since_ - seq_last_feasible_time_ <= 0.25;
      const double skip_window = was_feasible
          ? std::max(config_.gs_skip_confirm, config_.gs_skip_confirm_after_safe)
          : config_.gs_skip_confirm;
      // Do not abandon a still-upstream slot merely because an approaching
      // leader slows temporarily. Waiting cannot approve it; it only preserves
      // its identity until the leader reaches the merge and rear feasibility
      // can be judged without the speculative front-stop/restart profile.
      const bool leader_reached_merge = r0.gap.leader_id < 0 ||
          (opportunity ? r0.gap.leader_pos-.5*r0.gap.leader_length >=
              sp.approach_pos+sp.approach_half+config_.gs_spatial_front_gap :
              r0.gap.leader_pos >= -0.5*r0.gap.leader_length);
      // Start the expiry timer only once the front has actually cleared.
      if(opportunity && !leader_reached_merge)seq_infeasible_since_=input.now;
      const double expiry=opportunity?config_.gs_opportunity_expire_confirm:skip_window;
      if (follower_passed ||
          (leader_reached_merge &&
           input.now - seq_infeasible_since_ >= expiry)) {
        // Spatial evaluation checks one pair; unlike evaluateSequential it
        // does not implement max_skip. Advance explicitly before GO so an
        // expired/rejected pair cannot keep us waiting forever.
        const int next_target=config_.gs_spatial_arrival_check
            ? (r0.resolved_follower>=0 ? r0.resolved_follower : -2)
            : seq_target_leader_;
        result.switch_reason=follower_passed?"rear_passed":"front_clear_no_opportunity";
        seq = evaluate_candidate(seq_params,sp,next_target);
        seq_target_leader_ = seq.target_leader;
        seq_infeasible_since_ = -1.0;
      } else {
        seq = r0;
        seq.skipped.clear();
        seq_target_leader_ = r0.resolved_leader;  // 아직 패스하지 않는다
      }
    }
    result.observed_free_length=seq.observed_free_length;result.clear_time=seq.clear_time;
    result.physical_gap_length=seq.physical_free_length;
    result.preparation_valid=config_.gs_preparation_enabled && seq.feasible && seq.future_departure>0.;
    result.preparation_speed=seq.preparation_speed;result.launch_speed_limit=seq.launch_speed_limit;
    result.trajectory_observation=config_.gs_preparation_enabled?
        (seq.feasible?"observed":seq.observation_failure.empty()?seq.gap.limit_side:seq.observation_failure):"unknown";
    if(config_.gs_preparation_enabled)result.preview_stop_distance=seq.preparation_stop_distance;
    result.future_departure=seq.future_departure;
    result.future_front=seq.future_front_margin+(config_.gs_preparation_enabled?config_.gs_spatial_front_gap:config_.gs_spatial_rear_gap);
    result.future_rear=seq.future_rear_margin+config_.gs_spatial_rear_gap;
    if(opportunity) {
      result.predicted_front=seq.front_margin+(config_.gs_preparation_enabled?config_.gs_spatial_front_gap:config_.gs_spatial_rear_gap);
      result.predicted_rear=seq.rear_margin+config_.gs_spatial_rear_gap;
    }
    result.preview_ready=config_.gs_spatial_arrival_check && seq.preview_ready;
    if(!config_.gs_preparation_enabled)result.preview_stop_distance=std::max(0.0,sp.approach_distance-
        std::max(1.0,config_.gs_stop_margin+std::max(0.0,input.ego.speed)*config_.gs_approach_response));
    seq_timed_approach_=seq.approach_used;
    if (!config_.gs_preparation_enabled && config_.gs_timed_entry_approach && (seq.approach_used ||
        (result.preview_ready && !sp.lock_gap && !seq.departure_ready)) && sp.project_ego &&
        !sp.project_ego(0.0).active && sp.approach_distance>=0.0) {
      if (sp.lock_gap && committed_timed_approach_ && committed_leader_>=0)
        result.entry_approach_cap=0.0; // Missing committed front cannot open the approach.
      for (const auto& car:stream) {
        if (car.id != seq.gap.leader_id) continue;
        const double low=std::max(0.0,(car.speed_lo>=0.0?car.speed_lo:car.speed)-seq_params.speed_margin);
        const double needed=sp.approach_pos+sp.approach_half+0.5*car.length+
            std::max(seq_params.standstill_gap,sp.follow_standstill_gap);
        result.entry_approach_cap=timedApproachSpeedCap(
            sp.approach_distance-0.2,car.pos-needed,low,sp.approach_time_buffer,ego.speed,
            sp.approach_accel_compensation ? std::min(std::max(.1,ego.accel),GapSelector::entryAcceleration(ego,ego.speed)) : 0.0);
        break;
      }
    }
  }
  if (config_.gs_sequential) {
    chosen = seq.feasible ? &seq.gap : nullptr;
    if (seq.feasible) result.ego_zone_time = seq.gap.merge_time;
    // Visualize exactly the sequential evaluator, not the separate generic
    // evaluator (which can disagree about feasibility and even gap identity).
    bool found = false;
    for (GapCandidate& g : gaps) {
      if (g.wrap == 0 && g.leader_id == seq.gap.leader_id &&
          g.follower_id == seq.gap.follower_id) {
        g = seq.gap;
        found = true;
        break;
      }
    }
    if (!found) gaps.push_back(seq.gap);
  }
  // 시각화용 사본
  last_gap_select_active_ = true;
  last_conflict_point_ = conflict;
  last_conflict_angle_ = conflict_angle;
  for (const StreamVehicle& sv : stream) {
    const bool unconf = std::find(unconfirmed_ids.begin(), unconfirmed_ids.end(),
                                  sv.id) != unconfirmed_ids.end();
    RoundaboutVehicleViz vv;
    vv.id = sv.id; vv.pos = sv.pos; vv.speed = sv.speed;
    vv.length = sv.length; vv.confirmed = !unconf;
    for (const TrackedObject& object : input.objects) {
      if (object.id == sv.id) {
        vv.measured_position = object.position;
        vv.measured_position_valid = true;
        vv.physical_speed = std::hypot(object.velocity_x, object.velocity_y);
        break;
      }
    }
    last_stream_.push_back(vv);
  }
  const double open_len = 30.0;
  for (const GapCandidate& g : gaps) {
    RoundaboutGapViz gv;
    gv.leader_id = g.leader_id;
    gv.follower_id = g.follower_id;
    gv.feasible = g.feasible;
    gv.selected = config_.gs_sequential
                      ? (g.wrap == 0 && g.leader_id == seq.gap.leader_id &&
                         g.follower_id == seq.gap.follower_id)
                      : (&g == chosen);
    gv.depart_delay = g.depart_delay;
    if(gv.selected && config_.gs_opportunity_enabled)gv.failure_reason=seq.gap.limit_side;
    gv.go = config_.gs_sequential
                ? (gv.selected && seq.feasible &&
                   seq.departure_ready)
                : (g.feasible &&
                   (g.depart_delay <= config_.gs_go_tolerance ||
                    (g.rear_shortfall_now <= 1e-9 &&
                     g.depart_delay <= config_.gs_go_tolerance_front)));
    if(gv.selected && config_.gs_opportunity_enabled && seq.future_departure>0.0) {
      gv.preview=true;gv.failure_reason="future_entry";
    }
    if (gv.selected && config_.gs_sequential) {
      gv.feasible = seq.feasible;
      gv.depart_delay = seq.gap.depart_delay;
    }
    const bool has_l = g.leader_id >= 0, has_f = g.follower_id >= 0;
    gv.hi = has_l ? g.leader_pos - 0.5 * g.leader_length : 0.0;
    gv.lo = has_f ? g.follower_pos + 0.5 * g.follower_length : 0.0;
    if (!has_l && !has_f) {
      gv.lo = -open_len;
      gv.hi = open_len;
    } else if (!has_l) {
      gv.hi = gv.lo + open_len;
    } else if (!has_f) {
      gv.lo = gv.hi - open_len;
    }
    // 원형에서 한 바퀴 넘는 띠는 자른다.
    if (gv.hi - gv.lo > ring_length - 1.0) {
      gv.lo = gv.hi - (ring_length - 1.0);
    }
    last_gaps_.push_back(gv);
  }
  if (chosen != nullptr) {
    gap_latch_leader_ = chosen->leader_id;
    gap_latch_follower_ = chosen->follower_id;
    gap_latch_wrap_ = chosen->wrap;
  } else {
    gap_latch_leader_ = -2;
    gap_latch_follower_ = -2;
  }

  std::ostringstream reason;
  reason.setf(std::ios::fixed);
  reason.precision(1);
  if (config_.gs_sequential) {
    result.leader_id = seq.gap.leader_id;
    result.follower_id = seq.gap.follower_id;
    result.depart_delay = seq.gap.depart_delay;
    // Keep the selected front available to live ACC even if rear reevaluation
    // rejects this pair after approval. Missing-pair results have no front body.
    result.has_leader = seq.gap.leader_id >= 0 && seq.gap.leader_length > 0.0;
    result.leader_pos = seq.gap.leader_pos;
    result.leader_length = seq.gap.leader_length;
    result.leader_speed = seq.gap.leader_speed;
    for (const auto& object : input.objects) {
      if (object.id == seq.gap.leader_id) {
        result.leader_speed = std::hypot(object.velocity_x, object.velocity_y); break;
      }
    }
    if (!seq.skipped.empty()) {
      reason << "skip";
      for (int id : seq.skipped) reason << " F" << id;
      reason << "; ";
    }
    if (config_.gs_spatial_gap_enabled && chosen == nullptr) {
      result.safe=false;result.blocking_object_id=seq.resolved_follower;
      reason << "spatial L" << seq.gap.leader_id << "/F" << seq.gap.follower_id
             << " rejected: " << seq.gap.limit_side << " (TTC unused)";
      if(seq.future_departure>0.0)reason << "; future entry in " << seq.future_departure << "s";
    } else if (chosen == nullptr && state_ == RoundaboutState::kCommit && committed_valid_) {
      reason << "committed L" << committed_leader_ << "/F" << committed_follower_
             << " unsafe (" << seq.gap.limit_side << ", rear margin "
             << seq.rear_margin << "m, rear ttc " << seq.rear_ttc << "s)";
      result.safe = false;
      result.blocking_object_id = committed_follower_ >= 0
          ? committed_follower_ : committed_leader_;
    } else if (chosen == nullptr && seq.gap.limit_side == "wait_horizon") {
      reason << "seq L" << seq.gap.leader_id << " wait " << seq.gap.depart_delay
             << "s exceeds prediction horizon " << config_.gs_max_wait << "s";
      result.safe = false;
      result.blocking_object_id = seq.gap.leader_id;
    } else if (chosen == nullptr && seq_infeasible_since_ >= 0.0) {
      reason << "seq L" << seq.resolved_leader << "/F" << seq.resolved_follower
             << " unsafe, confirming skip (" << seq.gap.limit_side
             << ", front short " << seq.gap.front_shortfall_now
             << "m, rear margin " << seq.rear_margin
             << "m, rear ttc " << seq.rear_ttc << "s)";
      result.safe = false;
      result.blocking_object_id = seq.resolved_follower;
    } else if (chosen == nullptr) {
      reason << "no gap (all skipped)";
      result.safe = false;
      if (!seq.skipped.empty()) result.blocking_object_id = seq.skipped.back();
    } else {
      result.leader_id = chosen->leader_id;
      result.follower_id = chosen->follower_id;
      result.has_leader = chosen->leader_id >= 0;
      result.leader_pos = chosen->leader_pos;
      result.leader_speed = chosen->leader_speed;
      if (config_.gs_use_tracker_velocity && !config_.gs_zone_rule_enabled) {
        // ACC needs physical m/s, not the nominal-ring coordinate speed.
        // (거리 기준 판단에서는 흐름 속도를 그대로 쓴다 - 차량별 속도는 흔들린다.)
        for (const auto& object : input.objects) {
          if (object.id == chosen->leader_id) {
            result.leader_speed = std::hypot(object.velocity_x, object.velocity_y);
            break;
          }
        }
      }
      result.leader_length = chosen->leader_length;
      result.depart_delay = chosen->depart_delay;
      // 2026-10-06(18:48:57/18:49:45 백): 앞차가 합류점 앞에 있는데 예측(출발 지연 0)으로 GO -> 앞차 바로 뒤까지
      //   붙거나 늦게 잡힌 차에 취소. 가장 가까운 틈만: 앞차 뒤끝이 합류점을 standstill_gap 지난 뒤에만 GO.
      const bool leader_passed = config_.gs_spatial_only_admission || !config_.gs_go_after_leader_passed ||
          chosen->leader_id < 0 ||
          chosen->leader_pos - 0.5 * std::max(0.1, chosen->leader_length) >=
              config_.gs_standstill_gap;
      result.safe = seq.departure_ready && leader_passed &&
          (!zone_preconfirm_active_ || zone_pair_confirmed_);
      result.strict_go = result.safe;
      // 진입 중에는 같은 틈이 여전히 되면(뒤차 조건 만족) 계속 간다. 앞차가 늦으면
      // 합류 구역/원 판정 반경 앞 정지 목표가 잡아 준다.
      result.front_wait_ok = true;
      reason << (config_.gs_spatial_gap_enabled?"spatial L":"seq L") << chosen->leader_id << "/F" << chosen->follower_id
             << (result.safe ? " GO" : " wait ");
      if (!result.safe) {
        reason << chosen->depart_delay << "s";
        if (seq.departure_ready && !leader_passed) reason << " leader-not-passed";
        result.blocking_object_id = chosen->leader_id;
      }
      if (config_.gs_spatial_gap_enabled) {
        if(config_.gs_preparation_enabled)reason<<" (physical gap "<<seq.physical_free_length<<"m; trajectory checked)";
        else reason << " (slot spare " << seq.rear_margin << "m; TTC unused)";
      } else {
      reason << " (rear ";
      if (chosen->follower_id >= 0) {
        reason << "+" << seq.rear_margin << "m ttc ";
        if (seq.rear_ttc > 99.0) reason << "inf"; else reason << seq.rear_ttc << "s";
      } else {
        reason << "open";
      }
      reason << ", conflict " << result.conflict_distance << "m)";
      }
    }
    if (config_.gs_zone_rule_enabled) {
      reason << " zone " << last_zone_lead_ << "~" << last_zone_rear_ << "m v"
             << last_zone_speed_ << (stream_speed_ > 0.0 ? "" : "(tracker)");
      if (config_.gs_zone_length_estimate) {
        reason << " Lp" << (length_prior_ > 0.0 ? length_prior_ : config_.gs_zone_vehicle_length);
      }
      if (last_zone_relax_ > 0.0) reason << " relax-" << last_zone_relax_ << "m";
      if (!yield_released_ids_.empty()) {
        reason << " yield-release";
        for (int id : yield_released_ids_) reason << " " << id;
      }
    }
  } else if (chosen == nullptr) {
    // 가장 덜 부족한 틈으로 이유를 적는다.
    const GapCandidate* least = nullptr;
    for (const GapCandidate& g : gaps) {
      if (least == nullptr || g.limit_shortfall < least->limit_shortfall) {
        least = &g;
      }
    }
    reason << "no gap within " << config_.gs_max_wait << "s";
    if (least != nullptr) {
      reason << " (L" << least->leader_id << "/F" << least->follower_id
             << " " << least->limit_side << " short " << least->limit_shortfall
             << "m)";
      result.blocking_object_id = least->limit_side == "front"
                                      ? least->leader_id : least->follower_id;
    }
    result.safe = false;
  } else {
    result.leader_id = chosen->leader_id;
    result.follower_id = chosen->follower_id;
    result.has_leader = chosen->leader_id >= 0;
    result.leader_pos = chosen->leader_pos;
    result.leader_speed = chosen->leader_speed;
    result.leader_length = chosen->leader_length;
    result.depart_delay = chosen->depart_delay;
    // 앞차만 막는 틈(뒤차 조건은 지금 만족)은 go_tolerance_front 까지 출발.
    const bool rear_ok_now = chosen->rear_shortfall_now <= 1e-9;
    result.safe = chosen->depart_delay <= config_.gs_go_tolerance ||
                  (rear_ok_now &&
                   chosen->depart_delay <= config_.gs_go_tolerance_front);
    result.wrap = chosen->wrap;
    result.strict_go = chosen->depart_delay <= config_.gs_go_tolerance;
    result.front_wait_ok = rear_ok_now &&
                           chosen->depart_delay <= config_.gs_commit_front_tolerance;
    reason << "gap L" << chosen->leader_id << "/F" << chosen->follower_id
           << (result.safe ? " GO" : " wait ")
           ;
    if (!result.safe) {
      reason << chosen->depart_delay << "s";
      result.blocking_object_id = chosen->limit_side == "front"
                                      ? chosen->leader_id : chosen->follower_id;
    }
    reason << " (merge " << chosen->merge_time << "s, conflict "
           << result.conflict_distance << "m)";
  }
  if (hard_block) {
    result.preview_ready = false;result.preparation_valid=false;
    result.safe = false;
    result.strict_go = false;
    result.front_wait_ok = false;
    for (auto& gap : last_gaps_) gap.go = false;
    result.reason = hard_reason + "\n" + reason.str();
  } else {
    result.reason = reason.str();
  }
  return result;
}

bool RoundaboutMission::bodyCollisionRisk(const RoundaboutInput& input,double speed_cap,int* object_id) const {
  const auto projection=projectToPolyline(input.route,input.ego.position);
  if (!projection.valid || input.route.size()<2) return false;
  std::vector<double> arc(input.route.size(),0.0);
  for(size_t i=1;i<arc.size();++i)arc[i]=arc[i-1]+distance(input.route[i-1],input.route[i]);
  auto candidates=input.objects;
  bool cached_present=false;for(const auto& o:candidates)if(o.id==body_front_cache_.id)cached_present=true;
  if(!cached_present && body_front_cache_stamp_>=0 && input.now-body_front_cache_stamp_<=config_.tw_ghost_age) {
    auto remembered=body_front_cache_;remembered.velocity_valid=false;candidates.push_back(remembered);
  }
  const Point2 offset{input.ego.position.x-projection.point.x,input.ego.position.y-projection.point.y};
  double travel=0.0,speed=std::max(0.0,input.ego.speed);
  for(double time=0.0;time<=std::max(.1,config_.gs_collision_horizon)+1e-9;time+=.1) {
    const double at=projection.s+travel;
    if(at>arc.back())break;
    const auto upper=std::upper_bound(arc.begin(),arc.end(),at);
    const size_t i=std::min(arc.size()-1,std::max<size_t>(1,upper-arc.begin()));
    const double f=std::max(0.0,std::min(1.0,(at-arc[i-1])/std::max(1e-6,arc[i]-arc[i-1])));
    const Point2 ego{input.route[i-1].x+f*(input.route[i].x-input.route[i-1].x)+offset.x,
                     input.route[i-1].y+f*(input.route[i].y-input.route[i-1].y)+offset.y};
    const double path_yaw=std::atan2(input.route[i].y-input.route[i-1].y,input.route[i].x-input.route[i-1].x);
    const double yaw=input.ego.yaw+normalizeAngle(path_yaw-projection.yaw);
    for(const auto& o:candidates) {
      if(!o.has_moved || (o.collision_parent_id<0 && (o.height<.15 || o.width<1.0)))continue;
      double angle=0,vt=0;if(!isCirculatingObject(o,&angle,&vt))continue;
      const double radius=std::max(1.0,radiusFrom(config_.center,o.position));
      if(!o.velocity_valid) {
        const double ahead=(config_.counter_clockwise?1.:-1.)*normalizeAngle(angle-angleFrom(config_.center,input.ego.position))*config_.nominal_radius;
        vt=ahead>0.0?0.0:std::max(config_.gs_unconfirmed_speed,vt);
      }
      const double future_angle=angle+(config_.counter_clockwise?1.:-1.)*std::max(0.0,vt)*time/radius;
      const Point2 npc{config_.center.x+radius*std::cos(future_angle),config_.center.y+radius*std::sin(future_angle)};
      const bool world=o.aabb_x>0 && o.aabb_y>0;
      const double sep=boxSeparation(ego,yaw,config_.gs_ego_length,config_.gs_ego_width,
          npc,world?future_angle-angle:tangentYaw(future_angle,config_.counter_clockwise),
          world?o.aabb_x:std::max(config_.gs_min_vehicle_length,o.length),world?o.aabb_y:std::max(1.9,o.width));
      if(sep<config_.gs_collision_margin) {if(object_id)*object_id=o.id;return true;}
    }
    // Predict continued command motion so braking begins before contact.
    // Include the upper acceleration bound; the controller itself is unchanged.
    const double next=speed<speed_cap?std::min(speed_cap,speed+std::max(4.0,config_.gs_approach_accel_upper)*.1):speed;
    travel+=.05*(speed+next);speed=next;
  }
  return false;
}

RoundaboutMission::LeadResult RoundaboutMission::findLeadVehicle(
    const RoundaboutInput& input) {
  LeadResult result;
  result.distance = config_.lead_search_distance;
  const double ego_angle = angleFrom(config_.center, input.ego.position);
  const bool exiting = state_ == RoundaboutState::kExit;
  const auto ego_route = projectToPolyline(input.route, input.ego.position);
  const auto conflict=last_conflict_point_; // same point evaluated for this admission
  const double merge_distance=conflictDistance(input,conflict,distanceToYield(input));
  // CIRCULATE may start when the nose is still upstream of the conflict.
  // Keep entry-path distance until the ego center actually reaches it.
  const bool bumper_model = config_.distance_enabled || config_.gs_measured_entry_profile || config_.gs_observed_entry_enabled;
  const bool before_merge=bumper_model&&!exiting&&merge_distance>0.;

  auto candidates = input.objects;
  if (config_.gs_route_body_projection) {
    bool present = false;
    for (auto& object : candidates) {
      if (object.id == body_front_cache_.id) present = true;
      const auto meta = track_meta_.find(object.id);
      if (!object.velocity_valid && object.has_moved && object.height >= 0.15 &&
          object.width >= 1.0 && meta != track_meta_.end() &&
          input.now - meta->second.last_hit_time <= config_.tw_ghost_age) {
        // Movement proof survives a temporarily invalid speed. Never reuse
        // an old moving velocity as front clearance for a possibly stopped car.
        object.velocity_x = object.velocity_y = 0.0;
        object.velocity_valid = object.confirmed = true;
      }
    }
    if (!present && body_front_cache_stamp_ >= 0.0 &&
        input.now - body_front_cache_stamp_ <= config_.tw_ghost_age) {
      auto remembered = body_front_cache_;
      remembered.velocity_x = remembered.velocity_y = 0.0;
      remembered.velocity_valid = remembered.confirmed = true;
      candidates.push_back(remembered);
    }
  }
  for (const TrackedObject& object : candidates) {
    if(object.collision_parent_id>=0)continue;
    double object_angle = 0.0;
    double tangential_speed = 0.0;
    if(config_.distance_enabled&&!object.has_moved)continue;
    // 2026-10-06: 앞차는 움직임이 증명된 차량(has_moved)이거나 지금 moving_speed 이상으로 움직이는 물체만
    //   (길가 물체의 순간 속도 튐으로 링 안에서 섰다, 19:04:57 id17). 검출이 끊긴 지 ghost_age 넘은
    //   정지 트랙(유령)도 뺀다. 두 진입 모델 공통.
    {
      const double sp = object.velocity_valid ? std::hypot(object.velocity_x, object.velocity_y) : 0.0;
      if (!object.has_moved && sp < config_.tw_moving_speed) continue;
      const auto meta = track_meta_.find(object.id);
      if (meta != track_meta_.end() && input.now - meta->second.last_hit_time > config_.tw_ghost_age &&
          sp < 0.5) continue;
    }
    if ((!object.confirmed&&!(config_.distance_enabled&&object.has_moved)) || (!object.velocity_valid&&!(config_.distance_enabled&&object.has_moved)) ||
        (!object.has_moved && std::hypot(object.velocity_x, object.velocity_y) <= config_.stationary_speed) ||
        (!exiting && !isCirculatingObject(object, &object_angle, &tangential_speed))) {
      continue;
    }
    double arc = clampNonnegative(
        circleArcDistance(ego_angle, object_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        0.5 * std::max(0.1, object.length));
    if(before_merge && !config_.gs_route_body_projection){
      const double sign=config_.counter_clockwise?1.:-1.;
      const double from_conflict=sign*normalizeAngle(object_angle-angleFrom(config_.center,conflict))*config_.nominal_radius;
      const double rear=from_conflict-.5*std::max(.1,object.length);
      const bool occupies_merge = from_conflict + 0.5 * std::max(.1,object.length) >= 0.0;
      if(!std::isfinite(merge_distance) ||
         (rear < config_.gs_standstill_gap && !occupies_merge)) continue;
      arc=std::max(0.,merge_distance+rear-.5*config_.gs_ego_length);
    }
    if (bumper_model && !before_merge && !exiting) {
      // Keep bumper-to-bumper spacing after the reference point crosses the
      // conflict too. Dropping the ego half-length here creates a false
      // increase in ACC clearance exactly during the merge.
      arc = std::max(0.0, arc - 0.5 * config_.gs_ego_length);
    }
    if (config_.gs_route_body_projection && !exiting) {
      const double delta=normalizeAngle(input.ego.yaw-tangentYaw(ego_angle,config_.counter_clockwise));
      const double half=0.5*config_.gs_ego_length,width=0.5*config_.gs_ego_width;
      const double support=std::abs(std::cos(delta))*half+std::abs(std::sin(delta))*width;
      const double radial_support=std::abs(std::sin(delta))*half+std::abs(std::cos(delta))*width;
      if (std::abs(radiusFrom(config_.center,object.position)-radiusFrom(config_.center,input.ego.position)) >
          radial_support+0.5*std::max(1.9,object.width)) {
        continue; // Separate radial footprints are not a zero-distance lead.
      } else {
        const double sign=config_.counter_clockwise?1.:-1.;
        const double ahead=sign*normalizeAngle(object_angle-ego_angle)*config_.nominal_radius;
        if (config_.gs_body_collision_guard ? ahead<=0.0 : ahead+0.5*object.length < -support) continue; // Rear is checked by the body collision guard.
        arc=std::max(0.0,ahead-0.5*object.length-support);
      }
    }
    if (exiting) {
      // On departure the route, rather than the remaining ring, defines ahead.
      const auto object_route = projectToPolyline(input.route, object.position);
      if (!ego_route.valid || !object_route.valid ||
          ego_route.distance > config_.route_projection_tolerance ||
          object_route.distance > config_.exit_lead_lateral_tolerance ||
          object_route.s <= ego_route.s) continue;
      arc = std::max(0.0, object_route.s - ego_route.s - 0.5 * object.length -
                         0.5 * config_.gs_ego_length);
      tangential_speed = std::max(0.0, object.velocity_x * std::cos(object_route.yaw) +
                                      object.velocity_y * std::sin(object_route.yaw));
      if (std::hypot(object.velocity_x, object.velocity_y) > config_.stationary_speed &&
          object.velocity_x * std::cos(object_route.yaw) +
          object.velocity_y * std::sin(object_route.yaw) < 0.0) continue;
    }
    if ((arc > 0.2 || ((exiting || bumper_model) && arc >= 0.0)) && arc < result.distance) {
      result.active = true;
      result.id = object.id;
      result.distance = arc;
      result.speed = tangential_speed;
    }
  }
  if (config_.gs_route_body_projection && result.active) {
    for (const auto& object : candidates) {
      if (object.id != result.id) continue;
      const auto meta = track_meta_.find(object.id);
      // Predicted publications and the synthetic remembered object cannot
      // extend this lifetime; only the last actual detection timestamp can.
      if (meta != track_meta_.end() &&
          input.now - meta->second.last_hit_time <= config_.tw_ghost_age) {
        body_front_cache_ = object;
        body_front_cache_stamp_ = meta->second.last_hit_time;
      }
      break;
    }
  }
  return result;
}

void RoundaboutMission::transition(RoundaboutState next, double now) {
  if (state_ == next) {
    return;
  }
  state_ = next;
  if (next == RoundaboutState::kCommit) committed_timed_approach_=seq_timed_approach_;
  state_enter_time_ = now;
  safe_since_ = -1.0;
  if (next != RoundaboutState::kCommit) committed_released_ids_.clear();
}

MissionConstraint RoundaboutMission::baseConstraint(
    double max_speed, const std::string& reason) const {
  MissionConstraint constraint;
  constraint.active = true;
  constraint.priority = kSpeedPriority;
  constraint.max_speed = std::max(0.0, max_speed);
  constraint.comfortable_decel = config_.comfortable_decel;
  constraint.emergency_decel = config_.emergency_decel;
  constraint.reason = reason;
  return constraint;
}

RoundaboutOutput RoundaboutMission::update(const RoundaboutInput& raw_input) {
  RoundaboutOutput output;
  auto input=raw_input;
  const bool opportunity=config_.gs_opportunity_enabled && config_.gs_spatial_arrival_check &&
      config_.gs_spatial_gap_enabled && !config_.distance_enabled && !config_.tw_enabled;
  if(opportunity) {
    for(auto& fragment:input.objects) {
      if(fragment.has_moved || fragment.confirmed || fragment.hit_count>config_.gs_duplicate_max_hits ||
          fragment.aabb_x<=0.0 || fragment.aabb_y<=0.0)continue;
      const TrackedObject* parent=nullptr;double best=std::numeric_limits<double>::infinity();
      for(const auto& car:raw_input.objects) {
        if(car.id==fragment.id || !car.has_moved || car.hit_count<config_.gs_duplicate_parent_min_hits ||
            car.aabb_x<=0 || car.aabb_y<=0)continue;
        const auto meta=track_meta_.find(car.id);
        if(meta!=track_meta_.end() && meta->second.last_hits==car.hit_count &&
            input.now-meta->second.last_hit_time>config_.tw_ghost_age)continue;
        const double d=distance(fragment.position,car.position);
        if(d>config_.gs_duplicate_distance || d>=best)continue;
        const double ix=std::max(0.0,std::min(fragment.position.x+.5*fragment.aabb_x,car.position.x+.5*car.aabb_x)-
            std::max(fragment.position.x-.5*fragment.aabb_x,car.position.x-.5*car.aabb_x));
        const double iy=std::max(0.0,std::min(fragment.position.y+.5*fragment.aabb_y,car.position.y+.5*car.aabb_y)-
            std::max(fragment.position.y-.5*fragment.aabb_y,car.position.y-.5*car.aabb_y));
        if(ix*iy/(fragment.aabb_x*fragment.aabb_y)>=config_.gs_duplicate_coverage){parent=&car;best=d;}
      }
      if(!parent)continue;
      fragment.collision_parent_id=parent->id;
      fragment.has_moved=true;fragment.velocity_valid=parent->velocity_valid;
      fragment.velocity_x=parent->velocity_x;fragment.velocity_y=parent->velocity_y;
      output.duplicate_track_ids.push_back(fragment.id);
      if(seq_target_leader_==fragment.id)seq_target_leader_=parent->id;
    }
  }
  output.tracked_object_count = static_cast<int>(input.objects.size());
  // In the cooperative MORAI mode, admission is latched once issued.
  // Live lead following and tracker/localization protections remain independent.
  const bool rear_yield_commit_lock = config_.gs_observed_entry_enabled || (config_.distance_enabled &&
      config_.distance_clearance_only && config_.distance_rear_yield &&
      config_.distance_commit_rear_yield_lock) ||
      (!config_.distance_enabled && !config_.tw_enabled && config_.gap_select_enabled &&
       config_.gs_sequential && !config_.gs_zone_rule_enabled && config_.gs_commit_rear_yield_lock);

  if (!config_.enabled) {
    if (state_ != RoundaboutState::kIdle) {
      reset(input.now);
    }
    output.reason = "mission disabled";
    return output;
  }

  if (input.ego.valid && have_previous_ego_ &&
      distance(input.ego.position, previous_ego_position_) >
          config_.reset_jump_distance) {
    reset(input.now);
  }
  if (input.ego.valid) {
    previous_ego_position_ = input.ego.position;
    have_previous_ego_ = true;
  }

  output.ego_radius = radiusFrom(config_.center, input.ego.position);
  output.ego_angle = angleFrom(config_.center, input.ego.position);
  output.distance_to_yield = input.ego.valid
                                 ? distanceToYield(input)
                                 : std::numeric_limits<double>::infinity();

  const bool localization_ok =
      input.ego.valid && (!config_.require_localization ||
                          input.localization_valid);
  if (state_ != RoundaboutState::kIdle && !localization_ok) {
    failsafe_reason_ = "localization invalid";
    transition(RoundaboutState::kFailsafe, input.now);
  }

  if (state_ == RoundaboutState::kIdle && input.ego.valid &&
      output.distance_to_yield <= config_.activation_distance &&
      entryHeadingMatches(input.ego)) {
    if (localization_ok) {
      transition(RoundaboutState::kApproach, input.now);
    } else {
      failsafe_reason_ = "localization invalid near roundabout";
      transition(RoundaboutState::kFailsafe, input.now);
    }
  }

  const bool entered_merge = egoEnteredMerge(input, conflictDistance(
      input, effectiveConflictPoint(input), output.distance_to_yield));
  if (state_ == RoundaboutState::kFailsafe && localization_ok) {
    const auto recovered=config_.gs_observed_entry_enabled
        ? (committed_valid_ ? (entered_merge?RoundaboutState::kCirculate:RoundaboutState::kCommit)
                            : RoundaboutState::kApproach)
        : (entered_merge?RoundaboutState::kCirculate:RoundaboutState::kApproach);
    transition(recovered,input.now);
  }

  // A latched approval may wait behind a genuinely stopped leader. Do not
  // expire it into a new approach toward the old yield line behind the ego.
  if (state_ == RoundaboutState::kCommit && !rear_yield_commit_lock &&
      input.now - state_enter_time_ >= config_.commit_timeout_seconds &&
      !entered_merge) {
    failsafe_reason_ = "entry commit timeout";
    transition(RoundaboutState::kFailsafe, input.now);
  }

  if (input.tracker_stream_valid) last_stream_ok_time_ = input.now;
  // 트랙 메타(첫 관측, 마지막 실제 검출).
  for (const TrackedObject& o : input.objects) {
    if(o.collision_parent_id>=0)continue;
    TrackMeta& m = track_meta_[o.id];
    if (m.last_hits < 0) { m.first_seen = input.now; m.last_hit_time = input.now; }
    if (o.hit_count != m.last_hits) { m.last_hits = o.hit_count; m.last_hit_time = input.now; }
    m.last_seen = input.now;
    const double sp = o.velocity_valid ? std::hypot(o.velocity_x, o.velocity_y) : 0.0;
    if (sp >= 0.5) m.stop_since = -1.0;
    else if (m.stop_since < 0.0) m.stop_since = input.now;
    // 길이: 최근 2 s 관측 중간값(클러스터가 잠깐 합쳐진 7 m 같은 값을 거른다), [min_vehicle_length, 7.5].
    m.lengths.emplace_back(input.now, o.length);
    while (m.lengths.size() > 1U && m.lengths.front().first < input.now - 2.0) m.lengths.pop_front();
    std::vector<double> ls;
    for (const auto& q : m.lengths) ls.push_back(q.second);
    std::nth_element(ls.begin(), ls.begin() + ls.size() / 2, ls.end());
    m.length = std::min(config_.distance_enabled?14.0:7.5, std::max(config_.gs_min_vehicle_length, ls[ls.size() / 2]));
  }
  for (auto it = track_meta_.begin(); it != track_meta_.end();)
    it = input.now - it->second.last_seen > 3.0 ? track_meta_.erase(it) : std::next(it);

  GapResult gap;
  const bool acc_only_active=(config_.gs_observed_entry_enabled || (opportunity && config_.gs_commit_acc_only)) && committed_valid_ &&
      (state_==RoundaboutState::kCommit || state_==RoundaboutState::kCirculate || state_==RoundaboutState::kExit ||
       (config_.gs_observed_entry_enabled && state_==RoundaboutState::kFailsafe));
  if(acc_only_active) {
    // Admission was latched. Update display positions only: no gap feasibility
    // or swept-body collision forecast after approval. Live front ACC owns speed.
    gap.safe=true;gap.strict_go=true;gap.leader_id=committed_leader_;gap.follower_id=committed_follower_;
    gap.reason="approval latched; ACC only";gap.observed_free_length=approved_free_;
    gap.physical_gap_length=approved_physical_;gap.launch_speed_limit=approved_merge_speed_;gap.trajectory_observation="approval_fixed";
    gap.ego_zone_time=approved_entry_;gap.clear_time=approved_clear_;
    gap.conflict_distance=conflictDistance(input,last_conflict_point_,output.distance_to_yield);
    last_gap_select_active_=true;last_stream_.clear();
    for(const auto& object:input.objects) {
      if(object.collision_parent_id>=0)continue;
      double angle=0,speed=0;if(!isCirculatingObject(object,&angle,&speed))continue;
      RoundaboutVehicleViz car;car.id=object.id;
      car.pos=(config_.counter_clockwise?1.:-1.)*normalizeAngle(angle-last_conflict_angle_)*config_.nominal_radius;
      car.length=streamVehicleLength(object,input.objects_stamp>=0?input.objects_stamp:input.now);
      car.physical_speed=std::hypot(object.velocity_x,object.velocity_y);car.speed=speed;
      car.confirmed=object.confirmed;car.measured_position=object.position;car.measured_position_valid=true;
      last_stream_.push_back(car);
      if(object.id==committed_leader_){gap.has_leader=true;gap.leader_pos=car.pos;gap.leader_length=car.length;gap.leader_speed=car.physical_speed;}
    }
    for(auto& viz:last_gaps_)if(viz.selected) {
      viz.go=true;viz.feasible=true;viz.preview=false;viz.failure_reason.clear();
      for(const auto& car:last_stream_) {
        if(car.id==committed_leader_)viz.hi=car.pos-.5*car.length;
        if(car.id==committed_follower_)viz.lo=car.pos+.5*car.length;
      }
    }
  } else {
    gap=config_.distance_enabled ? evaluateDistance(input, output.distance_to_yield) : config_.tw_enabled
        ? evaluateTimeWindow(input, output.distance_to_yield) : config_.gap_select_enabled
        ? evaluateGapSelect(input, output.distance_to_yield) : evaluateGap(input, output.distance_to_yield);
  }
  output.gap_select_active = config_.gap_select_enabled && last_gap_select_active_;
  if (output.gap_select_active) {
    output.effective_conflict_point = last_conflict_point_;
    output.conflict_angle = last_conflict_angle_;
    output.gaps = last_gaps_;
    output.stream = last_stream_;
  }
  output.gap_leader_id = gap.leader_id;
  output.gap_follower_id = gap.follower_id;
  output.gap_depart_delay = gap.depart_delay;
  output.future_departure=gap.future_departure;output.gap_switch_reason=gap.switch_reason;
  output.future_front_gap=gap.future_front;output.future_rear_gap=gap.future_rear;
  output.conflict_distance = gap.conflict_distance;
  output.ego_zone_time = gap.ego_zone_time;
  output.ego_prediction_speed = gap.ego_prediction_speed;
  output.ego_reference_time=gap.ego_reference_time;
  output.ego_delay_remaining=gap.ego_delay_remaining;output.ego_leader_limited=gap.ego_leader_limited;output.ego_curve_limited=gap.ego_curve_limited;
  output.predicted_front_gap=gap.predicted_front;output.predicted_rear_gap=gap.predicted_rear;
  output.current_rear_gap=gap.current_rear;output.required_rear_decel=gap.rear_decel;output.ego_clear_time=gap.clear_time;
  output.observed_free_length=gap.observed_free_length;output.physical_gap_length=gap.physical_gap_length;
  output.preparation_speed=gap.preparation_speed;output.preparation_stop_distance=gap.preview_stop_distance;
  output.acceleration_start_delay=gap.future_departure;output.trajectory_observation=gap.trajectory_observation;
  output.gap_safe = gap.safe && (!config_.gs_observed_entry_enabled ||
      committed_valid_ || output.distance_to_yield<=config_.gs_entry_commit_distance);
  output.blocking_object_id = gap.blocking_object_id;
  output.next_npc_ttc = gap.next_npc_ttc;
  output.front_gap = gap.front_gap;
  const double required_safe_confirm_seconds =
      config_.distance_enabled ? std::max(0.0,config_.distance_confirm) : config_.tw_enabled ? std::max(0.0, config_.tw_confirm) :
      config_.gap_select_enabled
          ? std::max(0.0, config_.gs_zone_rule_enabled
                              // 사전 확인이면 쌍 확인이 이미 끝났으므로 여기서 다시 기다리지 않는다.
                              ? (zone_preconfirm_active_ ? 0.0 : config_.gs_zone_confirm_seconds)
                              : config_.gs_confirm_seconds)
          : relaxedThreshold(config_.safe_confirm_seconds,
                             config_.safe_confirm_relax_floor,
                             yieldRelaxation(input.now));

  std::string mandatory_stop_reason;
  bool mandatory_stop_pending =
      config_.mandatory_stop_seconds > 0.0 &&
      !mandatory_stop_completed_ &&
      (state_ == RoundaboutState::kApproach ||
       state_ == RoundaboutState::kYield);
  if (mandatory_stop_pending) {
    const double distance_to_stop_target = std::max(
        0.0, output.distance_to_yield - config_.stop_buffer);
    const bool at_stop_target =
        distance_to_stop_target <=
        config_.mandatory_stop_position_tolerance;
    const bool fully_stopped =
        input.ego.speed <= config_.mandatory_stop_speed_threshold;

    if (at_stop_target && fully_stopped) {
      if (mandatory_stop_since_ < 0.0) {
        mandatory_stop_since_ = input.now;
      }
      const double elapsed =
          std::max(0.0, input.now - mandatory_stop_since_);
      if (elapsed >= config_.mandatory_stop_seconds) {
        if (!mandatory_stop_completed_) mandatory_stop_completed_time_ = input.now;
        mandatory_stop_completed_ = true;
        mandatory_stop_pending = false;
      } else {
        std::ostringstream reason;
        reason.setf(std::ios::fixed);
        reason.precision(1);
        reason << "mandatory stop " << elapsed << "/"
               << config_.mandatory_stop_seconds << "s\n" << gap.reason;
        mandatory_stop_reason = reason.str();
      }
    } else {
      mandatory_stop_since_ = -1.0;
      mandatory_stop_reason = at_stop_target
                                  ? "mandatory stop: waiting for 0 km/h"
                                  : "approaching mandatory stop line";
    }
  }

  // 2026-10-06: 의무 정지를 끈 경우(굴러가며 판단) 대기 완화(zone_relax_from_stop)는 양보선에서 실제로 선 시각부터 센다.
  if (config_.mandatory_stop_seconds <= 0.0 && !mandatory_stop_completed_ &&
      state_ == RoundaboutState::kYield &&
      input.ego.speed <= config_.mandatory_stop_speed_threshold) {
    mandatory_stop_completed_ = true;
    mandatory_stop_completed_time_ = input.now;
  }

  // 진입한 뒤 정지 명령이 생기지 않도록 물리적 위치가 우선한다.
  if ((state_ == RoundaboutState::kApproach ||
       state_ == RoundaboutState::kYield ||
       state_ == RoundaboutState::kCommit) &&
      (!config_.gs_observed_entry_enabled || (state_==RoundaboutState::kCommit && committed_valid_)) &&
      localization_ok && entered_merge) {
    transition(RoundaboutState::kCirculate, input.now);
    commit_aborted_ = false;
  }

  if(config_.gs_observed_entry_enabled && !committed_valid_ && entered_merge &&
      (state_==RoundaboutState::kApproach || state_==RoundaboutState::kYield)) {
    gap.safe=gap.strict_go=false;gap.preview_ready=gap.preparation_valid=false;output.gap_safe=false;
    gap.reason="unapproved physical entry; no automatic GO";
    for(auto& viz:output.gaps)if(viz.selected){viz.go=false;viz.feasible=false;viz.failure_reason="unapproved_entry";}
  }

  if (state_ == RoundaboutState::kApproach ||
      state_ == RoundaboutState::kYield) {
    // 진입을 한 번 중단했으면(늦게 잡힌 뒤차 등) 다시 출발은 엄격한 기준만 쓴다.
    // 앞차 쪽 허용(go_tolerance_front)으로 곧바로 재진입해 COMMIT<->YIELD 가
    // 0.1 s 안에 오가지 않게.
    bool go_now =
        (config_.gap_select_enabled && commit_aborted_) ? gap.strict_go : gap.safe;
    if (commit_aborted_ && input.ego.speed > config_.mandatory_stop_speed_threshold)
      go_now = false; // finish the abort stop before issuing another commit
    if (mandatory_stop_pending) {
      safe_since_ = -1.0;
      if (output.distance_to_yield <= config_.decision_distance) {
        transition(RoundaboutState::kYield, input.now);
      }
    } else if (!go_now || (config_.gs_observed_entry_enabled && output.distance_to_yield>config_.gs_entry_commit_distance)) {
      safe_since_ = -1.0;
      confirm_leader_=confirm_follower_=-2;confirm_scan_stamp_=-1;
      if (output.distance_to_yield <= config_.decision_distance) {
        transition(RoundaboutState::kYield, input.now);
      }
    } else {
      if(config_.gs_observed_entry_enabled &&
          (confirm_leader_!=gap.leader_id || confirm_follower_!=gap.follower_id)) {
        safe_since_=-1;confirm_leader_=gap.leader_id;confirm_follower_=gap.follower_id;
      }
      if (safe_since_ < 0.0) {
        safe_since_ = input.now;
        confirm_scan_stamp_=input.objects_stamp;
        confirm_observation_stamp_=input.observation.frames.empty()?-1:input.observation.frames.back()->stamp;
      }
      // 2026-10-06: 의무 정지 없이 판단할 때는 판단 구간에 들어와 yield_roll 속도로 줄인 뒤에만 진입 확정한다
      //   (빠르게 달리며 짧게 본 틈으로 확정 -> 늦게 잡힌 뒤차에 취소. 18:35:52 재생 10.9 s, 7.2 m/s).
      //   그 전에는 YIELD 로 넘겨 굴러가기 상한을 걸고, 안전 확인 시간은 그대로 쌓는다.
      const bool roll_mode = config_.mandatory_stop_seconds <= 0.0 && config_.yield_roll_speed > 0.0;
      const bool roll_ready = config_.gs_observed_entry_enabled
          ? output.distance_to_yield<=config_.gs_entry_commit_distance
          : (config_.gs_spatial_gap_enabled && config_.gs_spatial_only_admission) || !roll_mode ||
            (output.distance_to_yield <= (opportunity?config_.gs_entry_commit_distance:config_.yield_go_distance) &&
             input.ego.speed <= (opportunity?config_.gs_entry_commit_max_speed:config_.yield_roll_speed + 0.5));
      if (roll_mode && !roll_ready && state_ == RoundaboutState::kApproach &&
          output.distance_to_yield <= config_.decision_distance) {
        const double keep = safe_since_;
        transition(RoundaboutState::kYield, input.now);
        safe_since_ = keep;
      }
      const bool scan_confirmed=!config_.gs_observed_entry_enabled ||
          (input.objects_stamp>confirm_scan_stamp_ && input.objects_stamp-confirm_scan_stamp_>=required_safe_confirm_seconds-1e-6 &&
           !input.observation.frames.empty() && input.observation.frames.back()->stamp>confirm_observation_stamp_ &&
           input.observation.frames.back()->stamp-confirm_observation_stamp_>=required_safe_confirm_seconds-1e-6);
      if (roll_ready && scan_confirmed && input.now - safe_since_ >= required_safe_confirm_seconds) {
        transition(RoundaboutState::kCommit, input.now);
        committed_valid_ = config_.gap_select_enabled;
        approval_time_=input.now;approval_distance_=output.distance_to_yield;
        approved_free_=gap.observed_free_length;approved_entry_=gap.ego_zone_time;approved_clear_=gap.clear_time;approved_merge_speed_=gap.launch_speed_limit;approved_physical_=gap.physical_gap_length;
        committed_released_ids_ = yield_released_ids_;
        committed_leader_ = gap.leader_id;
        committed_follower_ = gap.follower_id;
        committed_wrap_ = gap.wrap;
        if(config_.gs_spatial_arrival_check && committed_leader_>=0) {
          for(const auto& object:input.objects)if(object.id==committed_leader_) {
            body_front_cache_=object;const auto meta=track_meta_.find(object.id);
            body_front_cache_stamp_=meta==track_meta_.end()?-1.0:meta->second.last_hit_time;break;
          }
        }
      }
    }
  }

  if (state_ == RoundaboutState::kCommit && !entered_merge) {
    if (rear_yield_commit_lock) {
      commit_unsafe_since_ = -1.0;
    } else if (config_.gap_select_enabled && config_.gs_commit_abort_enabled) {
      // ★ 들어가던 틈이 무너지면(늦게 잡힌 뒤차 등) 링 앞에서 편하게 설 수
      //   있을 때만 다시 양보한다. 12:50 백: 출발 직후 -20 m 뒤차가 확정되며
      //   틈이 무너졌지만 그대로 진입해 0.54 s 간격으로 합류했다.
      if (commitGapOk(gap)) {
        commit_unsafe_since_ = -1.0;
      } else {
        if (commit_unsafe_since_ < 0.0) {
          commit_unsafe_since_ = input.now;
        }
        const double stop_room = holdStopDistance(gap);
        const double v = std::max(0.0, input.ego.speed);
        const double need = v * std::max(0.0, config_.gs_stop_reaction_time) +
            v * v / (2.0 * std::max(0.5, config_.comfortable_decel)) +
            std::max(0.0, config_.gs_stop_margin);
        if (input.now - commit_unsafe_since_ >= (config_.distance_enabled ? config_.distance_pair_invalid : config_.gs_commit_abort_confirm) &&
            std::isfinite(stop_room) && need <= stop_room) {
          commit_unsafe_since_ = -1.0;
          commit_aborted_ = true;
          transition(RoundaboutState::kYield, input.now);
        }
      }
    } else if (output.distance_to_yield > 1.0 && input.ego.speed < 2.5 &&
               !gap.safe) {
      // 아직 원형 차로에 진입하기 전(양보선 부근)이고 저속인 상태에서
      // 순환 차량이 급접근(위험 gap 또는 TTC 임계 이하)하는 경우 안전하게 다시 YIELD로 복귀
      transition(RoundaboutState::kYield, input.now);
    }
  } else {
    commit_unsafe_since_ = -1.0;
  }

  if (state_ == RoundaboutState::kCirculate &&
      input.now - state_enter_time_ >= config_.minimum_circulate_seconds &&
      (distance(input.ego.position, config_.exit_point) <=
           config_.exit_detection_radius ||
       (config_.auto_exit &&
        output.ego_radius > config_.outer_radius +
                                std::max(0.0, config_.auto_exit_radius_margin)))) {
    transition(RoundaboutState::kExit, input.now);
  }

  if (state_ == RoundaboutState::kExit &&
      input.now - state_enter_time_ >= config_.exit_hold_seconds &&
      distance(input.ego.position, config_.exit_point) >=
          config_.exit_clear_distance) {
    reset(input.now);
  }

  bool preparation_confirmed=false;
  if(config_.gs_preparation_enabled && !committed_valid_) {
    if(!localization_ok || state_==RoundaboutState::kFailsafe || !gap.preparation_valid || mandatory_stop_pending || !trackerStreamUsable(input) ||
        !input.observation.fresh(input.now,config_.gs_observation_timeout) ||
        output.distance_to_yield>config_.gs_entry_commit_distance) {
      preparation_since_=-1;preparation_leader_=preparation_follower_=-2;
    } else {
      if(preparation_since_<0 || preparation_leader_!=gap.leader_id || preparation_follower_!=gap.follower_id) {
        preparation_since_=input.now;preparation_leader_=gap.leader_id;preparation_follower_=gap.follower_id;
        preparation_scan_=input.objects_stamp;preparation_observation_=input.observation.frames.back()->stamp;
      }
      preparation_confirmed=input.now-preparation_since_>=config_.gs_confirm_seconds &&
          input.objects_stamp-preparation_scan_>=config_.gs_confirm_seconds-1e-6 &&
          input.observation.frames.back()->stamp-preparation_observation_>=config_.gs_confirm_seconds-1e-6;
    }
  }
  output.state = state_;
  switch (state_) {
    case RoundaboutState::kIdle:
      output.reason = "outside mission zone";
      break;
    case RoundaboutState::kApproach:
    case RoundaboutState::kYield: {
      // 의무 정지 없이 판단할 때는 판단 구간(YIELD)에서 천천히 굴러가며 본다. 진입 불가면 아래에서 양보선 정지.
      const double approach_room=std::max(0.0,output.distance_to_yield-
          (config_.gs_preparation_enabled?config_.gs_preparation_wait_distance:config_.yield_go_distance));
      const double approach_decel=std::max(0.1,config_.gs_adaptive_approach
          ? std::min(config_.gs_approach_decel,config_.comfortable_decel)
          : config_.gs_approach_decel);
      const double response=config_.gs_adaptive_approach?std::max(0.0,config_.gs_approach_response):0.0;
      const double stopping_room=std::max(0.0,input.ego.speed*input.ego.speed-config_.yield_roll_speed*config_.yield_roll_speed)/(2.0*approach_decel);
      const double slow_distance=std::max(config_.gs_approach_slow_distance,
          config_.yield_go_distance+stopping_room+std::max(0.0,input.ego.speed)*response);
      if(config_.gs_adaptive_approach && output.distance_to_yield<=slow_distance) spatial_approach_braking_=true;
      const double spatial_approach_cap=std::max(0.0,std::sqrt(approach_decel*approach_decel*response*response+
          config_.yield_roll_speed*config_.yield_roll_speed+2.0*approach_decel*approach_room)-approach_decel*response);
      const double yield_speed = config_.gs_spatial_gap_enabled
          ? (config_.gs_adaptive_approach
              ? (spatial_approach_braking_?spatial_approach_cap:-1.0)
              : (output.distance_to_yield > config_.gs_approach_slow_distance
                  ? -1.0 : std::min(config_.approach_speed,spatial_approach_cap))) :
          (!mandatory_stop_pending && state_ == RoundaboutState::kYield &&
           config_.yield_roll_speed > 0.0)
              ? std::min(config_.approach_speed, config_.yield_roll_speed)
              : config_.approach_speed;
      output.constraint = baseConstraint(yield_speed, gap.reason);
      if (yield_speed < 0.0) output.constraint.max_speed=-1.0; // Message contract: no speed limit.
      const bool confirmed = gap.safe && safe_since_ >= 0.0 &&
                             input.now - safe_since_ >=
                                 required_safe_confirm_seconds;
      if (mandatory_stop_pending || !gap.safe || !confirmed) {
        output.constraint.priority = kYieldPriority;
        output.constraint.stop_required = true;
        // ★ 의무 정지 전에는 양보선(stop_buffer) 기준으로 세우고, 정지를
        //   마친 뒤에는 creep_buffer 위치까지 전진해서 기다린다.
        //   양보선 뒤에서는 중앙분리대에 가려 순환 차량이 105° 밖에
        //   안 보인다(실측 2026-09-10). 규정 정지는 지키되 관측은
        //   시야가 열리는 앞에서 한다.
        const double hold_buffer = mandatory_stop_pending
                                       ? config_.stop_buffer
                                       : (config_.gs_preparation_enabled?config_.gs_preparation_wait_distance:config_.creep_buffer);
        output.constraint.stop_distance =
            std::max(0.0, output.distance_to_yield - hold_buffer);
        // 의무정지를 마치고 양보선을 이미 지나 있으면(COMMIT 중 양보 복귀)
        // 그 자리 급정지 대신 합류 구역 앞에 세운다.
        // 2026-10-06(18:58:36 백): 취소 제동 뒤 양보선 8.4 m 전에 서서 상한 0 이 풀리지 않았다.
        //   즉시 제동은 움직이는 동안(또는 이미 양보선 위/너머)만, 양보선 전에 섰으면 양보선 정지 목표로 돌아가 다가간다.
        if (config_.gap_select_enabled && commit_aborted_ &&
            std::isfinite(gap.conflict_distance) &&
            (input.ego.speed > config_.mandatory_stop_speed_threshold ||
             output.distance_to_yield <= 0.5)) {
          // Abort means brake now, not drive toward a later hold line.
          output.constraint.stop_distance = 0.0;
          output.constraint.max_speed = 0.0;
        }
        if (mandatory_stop_pending) {
          output.constraint.reason = mandatory_stop_reason;
        } else if (gap.safe) {
          output.constraint.reason = "confirming safe gap";
        }
      }
      // A valid far-away prediction is not yet GO. Retain the yield target
      // until the rolling-speed/distance gate actually commits the entry.
      if(config_.gs_spatial_arrival_check && confirmed) {
        output.constraint.stop_required=true;
        output.constraint.stop_distance=std::max(0.0,output.distance_to_yield);
      }
      if (!config_.gs_preparation_enabled && config_.gs_spatial_arrival_check && gap.preview_ready && !gap.safe &&
          !mandatory_stop_pending && !commit_aborted_ && trackerStreamUsable(input) &&
          output.distance_to_yield<=config_.yield_go_distance+2.0) {
        output.constraint.stop_required=true;
        output.constraint.stop_distance=gap.preview_stop_distance;
        const double preview_cap=std::min(config_.yield_roll_speed,gap.entry_approach_cap);
        output.constraint.max_speed=output.constraint.max_speed<0.0?preview_cap:
            std::min(output.constraint.max_speed,preview_cap);
        output.constraint.reason="following leader before entry; checking arrival space";
      }
      if(config_.gs_preparation_enabled) {
        output.entry_phase=gap.safe?"confirming":"waiting";
        if(preparation_confirmed) {
          const double room=std::max(0.,gap.preview_stop_distance);
          const double a=std::max(.5,std::min(config_.comfortable_decel,config_.gs_approach_decel));
          const double reaction=std::max(0.,config_.gs_approach_response);
          const double brake_cap=std::max(0.,std::sqrt(a*a*reaction*reaction+2*a*room)-a*reaction);
          output.constraint.stop_required=true;output.constraint.stop_distance=room;
          output.constraint.max_speed=std::min(gap.preparation_speed,brake_cap);
          output.constraint.reason="preparing entry; final approval pending";output.entry_phase="preparing";
        }
      }
      output.reason = output.constraint.reason;
      break;
    }
    case RoundaboutState::kCommit:
      if (config_.require_tracker_stream && !trackerStreamUsable(input)) {
        output.constraint = baseConstraint(
            std::min(config_.circulation_speed, config_.degraded_speed),
            "entry committed; LiDAR tracker degraded");
      } else {
        output.constraint = baseConstraint(config_.circulation_speed,
            rear_yield_commit_lock ? (config_.gs_spatial_arrival_check
                ? ((opportunity && config_.gs_commit_acc_only)?"entry committed; approval latched; ACC only":"entry committed; approval latched; body guard active")
                : "entry committed; approval latched; rear yields")
                                   : "entry committed");
        if(config_.gs_preparation_enabled && approved_merge_speed_>0.)
          output.constraint.max_speed=std::min(output.constraint.max_speed,approved_merge_speed_);
        if (config_.gs_timed_entry_approach) {
          output.constraint.max_speed=std::min(output.constraint.max_speed,gap.entry_approach_cap);
          if (std::isfinite(gap.entry_approach_cap))
            output.constraint.reason="entry committed; timing front clearance";
          if (config_.gs_spatial_gap_enabled && gap.reason=="spatial slot passed; waiting for next slot space")
            output.constraint.reason=gap.reason;
        }
        // 고른 틈의 앞차를 진입 중 추종 대상으로 넘긴다(링 진입 뒤에는
        // findLeadVehicle 이 이어받는다).
        // 들어가고 있는 틈(GO)의 앞차가 합류점 하류에 있을 때만. 틈이 바뀐
        // 프레임(예: 늦게 잡힌 상류 차량)에서 상류 차량을 앞차로 넘기면
        // 거리 0 으로 잘려 급정지 명령이 된다.
        if (!config_.gs_route_body_projection && config_.gap_select_enabled && (commitGapOk(gap) || rear_yield_commit_lock) && gap.has_leader &&
            gap.leader_pos > -0.5 * std::max(0.1, gap.leader_length) &&
            (!config_.distance_enabled || rear_yield_commit_lock ||
             gap.leader_pos - 0.5 * std::max(0.1,gap.leader_length) >= config_.gs_standstill_gap) &&
            std::isfinite(gap.conflict_distance)) {
          const double lead_gap = gap.conflict_distance + gap.leader_pos -
                                  0.5 * std::max(0.1, gap.leader_length) -
                                  0.5 * std::max(0.1, config_.gs_ego_length);
          if (lead_gap < config_.lead_search_distance) {
            output.constraint.lead_vehicle_active = true;
            output.constraint.lead_vehicle_id = gap.leader_id;
            output.constraint.lead_distance = std::max(0.0, lead_gap);
            output.constraint.lead_speed = gap.leader_speed;
          }
          output.constraint.reason = rear_yield_commit_lock
              ? "entry committed; approval latched; front following"
              : "entry committed; " + gap.reason;
        }
        // ★ 2026-09-30: 고른 틈의 앞차가 아직 합류점을 다 지나지 않았으면(상류에서
        //   다가오는 앞차를 먼저 보내는 틈) 합류 구역 앞에 정지 목표를 둔다.
        //   앞차 추종은 앞차가 합류점 하류일 때만 넘기므로, 앞차가 예측보다 더
        //   느려지면(12:34 백: 7 -> 4 m/s) 자차가 앞차보다 먼저 합류 구역에 닿을
        //   수 있었다. 앞차 뒤끝이 합류점을 standstill_gap 만큼 지나면 풀린다.
        if (!config_.distance_enabled && !rear_yield_commit_lock && config_.gap_select_enabled && commitGapOk(gap) && gap.has_leader &&
            gap.leader_pos - 0.5 * std::max(0.1, gap.leader_length) <
                config_.gs_standstill_gap &&
            std::isfinite(gap.conflict_distance)) {
          // 2026-10-05(16:13 백: 진입 확정 뒤 1.6 s 정지): 앞차가 움직이고 있고, 자차가 지금부터
          // 가속해 합류점에 닿는 시간보다 앞차 뒤끝이 standstill_gap 을 비우는 시간이 margin 이상 빠르면 세우지 않는다.
          const double leader_clear = config_.gs_standstill_gap -
              (gap.leader_pos - 0.5 * std::max(0.1, gap.leader_length));
          const double v0 = std::max(0.0, input.ego.speed);
          const double a = std::max(0.2, config_.gs_leader_release_accel);
          const double d = std::max(0.0, gap.conflict_distance);
          const double t_ego = (-v0 + std::sqrt(v0 * v0 + 2.0 * a * d)) / a;
          const bool release = config_.gs_leader_release_margin > 0.0 &&
              gap.leader_speed >= config_.gs_leader_release_min_speed &&
              leader_clear / gap.leader_speed + config_.gs_leader_release_margin <= t_ego;
          if (!release) {
            output.constraint.stop_required = true;
            output.constraint.stop_distance = holdStopDistance(gap);
            output.constraint.reason =
                "entry committed; waiting leader to pass; " + gap.reason;
          } else {
            output.constraint.reason =
                "entry committed; leader clears before arrival; " + gap.reason;
          }
        }
      }
      // 2026-10-06(18:35:52 백): 진입 중 정지 트랙(id10/12/13)이 새로 잡혀 틈 대상이 바뀌자 앞차(id6) 정지 목표·
      //   추종이 통째로 사라졌고, 앞차 4 m 뒤에서 7.9 m/s 까지 가속해 부딪혔다. 틈 판단과 무관하게 원형 차로의
      //   움직이는 앞차를 항상 추종한다(더 가까운 쪽).
      if (!(config_.require_tracker_stream && !trackerStreamUsable(input))) {
        const LeadResult lead = findLeadVehicle(input);
        if (lead.active && (!output.constraint.lead_vehicle_active ||
                            lead.distance < output.constraint.lead_distance)) {
          output.constraint.lead_vehicle_active = true;
          output.constraint.lead_vehicle_id = lead.id;
          output.constraint.lead_distance = lead.distance;
          output.constraint.lead_speed = lead.speed;
        }
      }
      if (config_.gap_select_enabled && config_.gs_commit_abort_enabled &&
          !rear_yield_commit_lock && !entered_merge && !commitGapOk(gap)) {
        const double v = std::max(0.0, input.ego.speed);
        const double need = v * std::max(0.0, config_.gs_stop_reaction_time) +
            v * v / (2.0 * std::max(0.5, config_.comfortable_decel)) +
            std::max(0.0, config_.gs_stop_margin);
        const bool imminent=config_.distance_enabled &&
            (gap.predicted_front<.5||gap.predicted_rear<.5||gap.reason.find("unavailable")!=std::string::npos||gap.reason.find("missing")!=std::string::npos||gap.reason.find("gap passed")!=std::string::npos);
        const bool confirmed_unsafe=!config_.distance_enabled||imminent||
            (commit_unsafe_since_>=0&&input.now-commit_unsafe_since_>=config_.distance_pair_invalid);
        // A front collision is not made safe by insufficient room to stop at
        // the yield line. Brake immediately instead of continuing into it.
        const bool front_emergency = config_.distance_enabled &&
            gap.predicted_front < config_.distance_front_gap;
        if ((confirmed_unsafe && need <= holdStopDistance(gap)) || front_emergency) {
          output.constraint.priority = kYieldPriority;
          output.constraint.stop_required = true;
          output.constraint.stop_distance = 0.0;
          output.constraint.max_speed = 0.0;
          output.constraint.reason = "entry gap unsafe; braking during abort confirmation";
        }
      }
      output.reason = output.constraint.reason;
      break;
    case RoundaboutState::kCirculate:
    case RoundaboutState::kExit: {
      const bool exiting = state_ == RoundaboutState::kExit;
      const bool tracker_degraded =
          config_.require_tracker_stream && !input.tracker_stream_valid;
      const double normal_speed =
          exiting ? config_.exit_speed : config_.circulation_speed;
      output.constraint = baseConstraint(
          tracker_degraded ? std::min(normal_speed, config_.degraded_speed)
                           : normal_speed,
          tracker_degraded
              ? "LiDAR tracker degraded; low-speed circulation"
              : (exiting ? "leaving roundabout" : "circulating"));
      const LeadResult lead =
          tracker_degraded ? LeadResult() : findLeadVehicle(input);
      if (lead.active) {
        output.constraint.lead_vehicle_active = true;
        output.constraint.lead_vehicle_id = lead.id;
        output.constraint.lead_distance = lead.distance;
        output.constraint.lead_speed = lead.speed;
      }
      output.reason = output.constraint.reason;
      break;
    }
    case RoundaboutState::kFailsafe:
      output.constraint = baseConstraint(0.0, failsafe_reason_);
      output.constraint.priority = kEmergencyPriority;
      output.constraint.stop_required = true;
      output.constraint.stop_distance = 0.0;
      output.reason = output.constraint.reason;
      break;
  }

  if(output.constraint.lead_vehicle_active&&
     config_.gs_prediction_follow_time_gap>0.){
    output.constraint.lead_profile_override=true;
    output.constraint.lead_standstill_distance=config_.gs_prediction_follow_standstill_gap;
    output.constraint.lead_time_gap=config_.gs_prediction_follow_time_gap;
    if((config_.distance_enabled && config_.distance_measured_profile) || config_.gs_measured_entry_profile){
      double ratio=1.0;
      if (config_.gs_route_body_projection) {
        const double a=angleFrom(config_.center,input.ego.position);
        ratio=std::max(0.1,std::cos(normalizeAngle(input.ego.yaw-tangentYaw(a,config_.counter_clockwise)))*
            config_.nominal_radius/std::max(1.0,radiusFrom(config_.center,input.ego.position)));
      }
      const double braking_cap=frontBrakingSpeedCap(output.constraint.lead_distance,
          output.constraint.lead_speed,config_.gs_prediction_follow_standstill_gap,
          std::max(.5,config_.comfortable_decel*ratio),config_.distance_front_response,
          config_.distance_front_max_decel,input.ego.speed*ratio)/ratio;
      const double usable=std::max(0.0,output.constraint.lead_distance-config_.gs_prediction_follow_standstill_gap);
      const double headway_cap=std::max(0.0,output.constraint.lead_speed+
          (usable-config_.gs_prediction_follow_time_gap*input.ego.speed*ratio)/config_.gs_prediction_follow_time_gap)/ratio;
      output.constraint.max_speed=std::min(output.constraint.max_speed,
          config_.gs_route_body_projection?std::min(braking_cap,headway_cap):braking_cap);
      if (config_.gs_route_body_projection) {
        // The scalar controller ACC compares parallel velocities. During the
        // crossing, the projected body constraint above owns the speed cap.
        output.constraint.lead_vehicle_active=false;
        output.constraint.lead_profile_override=false;
      }
    }
  }
  if (config_.gs_body_collision_guard && !((config_.gs_observed_entry_enabled || (opportunity && config_.gs_commit_acc_only)) && committed_valid_) && (state_==RoundaboutState::kCommit ||
      state_==RoundaboutState::kCirculate)) {
    int collision_id=-1;
    if(bodyCollisionRisk(input,output.constraint.max_speed<0?config_.circulation_speed:output.constraint.max_speed,&collision_id)) {
      output.constraint.max_speed=0.0;output.constraint.priority=kEmergencyPriority;
      output.constraint.stop_required=true;output.constraint.stop_distance=0.0;
      output.constraint.reason="body collision guard id"+std::to_string(collision_id);
      output.reason=output.constraint.reason;
    }
  }
  if(committed_valid_)output.entry_phase="committed";
  output.approval_latched=committed_valid_ && approval_time_>=0;
  output.approval_time=approval_time_;output.approval_distance=approval_distance_;
  output.confirmation_time=safe_since_<0?0:std::max(0.,input.now-safe_since_);
  output.observation_stamp=input.observation.frames.empty()?-1:input.observation.frames.back()->stamp;
  output.observation_state=input.observation.fresh(input.now,config_.gs_observation_timeout)?"observed":"unknown";
  return output;
}

}  // namespace mission_planner
