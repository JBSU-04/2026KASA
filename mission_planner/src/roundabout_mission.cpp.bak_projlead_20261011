RoundaboutMission::RoundaboutMission(const RoundaboutConfig& config)
    : config_(config) {}

void RoundaboutMission::setConfig(const RoundaboutConfig& config) {
  config_ = config;
}

void RoundaboutMission::reset(double now) {
  body_front_cache_stamp_ = -1.0;
  spatial_approach_braking_ = false;
  seq_timed_approach_ = committed_timed_approach_ = false;
  if(config_.distance_enabled)track_meta_.clear();
  distance_cache_.clear();distance_leader_=distance_follower_=-2;distance_wrap_=0;distance_bad_since_=-1;
  state_ = RoundaboutState::kIdle;
  state_enter_time_ = now;
  safe_since_ = -1.0;
  confirm_leader_=confirm_follower_=-2;confirm_scan_stamp_=confirm_observation_stamp_=-1;approval_time_=approval_distance_=-1;
  approved_free_=approved_entry_=approved_clear_=approved_physical_=0;approved_merge_speed_=0;
  preparation_since_=preparation_scan_=preparation_observation_=-1;
  preparation_leader_=preparation_follower_=-2;
  mandatory_stop_since_ = -1.0;
  mandatory_stop_completed_ = false;
  mandatory_stop_completed_time_ = -1.0;
  commit_unsafe_since_ = -1.0;
  commit_aborted_ = false;
  have_previous_ego_ = false;
  failsafe_reason_ = "localization invalid";
  gap_latch_leader_ = -2;
  gap_latch_follower_ = -2;
  have_auto_conflict_ = false;
  seq_target_leader_ = -2;
  seq_infeasible_since_ = -1.0;
  seq_last_feasible_time_ = -1.0;
  zone_pair_leader_ = zone_pair_follower_ = -2;
  zone_pair_ok_since_ = -1.0;
  zone_pair_confirmed_ = false;
  arc_hist_.clear();
  speed_hist_.clear();
  stream_travel_.clear();
  stream_speed_samples_.clear();
  stream_speed_ = -1.0;
  length_samples_.clear();
  length_estimates_.clear();
  length_prior_ = -1.0;
  zone_relax_ = 0.0;
  last_zone_relax_ = 0.0;
  stationary_since_.clear();
  yield_released_ids_.clear();
  committed_released_ids_.clear();
  last_stream_ok_time_ = -1.0;
}

const char* RoundaboutMission::stateName(RoundaboutState state) {
  switch (state) {
    case RoundaboutState::kIdle:
      return "IDLE";
    case RoundaboutState::kApproach:
      return "APPROACH";
    case RoundaboutState::kYield:
      return "YIELD";
    case RoundaboutState::kCommit:
      return "COMMIT";
    case RoundaboutState::kCirculate:
      return "CIRCULATE";
    case RoundaboutState::kExit:
      return "EXIT";
    case RoundaboutState::kFailsafe:
      return "FAILSAFE";
  }
  return "UNKNOWN";
}

double RoundaboutMission::distanceToYield(
    const RoundaboutInput& input) const {
  const PolylineProjection ego_projection =
      projectToPolyline(input.route, input.ego.position);
  const PolylineProjection yield_projection =
      projectToPolyline(input.route, config_.yield_point);

  if (ego_projection.valid && yield_projection.valid &&
      ego_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.s >= ego_projection.s - 1.0) {
    return clampNonnegative(yield_projection.s - ego_projection.s);
  }
  // 2026-10-06: 경로상 양보선을 이미 지났으면 0(그 자리 정지). 직선거리로 바꾸면 지나칠수록 정지 목표가
  //   앞으로 밀려나 계속 간다(시뮬 14:52:33: 양보선 1.4 m 넘은 뒤 dy 1.4 -> 6.5 m).
  if (ego_projection.valid && yield_projection.valid &&
      ego_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.distance <= config_.route_projection_tolerance &&
      yield_projection.s < ego_projection.s - 1.0 && !egoInsideCircle(input.ego)) {
    return 0.0;
  }
  return distance(input.ego.position, config_.yield_point);
}

bool RoundaboutMission::entryHeadingMatches(const EgoState& ego) const {
  return std::abs(normalizeAngle(ego.yaw - config_.entry_heading)) <=
         config_.entry_heading_tolerance;
}

bool RoundaboutMission::egoInsideCircle(const EgoState& ego) const {
  const double radius = radiusFrom(config_.center, ego.position);
  return radius >= config_.inner_radius && radius <= config_.outer_radius;
}

bool RoundaboutMission::egoEnteredMerge(const RoundaboutInput& input,
                                        double conflict_distance) const {
  if (!egoInsideCircle(input.ego)) return false;
  if (!config_.gs_require_merge_progress) return true;
  // A radial ROI is not the merge boundary. Use signed path progress up to
  // the actual conflict zone (ego front reaches conflict - entry_zone).
  if (!std::isfinite(conflict_distance)) return false;
  const PolylineProjection projection = projectToPolyline(input.route, input.ego.position);
  if (!projection.valid || projection.distance > config_.route_projection_tolerance)
    return false;
  return conflict_distance <= 0.5 * config_.gs_ego_length + config_.gs_entry_zone;
}

double RoundaboutMission::yieldRelaxation(double now) const {
  if (state_ != RoundaboutState::kYield) {
    return 0.0;
  }
  const double dwell = std::max(0.0, now - state_enter_time_);
  const double active_dwell =
      std::max(0.0, dwell - std::max(0.0, config_.gap_relax_start_seconds));
  return active_dwell * std::max(0.0, config_.gap_relax_rate);
}

double RoundaboutMission::relaxedThreshold(double configured, double floor,
                                           double relaxation) const {
  const double nonnegative_configured = std::max(0.0, configured);
  const double bounded_floor =
      std::min(nonnegative_configured, std::max(0.0, floor));
  return std::max(bounded_floor, nonnegative_configured - relaxation);
}

bool RoundaboutMission::isCirculatingObject(const TrackedObject& object,
                                            double* angle,
                                            double* tangential_speed) const {
  const double object_radius = radiusFrom(config_.center, object.position);
  const double inner = config_.vehicle_roi_inner_radius >= 0.0
      ? config_.vehicle_roi_inner_radius : config_.inner_radius;
  const double outer = config_.vehicle_roi_outer_radius >= 0.0
      ? config_.vehicle_roi_outer_radius : config_.outer_radius;
  const double pad=config_.distance_enabled&&object.has_moved?.3:0.;
  if (object_radius < inner-pad || object_radius > outer+pad) {
    return false;
  }

  const double object_angle = angleFrom(config_.center, object.position);
  const double speed = std::hypot(object.velocity_x, object.velocity_y);
  const double expected_yaw =
      tangentYaw(object_angle, config_.counter_clockwise);

  if (object.velocity_valid && speed > config_.stationary_speed) {
    const double velocity_yaw =
        std::atan2(object.velocity_y, object.velocity_x);
    if (std::abs(normalizeAngle(velocity_yaw - expected_yaw)) >
        config_.tangent_heading_tolerance) {
      return false;
    }
  }

  const double tangent_x = std::cos(expected_yaw);
  const double tangent_y = std::sin(expected_yaw);
  if (angle != nullptr) {
    *angle = object_angle;
  }
  if (tangential_speed != nullptr) {
    *tangential_speed = std::max(
        0.0, object.velocity_x * tangent_x + object.velocity_y * tangent_y);
  }
  return true;
}

RoundaboutMission::GapResult RoundaboutMission::evaluateGap(
    const RoundaboutInput& input, double distance_to_yield) const {
  GapResult result;
  if (config_.require_tracker_stream && !trackerStreamUsable(input)) {
    result.reason = "LiDAR tracker stream stale";
    return result;
  }

  result.safe = true;
  result.reason = "gap accepted";
  const double conflict_angle =
      angleFrom(config_.center, config_.conflict_point);
  const double ego_arrival_time =
      clampNonnegative(distance_to_yield) /
          std::max(kMinimumApproachSpeed, config_.approach_speed) +
      config_.ego_merge_time;
  // 일반 모드는 합류 완료 뒤 rear_time만큼의 추가 여유를 요구한다.
  // K-City처럼 rear_time을 최종 TTC 기준으로 직접 튜닝하는 현장은
  // rear_time_is_total_ttc=true로 두어 화면 값과 설정값을 일치시킨다.
  double configured_rear_ttc =
      config_.rear_time_is_total_ttc ? config_.rear_time_gap
                                     : ego_arrival_time + config_.rear_time_gap;

  // YIELD 대기가 길어지면 진입 기준을 설정된 하한까지 점진 완화한다.
  // 트래커 단절, 속도 미확정 객체, 정지 차량 차단 조건에는 적용하지 않는다.
  const double relaxation = yieldRelaxation(input.now);
  const double rear_relaxation =
      std::min(std::max(0.0, config_.rear_ttc_relax_max), relaxation);
  configured_rear_ttc = relaxedThreshold(
      configured_rear_ttc, config_.rear_ttc_relax_floor, rear_relaxation);

  // 예측 불확실성은 실제 TTC에서 숨겨서 빼지 않고 비교 기준에 더한다.
  // 동작은 같지만 RViz에는 센서로 계산한 실제 TTC가 그대로 표시된다.
  const double required_rear_ttc =
      configured_rear_ttc + config_.prediction_uncertainty_time;

  for (const TrackedObject& object : input.objects) {
    double object_angle = 0.0;
    double tangential_speed = 0.0;
    if (!object.confirmed ||
        !isCirculatingObject(object, &object_angle, &tangential_speed)) {
      continue;
    }

    const double vehicle_half_length = 0.5 * std::max(0.1, object.length);
    const double upstream_arc = clampNonnegative(
        circleArcDistance(object_angle, conflict_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        vehicle_half_length);
    const double downstream_arc = clampNonnegative(
        circleArcDistance(conflict_angle, object_angle, config_.nominal_radius,
                          config_.counter_clockwise) -
        vehicle_half_length);

    // 추적 초기에는 속도를 모르므로 충돌점 부근 객체를 안전 쪽으로 처리한다.
    if (!object.velocity_valid) {
      if (std::min(upstream_arc, downstream_arc) <=
          config_.uncertain_object_block_distance) {
        result.safe = false;
        result.blocking_object_id = object.id;
        result.reason = "object motion not confirmed";
      }
      continue;
    }

    if (tangential_speed <= config_.stationary_speed) {
      // 움직인 이력이 없는 정지 클러스터는 시설물일 가능성이 높다.
      if (!object.has_moved) {
        continue;
      }
      if (upstream_arc <= config_.stationary_block_distance) {
        result.safe = false;
        result.blocking_object_id = object.id;
        result.next_npc_ttc = 0.0;
        result.reason = "stationary vehicle near conflict";
      }
    }

    // 충돌점 통과 직후 차량은 진입할 앞 공간을 제한한다.
    if (downstream_arc <= config_.front_check_distance &&
        downstream_arc < result.front_gap) {
      result.front_gap = downstream_arc;
    }
    // 양보선에서 완전정지한 뒤 출발하므로 접근 제한속도를 곧바로 쓰지
    // 않고 출발 구간의 평균속도 비율을 적용한다. K-City는 0.5로 두어
    // 등가속 출발의 평균속도(approach_speed / 2)를 사용한다.
    const double departure_average_speed =
        std::max(0.0, config_.approach_speed) *
        std::max(0.0, config_.front_departure_speed_ratio);
    const double effective_front_time = relaxedThreshold(
        config_.front_time_gap, config_.front_time_relax_floor, relaxation);
    const double required_front_gap =
        std::max(0.0, config_.front_standstill_distance) +
        effective_front_time * departure_average_speed;
    if (downstream_arc <= config_.front_check_distance &&
        downstream_arc < required_front_gap) {
      result.safe = false;
      result.blocking_object_id = object.id;
      std::ostringstream reason;
      reason.setf(std::ios::fixed);
      reason.precision(2);
      reason << "front ID " << object.id << ": gap " << downstream_arc
             << "m < limit " << required_front_gap << "m";
      result.reason = reason.str();
    }

    if (tangential_speed <= config_.stationary_speed) {
      continue;
    }

    const double npc_ttc = upstream_arc / tangential_speed;
    if (npc_ttc < result.next_npc_ttc) {
      result.next_npc_ttc = npc_ttc;
    }
    if (npc_ttc < required_rear_ttc) {
      result.safe = false;
      result.blocking_object_id = object.id;
      std::ostringstream reason;
      reason.setf(std::ios::fixed);
      reason.precision(2);
      reason << "rear ID " << object.id << ": TTC " << npc_ttc
             << "s < limit " << required_rear_ttc << "s\narc "
             << upstream_arc << "m / " << tangential_speed << "m/s";
      result.reason = reason.str();
    }
  }

  return result;
}

// 경로가 원형 차로(nominal + margin 반경) 안으로 처음 들어가는 점.
// 자차가 링 밖일 때만 갱신하고, 못 찾으면 직전 값 -> 설정값 순으로 쓴다.
Point2 RoundaboutMission::effectiveConflictPoint(const RoundaboutInput& input) {
  if (!config_.auto_conflict_point) {
    return config_.conflict_point;
  }
  if (input.ego.valid && !egoInsideCircle(input.ego) && input.route.size() >= 2) {
    const PolylineProjection ego_proj =
        projectToPolyline(input.route, input.ego.position);
    if (ego_proj.valid &&
        ego_proj.distance <= config_.route_projection_tolerance) {
      const double limit =
          config_.nominal_radius + std::max(0.0, config_.auto_conflict_radius_margin);
      double s = 0.0;
      for (size_t i = 1; i < input.route.size(); ++i) {
        s += distance(input.route[i - 1], input.route[i]);
        if (s < ego_proj.s) {
          continue;
        }
        if (radiusFrom(config_.center, input.route[i]) <= limit) {
          // 앞 점과의 사이에서 반경이 limit 인 곳을 선형 보간.
          const Point2& a = input.route[i - 1];
          const Point2& b = input.route[i];
          const double ra = radiusFrom(config_.center, a);
          const double rb = radiusFrom(config_.center, b);
          const double f = (ra > rb + 1e-6)
                               ? std::min(1.0, std::max(0.0, (ra - limit) / (ra - rb)))
                               : 1.0;
          auto_conflict_ = {a.x + f * (b.x - a.x), a.y + f * (b.y - a.y)};
          have_auto_conflict_ = true;
          break;
        }
      }
    }
  }
  return have_auto_conflict_ ? auto_conflict_ : config_.conflict_point;
}

// 자차 중심에서 합류점까지 경로 거리. 경로 투영이 안 되면 직선 근사.
double RoundaboutMission::conflictDistance(const RoundaboutInput& input,
                                           const Point2& conflict,
                                           double distance_to_yield) const {
  const PolylineProjection ego_projection =
      projectToPolyline(input.route, input.ego.position);
  const PolylineProjection conflict_projection =
      projectToPolyline(input.route, conflict);
  if (ego_projection.valid && conflict_projection.valid &&
      ego_projection.distance <= config_.route_projection_tolerance &&
      conflict_projection.distance <= config_.route_projection_tolerance) {
    return conflict_projection.s - ego_projection.s;
  }
  return clampNonnegative(distance_to_yield) +
         distance(config_.yield_point, conflict);
}

// 경로가 원형 차로 판정 반경(outer + margin) 안으로 처음 들어가는 곳까지 거리.
double RoundaboutMission::circleEntryDistance(const RoundaboutInput& input) const {
  if (input.route.size() < 2) return std::numeric_limits<double>::infinity();
  const PolylineProjection ego_proj = projectToPolyline(input.route, input.ego.position);
  if (!ego_proj.valid || ego_proj.distance > config_.route_projection_tolerance)
    return std::numeric_limits<double>::infinity();
  const double limit = config_.outer_radius + std::max(0.0, config_.gs_circle_stop_margin);
  double s = 0.0;
  for (size_t i = 1; i < input.route.size(); ++i) {
    const double seg = distance(input.route[i - 1], input.route[i]);
    const double s_prev = s;
    s += seg;
    if (s < ego_proj.s) continue;
    const double rb = radiusFrom(config_.center, input.route[i]);
    if (rb <= limit) {
      // 선분 a->b 와 반경 limit 원의 교점(직선-원 2차식, 들어가는 쪽 해).
      const Point2& pa = input.route[i - 1];
      const Point2& pb = input.route[i];
      const double dx = pb.x - pa.x, dy = pb.y - pa.y;
      const double fx = pa.x - config_.center.x, fy = pa.y - config_.center.y;
      const double qa = dx * dx + dy * dy;
      const double qb = 2.0 * (fx * dx + fy * dy);
      const double qc = fx * fx + fy * fy - limit * limit;
      double f = 0.0;
      const double disc = qb * qb - 4.0 * qa * qc;
      if (qa > 1e-9 && disc >= 0.0) {
        f = std::min(1.0, std::max(0.0, (-qb - std::sqrt(disc)) / (2.0 * qa)));
      }
      return std::max(0.0, s_prev + f * seg - ego_proj.s);
    }
  }
  return std::numeric_limits<double>::infinity();
}

// 원호 위치 이력의 1차 회귀 기울기로 차량 등속을 추정한다. 이력이 짧으면 fallback.
double RoundaboutMission::estimateSpeed(int id, double now, double angle,
                                        double fallback) {
  const double r = config_.nominal_radius;
  std::deque<std::pair<double, double>>& h = arc_hist_[id];
  double arc = angle * r;
  if (!h.empty()) {
    // 진행 방향으로 펼친다(한 바퀴 넘김 보정).
    const double ring = 2.0 * 3.14159265358979323846 * r;
    double d = arc - std::fmod(h.back().second, ring);
    const double sign = config_.counter_clockwise ? 1.0 : -1.0;
    d *= sign;
    while (d > 0.5 * ring) d -= ring;
    while (d < -0.5 * ring) d += ring;
    arc = h.back().second + sign * d;
  }
  if (h.empty() || now > h.back().first + 1e-6) h.emplace_back(now, arc);
  const double win = std::max(0.3, config_.gs_speed_window);
  while (!h.empty() && h.front().first < now - win) h.pop_front();
  // 막 생긴 트랙도 위치로 속도를 본다(트래커 속도는 초기에 늦게 따라온다:
  // 14:49 백 id6 트래커 5.5 m/s, 위치 변화 7.2 m/s). 짧은 이력은 잡음이 크니
  // 호출 쪽에서 앞차는 min, 뒤차는 max 로 쓴다.
  if (h.size() < 3 || h.back().first - h.front().first < std::max(0.25, config_.gs_speed_min_span)) return fallback;
  double mt = 0.0, ms = 0.0;
  for (const auto& q : h) { mt += q.first; ms += q.second; }
  mt /= h.size(); ms /= h.size();
  double num = 0.0, den = 0.0;
  for (const auto& q : h) {
    num += (q.first - mt) * (q.second - ms);
    den += (q.first - mt) * (q.first - mt);
  }
  if (den < 1e-9) return fallback;
  const double v = (config_.counter_clockwise ? 1.0 : -1.0) * num / den;
  // Bound disagreement with the independent tracker estimate. Do not let a
  // short-window position artifact become an arbitrarily fast rear vehicle.
  const double delta = std::max(0.0, config_.gs_speed_disagreement_limit);
  return std::max(0.0, std::min(fallback + delta, std::max(fallback - delta, v)));
}

double RoundaboutMission::holdStopDistance(const GapResult& gap) const {
  double d = gap.conflict_distance - 0.5 * config_.gs_ego_length -
             config_.gs_entry_zone - config_.gs_abort_margin;
  // 자차 중심이 원 판정 반경에 닿으면 CIRCULATE 로 넘어가므로 그 앞에 선다.
  if (!config_.gs_require_merge_progress && std::isfinite(gap.circle_distance))
    d = std::min(d, gap.circle_distance);
  return std::max(0.0, d);
}

// 차량별 길이(zone 규칙). NPC 차종이 주행마다 랜덤이라 고정값을 쓰지 않는다.
//   프레임별 관측 길이는 보이는 면에 따라 1.9~6.8 m 로 흔들리므로 id별 창 안의
//   백분위수를 쓴다(최대값은 합쳐진 클러스터에, 중앙값은 부분 관측에 끌려간다).
//   표본이 부족한 차는 스트림 prior 와 비교해 큰 쪽(부분 관측으로 짧게 본 경우 대비).
double RoundaboutMission::streamVehicleLength(const TrackedObject& object, double stamp) {
  const double observed = std::max(config_.gs_min_vehicle_length, object.length);
  if (!config_.gs_zone_rule_enabled) return observed;  // 기존 판단은 관측 길이 그대로
  if (!config_.gs_zone_length_estimate) return config_.gs_zone_vehicle_length;
  auto& samples = length_samples_[object.id];
  if (samples.empty() || stamp > samples.back().first + 1e-6) {
    samples.emplace_back(stamp, std::max(0.1, object.length));
  }
  const double window = std::max(1.0, config_.gs_zone_length_window);
  while (!samples.empty() && samples.front().first < stamp - window) samples.pop_front();
  std::vector<double> values;
  values.reserve(samples.size());
  for (const auto& sample : samples) values.push_back(sample.second);
  std::sort(values.begin(), values.end());
  const double p = std::min(1.0, std::max(0.0, config_.gs_zone_length_percentile));
  const double estimate =
      values[static_cast<size_t>(std::lround(p * static_cast<double>(values.size() - 1)))];
  const double prior = length_prior_ > 0.0 ? length_prior_ : config_.gs_zone_vehicle_length;
  double length;
  if (static_cast<int>(values.size()) >= std::max(1, config_.gs_zone_length_min_samples)) {
    length = estimate;
    length_estimates_[object.id] = {stamp, estimate};
  } else {
    length = std::max(estimate, prior);
  }
  const double lo = std::max(0.1, config_.gs_min_vehicle_length);
  const double hi = std::max(lo, config_.gs_zone_length_max);
  return std::min(hi, std::max(lo, length));
}

// 스트림 prior = 표본이 충분한 차량들 추정값의 중앙값(지나간 차량도 기억 시간 동안 포함).
void RoundaboutMission::updateLengthPrior(double stamp) {
  const double window = std::max(1.0, config_.gs_zone_length_window);
  for (auto it = length_samples_.begin(); it != length_samples_.end();) {
    if (it->second.empty() || it->second.back().first < stamp - window) {
      it = length_samples_.erase(it);
    } else {
      ++it;
    }
  }
  const double memory = std::max(1.0, config_.gs_zone_length_prior_memory);
  std::vector<double> estimates;
  for (auto it = length_estimates_.begin(); it != length_estimates_.end();) {
    if (it->second.first < stamp - memory) {
      it = length_estimates_.erase(it);
    } else {
      estimates.push_back(it->second.second);
      ++it;
    }
  }
  if (estimates.empty()) {
    length_prior_ = -1.0;
    return;
  }
  std::sort(estimates.begin(), estimates.end());
  const size_t n = estimates.size();
  length_prior_ = n % 2 ? estimates[n / 2] : 0.5 * (estimates[n / 2 - 1] + estimates[n / 2]);
}

// 트래커 스트림 사용 가능 여부. valid=false 라도 메시지가 신선하고(가림 보호 expiry guard 만 걸림)
// COMMIT 중이면, 마지막 정상 시각으로부터 grace 안에서는 사용한다.
//   16:24:06 백: COMMIT 15.7 s 에 1 초 valid=false -> 'entry gap unsafe' 감속 -> 뒤차 침범 -> 취소.
bool RoundaboutMission::trackerStreamUsable(const RoundaboutInput& input) const {
  if (input.tracker_stream_valid) return true;
  // 2026-10-05(16:13 백 194.0 s): 양보 중 순간 끊김마다 판단이 리셋돼 진입이 늦어졌다.
  if (input.tracker_stream_fresh && config_.tracker_stale_grace > 0.0 && last_stream_ok_time_ >= 0.0 &&
      input.now - last_stream_ok_time_ <= config_.tracker_stale_grace)
    return true;
  return state_ == RoundaboutState::kCommit && input.tracker_stream_fresh &&
         config_.tracker_guard_commit_grace > 0.0 && last_stream_ok_time_ >= 0.0 &&
         input.now - last_stream_ok_time_ <= config_.tracker_guard_commit_grace;
}

// 자차가 현재 속도 v0 에서 dist 만큼 가는 시간(정지 출발이면 반응 지연, 가속 gs_ego_accel, 상한 vmax).
double RoundaboutMission::egoTimeToDistance(double dist, double v0, double vmax) const {
  if (dist <= 0.0) return 0.0;
  const double a = std::max(0.3, config_.gs_ego_accel);
  v0 = std::max(0.0, std::min(v0, vmax));
  const double delay = v0 < 0.5 ? std::max(0.0, config_.gs_ego_start_delay) : 0.0;
  const double t_acc = (vmax - v0) / a;
  const double d_acc = v0 * t_acc + 0.5 * a * t_acc * t_acc;
  if (dist <= d_acc) return delay + (std::sqrt(v0 * v0 + 2.0 * a * dist) - v0) / a;
  return delay + t_acc + (dist - d_acc) / std::max(0.1, vmax);
}

// ★ 2026-10-06 시간창 진입 모델. 합류 구역 = 합류점 ±Z (Z = 자차 반길이 + entry_zone), 링 원호 좌표.
//   자차: 구역 진입 t_in(앞끝 도착), 통과 완료 t_clear(중심이 합류점 + Z 를 지나 차체가 흐름 안).
//   확정 뒤차(상류): 앞끝이 구역 시작에 닿는 시각 >= t_clear + m_rear. 정지 차량은 재출발 가정.
//   확정 앞차(하류/구역 안): 뒤끝이 구역 끝을 지나는 시각 + m_front <= t_in,
//     그리고 자차 통과 완료 시점에 앞차 뒤끝이 자차 앞끝 + standstill + headway*v 보다 앞.
//   미확정 물체: 나타난 지 young_age 안이고 상류 near_upstream 안이면 assumed_speed 차량으로 본다.
//   확정 유령(검출 끊긴 지 ghost_age 넘고 정지)은 무시한다. 완화는 없다.
RoundaboutMission::GapResult RoundaboutMission::evaluateDistance(
    const RoundaboutInput& input, double distance_to_yield) {
  GapResult result;
  last_gap_select_active_=true;last_gaps_.clear();last_stream_.clear();
  const auto conflict=effectiveConflictPoint(input);last_conflict_point_=conflict;
  const double angle0=angleFrom(config_.center,conflict);last_conflict_angle_=angle0;
  result.conflict_distance=conflictDistance(input,conflict,distance_to_yield);
  result.circle_distance=circleEntryDistance(input);
  if(config_.require_tracker_stream&&!(state_==RoundaboutState::kCommit?trackerStreamUsable(input):input.tracker_stream_valid)){
    result.reason="distance tracker unavailable";return result;}
  if(config_.gs_use_mpc_prediction&&(!std::isfinite(input.prediction_speed_limit)||input.prediction_speed_limit<=.1)){
    result.reason="distance MPC prediction unavailable";return result;}
  EgoEntryModel ego;ego.distance_to_merge=result.conflict_distance;ego.speed=std::max(0.,input.ego.speed);
  ego.accel=config_.gs_ego_accel;ego.max_speed=config_.gs_ego_max_speed>0?config_.gs_ego_max_speed:config_.circulation_speed;
  ego.measured_profile=config_.distance_measured_profile;
  ego.profile_times=config_.distance_profile_times;ego.profile_speeds=config_.distance_profile_speeds;
  if(config_.gs_use_mpc_prediction){ego.max_speed=std::min(ego.max_speed,input.prediction_speed_limit);
    if(!ego.measured_profile&&std::isfinite(input.prediction_accel_limit)&&input.prediction_accel_limit>0)ego.accel=std::min(ego.accel,input.prediction_accel_limit);}
  ego.length=config_.gs_ego_length;ego.start_delay=config_.gs_ego_start_delay;ego.departure_in_progress=state_==RoundaboutState::kCommit;
  if(state_==RoundaboutState::kCommit&&ego.speed<.5){
    const double remaining=config_.gs_ego_start_delay-std::max(0.,input.now-state_enter_time_);
    if(remaining>0){ego.start_delay=remaining;ego.departure_in_progress=false;}
  }
  result.ego_prediction_speed=ego.max_speed;
  const double sign=config_.counter_clockwise?1.:-1.,R=std::max(1.,config_.nominal_radius),C=2*M_PI*R;
  std::map<int,TrackedObject> present;
  for(const auto& o:input.objects){present[o.id]=o;
    // A replacement ID inherits movement proof only from a fresh, spatially
    // matching body with a consistent measured velocity. A separate newly
    // visible vehicle must still participate in the admission safety check.
    if(!o.has_moved&&o.velocity_valid&&o.hit_count>=3&&o.height>=.15&&o.width>=1.){
      for(const auto& cached:distance_cache_){const auto& old=cached.second;
        auto meta=track_meta_.find(old.id);
        if(old.id==o.id||!old.velocity_valid||meta==track_meta_.end()||
           input.now-meta->second.last_hit_time>.3)continue;
        const double dt=std::max(0.,input.now-meta->second.last_seen);
        Point2 predicted{old.position.x+old.velocity_x*dt,old.position.y+old.velocity_y*dt};
        if(distance(predicted,o.position)<1.0&&
           std::hypot(old.velocity_x-o.velocity_x,old.velocity_y-o.velocity_y)<1.0&&
           std::abs(old.width-o.width)<.8&&std::abs(old.height-o.height)<.6){
          present[o.id].has_moved=true;break;
        }
      }
    }
    // A proved vehicle that stops remains a vehicle while real, body-like
    // observations continue. Do not transfer proof to an adjacent thin sign.
    if(!o.has_moved&&distance_cache_.count(o.id)&&o.height>=.15&&o.width>=1.0&&
       distance(distance_cache_[o.id].position,o.position)<2.)present[o.id].has_moved=true;
    if(present[o.id].has_moved){auto cached=present[o.id];
    if(!o.velocity_valid&&distance_cache_.count(o.id)&&distance_cache_[o.id].velocity_valid){cached.velocity_x=distance_cache_[o.id].velocity_x;cached.velocity_y=distance_cache_[o.id].velocity_y;cached.velocity_valid=true;}
    distance_cache_[o.id]=cached;}}
  // Lifetime is measured from the last *detection*, never refreshed by predicted publications.
  for(auto it=distance_cache_.begin();it!=distance_cache_.end();){auto meta=track_meta_.find(it->first);
    if(meta==track_meta_.end()||input.now-meta->second.last_hit_time>3.){it=distance_cache_.erase(it);continue;}
    if(!present.count(it->first)){auto o=it->second;double dt=std::max(0.,input.now-meta->second.last_seen);
      const double a=angleFrom(config_.center,o.position),rad=distance(config_.center,o.position);
      const double vt=sign*(-std::sin(a)*o.velocity_x+std::cos(a)*o.velocity_y);
      o.position={config_.center.x+rad*std::cos(a+sign*std::max(0.,vt)*dt/std::max(1.,rad)),
                  config_.center.y+rad*std::sin(a+sign*std::max(0.,vt)*dt/std::max(1.,rad))};present[o.id]=o;}
    ++it;
  }
  bool uncertain=false;std::vector<StreamVehicle> stream,unknown;
  for(const auto& pair:present){const auto& o=pair.second;double a=0,v=0;if(!isCirculatingObject(o,&a,&v))continue;
    const auto& meta=track_meta_[o.id];const double pos=sign*normalizeAngle(a-angle0)*R;
    if(!o.has_moved){
      // Thin fixed pieces are not a stream vehicle just because a centroid has a noisy velocity.
      if(o.height<.12&&o.hit_count>=3)continue;
      const bool body_like=o.height>=.15&&o.length>=config_.gs_min_vehicle_length&&o.width>=1.0;
      if((body_like||input.now-meta.first_seen<=config_.distance_unknown_hold)&&std::abs(pos)<=config_.gs_unconfirmed_range){
        StreamVehicle u;u.id=o.id;u.pos=pos;u.length=std::max(o.length,body_like?config_.gs_min_vehicle_length:1.);
        u.speed=input.now-meta.first_seen<=config_.distance_unknown_hold|| (o.velocity_valid&&v>=config_.tw_moving_speed)
          ?std::max(config_.gs_unconfirmed_speed,v):0.;unknown.push_back(u);
      }
      continue;
    }
    if(!o.velocity_valid){const auto cached=distance_cache_.find(o.id);
      if(cached!=distance_cache_.end()&&cached->second.velocity_valid){const auto& old=cached->second;v=sign*(-std::sin(a)*old.velocity_x+std::cos(a)*old.velocity_y);}
      else {
        StreamVehicle u;u.id=o.id;u.pos=pos;u.length=meta.length;u.speed=0;unknown.push_back(u);
        u.speed=std::max(config_.gs_unconfirmed_speed,std::hypot(o.velocity_x,o.velocity_y));unknown.push_back(u);continue;
      }}
    StreamVehicle sv;sv.id=o.id;sv.pos=pos;sv.speed=std::max(0.,v)*R/std::max(1.,distance(config_.center,o.position));sv.physical_speed=std::max(0.,v);sv.length=meta.length;
    stream.push_back(sv);
  }
  std::sort(stream.begin(),stream.end(),[](const StreamVehicle&a,const StreamVehicle&b){return a.pos>b.pos;});
  // Suppress simultaneous fragments of one vehicle; require close arc/radius and matching speeds.
  std::vector<StreamVehicle> unique;
  for(const auto& s:stream){bool duplicate=false;for(const auto& u:unique){
    const auto& a=present.at(s.id);const auto& b=present.at(u.id);
    if(std::abs(s.pos-u.pos)<3.0&&std::abs(distance(config_.center,a.position)-distance(config_.center,b.position))<.8&&std::abs(s.speed-u.speed)<1.5){
      // Never erase a currently selected pair member in favour of a new fragment.
      if(s.id==committed_leader_||s.id==committed_follower_||s.id==distance_leader_||s.id==distance_follower_)continue;
      duplicate=true;break;}}
    if(!duplicate)unique.push_back(s);}
  stream=unique;
  for(const auto& s:stream){RoundaboutVehicleViz viz;viz.id=s.id;viz.pos=s.pos;viz.speed=s.speed;viz.length=s.length;
    viz.measured_position=present[s.id].position;viz.measured_position_valid=true;last_stream_.push_back(viz);}
  std::vector<GapCandidate> candidates;
  auto make=[&](const StreamVehicle* l,const StreamVehicle* f,int wrap){GapCandidate g;g.wrap=wrap;
    if(l){g.leader_id=l->id;g.leader_pos=l->pos;g.leader_speed=l->speed;g.leader_length=l->length;}
    if(f){g.follower_id=f->id;g.follower_pos=f->pos;g.follower_speed=f->speed;g.follower_length=f->length;}
    candidates.push_back(g);};
  if(stream.empty())make(nullptr,nullptr,0);
  else{for(size_t i=1;i<stream.size();++i)make(&stream[i-1],&stream[i],0);
    auto l=stream.back(),f=stream.front();l.pos+=C;make(&l,&f,1);
    l=stream.back();f=stream.front();f.pos-=C;make(&l,&f,-1);}
  DistanceEntryParams p;p.clearance_only=config_.distance_clearance_only;p.front_gap=config_.distance_front_gap;p.rear_gap=config_.distance_rear_gap;p.horizon=config_.distance_clearance_only?0.:config_.distance_horizon;
  p.reaction=config_.distance_reaction;p.rear_decel=config_.distance_rear_decel;p.rear_yield=config_.distance_rear_yield;p.speed_margin=config_.gs_speed_margin;
  p.follow_standstill_gap=config_.gs_prediction_follow_standstill_gap;
  p.follow_time_gap=config_.gs_prediction_follow_time_gap;
  p.leader_release_gap=config_.gs_standstill_gap;p.comfortable_decel=config_.comfortable_decel;
  p.front_response_time=config_.distance_measured_profile?config_.distance_front_response:0.;
  p.front_max_decel=config_.distance_measured_profile?config_.distance_front_max_decel:0.;
  std::vector<DistanceEntryResult> checks;int best=-1,latched=-1;double score=1e100;
  const bool commit=state_==RoundaboutState::kCommit;
  for(size_t i=0;i<candidates.size();++i){const auto& g=candidates[i];auto check=evaluateDistanceEntry(g,ego,p);
    // Once the rear vehicle reaches the conflict point, this slot has passed
    // a vehicle still outside the merge. Prediction may not resurrect it by
    // imagining that we accelerate past that rear vehicle later.
    if(!egoEnteredMerge(input,result.conflict_distance)&&g.follower_id>=0&&
       g.follower_pos+.5*g.follower_length>=0.){
      check.safe=false;check.reason="gap_passed";
    }
    if(check.safe)for(const auto& u:unknown){
      bool clear=true;double end=check.clear_time+p.horizon;
      for(double t=check.entry_time;t<=end+1e-6;t+=.05){double s,v;sampleEntryMotion(check,t,&s,&v);
        double front=s-ego.distance_to_merge+.5*ego.length;
        double rear=std::max(0.,s-ego.distance_to_merge-.5*ego.length);
        double center=u.pos+u.speed*t;
        if(center-.5*u.length-front<p.front_gap && rear-center-.5*u.length<p.rear_gap){clear=false;break;}
      }
      if(!clear){check.safe=false;check.reason="unconfirmed vehicle "+std::to_string(u.id);break;}
    }
    checks.push_back(check);
    bool same=g.leader_id==(commit?committed_leader_:distance_leader_)&&g.follower_id==(commit?committed_follower_:distance_follower_)&&g.wrap==(commit?committed_wrap_:distance_wrap_);
    if(same)latched=i;
    const double cost=check.entry_time+check.required_decel*.1;
    if(check.safe&&cost<score){best=i;score=cost;}
    RoundaboutGapViz viz;viz.leader_id=g.leader_id;viz.follower_id=g.follower_id;
    viz.lo=g.follower_id<0?-config_.gs_viz_range:g.follower_pos+.5*g.follower_length;
    viz.hi=g.leader_id<0?config_.gs_viz_range:g.leader_pos-.5*g.leader_length;
    viz.feasible=check.safe&&!uncertain;viz.go=viz.feasible;
    viz.failure_reason=check.safe?"":check.reason;last_gaps_.push_back(viz);
  }
  int selected=best;
  if(latched>=0){
    if(checks[latched].reason=="gap_passed"){
      if(commit){result.reason="distance committed gap passed";return result;}
      distance_leader_=distance_follower_=-2;distance_wrap_=0;
      distance_bad_since_=-1.;safe_since_=-1.;latched=-1;
    }
  }
  if(latched>=0){
    if(checks[latched].safe){selected=latched;distance_bad_since_=-1.;}
    else if(commit)selected=latched;
    else{
      // Waiting does not reserve a failed slot. Inspect all other slots now.
      distance_leader_=distance_follower_=-2;distance_wrap_=0;
      distance_bad_since_=-1.;safe_since_=-1.;
    }}
  else if(commit){result.reason="distance committed pair missing";return result;}
  if(selected<0){
    // Prepare the next upstream gap before its leader crosses the conflict.
    // It is a preview only; every gap continues to be evaluated each cycle.
    double closest=-std::numeric_limits<double>::infinity();
    for(size_t i=0;i<candidates.size();++i){const auto& g=candidates[i];
      if(checks[i].reason!="gap_passed"&&g.leader_id>=0&&
         g.leader_pos+.5*g.leader_length<0&&g.leader_pos>closest){
        closest=g.leader_pos;selected=i;
      }
    }
    if(selected<0)for(size_t i=0;i<candidates.size();++i)if(checks[i].reason!="gap_passed"){selected=i;break;}
  }
  if(selected<0){result.reason="distance no candidate";return result;}
  const auto& g=candidates[selected];const auto& check=checks[selected];last_gaps_[selected].selected=check.reason!="gap_passed";
  last_gaps_[selected].preview=!commit&&!check.safe;
  result.safe=check.safe&&!uncertain;result.strict_go=result.front_wait_ok=result.safe;result.depart_delay=result.safe?0:std::numeric_limits<double>::infinity();
  result.leader_id=g.leader_id;result.follower_id=g.follower_id;result.wrap=g.wrap;result.has_leader=g.leader_id>=0;
  result.leader_pos=g.leader_pos;result.leader_speed=g.leader_speed;result.leader_length=g.leader_length;
  for(const auto& s:stream)if(s.id==g.leader_id)result.leader_speed=s.physical_speed;
  result.front_gap=check.front_now;result.current_rear=check.rear_now;result.predicted_front=check.front_min;result.predicted_rear=check.rear_min;
  result.ego_reference_time=check.reference_time;
  result.ego_delay_remaining=check.delay_remaining;result.ego_leader_limited=check.leader_limited;result.ego_curve_limited=check.curve_limited;
  result.rear_decel=check.required_decel;result.ego_zone_time=check.entry_time;result.clear_time=check.clear_time;
  result.blocking_object_id=result.safe?-1:(check.reason=="front_space"?g.leader_id:g.follower_id);
  if(!commit&&result.safe){if(distance_leader_!=g.leader_id||distance_follower_!=g.follower_id||distance_wrap_!=g.wrap)safe_since_=-1.;
    distance_leader_=g.leader_id;distance_follower_=g.follower_id;distance_wrap_=g.wrap;distance_bad_since_=-1.;}
  std::ostringstream reason;reason<<"distance "<<(result.safe?"GO":"wait")<<" L"<<g.leader_id<<"/F"<<g.follower_id
    <<" front "<<check.front_min<<"m rear "<<check.rear_min<<"m a "<<check.required_decel<<" t_in "<<check.entry_time<<" t_clear "<<check.clear_time
    <<" "<<(uncertain?"unconfirmed vehicle":check.reason);result.reason=reason.str();return result;
}

RoundaboutMission::GapResult RoundaboutMission::evaluateTimeWindow(
    const RoundaboutInput& input, double distance_to_yield) {
  GapResult result;
  const Point2 conflict = effectiveConflictPoint(input);
  const double conflict_angle = angleFrom(config_.center, conflict);
  result.conflict_distance = conflictDistance(input, conflict, distance_to_yield);
  result.circle_distance = circleEntryDistance(input);
  const double sign = config_.counter_clockwise ? 1.0 : -1.0;
  const double R = std::max(1.0, config_.nominal_radius);
  const bool commit = state_ == RoundaboutState::kCommit;

  // 관측 충분: 트래커가 끊김 없이 min_observe 이상.
  const bool stream_ok = trackerStreamUsable(input);
  if (!stream_ok) tw_stream_ok_since_ = -1.0;
  else if (tw_stream_ok_since_ < 0.0) tw_stream_ok_since_ = input.now;
  const bool observed = stream_ok && input.now - tw_stream_ok_since_ >= config_.tw_min_observe;

  double vmax = config_.gs_ego_max_speed > 0.0 ? config_.gs_ego_max_speed : config_.circulation_speed;
  if (std::isfinite(input.prediction_speed_limit) && input.prediction_speed_limit > 0.5)
    vmax = std::min(vmax, input.prediction_speed_limit);
  const double v0 = std::max(0.0, input.ego.speed);
  const double d = result.conflict_distance;
  const double Lego = config_.gs_ego_length;
  // 자차 앞끝이 합류점에 닿는 시각 / 자차 뒤끝이 합류점을 지나는 시각.
  const double t_in = egoTimeToDistance(d - 0.5 * Lego, v0, vmax);
  const double t_clear = egoTimeToDistance(d + 0.5 * Lego, v0, vmax);
  // 자차 중심이 합류점에 닿는 시각(차체 절반이 차로 안)과 그때 속도.
  const double t_mid = egoTimeToDistance(d, v0, vmax);
  const double v_mid = std::min(vmax, std::sqrt(v0 * v0 + 2.0 * std::max(0.3, config_.gs_ego_accel) * std::max(0.0, d)));
  const double FS = config_.tw_front_space, RS = config_.tw_rear_space;
  result.ego_zone_time = t_in;
  result.ego_prediction_speed = vmax;

  // 진입 확정 중 유지 기준은 항상 진입 기준보다 느슨하다(같거나 크면 확정 직후 바로 취소된다).
  const double m_front = commit ? std::min(config_.tw_commit_m_front, config_.tw_m_front - 0.2) : config_.tw_m_front;
  const double m_rear = commit ? std::min(config_.tw_commit_m_rear, config_.tw_m_rear - 0.3) : config_.tw_m_rear;
  bool ok = true;
  double worst_margin = std::numeric_limits<double>::infinity();
  std::ostringstream why;
  why.setf(std::ios::fixed);
  why.precision(1);
  int n_vehicle = 0, n_young = 0;

  for (const TrackedObject& o : input.objects) {
    double angle = 0.0, vt = 0.0;
    if (!isCirculatingObject(o, &angle, &vt)) continue;
    const TrackMeta& meta = track_meta_[o.id];
    const double age = input.now - meta.first_seen;
    const double meas_age = input.now - meta.last_hit_time;
    const double p = sign * normalizeAngle(angle - conflict_angle) * R;  // +하류 / -상류 (중심 기준)
    const double L = meta.length;
    const bool proven = o.has_moved;
    double v = proven && o.velocity_valid ? vt : 0.0;
    if (proven) {
      if (meas_age > config_.tw_ghost_age && v < 0.5) continue;  // 정지 유령
      ++n_vehicle;
    } else if (o.velocity_valid && vt >= config_.tw_moving_speed) {
      // 미확정이지만 지금 움직이는 물체 - 차량으로 본다(18:45:18 시뮬: 증명 취소된 4.75 m/s 실제 차를
      //   '오래된 미확정 = 정지물'로 무시해 합류 중 2.45 m 까지 붙었다). 길가 물체 속도 튐은 잠깐 막을 뿐이다.
      v = vt;
      ++n_young;
    } else {
      if (age > config_.tw_young_age) continue;                   // 오래 안 움직인 물체 = 정지물
      if (p < -config_.tw_near_upstream || p > config_.tw_front_space + 0.5 * L) continue;
      v = config_.tw_assumed_speed;
      ++n_young;
    }
    const double front = p + 0.5 * L, rear = p - 0.5 * L;
    if (front < -RS) {
      // 상류(뒤차): 앞끝이 합류점 - RS 에 닿는 시각 >= 자차 뒤끝 통과 + m_rear.
      const double gap = -RS - front;
      if (v < 0.5 && proven && meta.stop_since >= 0.0 &&
          input.now - meta.stop_since >= config_.tw_stopped_wait && gap >= config_.tw_stopped_min_gap) {
        // 오래 서 있는 차(양보 중이거나 정체) - 자차 뒤를 따라올 차다. 막 멈춘 차만 재출발을 가정한다.
        //   19:03:50 시뮬: 구역 상류 정지 차량을 0.5 s 재출발로 가정해 15 s 넘게 서로 기다렸다.
        continue;
      }
      double margin;
      if (v < 0.5) {
        // 막 멈춘 차: 재출발 가정 - 자차 뒤끝이 합류점을 지난 뒤 m_rear 후에야 도착해야 한다.
        const double a = std::max(0.3, config_.tw_restart_accel);
        const double t_arr = config_.tw_restart_delay + std::sqrt(2.0 * gap / a);
        margin = t_arr - (t_clear + m_rear);
        result.next_npc_ttc = std::min(result.next_npc_ttc, t_arr);
      } else {
        // 움직이는 뒤차: 자차 중심이 합류점에 닿을 때(t_mid) 뒤차 앞끝 ~ 자차 뒤끝 거리 g 와
        //   그 거리 안에서 자차 속도로 맞추는 감속 rel^2/(2g) <= rear_decel. 녹화 주행에서 NPC 는 끼어든
        //   자차를 보고 감속했다. 시간 여유 m_rear 만큼 뒤차를 앞당겨 본다.
        const double vf = v + config_.tw_sigma_v;
        const double front_at_mid = front + vf * (t_mid + m_rear);
        const double g = (-0.5 * Lego - RS) - front_at_mid;
        // 합류 뒤 자차는 앞차 추종으로 흐름 속도 이상 달리지 않는다 - 뒤차 감속 판단에 그 속도를 쓴다.
        const double rel = vf - std::min(v_mid, config_.tw_assumed_speed);
        const double need_decel = g <= 0.0 ? 1e9 : (rel > 0.0 ? rel * rel / (2.0 * g) : 0.0);
        margin = g <= 0.0 ? g / std::max(1.0, vf) : (config_.tw_rear_decel - need_decel) / std::max(0.5, config_.tw_rear_decel);
        static const bool tw_debug = std::getenv("TW_DEBUG") != nullptr;
        if (tw_debug)
          std::fprintf(stderr, "TWREAR now %.2f id %d p %.1f L %.1f v %.2f front %.1f t_mid %.2f v_mid %.2f front_at_mid %.1f g %.1f need %.2f\n",
                       input.now, o.id, p, L, v, front, t_mid, v_mid, front_at_mid, g, need_decel);
        result.next_npc_ttc = std::min(result.next_npc_ttc, gap / vf);
      }
      if (margin < worst_margin) { worst_margin = margin; result.blocking_object_id = o.id; }
      if (margin < 0.0) {
        ok = false;
        why << (proven ? " rear " : " young ") << o.id << " m " << margin;
      }
    } else {
      // 합류점 근처 또는 하류(앞차): 뒤끝이 합류점 + FS 를 지나는 시각 + m_front <= 자차 앞끝 도착.
      const double vl = std::max(0.0, v - config_.tw_sigma_v);
      const double t_out = rear >= FS ? 0.0 : (vl < 0.3 ? std::numeric_limits<double>::infinity() : (FS - rear) / vl);
      const double margin1 = t_in - (t_out + m_front);
      // 자차 중심이 합류점일 때(앞끝 = 합류점 + Lego/2) 앞차 뒤끝이 FS + headway*min(자차, 앞차 속도) 앞이어야 한다.
      //   (예전: 자차가 8.5 m/s 까지 가속한다고 보고 headway 를 키워 11 m 틈을 다 막았다.)
      const double need = 0.5 * Lego + FS + config_.tw_leader_headway * std::min(v_mid, vl);
      const double rear_at_mid = rear + vl * t_mid;
      const double margin2 = (rear_at_mid - need) / std::max(1.0, v_mid);
      // 진입 확정 중에는 앞차 뒤 공간으로 취소하지 않는다(간격은 앞차 추종이 맡는다).
      const double margin = commit ? margin1 : std::min(margin1, margin2);
      if (rear < 30.0 && margin < worst_margin) { worst_margin = margin; result.blocking_object_id = o.id; }
      if (rear < 30.0 && margin < 0.0) {
        ok = false;
        why << " lead " << o.id << (margin1 < 0.0 ? " out " : " space ") << rear << "m v" << v;
      }
      result.front_gap = std::min(result.front_gap, std::max(0.0, rear));
    }
  }
  if (!observed) {
    ok = false;
    why << " observing " << (tw_stream_ok_since_ < 0.0 ? 0.0 : input.now - tw_stream_ok_since_) << "s";
  }
  result.safe = ok;
  result.strict_go = ok;
  // COMMIT 중 유지 기준(작은 여유)은 commit 이면 위에서 이미 그 여유로 계산했다.
  result.front_wait_ok = commit ? ok : ok;
  if (ok) result.blocking_object_id = -1;
  std::ostringstream reason;
  reason.setf(std::ios::fixed);
  reason.precision(1);
  reason << "tw " << (ok ? "GO" : "wait") << " t_in " << t_in << " t_clear " << t_clear
         << " veh " << n_vehicle << " young " << n_young << " margin "
         << (std::isfinite(worst_margin) ? worst_margin : 99.0) << "s" << why.str();
  result.reason = reason.str();
  return result;
}

// ★ 흐름 틈 선택(GapSelector). 순환 차량을 합류점 기준 호 좌표로 펴서
//   (앞차, 뒤차) 틈마다 '몇 초 뒤 출발하면 들어가는지'를 예측하고 가장
//   이른 틈을 고른다. 고른 틈은 (앞차, 뒤차) id 로 래치해 흔들리지 않게 한다.
RoundaboutMission::GapResult RoundaboutMission::evaluateGapSelect(
    const RoundaboutInput& input, double distance_to_yield) {
  GapResult result;
  last_gap_select_active_ = false;
  last_gaps_.clear();
  last_stream_.clear();
  if (config_.require_tracker_stream && !trackerStreamUsable(input)) {
    result.reason = "LiDAR tracker stream stale";
    return result;
  }
  if (config_.gs_use_mpc_prediction && !config_.gs_spatial_only_admission &&
      (!std::isfinite(input.prediction_speed_limit) || input.prediction_speed_limit <= 0.1)) {
    result.reason = "MPC prediction feedback unavailable; holding entry";
    return result;
  }
  const Point2 conflict = effectiveConflictPoint(input);
  const double conflict_angle = angleFrom(config_.center, conflict);
  const double ring_length = 2.0 * 3.14159265358979323846 * config_.nominal_radius;
  result.conflict_distance =
      conflictDistance(input, conflict, distance_to_yield);
  result.circle_distance = circleEntryDistance(input);

  bool hard_block = false;
  std::string hard_reason;
  std::vector<StreamVehicle> stream;
  std::vector<int> unconfirmed_ids;
  const double obj_stamp = input.objects_stamp >= 0.0 ? input.objects_stamp : input.now;
  if (config_.gs_zone_rule_enabled && config_.gs_zone_length_estimate) updateLengthPrior(obj_stamp);
  // 정지 차량 차단 후보. 루프가 끝난 뒤 스트림 전체를 보고 해제 여부를 정한다.
  struct StationaryBlocker {
    int id;
    double pos;
    double up_edge;
    bool eligible;
    bool latched;
  };
  std::vector<StationaryBlocker> stationary_blockers;
  const double yield_dwell =
      state_ == RoundaboutState::kYield ? std::max(0.0, input.now - state_enter_time_) : 0.0;
  for (const TrackedObject& object : input.objects) {
    if(object.collision_parent_id>=0)continue;
    double object_angle = 0.0;
    double tangential_speed = 0.0;
    if (!isCirculatingObject(object, &object_angle, &tangential_speed)) {
      continue;
    }
    const double up = circleArcDistance(object_angle, conflict_angle,
                                        config_.nominal_radius,
                                        config_.counter_clockwise);
    const double down = circleArcDistance(conflict_angle, object_angle,
                                          config_.nominal_radius,
                                          config_.counter_clockwise);
    const double half_len = 0.5 * std::max(0.1, object.length);
    // 이동이 확인되고 오래 추적된 차는 속도가 잠깐 무효가 돼도 순환 차량으로 본다.
    //   01:10 백: 합류점을 막 지난 차(+6~+12 m)의 22 % 프레임에서 속도가 무효가 됐고,
    //   그때마다 'object motion not confirmed' 로 출발이 막혔다(5 주기 중 4 주기).
    //   거리 기준 판단은 차량별 속도를 쓰지 않으므로 속도가 무효여도 판단할 수 있다.
    const bool proven_mover = (config_.gs_zone_rule_enabled || config_.gs_spatial_gap_enabled) && object.has_moved &&
        object.hit_count >= config_.gs_velocity_hold_min_hits;
    if (!object.confirmed && !proven_mover) {
      // A proven vehicle with a temporarily invalid speed must not disappear
      // from the stream and turn its slot into an apparently empty gap.
      if (!config_.gs_unconfirmed_enabled ||
          (!object.has_moved && object.hit_count > config_.gs_unconfirmed_max_hits)) {
        continue;
      }
      if (up < down) {
        // 상류: 보수적 속도의 뒤차로 넣는다.
        if (up <= config_.gs_unconfirmed_range) {
          StreamVehicle sv;
          sv.id = object.id;
          sv.pos = -up;
          const double measured =
              object.velocity_valid ? tangential_speed : 0.0;
          sv.speed = std::max(measured, config_.gs_observed_entry_enabled?config_.gs_unknown_speed_upper:config_.gs_unconfirmed_speed);
          if (object.has_moved) {
            sv.speed_lo = 0.0; // Unknown front clearance: retain ID but wait for speed evidence.
            sv.speed_hi = std::max(tangential_speed, sv.speed);
          }
          sv.length = streamVehicleLength(object, obj_stamp);
          stream.push_back(sv);
          unconfirmed_ids.push_back(object.id);
          result.next_npc_ttc = std::min(
              result.next_npc_ttc, clampNonnegative(up - half_len) / sv.speed);
        }
      } else if (clampNonnegative(down - half_len) <=
                 config_.uncertain_object_block_distance) {
        // 합류점 바로 하류의 미확정 물체: 진입을 막는다(기존 규칙).
        hard_block = true;
        result.blocking_object_id = object.id;
        hard_reason = "object motion not confirmed";
      }
      continue;
    }
    if (!object.velocity_valid && !proven_mover) {
      if (std::min(clampNonnegative(up - half_len),
                   clampNonnegative(down - half_len)) <=
          config_.uncertain_object_block_distance) {
        hard_block = true;
        result.blocking_object_id = object.id;
        hard_reason = "object motion not confirmed";
      }
      continue;
    }
    // 속도가 무효인 proven_mover 는 속도 값을 믿을 수 없으므로 정지 판정에서 뺀다.
    const bool stationary = !(proven_mover && !object.velocity_valid) &&
        tangential_speed <= config_.stationary_speed;
    if (stationary && !object.has_moved) {
      continue;  // 움직인 적 없는 정지 클러스터 = 시설물
    }
    // 이동 이력이 있는데 계속 서 있는 차: 정지 시작 시각을 기억한다(양보 중인지 판단).
    if (stationary) {
      auto it = stationary_since_.find(object.id);
      if (it == stationary_since_.end()) {
        stationary_since_[object.id] = {obj_stamp, obj_stamp};
      } else {
        it->second.second = obj_stamp;
      }
    } else {
      stationary_since_.erase(object.id);
    }
    if (stationary && clampNonnegative(up - half_len) <=
                          config_.stationary_block_distance) {
      const double up_edge = clampNonnegative(up - half_len);
      StationaryBlocker blocker{object.id, -up, up_edge, false, false};
      // 자차를 기다리는 동안 계속 서 있던 상류 차는 양보 중으로 보고 차단에서 뺄 수 있다.
      //   16:24:06 백: NPC 가 5.7 -> 0 m/s 로 감속해 합류점 6.8 m 앞(자차 옆 4.6 m)에 서서
      //   5 초 넘게 서로 기다렸다.
      if (config_.gs_zone_rule_enabled && config_.gs_stationary_yield_enabled && up <= down &&
          up_edge >= config_.gs_stationary_yield_min_distance) {
        blocker.latched = state_ == RoundaboutState::kCommit &&
                          committed_released_ids_.count(object.id) > 0;
        const bool waited = state_ == RoundaboutState::kYield &&
                            yield_dwell >= config_.gs_stationary_yield_start &&
                            obj_stamp - stationary_since_[object.id].first >=
                                config_.gs_stationary_yield_confirm;
        blocker.eligible = blocker.latched || waited;
      }
      stationary_blockers.push_back(blocker);
    }
    StreamVehicle sv;
    sv.id = object.id;
    sv.pos = down <= up ? down : -up;
    if (config_.gs_zone_rule_enabled && !stationary) {
      // 추적 위치는 '보이는 점들의 중심'이라 상류에서 실제 차 중심보다 앞서 보인다
      // (01:10 백: -15 m 에서 +3.9 m, -10 m 에서 +2.6 m, 합류점에서 0). 실측 표로 보정한다.
      sv.pos -= zoneBiasAt(config_.gs_zone_position_bias, sv.pos);
    }
    sv.speed = stationary ? 0.0 : tangential_speed;
    if (config_.gs_sequential && !stationary && config_.gs_use_tracker_velocity) {
      // Positions use nominal-ring arc metres, so velocity must use the same
      // coordinate. Tracker v/r is angular velocity from real detections only.
      const double observed_radius = std::max(0.1, radiusFrom(config_.center, object.position));
      sv.speed = tangential_speed * config_.nominal_radius / observed_radius;
      sv.speed_lo = sv.speed;
      sv.speed_hi = sv.speed;
    } else if (config_.gs_sequential && !stationary) {
      const double reg =
          estimateSpeed(object.id, input.objects_stamp >= 0.0 ? input.objects_stamp : input.now,
                        object_angle, tangential_speed);
      sv.speed = reg;
      sv.speed_lo = std::min(reg, tangential_speed);
      sv.speed_hi = std::max(reg, tangential_speed);
    }
    sv.length = streamVehicleLength(object, obj_stamp);
    sv.physical_speed = std::hypot(object.velocity_x, object.velocity_y);
    if (config_.gs_sequential && object.confirmed && !stationary) {
      const double stamp = input.objects_stamp >= 0.0 ? input.objects_stamp : input.now;
      auto& history = speed_hist_[object.id];
      if (history.empty() || stamp > history.back().first + 1e-6)
        history.emplace_back(stamp, sv.speed);
      while (history.size() > 1 && history.front().first < stamp - 0.6)
        history.pop_front();
      if (history.size() > 1 && history.back().first - history.front().first >= 0.2) {
        const double slowdown = std::max(0.0,
            (history.front().second - history.back().second) /
            (history.back().first - history.front().first));
        const double low = std::max(0.0, sv.speed -
            std::min(slowdown, std::max(0.0, config_.gs_leader_decel_limit)) *
            std::max(0.0, config_.gs_leader_decel_horizon));
        sv.speed_lo = std::min(sv.speed_lo >= 0.0 ? sv.speed_lo : sv.speed, low);
      }
    }
    if (config_.gs_spatial_gap_enabled && !object.velocity_valid) {
      sv.speed_lo=0.0;
      if(config_.gs_observed_entry_enabled)sv.speed_hi=std::max(sv.speed_hi,config_.gs_unknown_speed_upper);
    }
    stream.push_back(sv);
    // 표시용(기존 출력과 같은 의미)
    const double down_edge = clampNonnegative(down - half_len);
    if (down <= up && down_edge < result.front_gap) {
      result.front_gap = down_edge;
    }
    if (up < down && !stationary) {
      result.next_npc_ttc = std::min(
          result.next_npc_ttc, clampNonnegative(up - half_len) / std::max(0.1, sv.speed));
    }
  }
  for (auto it = stationary_since_.begin(); it != stationary_since_.end();) {
    if (it->second.second < obj_stamp - 2.0) it = stationary_since_.erase(it); else ++it;
  }
  std::set<int> released_now;
  for (const StationaryBlocker& blocker : stationary_blockers) {
    bool release = blocker.eligible;
    if (release && !blocker.latched) {
      // 그 차와 합류점 사이에 다른 순환 차량이 있으면 상호 대기가 아니다.
      for (const StreamVehicle& other : stream) {
        if (other.id != blocker.id && other.pos > blocker.pos && other.pos <= 0.0) {
          release = false;
          break;
        }
      }
    }
    if (release) {
      released_now.insert(blocker.id);
      stream.erase(std::remove_if(stream.begin(), stream.end(),
                                  [&](const StreamVehicle& car) { return car.id == blocker.id; }),
                   stream.end());
    } else {
      hard_block = true;
      result.blocking_object_id = blocker.id;
      hard_reason = "stationary vehicle near conflict";
    }
  }
  yield_released_ids_ = released_now;
  if (config_.gs_phantom_enabled) {
    StreamVehicle ph;
    ph.id = -100;
    ph.pos = -std::max(0.0, config_.gs_phantom_arc);
    ph.speed = std::max(0.0, config_.gs_phantom_speed);
    ph.length = config_.gs_min_vehicle_length;
    // 실제 차량이 이미 그 근처(뒤쪽)에 보이면 가정하지 않는다.
    bool covered = false;
    for (const StreamVehicle& sv : stream) {
      if (sv.pos <= ph.pos + 0.5 * ph.length + 2.0 && sv.pos >= ph.pos - 15.0) {
        covered = true;
      }
    }
    if (!covered) {
      stream.push_back(ph);
    }
  }

  EgoEntryModel ego;
  ego.distance_to_merge = result.conflict_distance;
  ego.speed = std::max(0.0, input.ego.speed);
  ego.accel = config_.gs_ego_accel;
  ego.max_speed = config_.gs_ego_max_speed > 0.0 ? config_.gs_ego_max_speed
                                                 : config_.circulation_speed;
  if (config_.gs_use_mpc_prediction) {
    ego.max_speed = std::min(ego.max_speed, input.prediction_speed_limit);
    if (std::isfinite(input.prediction_accel_limit) && input.prediction_accel_limit > 0.0)
      ego.accel = std::min(ego.accel, input.prediction_accel_limit);
  }
  ego.start_delay = config_.gs_ego_start_delay;
  ego.departure_in_progress = state_ == RoundaboutState::kCommit;
  ego.length = config_.gs_ego_length;
  ego.measured_profile = config_.gs_measured_entry_profile;
  ego.profile_times = config_.distance_profile_times;
  ego.profile_speeds = config_.distance_profile_speeds;
  if (state_ == RoundaboutState::kCommit && ego.speed < 0.5) {
    const double remaining = config_.gs_ego_start_delay - std::max(0.0, input.now-state_enter_time_);
    if (remaining > 0.0) { ego.start_delay = remaining; ego.departure_in_progress = false; }
  }
  GapSelectorParams params;
  params.front_headway = config_.gs_front_headway;
  params.rear_headway = config_.gs_rear_headway;
  params.standstill_gap = config_.gs_standstill_gap;
  params.check_horizon = config_.gs_check_horizon;
  params.speed_margin = config_.gs_speed_margin;
  params.entry_zone = config_.gs_entry_zone;
  params.max_wait = config_.gs_max_wait;
  params.ring_length = ring_length;
  result.ego_zone_time = GapSelector::timeToZone(ego, params);
  result.ego_prediction_speed = ego.max_speed;
  std::vector<GapCandidate> gaps = config_.gs_spatial_gap_enabled
      ? std::vector<GapCandidate>() : GapSelector::evaluate(stream, ego, params);

  const GapCandidate* best = nullptr;
  const GapCandidate* latched = nullptr;
  for (const GapCandidate& g : gaps) {
    if (g.leader_id == gap_latch_leader_ && g.follower_id == gap_latch_follower_ &&
        g.wrap == gap_latch_wrap_) {
      latched = &g;
    }
    if (g.feasible && (best == nullptr || g.depart_delay < best->depart_delay)) {
      best = &g;
    }
  }
  const GapCandidate* chosen = best;
  if (latched != nullptr && latched->feasible && best != nullptr &&
      latched->depart_delay <= best->depart_delay + config_.gs_switch_margin) {
    chosen = latched;
  }
  for (auto it = arc_hist_.begin(); it != arc_hist_.end();) {
    if (it->second.empty() || it->second.back().first < input.now - 2.0) {
      it = arc_hist_.erase(it);
    } else {
      ++it;
    }
  }
  SequentialResult seq;
  for (auto it = speed_hist_.begin(); it != speed_hist_.end();) {
    if (it->second.empty() || it->second.back().first < input.now - 2.0)
      it = speed_hist_.erase(it);
    else
      ++it;
  }
  if (config_.gs_sequential && config_.gs_zone_rule_enabled) {
    // 흐름 속도: 차량별 긴 구간 평균(처음 관측부터의 이동 거리 / 시간)의 중앙값.
    const double stamp = input.objects_stamp >= 0.0 ? input.objects_stamp : input.now;
    std::vector<double> tracker_speeds;
    for (const StreamVehicle& sv : stream) {
      if (sv.id < 0 || sv.speed <= config_.stationary_speed ||
          std::find(unconfirmed_ids.begin(), unconfirmed_ids.end(), sv.id) !=
              unconfirmed_ids.end()) {
        continue;
      }
      tracker_speeds.push_back(sv.speed);
      StreamTravel& tr = stream_travel_[sv.id];
      if (tr.t0 < 0.0) {
        tr.t0 = tr.last_t = stamp;
        tr.last_pos = sv.pos;
        tr.travel = 0.0;
        continue;
      }
      if (stamp <= tr.last_t + 1e-6) continue;
      double d = sv.pos - tr.last_pos;
      if (d < -0.5 * ring_length) d += ring_length;  // 호 좌표가 한 바퀴 넘어감
      if (d < -2.0 || d > 10.0) {   // id 가 다른 차로 넘어갔거나 위치가 튐: 다시 시작
        tr.t0 = stamp;
        tr.travel = 0.0;
      } else {
        tr.travel += d;
      }
      tr.last_pos = sv.pos;
      tr.last_t = stamp;
      if (tr.travel >= config_.gs_stream_speed_min_travel && stamp - tr.t0 >= 1.0) {
        stream_speed_samples_[sv.id] = {stamp, tr.travel / (stamp - tr.t0)};
      }
    }
    for (auto it = stream_travel_.begin(); it != stream_travel_.end();) {
      if (it->second.last_t < stamp - 2.0) it = stream_travel_.erase(it); else ++it;
    }
    std::vector<double> samples;
    for (auto it = stream_speed_samples_.begin(); it != stream_speed_samples_.end();) {
      if (it->second.first < stamp - std::max(1.0, config_.gs_stream_speed_memory)) {
        it = stream_speed_samples_.erase(it);
      } else {
        samples.push_back(it->second.second);
        ++it;
      }
    }
    auto median = [](std::vector<double> x) {
      std::sort(x.begin(), x.end());
      const size_t n = x.size();
      return n % 2 ? x[n / 2] : 0.5 * (x[n / 2 - 1] + x[n / 2]);
    };
    stream_speed_ = samples.empty() ? -1.0 : median(samples);
    // 표본이 아직 없으면 트래커 속도의 중앙값(없으면 미확정 트랙 가정 속도).
    const double v_stream = stream_speed_ > 0.0
        ? stream_speed_
        : (tracker_speeds.empty() ? std::max(0.5, config_.gs_unconfirmed_speed)
                                  : median(tracker_speeds));
    ZoneRuleInput z;
    z.stream_speed = v_stream;
    z.t_zone = result.ego_zone_time;
    z.entry_zone = std::max(0.0, config_.gs_entry_zone);
    z.ego_length = config_.gs_ego_length;
    // 차량별 길이는 sv.length 에 들어 있다. 여기 값은 표시용 창과 길이를 모르는 차의 기본값.
    z.vehicle_length = (config_.gs_zone_length_estimate && length_prior_ > 0.0)
                           ? length_prior_ : config_.gs_zone_vehicle_length;
    // 진입 중에는 앞차 뒤끝이 합류점을 standstill_gap 지날 때까지 합류 구역 앞 정지 목표가
    // 걸린다. 자차가 그 제동 한계에 걸리지 않고 모델대로 가속하려면, 자차 도착
    // zone_front_time 전에 앞차가 그 선을 벗어나 있어야 한다. 그만큼을 앞 간격으로 둔다.
    z.front_gap = std::max(config_.gs_zone_front_gap,
        config_.gs_standstill_gap + z.entry_zone +
            std::max(0.0, config_.gs_zone_front_time) * v_stream);
    z.rear_gap = config_.gs_zone_rear_gap;
    // 대기 완화: YIELD 대기가 길면 뒤 간격을 먼저, 그다음 앞 간격을 하한까지 줄인다.
    //   COMMIT 동안은 고른 틈의 창이 도로 넓어지지 않도록 완화량을 유지한다.
    if (state_ == RoundaboutState::kYield) {
      // 2026-10-06: zone_relax_from_stop 이면 양보선에서 실제로 선 뒤부터만 완화한다(서기 전엔 0).
      //   의무 정지를 끈 뒤 YIELD 진입부터 세면 굴러가는 중 완화된 틈으로 GO -> 취소가 반복됐다(18:35:52 재생).
      const double relax_dwell =
          config_.gs_zone_relax_from_stop
              ? ((mandatory_stop_completed_ && mandatory_stop_completed_time_ >= 0.0)
                     ? std::max(0.0, input.now - mandatory_stop_completed_time_)
                     : 0.0)
              : yield_dwell;
      zone_relax_ = config_.gs_zone_relax_rate > 0.0
          ? std::max(0.0, relax_dwell - config_.gs_zone_relax_start) * config_.gs_zone_relax_rate
          : 0.0;
    } else if (state_ != RoundaboutState::kCommit) {
      zone_relax_ = 0.0;
    }
    last_zone_relax_ = 0.0;
    if (zone_relax_ > 0.0) {
      double remaining = zone_relax_;
      const double rear_floor = std::min(z.rear_gap, std::max(0.0, config_.gs_zone_rear_gap_floor));
      const double rear_cut = std::min(remaining, z.rear_gap - rear_floor);
      z.rear_gap -= rear_cut;
      remaining -= rear_cut;
      const double front_floor = std::min(z.front_gap, std::max(0.0, config_.gs_zone_front_gap_floor));
      const double front_cut = std::min(remaining, z.front_gap - front_floor);
      z.front_gap -= front_cut;
      last_zone_relax_ = rear_cut + front_cut;
    }
    z.locked = state_ == RoundaboutState::kCommit && committed_valid_;
    z.locked_leader = committed_leader_;
    z.locked_follower = committed_follower_;
    z.commit_tolerance = std::max(0.0, config_.gs_zone_commit_tolerance);
    zone_preconfirm_active_ = config_.gs_zone_preconfirm;
    if (zone_preconfirm_active_ && zone_pair_confirmed_) {
      z.latched_leader = zone_pair_leader_;
      z.latched_follower = zone_pair_follower_;
      // 허용치는 뒤 간격 하한 아래로 내려가지 않게: 남은 (뒤 간격 - 하한) 이내.
      //   (간격 부족은 뒤차 쪽으로 나타난다. 앞 간격 여유까지 빌리면 20:38 재생에서 뒤 0.5 m 진입이 나왔다.)
      const double room = std::max(0.0, z.rear_gap - config_.gs_zone_rear_gap_floor);
      z.pair_tolerance = std::min(std::max(0.0, config_.gs_zone_pair_tolerance), room);
    }
    seq = evaluateZoneRule(stream, z, &last_zone_lead_, &last_zone_rear_);
    if (zone_preconfirm_active_) {
      // 같은 (앞차, 뒤차) 쌍이 연속으로 가능한 시간 = 확인. 출발 대기(depart_delay) 중에도 센다.
      const bool ok = seq.feasible && seq.gap.feasible;
      if (!ok) {
        zone_pair_leader_ = zone_pair_follower_ = -2;
        zone_pair_ok_since_ = -1.0;
      } else if (seq.gap.leader_id != zone_pair_leader_ ||
                 seq.gap.follower_id != zone_pair_follower_ || zone_pair_ok_since_ < 0.0) {
        zone_pair_leader_ = seq.gap.leader_id;
        zone_pair_follower_ = seq.gap.follower_id;
        zone_pair_ok_since_ = input.now;
      }
      zone_pair_confirmed_ = ok && zone_pair_ok_since_ >= 0.0 &&
          input.now - zone_pair_ok_since_ >= std::max(0.0, config_.gs_zone_confirm_seconds);
    }
    last_zone_speed_ = v_stream;
    seq_target_leader_ = seq.target_leader;
    seq_infeasible_since_ = -1.0;
  } else if (config_.gs_sequential) {
    SequentialParams sp;
    sp.observed_slot=config_.gs_observed_entry_enabled;
    if(sp.observed_slot) {
      if(!input.observation.fresh(input.now,config_.gs_observation_timeout)) {
        result.reason="entry observation stale or unavailable";return result;
      }
      sp.observed_bounds=[&, conflict_angle](double anchor) {
        const auto& history=input.observation.frames;
        // Open slots need three distinct scans; bounded pairs still need a
        // fresh scan. The callback is selected below after identifying a pair.
        return history.back()->bounds(config_.center.x,config_.center.y,config_.nominal_radius,
            conflict_angle,config_.counter_clockwise?1.:-1.,anchor,config_.gs_observation_radial_half);
      };
    }
    sp.spatial_front_gap=config_.gs_spatial_front_gap;
    sp.spatial_rear_gap=config_.gs_spatial_rear_gap;
    sp.approach_time_buffer = std::max(0.0, config_.gs_approach_time_buffer);
    sp.approach_accel_compensation = config_.gs_approach_accel_compensation;
    sp.approach_accel_upper = std::min(std::max(.1,ego.accel),GapSelector::entryAcceleration(ego,ego.speed));
    sp.separate_slot_observation=config_.gs_preparation_enabled;
    sp.leader_start_distance = config_.gs_preparation_enabled?0.:config_.gs_leader_start_distance;
