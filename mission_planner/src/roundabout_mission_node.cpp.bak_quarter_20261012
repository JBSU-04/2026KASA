  void timerCallback(const ros::TimerEvent&) {
    const ros::Time stamp = ros::Time::now();

    // 런타임 핫 리로드: 1초 주기로 파라미터 동기화하여 rosparam 갱신 시 실시간 반영
    if ((stamp - last_param_sync_).toSec() >= 1.0) {
      loadParameters();
      mission_.setConfig(config_);
      last_param_sync_ = stamp;
    }

    RoundaboutInput input;
    {
      std::lock_guard<std::mutex> lock(mutex_);
      input.now = stamp.toSec();
      input.ego = ego_;
      input.ego.valid = input.ego.valid && !last_odom_time_.isZero() &&
                        (stamp - last_odom_time_).toSec() <= odom_timeout_;
      input.localization_valid =
          !config_.require_localization ||
          (have_localization_status_ && localization_valid_);
      input.tracker_stream_fresh =
          !last_tracker_time_.isZero() &&
          (stamp - last_tracker_time_).toSec() <= config_.tracker_timeout;
      input.tracker_stream_valid = input.tracker_stream_fresh && tracker_reported_valid_;
      input.route = route_;
      input.objects = tracked_objects_;
      input.observation=observation_;
      input.objects_stamp = last_objects_stamp_.isZero() ? -1.0 : last_objects_stamp_.toSec();
      const bool feedback_fresh = !last_curve_speed_.isZero() && !last_mission_speed_.isZero() &&
          (stamp - last_curve_speed_).toSec() >= 0.0 &&
          (stamp - last_mission_speed_).toSec() >= 0.0 &&
          (stamp - last_curve_speed_).toSec() <= feedback_timeout_ &&
          (stamp - last_mission_speed_).toSec() <= feedback_timeout_;
      if (feedback_fresh && std::isfinite(curve_speed_) && std::isfinite(mission_speed_))
        // Future speed grows from measured ego speed at the MPC ramp rate.
        // A stopped mission target (~3m/s) is not the future geometry ceiling.
        input.prediction_speed_limit = curve_speed_;
      input.prediction_accel_limit = prediction_accel_limit_;
    }

    const RoundaboutState previous_state = mission_.state();
    const RoundaboutOutput output = mission_.update(input);
    ego_display_position_ = input.ego.position;
    if (previous_state != output.state) {
      ROS_INFO_STREAM("[roundabout_mission] "
                      << RoundaboutMission::stateName(previous_state) << " -> "
                      << RoundaboutMission::stateName(output.state)
                      << " reason=" << output.reason);
    }
    publish(output, input.localization_valid, input.tracker_stream_valid,
            stamp);
  }

  void publish(const RoundaboutOutput& output, bool localization_valid,
               bool tracker_stream_valid,
               const ros::Time& stamp) {
    mission_planner_msgs::BehaviorConstraint constraint;
    constraint.header.stamp = stamp;
    constraint.header.frame_id = frame_id_;
    constraint.source = mission_planner_msgs::BehaviorConstraint::SOURCE_ROUNDABOUT;
    constraint.priority = output.constraint.priority;
    constraint.active = output.constraint.active;
    constraint.max_speed = output.constraint.max_speed;
    constraint.stop_required = output.constraint.stop_required;
    constraint.stop_distance = output.constraint.stop_distance;
    constraint.lead_vehicle_active = output.constraint.lead_vehicle_active;
    constraint.lead_vehicle_id = output.constraint.lead_vehicle_id;
    constraint.lead_distance = output.constraint.lead_distance;
    constraint.lead_speed = output.constraint.lead_speed;
    constraint.lead_time_gap = output.constraint.lead_time_gap;
    constraint.lead_standstill_distance = output.constraint.lead_standstill_distance;
    constraint.lead_profile_override = output.constraint.lead_profile_override;
    constraint.comfortable_decel = output.constraint.comfortable_decel;
    constraint.emergency_decel = output.constraint.emergency_decel;
    constraint.reason = output.constraint.reason;
    constraint_pub_.publish(constraint);

    mission_planner_msgs::MissionState state;
    state.header = constraint.header;
    state.state = static_cast<std::uint8_t>(output.state);
    state.active = output.state != RoundaboutState::kIdle;
    state.gap_safe = output.gap_safe;
    state.localization_valid = localization_valid;
    state.tracker_stream_valid = tracker_stream_valid;
    state.blocking_object_id = output.blocking_object_id;
    state.tracked_object_count = output.tracked_object_count;
    state.distance_to_yield = output.distance_to_yield;
    state.next_npc_ttc = output.next_npc_ttc;
    state.front_gap = output.front_gap;
    state.reason = output.reason;
    if(config_.distance_enabled || config_.gs_spatial_arrival_check){
      auto num=[](double v){if(!std::isfinite(v))return std::string("null");std::ostringstream n;n.precision(17);n<<v;return n.str();};
      std::string phase="waiting",failure;
      for(const auto& g:output.gaps)if(g.selected){
        phase=g.preview?"preview":(output.gap_safe?"confirming":"blocked");failure=g.failure_reason;
      }
      if(output.reason.find("mandatory stop")!=std::string::npos)phase="mandatory_stop";
      else if(output.state==RoundaboutState::kCommit)phase="committed";
      else if(output.state==RoundaboutState::kCirculate||output.state==RoundaboutState::kExit)phase="circulating";
      else if(output.state==RoundaboutState::kFailsafe)phase="failsafe";
      else if(output.state==RoundaboutState::kIdle)phase="inactive";
      std::ostringstream d;d<<"{\"model\":\""<<(config_.window_enabled?"window":config_.gs_spatial_arrival_check?"spatial":"distance")<<"\",\"stamp\":"<<num(stamp.toSec())
       <<",\"ego_motion_model\":\""<<(config_.distance_measured_profile?"measured_profile":"constant_accel")<<"\""
       <<",\"approval_mode\":\""<<(config_.gs_spatial_only_admission?"spatial_space":config_.gs_spatial_arrival_check?"spatial_trajectory":(config_.distance_clearance_only?"clearance":"trajectory"))<<"\""
       <<",\"approval_latched\":"<<((config_.gs_observed_entry_enabled?output.approval_latched:(output.state==RoundaboutState::kCommit&&(config_.gs_spatial_arrival_check?config_.gs_commit_rear_yield_lock:(config_.distance_clearance_only&&config_.distance_rear_yield&&config_.distance_commit_rear_yield_lock))))?"true":"false")
       <<",\"reference_time_s\":"<<num(output.ego_reference_time)
       <<",\"delay_remaining_s\":"<<num(output.ego_delay_remaining)
       <<",\"front_check\":\""<<(config_.gs_spatial_only_admission?"slot_space":!config_.gs_spatial_arrival_check&&config_.distance_clearance_only?"first_entry":"trajectory_min")<<"\""
       <<",\"rear_check\":\""<<(config_.gs_spatial_only_admission?"slot_space":config_.gs_spatial_arrival_check||config_.distance_clearance_only?"rear_clearance":"trajectory_min")<<"\""
       <<",\"front_response_s\":"<<num(config_.distance_front_response)
       <<",\"front_max_decel_mps2\":"<<num(config_.distance_front_max_decel)
       <<",\"follow_standstill_m\":"<<num(config_.gs_prediction_follow_standstill_gap)
       <<",\"follow_headway_s\":"<<num(config_.gs_prediction_follow_time_gap)
       <<",\"leader_limited\":"<<(output.ego_leader_limited?"true":"false")
       <<",\"curve_limited\":"<<(output.ego_curve_limited?"true":"false")
       <<",\"candidate_state\":\""<<phase<<"\",\"failure_reason\":\""<<failure<<"\""
       <<",\"safe\":"<<(output.gap_safe?"true":"false")<<",\"leader_id\":"<<output.gap_leader_id<<",\"follower_id\":"<<output.gap_follower_id
       <<",\"front_now_m\":"<<num(output.front_gap)<<",\"rear_now_m\":"<<num(output.current_rear_gap)
       <<",\"front_min_m\":"<<num(output.predicted_front_gap)<<",\"rear_min_m\":"<<num(output.predicted_rear_gap)
       <<",\"required_rear_decel_mps2\":"<<num(output.required_rear_decel)<<",\"entry_time_s\":"<<num(output.ego_zone_time)
       <<",\"clear_time_s\":"<<num(output.ego_clear_time)<<",\"rear_yield_assumption\":"<<(config_.gs_spatial_arrival_check?(config_.gs_opportunity_enabled&&config_.gs_opportunity_rear_yield?"true":"false"):(config_.distance_rear_yield?"true":"false"))<<"}";
      std::string payload=d.str();payload.pop_back();
      std::ostringstream extra;extra<<",\"future_departure_s\":"<<num(output.future_departure)
          <<",\"commit_acc_only\":"<<(config_.gs_opportunity_enabled&&config_.gs_commit_acc_only?"true":"false")
          <<",\"future_front_min_m\":"<<num(output.future_front_gap)
          <<",\"future_rear_min_m\":"<<num(output.future_rear_gap)
          <<",\"switch_reason\":\""<<output.gap_switch_reason<<"\",\"duplicate_ids\":[";
      for(size_t i=0;i<output.duplicate_track_ids.size();++i){if(i)extra<<',';extra<<output.duplicate_track_ids[i];}
      extra<<"],\"observation_state\":\""<<output.observation_state<<"\",\"observation_stamp\":"<<output.observation_stamp
          <<",\"observed_free_m\":"<<num(output.observed_free_length)
          <<",\"confirmation_s\":"<<num(output.confirmation_time)
          <<",\"approval_time\":"<<num(output.approval_time)<<",\"approval_distance_m\":"<<num(output.approval_distance)
          <<",\"physical_gap_m\":"<<num(output.physical_gap_length)
          <<",\"entry_phase\":\""<<output.entry_phase<<"\""
          <<",\"trajectory_observation\":\""<<output.trajectory_observation<<"\""
          <<",\"preparation_speed_mps\":"<<num(output.preparation_speed)
          <<",\"preparation_stop_distance_m\":"<<num(output.preparation_stop_distance)
          <<",\"acceleration_start_delay_s\":"<<num(output.acceleration_start_delay)
          <<",\"approval_fixed\":"<<(output.approval_latched?"true":"false")
          <<",\"acc_target_id\":"<<output.constraint.lead_vehicle_id
          <<",\"acc_distance_m\":"<<num(output.constraint.lead_distance)
          <<",\"acc_speed_mps\":"<<num(output.constraint.lead_speed)
          <<",\"window_t_open_s\":"<<num(output.window_t_open)<<",\"window_t_ego_s\":"<<num(output.window_t_ego)
          <<",\"window_t_close_s\":"<<num(output.window_t_close)<<",\"window_ok_frames\":"<<output.window_ok_frames
          <<",\"window_missed\":"<<output.window_missed<<"}";
      std_msgs::String message;message.data=payload+extra.str();distance_debug_pub_.publish(message);
    }

    state_pub_.publish(state);
    {  // 2026-10-12 ACC: [active, id, gap, gap_ref, lead_speed, v_des, a_des] (roundabout_launch_assist 가 a_des 로 페달 보조)
      std_msgs::Float64MultiArray acc;acc.data={output.acc_active?1.:0.,double(output.acc_id),output.acc_gap,output.acc_gap_ref,
        output.acc_lead_speed,output.acc_v_des,output.acc_a_des};acc_pub_.publish(acc);
    }

    mission_planner_msgs::MissionDebug debug;
    debug.header = constraint.header;
    debug.center = toRosPoint(config_.center);
    debug.yield_point = toRosPoint(config_.yield_point);
    debug.conflict_point = toRosPoint(config_.conflict_point);
    debug.exit_point = toRosPoint(config_.exit_point);
    debug.inner_radius = config_.inner_radius;
    debug.outer_radius = config_.outer_radius;
    debug.ego_radius = output.ego_radius;
    debug.ego_angle = output.ego_angle;
    debug.safe_speed = output.constraint.max_speed;
    debug.blocking_object_id = output.blocking_object_id;
    debug_pub_.publish(debug);

    marker_pub_.publish(makeMarkers(output, stamp));
    publishGapMarkers(output, stamp);
  }

  // 흐름 좌표(합류점 0, 진행 방향 +) -> map 점과 접선 방향.
  Point2 ringPoint(double conflict_angle, double pos, double radius,
                   double* yaw) const {
    const double dir = config_.counter_clockwise ? 1.0 : -1.0;
    const double ang = conflict_angle + dir * pos / std::max(1.0, config_.nominal_radius);
    if (yaw) *yaw = tangentYaw(ang, config_.counter_clockwise);
    return {config_.center.x + radius * std::cos(ang),
            config_.center.y + radius * std::sin(ang)};
  }

  // ★ 틈 선택 시각화(고주로 gap select 마커와 같은 색 규칙).
  //   승인: 초록 / 목표 대기: 노랑 / 목표 재확인: 주황 / 다른 가능 틈: 하늘색
  //   차량: 선택 틈 앞차 보라, 뒤차 주황, 그 외 흰색 + id/속도
  //   합류점(자동 판정 포함): 노란 기둥, 자차 위 상태 글씨
  void publishGapMarkers(const RoundaboutOutput& output,
                         const ros::Time& stamp) {
    visualization_msgs::MarkerArray arr;
    visualization_msgs::Marker del;
    del.header.frame_id = frame_id_;
    del.header.stamp = stamp;
    del.action = visualization_msgs::Marker::DELETEALL;
    arr.markers.push_back(del);
    if(config_.gs_observed_entry_enabled && output.state!=RoundaboutState::kIdle) {
      visualization_msgs::Marker label;label.header=del.header;label.ns="entry_phase";label.id=0;
      label.type=visualization_msgs::Marker::TEXT_VIEW_FACING;label.action=visualization_msgs::Marker::ADD;
      label.pose.position=toRosPoint(ego_display_position_,3.5);label.pose.orientation.w=1.;label.scale.z=.65;
      label.color=output.approval_latched?color(.75F,.15F,1.F,1.F):output.gap_safe?color(.1F,1.F,.3F,1.F):color(1.F,.85F,.1F,1.F);
      std::ostringstream text;text<<"ENTRY "<<(output.approval_latched?"COMMITTED / ACC":output.gap_safe?"READY / confirming":output.entry_phase=="preparing"?"PREPARING / no approval":"CANDIDATE / HOLD")
          <<"\nobservation: "<<output.trajectory_observation<<" physical="<<output.physical_gap_length<<"m observed="<<output.observed_free_length<<"m"
          <<"\ncreep="<<output.preparation_speed<<"m/s accel in="<<output.acceleration_start_delay<<"s"
          <<"\nentry="<<output.ego_zone_time<<"s clear="<<output.ego_clear_time<<"s"
          <<"\nACC id="<<output.constraint.lead_vehicle_id<<" gap="<<output.constraint.lead_distance<<"m";
      label.text=text.str();arr.markers.push_back(label);
      if(config_.gs_preparation_enabled && !output.approval_latched &&
          output.preparation_stop_distance>0. && route_.size()>1) {
        const auto projection=projectToPolyline(route_,ego_display_position_);
        if(projection.valid) {
          const double target=projection.s+output.preparation_stop_distance;double arc=0.;
          for(size_t i=1;i<route_.size();++i) {
            const double length=distance(route_[i-1],route_[i]);
            if(arc+length>=target && length>1e-6) {
              const double f=std::max(0.,std::min(1.,(target-arc)/length));
              visualization_msgs::Marker boundary;boundary.header=del.header;boundary.ns="preparation_boundary";boundary.id=0;
              boundary.type=visualization_msgs::Marker::SPHERE;boundary.action=visualization_msgs::Marker::ADD;
              boundary.pose.position=toRosPoint({route_[i-1].x+f*(route_[i].x-route_[i-1].x),route_[i-1].y+f*(route_[i].y-route_[i-1].y)},.25);
              boundary.pose.orientation.w=1.;boundary.scale.x=boundary.scale.y=.45;boundary.scale.z=.5;
              boundary.color=color(1.F,.65F,.05F,.9F);arr.markers.push_back(boundary);break;
            }
            arc+=length;
          }
        }
      }

      // Last scan's cells: no persistent empty map and no unknown=free rendering.
      if(!observation_.frames.empty()) {
        const auto& scan=*observation_.frames.back();
        visualization_msgs::Marker free,occupied;free.header=del.header;free.ns="observed_free";free.id=0;
        free.type=visualization_msgs::Marker::CUBE_LIST;free.action=visualization_msgs::Marker::ADD;
        free.pose.orientation.w=1.;free.scale.x=free.scale.y=scan.resolution;free.scale.z=.025;
        free.color=color(.1F,.8F,1.F,.2F);occupied=free;occupied.ns="observed_occupied";occupied.color=color(1.F,.15F,.05F,.4F);
        if(observation_.fresh(stamp.toSec(),config_.gs_observation_timeout))
          for(int iy=0;iy<scan.width;++iy)for(int ix=0;ix<scan.width;++ix) {
            Point2 p{scan.min_x+(ix+.5)*scan.resolution,scan.min_y+(iy+.5)*scan.resolution};
            if(std::abs(radiusFrom(config_.center,p)-config_.nominal_radius)>2.)continue;
            const auto cell=scan.cells[iy*scan.width+ix];
            if(cell==ObservationCell::Free)free.points.push_back(toRosPoint(p,.08));
            else if(cell==ObservationCell::Occupied)occupied.points.push_back(toRosPoint(p,.1));
          }
        arr.markers.push_back(free);arr.markers.push_back(occupied);
      }
    }
    // 링에 들어간 뒤(순환/출구)는 틈 선택이 의미 없어 지운다.
    if (!output.gap_select_active ||
        (output.state != RoundaboutState::kApproach &&
         output.state != RoundaboutState::kYield &&
         output.state != RoundaboutState::kCommit)) {
      gap_marker_pub_.publish(arr);
      return;
    }
    const ros::Duration lifetime(0.3);
    // Arc positions are measured along the NPC ring, not the ego merge marker.
    const double display_radius = config_.gs_observed_entry_enabled
        ? config_.nominal_radius
        : radiusFrom(config_.center, output.effective_conflict_point);
    const double band_half_width = config_.gs_observed_entry_enabled
        ? 0.5 * config_.gs_prediction_npc_width : 1.4;
    const double r_in = display_radius - band_half_width;
    const double r_out = display_radius + band_half_width;
    int id = 0;
    const double view = std::max(5.0, config_.gs_viz_range);
    for (const RoundaboutGapViz& g0 : output.gaps) {
      // 한 바퀴 돌린 차량으로 만든 틈은 원 거의 전체를 덮는다. 합류점 기준
      // +-view 안만 그린다(판단에는 영향 없음).
      RoundaboutGapViz g = g0;
      g.go = g.go && output.state == RoundaboutState::kCommit;
      g.lo = std::max(g.lo, -view);
      g.hi = std::min(g.hi, view);
      if (g.hi <= g.lo) continue;
      visualization_msgs::Marker band;
      band.header.frame_id = frame_id_;
      band.header.stamp = stamp;
      band.ns = g.selected ? (g.feasible ? (g.go ? "gap_go" : "gap_wait")
                                                   : "gap_pending")
                           : (g.feasible ? "gap_feasible" : "gap_infeasible");
      band.id = id++;
      band.type = visualization_msgs::Marker::TRIANGLE_LIST;
      band.action = visualization_msgs::Marker::ADD;
      band.pose.orientation.w = 1.0;
      band.scale.x = band.scale.y = band.scale.z = 1.0;
      band.color = g.preview ? color(0.35F,0.4F,1.0F,0.35F) : g.selected
          ? (config_.gs_observed_entry_enabled && output.approval_latched ? color(.75F,.15F,1.0F,.45F) : !g.feasible ? color(1.0F, 0.4F, 0.05F, 0.4F)
                        : ((g.go&&(!config_.distance_enabled||output.state==RoundaboutState::kCommit)&&(!config_.gs_observed_entry_enabled||output.gap_safe)) ? color(0.1F, 1.0F, 0.3F, 0.4F)
                                : color(1.0F, 0.85F, 0.1F, 0.35F)))
          : (g.feasible ? color(0.0F, 0.8F, 1.0F, 0.15F)
                        : color(0.6F, 0.6F, 0.6F, 0.12F));
      band.lifetime = lifetime;
      const int n = std::max(2, static_cast<int>(std::ceil((g.hi - g.lo) / 0.5)));
      const double z = g.selected ? 0.25 : 0.18;
      for (int k = 0; k < n; ++k) {
        const double a = g.lo + (g.hi - g.lo) * k / n;
        const double b = g.lo + (g.hi - g.lo) * (k + 1) / n;
        const Point2 ai = ringPoint(output.conflict_angle, a, r_in, nullptr);
        const Point2 ao = ringPoint(output.conflict_angle, a, r_out, nullptr);
        const Point2 bi = ringPoint(output.conflict_angle, b, r_in, nullptr);
        const Point2 bo = ringPoint(output.conflict_angle, b, r_out, nullptr);
        band.points.push_back(toRosPoint(ai, z));
        band.points.push_back(toRosPoint(ao, z));
        band.points.push_back(toRosPoint(bo, z));
        band.points.push_back(toRosPoint(ai, z));
        band.points.push_back(toRosPoint(bo, z));
        band.points.push_back(toRosPoint(bi, z));
      }
      arr.markers.push_back(band);
      // 틈 글씨: GO / wait / X
      visualization_msgs::Marker txt;
      txt.header = band.header;
      txt.ns = "gap_label";
      txt.id = band.id;
      txt.type = visualization_msgs::Marker::TEXT_VIEW_FACING;
      txt.action = visualization_msgs::Marker::ADD;
      txt.pose.position = toRosPoint(
          ringPoint(output.conflict_angle, 0.5 * (g.lo + g.hi),
                    display_radius, nullptr), 1.2);
      txt.pose.orientation.w = 1.0;
      txt.scale.z = 0.8;
      txt.color = band.color;
      txt.color.a = 1.0F;
      txt.lifetime = lifetime;
      std::ostringstream ts;
      ts.setf(std::ios::fixed);
      ts.precision(1);
      if(g.preview){ts<<"PREVIEW / "<<g.failure_reason;}
      else if(config_.distance_enabled&&g.selected&&output.state!=RoundaboutState::kCommit&&g.feasible){
        ts<<(output.reason.find("mandatory stop")!=std::string::npos?"STOP 1s":"CONFIRM");
      } else if (!g.feasible) {
        ts << (g.selected ? "HOLD / recheck" : "X");
      } else if (g.go) {
        ts << (config_.gs_observed_entry_enabled?(output.approval_latched?"COMMITTED / ACC":output.gap_safe?"READY / confirming":"CANDIDATE / approach"):"GO");
      } else {
        ts << "wait " << g.depart_delay << "s";
      }
      txt.text = ts.str();
      arr.markers.push_back(txt);
    }
    int sel_leader = -1, sel_follower = -1;
    for (const RoundaboutGapViz& g : output.gaps) {
      if (g.selected) { sel_leader = g.leader_id; sel_follower = g.follower_id; }
    }
    int vid = 0;
    for (const RoundaboutVehicleViz& v : output.stream) {
      if (std::abs(v.pos) > view + 10.0) continue;
      double yaw = 0.0;
      Point2 c = ringPoint(output.conflict_angle, v.pos, display_radius, &yaw);
      if (v.measured_position_valid) {
        c = v.measured_position;
        yaw = tangentYaw(angleFrom(config_.center, c), config_.counter_clockwise);
      }
      visualization_msgs::Marker box;
      box.header.frame_id = frame_id_;
      box.header.stamp = stamp;
      box.ns = "gap_vehicle";
      box.id = vid;
      box.type = visualization_msgs::Marker::CUBE;
      box.action = visualization_msgs::Marker::ADD;
      box.pose.position = toRosPoint(c, 0.8);
      box.pose.orientation.z = std::sin(0.5 * yaw);
      box.pose.orientation.w = std::cos(0.5 * yaw);
      box.scale.x = std::max(1.0, v.length);
      box.scale.y = 1.9;
      box.scale.z = 1.5;
      box.color = v.confirmed ? color(0.9F, 0.9F, 0.9F, 0.8F)
                              : color(1.0F, 0.3F, 0.3F, 0.5F);  // 미확정: 연한 빨강
      if (v.id == sel_follower) box.color = color(1.0F, 0.55F, 0.0F, 0.8F);
      if (v.id == sel_leader) box.color = color(0.75F, 0.2F, 1.0F, 0.8F);
      box.lifetime = lifetime;
      arr.markers.push_back(box);
      visualization_msgs::Marker txt = box;
      txt.ns = "gap_vehicle_text";
      txt.type = visualization_msgs::Marker::TEXT_VIEW_FACING;
      txt.pose.position.z = 2.3;
      txt.pose.orientation.z = 0.0;
      txt.pose.orientation.w = 1.0;
      txt.scale.x = txt.scale.y = 0.0;
      txt.scale.z = 0.8;
      txt.color.a = 1.0F;
      std::ostringstream vs;
      vs.setf(std::ios::fixed);
      vs.precision(1);
      vs << (v.id < 0 ? std::string("phantom") : "id" + std::to_string(v.id))
         << " " << (std::isfinite(v.physical_speed) ? v.physical_speed : v.speed)
         << "m/s" << (v.confirmed ? "" : " ?");
      if (config_.gs_use_tracker_velocity && std::isfinite(v.physical_speed))
        vs << " arc " << v.speed;
      txt.text = vs.str();
      arr.markers.push_back(txt);
      ++vid;
    }
    visualization_msgs::Marker cp;
    cp.header.frame_id = frame_id_;
    cp.header.stamp = stamp;
    cp.ns = "gap_conflict";
    cp.id = 0;
    cp.type = visualization_msgs::Marker::CYLINDER;
    cp.action = visualization_msgs::Marker::ADD;
    cp.pose.position = toRosPoint(output.effective_conflict_point, 1.25);
    cp.pose.orientation.w = 1.0;
    cp.scale.x = cp.scale.y = 0.8;
    cp.scale.z = 2.5;
    cp.color = color(1.0F, 0.95F, 0.0F, 0.9F);
    cp.lifetime = lifetime;
    arr.markers.push_back(cp);

    int feasible = 0;
    for (const RoundaboutGapViz& g : output.gaps) feasible += g.feasible ? 1 : 0;
    visualization_msgs::Marker st;
    st.header = cp.header;
    st.ns = "gap_status";
    st.id = 0;
    st.type = visualization_msgs::Marker::TEXT_VIEW_FACING;
    st.action = visualization_msgs::Marker::ADD;
    st.pose.position = toRosPoint(ego_display_position_, 3.6);
    st.pose.orientation.w = 1.0;
    st.scale.z = 0.9;
    st.color = color(1.0F, 1.0F, 1.0F, 0.95F);
    st.lifetime = lifetime;
    std::ostringstream ss;
    ss.setf(std::ios::fixed);
    ss.precision(1);
    ss << "GAP SELECT " << RoundaboutMission::stateName(output.state)
       << "  feasible " << feasible << "/" << output.gaps.size();
    if (output.gap_leader_id != -1 || output.gap_follower_id != -1) {
      ss << "\nL" << output.gap_leader_id << "/F" << output.gap_follower_id;
      if (std::isfinite(output.gap_depart_delay)) {
        ss << (output.gap_safe ? "  ready" : "  wait/recheck ");
        if (!output.gap_safe) ss << output.gap_depart_delay << "s";
      }
    }
    ss << "\nconflict " << output.conflict_distance << "m";
    if (std::isfinite(output.ego_zone_time))
      ss << "\nmerge zone in " << output.ego_zone_time << "s at cap "
         << output.ego_prediction_speed << "m/s";
    if(output.future_departure>0.0)ss<<"\nFUTURE ENTRY "<<output.future_departure<<"s (not GO)";
    if(!output.gap_switch_reason.empty())ss<<"\nswitch: "<<output.gap_switch_reason;
    if(!output.duplicate_track_ids.empty()){
      ss<<"\nduplicate fragments:";for(int id:output.duplicate_track_ids)ss<<" "<<id;
    }
    ss << "\n" << (output.state == RoundaboutState::kCommit ? "ENTRY APPROVED"
                                                            : "ENTRY NOT APPROVED");
    if(config_.distance_enabled){
      ss<<"\nbumper now F "<<output.front_gap<<" R "<<output.current_rear_gap<<" m";
      ss<<"\npred F "<<output.predicted_front_gap<<" R "<<output.predicted_rear_gap<<" m";
      ss<<"\nrear braking "<<output.required_rear_decel<<" m/s2; clear "<<output.ego_clear_time<<" s";
    }
    st.text = ss.str();
    arr.markers.push_back(st);
    gap_marker_pub_.publish(arr);
  }

  visualization_msgs::Marker baseMarker(const ros::Time& stamp, int id,
                                         int type) const {
    visualization_msgs::Marker marker;
    marker.header.stamp = stamp;
    marker.header.frame_id = frame_id_;
    marker.ns = "roundabout_mission";
    marker.id = id;
    marker.type = type;
    marker.action = visualization_msgs::Marker::ADD;
    marker.pose.orientation.w = 1.0;
    marker.lifetime = ros::Duration(0.25);
    return marker;
  }

  visualization_msgs::Marker makeCircle(const ros::Time& stamp, int id,
                                         double radius,
                                         const std_msgs::ColorRGBA& marker_color) const {
    visualization_msgs::Marker marker =
        baseMarker(stamp, id, visualization_msgs::Marker::LINE_STRIP);
    marker.scale.x = 0.18;
    marker.color = marker_color;
    for (int index = 0; index <= 72; ++index) {
      const double angle = kTwoPi * static_cast<double>(index) / 72.0;
      marker.points.push_back(toRosPoint(
          {config_.center.x + radius * std::cos(angle),
           config_.center.y + radius * std::sin(angle)},
          0.25));
    }
    return marker;
  }

  visualization_msgs::MarkerArray makeMarkers(const RoundaboutOutput& output,
                                                const ros::Time& stamp) const {
    visualization_msgs::MarkerArray markers;
    markers.markers.push_back(
        makeCircle(stamp, 0, config_.inner_radius, color(0.2F, 0.7F, 1.0F, 0.8F)));
    markers.markers.push_back(
        makeCircle(stamp, 1, config_.outer_radius, color(0.2F, 0.7F, 1.0F, 0.8F)));

    visualization_msgs::Marker yield_line =
        baseMarker(stamp, 2, visualization_msgs::Marker::LINE_LIST);
    yield_line.scale.x = 0.35;
    yield_line.color = color(1.0F, 0.2F, 0.2F, 1.0F);
    const double normal_x = -std::sin(config_.entry_heading);
    const double normal_y = std::cos(config_.entry_heading);
    yield_line.points.push_back(toRosPoint(
        {config_.yield_point.x - 3.0 * normal_x,
         config_.yield_point.y - 3.0 * normal_y},
        0.35));
    yield_line.points.push_back(toRosPoint(
        {config_.yield_point.x + 3.0 * normal_x,
         config_.yield_point.y + 3.0 * normal_y},
        0.35));
    markers.markers.push_back(yield_line);

    visualization_msgs::Marker conflict =
        baseMarker(stamp, 3, visualization_msgs::Marker::SPHERE);
    conflict.pose.position = toRosPoint(config_.conflict_point, 0.4);
    conflict.scale.x = conflict.scale.y = conflict.scale.z = 0.8;
    conflict.color = color(1.0F, 0.55F, 0.0F, 1.0F);
    markers.markers.push_back(conflict);

    visualization_msgs::Marker exit =
        baseMarker(stamp, 4, visualization_msgs::Marker::SPHERE);
    exit.pose.position = toRosPoint(config_.exit_point, 0.4);
    exit.scale.x = exit.scale.y = exit.scale.z = 0.8;
    exit.color = color(0.2F, 1.0F, 0.3F, 1.0F);
    markers.markers.push_back(exit);

    visualization_msgs::Marker label =
        baseMarker(stamp, 5, visualization_msgs::Marker::TEXT_VIEW_FACING);
    label.pose.position = toRosPoint(config_.center, 2.0);
    label.scale.z = 1.2;
    label.color = color(1.0F, 1.0F, 1.0F, 1.0F);
    label.text = std::string("Roundabout: ") +
                 RoundaboutMission::stateName(output.state) + "\n" +
                 output.reason;
    markers.markers.push_back(label);
    return markers;
  }

