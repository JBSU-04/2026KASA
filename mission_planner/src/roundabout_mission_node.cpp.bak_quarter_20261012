namespace mission_planner {
namespace {

constexpr double kPi = 3.14159265358979323846;
constexpr double kTwoPi = 2.0 * kPi;

geometry_msgs::Point toRosPoint(const Point2& point, double z = 0.0) {
  geometry_msgs::Point result;
  result.x = point.x;
  result.y = point.y;
  result.z = z;
  return result;
}

std_msgs::ColorRGBA color(float red, float green, float blue, float alpha) {
  std_msgs::ColorRGBA result;
  result.r = red;
  result.g = green;
  result.b = blue;
  result.a = alpha;
  return result;
}

}  // namespace

class RoundaboutMissionNode {
 public:
  RoundaboutMissionNode()
      : nh_(),
        pnh_("~"),
        mission_(RoundaboutConfig()) {
    loadParameters();
    mission_.setConfig(config_);

    odom_sub_ = nh_.subscribe(odom_topic_, 5,
                              &RoundaboutMissionNode::odomCallback, this);
    route_sub_ = nh_.subscribe(route_topic_, 2,
                               &RoundaboutMissionNode::routeCallback, this);
    tracked_objects_sub_ = nh_.subscribe(
        tracked_objects_topic_, 5,
        &RoundaboutMissionNode::trackedObjectsCallback, this);
    localization_sub_ = nh_.subscribe(
        localization_topic_, 2,
        &RoundaboutMissionNode::localizationCallback, this);

    curve_speed_sub_ = nh_.subscribe(curve_speed_topic_, 2,
        &RoundaboutMissionNode::curveSpeedCallback, this);
    mission_speed_sub_ = nh_.subscribe(mission_speed_topic_, 2,
        &RoundaboutMissionNode::missionSpeedCallback, this);
    constraint_pub_ = nh_.advertise<mission_planner_msgs::BehaviorConstraint>(
        constraint_topic_, 2);
    state_pub_ =
        nh_.advertise<mission_planner_msgs::MissionState>(state_topic_, 2);
    distance_debug_pub_=nh_.advertise<std_msgs::String>("/mission/roundabout/distance_debug",2);
    acc_pub_=nh_.advertise<std_msgs::Float64MultiArray>("/mission/roundabout/acc",2);
    debug_pub_ =
        nh_.advertise<mission_planner_msgs::MissionDebug>(debug_topic_, 2);
    marker_pub_ = nh_.advertise<visualization_msgs::MarkerArray>(
        marker_topic_, 1, true);
    gap_marker_pub_ = nh_.advertise<visualization_msgs::MarkerArray>(
        gap_marker_topic_, 1);

    observation_raw_sub_=nh_.subscribe(observation_raw_topic_,1,&RoundaboutMissionNode::observationRawCallback,this);
    observation_ng_sub_=nh_.subscribe(observation_ng_topic_,1,&RoundaboutMissionNode::observationNongroundCallback,this);
    timer_ = nh_.createTimer(ros::Duration(1.0 / update_rate_hz_),
                             &RoundaboutMissionNode::timerCallback, this);

    ROS_INFO_STREAM("[roundabout_mission] ready enabled=" << config_.enabled
                    << " odom=" << odom_topic_ << " route=" << route_topic_
                    << " tracked_objects=" << tracked_objects_topic_
                    << " constraint=" << constraint_topic_);
    if (!config_.enabled) {
      ROS_WARN("[roundabout_mission] disabled: set roundabout/enabled=true "
               "after entering site coordinates");
    }
  }

 private:
  void loadPoint(const std::string& name, Point2* point) {
    pnh_.param<double>(name + "/x", point->x, 0.0);
    pnh_.param<double>(name + "/y", point->y, 0.0);
  }

  void loadParameters() {
    pnh_.param<std::string>("topics/curve_speed_limit", curve_speed_topic_,
                           "/control_feedback/curvature_capacity_speed_mps");
    pnh_.param<std::string>("topics/mission_speed_target", mission_speed_topic_,
                           "/control_feedback/mission_speed_target_mps");
    pnh_.param<double>("roundabout/gap_select/mpc_feedback_timeout", feedback_timeout_, 0.5);
    pnh_.param<bool>("roundabout/gap_select/commit_rear_yield_lock", config_.gs_commit_rear_yield_lock, false);
    pnh_.param<bool>("roundabout/gap_select/use_route_body_projection", config_.gs_route_body_projection, false);
    pnh_.param<double>("roundabout/gap_select/ego_width", config_.gs_ego_width, 1.9);
    pnh_.param<double>("roundabout/gap_select/prediction_npc_width", config_.gs_prediction_npc_width, 3.0);
    pnh_.param<bool>("roundabout/gap_select/spatial_gap_enabled", config_.gs_spatial_gap_enabled, false);
    pnh_.param<bool>("roundabout/gap_select/spatial_arrival_check", config_.gs_spatial_arrival_check, false);
    pnh_.param<bool>("roundabout/gap_select/adaptive_approach", config_.gs_adaptive_approach, false);
    pnh_.param<bool>("roundabout/gap_select/body_collision_guard", config_.gs_body_collision_guard, false);
    pnh_.param<double>("roundabout/gap_select/approach_response_s", config_.gs_approach_response, .3);
    pnh_.param<double>("roundabout/gap_select/collision_horizon_s", config_.gs_collision_horizon, 1.0);
    pnh_.param<double>("roundabout/gap_select/collision_margin_m", config_.gs_collision_margin, .2);
    pnh_.param<double>("roundabout/gap_select/spatial_front_gap_m", config_.gs_spatial_front_gap, 2.5);
    pnh_.param<double>("roundabout/gap_select/spatial_rear_gap_m", config_.gs_spatial_rear_gap, 2.0);
    pnh_.param<double>("roundabout/gap_select/approach_decel_mps2", config_.gs_approach_decel, 1.0);
    pnh_.param<double>("roundabout/gap_select/approach_slow_distance_m", config_.gs_approach_slow_distance, 18.0);
    pnh_.param<bool>("roundabout/gap_select/timed_entry_approach", config_.gs_timed_entry_approach, false);
    pnh_.param<double>("roundabout/gap_select/approach_time_buffer_s", config_.gs_approach_time_buffer, 0.5);
    pnh_.param<bool>("roundabout/gap_select/approach_accel_compensation", config_.gs_approach_accel_compensation, false);
    pnh_.param<double>("roundabout/gap_select/approach_accel_upper_mps2", config_.gs_approach_accel_upper, 4.0);
    pnh_.param<bool>("roundabout/gap_select/rear_ttc_at_entry", config_.gs_rear_ttc_at_entry, false);
    pnh_.param<bool>("roundabout/gap_select/use_measured_entry_profile", config_.gs_measured_entry_profile, false);
    pnh_.param<bool>("roundabout/gap_select/use_mpc_prediction", config_.gs_use_mpc_prediction, false);
    pnh_.param<bool>("roundabout/gap_select/require_merge_progress", config_.gs_require_merge_progress, false);
    pnh_.param<bool>("roundabout/gap_select/use_tracker_velocity",
                     config_.gs_use_tracker_velocity, false);
    pnh_.param<double>("roundabout/gap_select/speed_min_span", config_.gs_speed_min_span, 0.8);
    pnh_.param<double>("roundabout/gap_select/speed_disagreement_limit", config_.gs_speed_disagreement_limit, 1.0);
    pnh_.param<double>("roundabout/gap_select/stop_reaction_time", config_.gs_stop_reaction_time, 0.3);
    pnh_.param<double>("roundabout/gap_select/stop_margin", config_.gs_stop_margin, 0.5);
    // Read the existing MPC ramp setting; never modify MPC parameters.
    prediction_accel_limit_ = std::numeric_limits<double>::infinity();
    nh_.getParam("mission_speed/rate_limit_up_mps2", prediction_accel_limit_);
    pnh_.param<std::string>("topics/odom", odom_topic_, "/odom");
    pnh_.param<std::string>("topics/route", route_topic_, "/local_path");
    pnh_.param<std::string>("topics/tracked_objects", tracked_objects_topic_,
                            "/perception/roundabout/tracked_objects");
    pnh_.param<std::string>("topics/localization_valid", localization_topic_,
                            "/localization/valid");
    pnh_.param<std::string>("topics/constraint", constraint_topic_,
                            "/mission/constraints/roundabout");
    pnh_.param<std::string>("topics/state", state_topic_,
                            "/mission/roundabout/state");
    pnh_.param<std::string>("topics/debug", debug_topic_,
                            "/mission/roundabout/debug");
    pnh_.param<std::string>("topics/gap_markers", gap_marker_topic_,
                            "/mission/roundabout/gap_markers");
    pnh_.param<std::string>("topics/markers", marker_topic_,
                            "/mission/roundabout/markers");
    pnh_.param<std::string>("frame_id", frame_id_, "map");
    pnh_.param<double>("update_rate_hz", update_rate_hz_, 20.0);
    pnh_.param<double>("odom_timeout", odom_timeout_, 0.4);
    pnh_.param<double>("tracked_objects/min_confidence", min_confidence_, 0.4);
    pnh_.param<bool>("tracked_objects/require_velocity_valid",
                     require_velocity_valid_, false);
    pnh_.param<bool>("tracked_objects/require_movement_confirmation",
                     require_movement_confirmation_, false);
    update_rate_hz_ = std::max(1.0, update_rate_hz_);
    odom_timeout_ = std::max(0.05, odom_timeout_);

    pnh_.param<bool>("roundabout/enabled", config_.enabled, false);
    pnh_.param<bool>("roundabout/counter_clockwise",
                     config_.counter_clockwise, true);
    pnh_.param<bool>("roundabout/require_tracker_stream",
                     config_.require_tracker_stream, true);
    pnh_.param<bool>("roundabout/require_localization",
                     config_.require_localization, true);
    loadPoint("roundabout/center", &config_.center);
    loadPoint("roundabout/yield_point", &config_.yield_point);
    loadPoint("roundabout/conflict_point", &config_.conflict_point);
    loadPoint("roundabout/exit_point", &config_.exit_point);

    double entry_heading_deg = 0.0;
    double entry_heading_tolerance_deg = 70.0;
    double tangent_heading_tolerance_deg = 60.0;
    pnh_.param<double>("roundabout/entry_heading_deg", entry_heading_deg, 0.0);
    pnh_.param<double>("roundabout/entry_heading_tolerance_deg",
                       entry_heading_tolerance_deg, 70.0);
    pnh_.param<double>("roundabout/tangent_heading_tolerance_deg",
                       tangent_heading_tolerance_deg, 60.0);
    config_.entry_heading = entry_heading_deg * kPi / 180.0;
    config_.entry_heading_tolerance =
        entry_heading_tolerance_deg * kPi / 180.0;
    config_.tangent_heading_tolerance =
        tangent_heading_tolerance_deg * kPi / 180.0;

    pnh_.param<double>("roundabout/radius/inner", config_.inner_radius, 8.0);
    pnh_.param<double>("roundabout/radius/outer", config_.outer_radius, 18.0);
    pnh_.param<double>("roundabout/radius/nominal", config_.nominal_radius,
                       13.0);
    pnh_.param<double>("roundabout/vehicle_roi/inner_radius",
                       config_.vehicle_roi_inner_radius, -1.0);
    pnh_.param<double>("roundabout/vehicle_roi/outer_radius",
                       config_.vehicle_roi_outer_radius, -1.0);
    pnh_.param<double>("roundabout/vehicle_roi/exit_lead_lateral_tolerance",
                       config_.exit_lead_lateral_tolerance, 2.0);
    pnh_.param<double>("roundabout/distance/activation",
                       config_.activation_distance, 35.0);
    pnh_.param<double>("roundabout/distance/decision",
                       config_.decision_distance, 18.0);
    pnh_.param<double>("roundabout/distance/exit_detection",
                       config_.exit_detection_radius, 6.0);
    pnh_.param<double>("roundabout/distance/exit_clear",
                       config_.exit_clear_distance, 12.0);
    pnh_.param<double>("roundabout/distance/route_projection_tolerance",
                       config_.route_projection_tolerance, 4.0);
    pnh_.param<double>("roundabout/distance/stop_buffer", config_.stop_buffer,
                       1.0);
    pnh_.param<double>("roundabout/distance/creep_buffer",
                       config_.creep_buffer, config_.stop_buffer);
    pnh_.param<double>("roundabout/distance/lead_search",
                       config_.lead_search_distance, 45.0);

    pnh_.param<double>("roundabout/speed/approach", config_.approach_speed,
                       6.0);
    pnh_.param<double>("roundabout/speed/circulation",
                       config_.circulation_speed, 7.0);
    pnh_.param<double>("roundabout/speed/exit", config_.exit_speed, 8.0);
    pnh_.param<double>("roundabout/speed/degraded", config_.degraded_speed,
                       2.0);
    pnh_.param<double>("roundabout/speed/stationary_threshold",
                       config_.stationary_speed, 0.3);

    pnh_.param<double>("roundabout/gap/ego_merge_time",
                       config_.ego_merge_time, 2.0);
    pnh_.param<double>("roundabout/gap/rear_time", config_.rear_time_gap, 4.0);
    pnh_.param<double>("roundabout/gap/rear_ttc_relax_floor",
                       config_.rear_ttc_relax_floor, 3.0);
    pnh_.param<double>("roundabout/gap/rear_ttc_relax_max",
                       config_.rear_ttc_relax_max, 0.5);
    pnh_.param<double>("roundabout/gap/relax_start_seconds",
                       config_.gap_relax_start_seconds, 5.0);
    pnh_.param<double>("roundabout/gap/relax_rate",
                       config_.gap_relax_rate, 0.1);
    pnh_.param<bool>("roundabout/gap/rear_time_is_total_ttc",
                     config_.rear_time_is_total_ttc, false);
    pnh_.param<double>("roundabout/gap/front_time", config_.front_time_gap,
                       2.0);
    pnh_.param<double>("roundabout/gap/front_time_relax_floor",
                       config_.front_time_relax_floor, 1.2);
    pnh_.param<double>("roundabout/gap/front_standstill_distance",
                       config_.front_standstill_distance, 5.0);
    pnh_.param<double>("roundabout/gap/front_departure_speed_ratio",
                       config_.front_departure_speed_ratio, 1.0);
    pnh_.param<double>("roundabout/gap/front_check_distance",
                       config_.front_check_distance, 35.0);
    pnh_.param<double>("roundabout/gap/stationary_block_distance",
                       config_.stationary_block_distance, 20.0);
    pnh_.param<double>("roundabout/gap/uncertain_object_block_distance",
                       config_.uncertain_object_block_distance, 15.0);
    pnh_.param<double>("roundabout/gap/prediction_uncertainty_time",
                       config_.prediction_uncertainty_time, 0.5);
    pnh_.param<double>("roundabout/gap/safe_confirm_seconds",
                       config_.safe_confirm_seconds, 0.5);
    pnh_.param<double>("roundabout/gap/safe_confirm_relax_floor",
                       config_.safe_confirm_relax_floor, 0.15);

    pnh_.param<bool>("roundabout/gap_select/opportunity_enabled", config_.gs_opportunity_enabled, false);
    pnh_.param<bool>("roundabout/gap_select/spatial_only_admission", config_.gs_spatial_only_admission, false);
    pnh_.param<bool>("roundabout/gap_select/observed_entry_enabled",config_.gs_observed_entry_enabled,false);
    pnh_.param<bool>("roundabout/gap_select/preparation_enabled",config_.gs_preparation_enabled,false);
    pnh_.param<double>("roundabout/gap_select/preparation_wait_distance_m",config_.gs_preparation_wait_distance,3.);
    pnh_.param<double>("roundabout/gap_select/preparation_max_speed_mps",config_.gs_preparation_max_speed,1.5);
    pnh_.param<double>("roundabout/gap_select/preparation_margin_m",config_.gs_preparation_margin,.5);
    pnh_.param<double>("roundabout/gap_select/preparation_horizon_s",config_.gs_preparation_horizon,4.);
    pnh_.param<double>("roundabout/gap_select/observation_timeout_s",config_.gs_observation_timeout,.5);
    pnh_.param<double>("roundabout/gap_select/unknown_speed_upper_mps",config_.gs_unknown_speed_upper,8.);
    pnh_.param<double>("roundabout/gap_select/observation_radial_half_m",config_.gs_observation_radial_half,.7);
    pnh_.param<double>("roundabout/gap_select/post_clear_horizon_s",config_.gs_post_clear_horizon,.5);
    pnh_.param<std::string>("roundabout/observation/raw_cloud",observation_raw_topic_,"/perception/points_gravity");
    pnh_.param<std::string>("roundabout/observation/nonground_cloud",observation_ng_topic_,"/nonground");
    pnh_.param<std::string>("roundabout/observation/frame",observation_frame_,"velodyne_ground");
    pnh_.param<double>("roundabout/observation/resolution_m",observation_resolution_,.5);
    pnh_.param<double>("roundabout/observation/ground_height_below_sensor_m",observation_height_,1.765);
    nh_.getParam("/lidar_extrinsic/z_from_ground",observation_height_);
    pnh_.param<double>("lidar_tracker/sensor_extrinsic/x",observation_tf_.sensor_x,1.1);
    pnh_.param<double>("lidar_tracker/sensor_extrinsic/y",observation_tf_.sensor_y,0.);
    pnh_.param<double>("lidar_tracker/sensor_extrinsic/z",observation_tf_.sensor_z,1.33);
    double observation_yaw_deg=0.;pnh_.param<double>("lidar_tracker/sensor_extrinsic/yaw_deg",observation_yaw_deg,0.);
    observation_tf_.sensor_yaw=observation_yaw_deg*kPi/180.;
    pnh_.param<bool>("roundabout/gap_select/opportunity_rear_yield", config_.gs_opportunity_rear_yield, false);
    pnh_.param<bool>("roundabout/gap_select/commit_acc_only", config_.gs_commit_acc_only, false);
    pnh_.param<double>("roundabout/gap_select/entry_commit_distance_m", config_.gs_entry_commit_distance, 8.0);
    pnh_.param<double>("roundabout/gap_select/entry_commit_max_speed_mps", config_.gs_entry_commit_max_speed, 5.0);
    pnh_.param<double>("roundabout/gap_select/opportunity_horizon_s", config_.gs_opportunity_horizon, 1.2);
    pnh_.param<double>("roundabout/gap_select/opportunity_step_s", config_.gs_opportunity_step, 0.1);
    pnh_.param<double>("roundabout/gap_select/opportunity_expire_confirm_s", config_.gs_opportunity_expire_confirm, 0.8);
    pnh_.param<double>("roundabout/gap_select/duplicate_distance_m", config_.gs_duplicate_distance, 1.5);
    pnh_.param<double>("roundabout/gap_select/duplicate_coverage", config_.gs_duplicate_coverage, 0.8);
    pnh_.param<int>("roundabout/gap_select/duplicate_max_hits", config_.gs_duplicate_max_hits, 5);
    pnh_.param<int>("roundabout/gap_select/duplicate_parent_min_hits", config_.gs_duplicate_parent_min_hits, 6);

    // 흐름 틈 선택(roundabout/gap_select/*)
    pnh_.param<bool>("roundabout/gap_select/enabled",
                     config_.gap_select_enabled, false);
    pnh_.param<double>("roundabout/gap_select/ego_accel",
                       config_.gs_ego_accel, 2.2);
    pnh_.param<double>("roundabout/gap_select/ego_start_delay",
                       config_.gs_ego_start_delay, 0.2);
    pnh_.param<double>("roundabout/gap_select/ego_max_speed",
                       config_.gs_ego_max_speed, 0.0);
    pnh_.param<double>("roundabout/gap_select/ego_length",
                       config_.gs_ego_length, 4.6);
    pnh_.param<double>("roundabout/gap_select/min_vehicle_length",
                       config_.gs_min_vehicle_length, 4.0);
    pnh_.param<double>("roundabout/gap_select/front_headway",
                       config_.gs_front_headway, 1.0);
    pnh_.param<double>("roundabout/gap_select/rear_headway",
                       config_.gs_rear_headway, 1.2);
    pnh_.param<double>("roundabout/gap_select/standstill_gap",
                       config_.gs_standstill_gap, 2.0);
    pnh_.param<double>("roundabout/gap_select/check_horizon",
                       config_.gs_check_horizon, 3.0);
    pnh_.param<double>("roundabout/gap_select/speed_margin",
                       config_.gs_speed_margin, 0.5);
    pnh_.param<double>("roundabout/gap_select/entry_zone",
                       config_.gs_entry_zone, 1.0);
    pnh_.param<double>("roundabout/gap_select/max_wait",
                       config_.gs_max_wait, 12.0);
    pnh_.param<double>("roundabout/gap_select/go_tolerance",
                       config_.gs_go_tolerance, 0.05);
    pnh_.param<double>("roundabout/gap_select/go_tolerance_front",
                       config_.gs_go_tolerance_front, 0.4);
    pnh_.param<double>("roundabout/gap_select/commit_front_tolerance",
                       config_.gs_commit_front_tolerance, 1.0);
    pnh_.param<bool>("roundabout/gap_select/sequential",
                     config_.gs_sequential, true);
    pnh_.param<double>("roundabout/gap_select/ttc_rear",
                       config_.gs_ttc_rear, 1.0);
    pnh_.param<double>("roundabout/gap_select/late_margin",
                       config_.gs_late_margin, 0.2);
    pnh_.param<double>("roundabout/gap_select/seq_go_tolerance",
                       config_.gs_seq_go_tolerance, 0.3);
    pnh_.param<double>("roundabout/gap_select/seq_rear_headway",
                       config_.gs_seq_rear_headway, 0.3);
    pnh_.param<double>("roundabout/gap_select/leader_start_distance",
                       config_.gs_leader_start_distance, 9.0);
    pnh_.param<double>("roundabout/gap_select/leader_decel_horizon",
                       config_.gs_leader_decel_horizon, 0.5);
    pnh_.param<double>("roundabout/gap_select/leader_decel_limit",
                       config_.gs_leader_decel_limit, 1.5);
    pnh_.param<double>("roundabout/gap_select/prediction_follow_standstill_gap",
                       config_.gs_prediction_follow_standstill_gap, 4.0);
    pnh_.param<double>("roundabout/gap_select/prediction_follow_time_gap",
                       config_.gs_prediction_follow_time_gap, 1.5);
    // The site profile is also carried with the selected lead to the command adapter.
    pnh_.param<bool>("roundabout/gap_select/adaptive_leader_start",
                     config_.gs_adaptive_leader_start, false);
    pnh_.param<double>("roundabout/gap_select/leader_start_max_distance",
                       config_.gs_leader_start_max_distance, 12.0);
    pnh_.param<double>("roundabout/gap_select/speed_window",
                       config_.gs_speed_window, 1.5);
    pnh_.param<double>("roundabout/gap_select/skip_confirm",
                       config_.gs_skip_confirm, 0.3);
    pnh_.param<double>("roundabout/gap_select/skip_confirm_after_safe",
                       config_.gs_skip_confirm_after_safe, 0.8);
    pnh_.param<double>("roundabout/gap_select/leader_release_margin_s",
                       config_.gs_leader_release_margin, 0.6);
    pnh_.param<double>("roundabout/gap_select/leader_release_accel",
                       config_.gs_leader_release_accel, 1.0);
    pnh_.param<double>("roundabout/gap_select/leader_release_min_speed",
                       config_.gs_leader_release_min_speed, 2.0);
    {
      std::string entry_model;
      pnh_.param<std::string>("roundabout/entry_model", entry_model, "legacy");
      if(entry_model!="legacy"&&entry_model!="distance"&&entry_model!="time_window"&&entry_model!="observed_follow"&&entry_model!="window")
        throw std::runtime_error("Unknown roundabout entry_model: "+entry_model);
      if(entry_model=="observed_follow") {
        config_.gap_select_enabled=true;
        config_.gs_observed_entry_enabled=true;
      }
      config_.tw_enabled = entry_model == "time_window";
      config_.distance_enabled = entry_model == "distance" || entry_model == "window";
      config_.window_enabled = entry_model == "window";
      if(config_.distance_enabled)config_.gap_select_enabled=true;
      std::string motion_model;
      pnh_.param<std::string>("roundabout/distance_entry/ego_motion_model",motion_model,"constant_accel");
      if(motion_model!="constant_accel"&&motion_model!="measured_profile")throw std::runtime_error("Unknown roundabout ego_motion_model");
      config_.distance_measured_profile=motion_model=="measured_profile";
