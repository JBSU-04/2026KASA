  void odomCallback(const nav_msgs::Odometry::ConstPtr& message) {
    std::lock_guard<std::mutex> lock(mutex_);
    if(ego_.valid && distance(ego_.position,{message->pose.pose.position.x,message->pose.pose.position.y})>config_.reset_jump_distance) {
      observation_.frames.clear();observation_poses_.clear();observation_raw_.clear();observation_ng_.clear();
    }
    ego_.position.x = message->pose.pose.position.x;
    ego_.position.y = message->pose.pose.position.y;
    ego_.yaw = tf2::getYaw(message->pose.pose.orientation);
    ego_.speed = std::hypot(message->twist.twist.linear.x,
                            message->twist.twist.linear.y);
    ego_.valid = std::isfinite(ego_.position.x) &&
                 std::isfinite(ego_.position.y) && std::isfinite(ego_.yaw) &&
                 std::isfinite(ego_.speed);
    last_odom_time_ = ros::Time::now();
    auto pose=observation_tf_;pose.x=ego_.position.x;pose.y=ego_.position.y;
    pose.z=message->pose.pose.position.z;pose.yaw=ego_.yaw;
    observation_poses_.push_back({message->header.stamp.isZero()?last_odom_time_.toSec():message->header.stamp.toSec(),pose});
    while(observation_poses_.size()>60)observation_poses_.pop_front();
  }

  void observationRawCallback(const sensor_msgs::PointCloud2::ConstPtr& message) {
    std::lock_guard<std::mutex> lock(mutex_);
    observation_raw_.push_back(message);while(observation_raw_.size()>4)observation_raw_.pop_front();
    processObservation();
  }
  void observationNongroundCallback(const sensor_msgs::PointCloud2::ConstPtr& message) {
    std::lock_guard<std::mutex> lock(mutex_);
    observation_ng_.push_back(message);while(observation_ng_.size()>4)observation_ng_.pop_front();
    processObservation();
  }
  void processObservation() {
    if(!config_.gs_observed_entry_enabled || !ego_.valid || observation_poses_.empty() ||
        distance(ego_.position,config_.center)>80.)return;
    for(const auto& raw:observation_raw_) {
      const double stamp=raw->header.stamp.toSec();
      if(stamp<=0 || raw->header.frame_id!=observation_frame_ ||
          (!observation_.frames.empty() && stamp<=observation_.frames.back()->stamp) ||
          std::abs(ros::Time::now().toSec()-stamp)>config_.gs_observation_timeout)continue;
      sensor_msgs::PointCloud2::ConstPtr ng;
      double best=.031;
      for(const auto& cloud:observation_ng_) {
        const double dt=std::abs(cloud->header.stamp.toSec()-stamp);
        if(cloud->header.frame_id==observation_frame_ && dt<best){ng=cloud;best=dt;}
      }
      if(!ng)continue;
      const auto pose=std::min_element(observation_poses_.begin(),observation_poses_.end(),
          [stamp](const auto& a,const auto& b){return std::abs(a.first-stamp)<std::abs(b.first-stamp);});
      if(std::abs(pose->first-stamp)>.15)continue;
      std::vector<ObservationPoint> rays,occupied;
      if(!observationPoints(*raw,pose->second,&rays) || !observationPoints(*ng,pose->second,&occupied) || rays.size()<100)continue;
      const auto origin=pose->second.origin();
      observation_.add(buildRoundaboutObservation(config_.center.x,config_.center.y,
          config_.outer_radius+(config_.gs_preparation_enabled?config_.gs_entry_commit_distance+5.:3.),observation_resolution_,stamp,origin,origin.z-observation_height_,rays,occupied));
    }
  }

  void routeCallback(const nav_msgs::Path::ConstPtr& message) {
